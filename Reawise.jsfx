);

// Dynamic GUI redraw triggers
now_t_mtr = time_precise();
dt_mtr = last_mtr_time > 0 ? min(0.1, max(0.001, now_t_mtr - last_mtr_time)) : 0.016;
last_mtr_time = now_t_mtr;

// Latch incoming note triggers before decay
meter_l_raw > meter_l_disp ? meter_l_disp = meter_l_raw;
meter_r_raw > meter_r_disp ? meter_r_disp = meter_r_raw;
meter_l_raw = 0.0;
meter_r_raw = 0.0;

// Peak hold decay handling (0.6s hold, then smooth exponential drop)
meter_l_disp >= meter_l_peak ? (
  meter_l_peak = meter_l_disp;
  meter_l_peak_time = now_t_mtr;
) : (
  (now_t_mtr - meter_l_peak_time > 0.6) ? (
    meter_l_peak *= exp(-dt_mtr * 3.5);
    meter_l_peak < 0.005 ? meter_l_peak = 0.0;
  );
);

meter_r_disp >= meter_r_peak ? (
  meter_r_peak = meter_r_disp;
  meter_r_peak_time = now_t_mtr;
) : (
  (now_t_mtr - meter_r_peak_time > 0.6) ? (
    meter_r_peak *= exp(-dt_mtr * 3.5);
    meter_r_peak < 0.005 ? meter_r_peak = 0.0;
  );
);

(now_t_mtr - meter_l_num_time > 0.8) ? (
  meter_l_num_peak = 0;
  meter_r_num_peak = 0;
);

(cur_w != last_gfx_w || cur_h != last_gfx_h) ? (
  last_gfx_w = cur_w;
  last_gfx_h = cur_h;
  gfx_setimgdim(1, cur_w, cur_h);
  gui_dirty = 1;
);

mouse_press || mouse_release || mouse_down || mouse_middle_press || drag_mode > 0 || step_paint_mode >= 0 || kb_paint_mode >= 0 ? (
  gui_dirty = 1;
);

(m_x != last_m_x || m_y != last_m_y) ? (
  last_m_x = m_x;
  last_m_y = m_y;
  gui_dirty = 1;
);

is_playing_transport != last_transport_play ? (
  last_transport_play = is_playing_transport;
  gui_dirty = 1;
);

// Sum the most recent audio LFO feedback for visual master offsets.
gui_master_len = 0; gui_master_density = 0; gui_master_swing = 0; gui_master_gate = 0;
gui_master_i = 0;
while (gui_master_i < NUM_TRACKS) (
  is_playing_transport ? (
    4600[gui_master_i] == 64 ? gui_master_len += 4740[gui_master_i] * 16.0 :
    4600[gui_master_i] == 65 ? gui_master_density += 4740[gui_master_i] * 50.0 :
    4600[gui_master_i] == 66 ? gui_master_swing += 4740[gui_master_i] * 50.0 :
    4600[gui_master_i] == 67 ? gui_master_gate += 4740[gui_master_i] * 50.0;
  );
  gui_master_i += 1;
);
gui_master_len = floor(gui_master_len + 0.5);
gui_master_density = min(100, max(0, master_density + floor(gui_master_density + 0.5)));
gui_master_swing = floor(gui_master_swing + 0.5);
gui_master_gate = min(100, max(-100, master_gate + floor(gui_master_gate + 0.5)));
// Modulated controls still belong to the cached interface and need refreshes.
// The waveform itself is drawn separately and does not invalidate this cache.
has_lfo_gui_anim = 0;
(lfo_sh_menu_open || lfo_ds_menu_open || scale_menu_open || lfo_rt_menu_open) ? has_lfo_gui_anim = 1;

ti_hf = 0;
while (ti_hf < NUM_TRACKS && !has_lfo_gui_anim) (
  (
    (euc_mode && 4600[ti_hf] == 4) ||
    4600[ti_hf] == 3 ||
    4600[ti_hf] == 5 || 4600[ti_hf] == 7 || 4600[ti_hf] == 61 || 4600[ti_hf] == 62 || 4600[ti_hf] == 63 || (4600[ti_hf] >= 64 && 4600[ti_hf] <= 67) ||
    (gate_mode && 4600[ti_hf] == 8) ||
    (pan_mode && 4600[ti_hf] == 9) ||
    (timing_mode && 4600[ti_hf] == 10) ||
    (ratchet_mode && 4600[ti_hf] == 11) ||
    (chance_mode && 4600[ti_hf] == 12)
  ) ? has_lfo_gui_anim = 1;
  ti_hf += 1;
);
(is_playing_transport || (!4580[lfo_cur_tr] && 4600[lfo_cur_tr] != 0) || lfo_sh_menu_open || lfo_ds_menu_open || scale_menu_open || lfo_rt_menu_open) && has_lfo_gui_anim ? (
  gui_dirty = 1;
);

// Shared slot rendering for cached controls and independently animated LFO overlays.
function draw_track_slots(slot_tr, slot_ry, draw_slot_a, draw_slot_b) (
  num_y_off = max(1, floor(1 * sy));
  draw_slot_a ? (
  // Slot A (Volume scaled by Master Volume or Density)
  chance_x = 787;
  is_vol_mode = (2100[slot_tr] == 0);
  slot_track_vol = 1940[slot_tr];
  4600[slot_tr] == 61 ? slot_track_vol = min(100, max(0, floor(slot_track_vol + 4740[slot_tr] * 50.0 + 0.5)));
  slot_a_val = is_vol_mode ? floor(slot_track_vol * (master_vol / 100.0) + 0.5) : max(0, min(100, 1720[slot_tr] + gui_master_density - 100));
  (!is_vol_mode && 4600[slot_tr] == 5) ? (
    slot_a_val = min(100, max(0, floor(slot_a_val + 4740[slot_tr] * 50.0 + 0.5)));
  );
  ch_pct = slot_a_val / 100.0;
  bar_h = H(24);
  fill_h = slot_a_val > 0 ? max(floor(2 * sy), floor(bar_h * ch_pct)) : 0;

  gfx_r = 28 / 255.0; gfx_g = 28 / 255.0; gfx_b = 28 / 255.0;
  gfx_rect(X(chance_x), Y(slot_ry + 6), W(3), bar_h);

  fill_h > 0 ? (
    gfx_r = cr; gfx_g = cg; gfx_b = cb;
    gfx_rect(X(chance_x), Y(slot_ry + 6) + (bar_h - fill_h), W(3), fill_h);
  );

  // Slot A Box
  chance_hov = m_x >= chance_x + 6 && m_x <= chance_x + 50 && m_y >= slot_ry + 6 && m_y <= slot_ry + 30;
  bx_chc = X(chance_x + 6); bw_chc = W(44); by_chc = Y(slot_ry + 6); bh_chc = H(24);
  num_y_off = max(1, floor(1 * sy));
  is_vol_mode ? sprintf(#chance_str, "V %d", slot_a_val) : sprintf(#chance_str, "D %d", slot_a_val);
  draw_display_val(bx_chc, by_chc, bw_chc, bh_chc, W(3), chance_hov, (edit_active == 5 && edit_tr == slot_tr), 10, #chance_str, 92 / 255, 193 / 255, 254 / 255, num_y_off);
  gfx_setfont(1, "Inter", sz_main, 'B');

  );
  draw_slot_b ? (
  // Swing / Pan / Gate Box (Slot B)
  swing_x = 841;
  swing_hov = m_x >= swing_x && m_x <= swing_x + 48 && m_y >= slot_ry + 6 && m_y <= slot_ry + 30;
  bx_sw = X(swing_x); bw_sw = W(48); by_sw = Y(slot_ry + 6); bh_sw = H(24);
  cur_slot_b_m = 2140[slot_tr];

  // Bipolar Horizontal Meter for Slot B (under the box)
  b_meter_y = by_sw + bh_sw + max(2, H(3));
  b_meter_h = max(2, H(3));
  b_mid_x = bx_sw + floor(bw_sw * 0.5);
  b_half_w = b_mid_x - bx_sw;

  // Background track (dark #1c1c1c / RGB 28,28,28)
  gfx_r = 28 / 255.0; gfx_g = 28 / 255.0; gfx_b = 28 / 255.0;
  gfx_rect(bx_sw, b_meter_y, bw_sw, b_meter_h);

  // Meter value
  cur_slot_b_m == 2 ? (
    tr_g_val = 2160[slot_tr];
    4600[slot_tr] == 62 ? tr_g_val = min(100, max(-100, floor(tr_g_val + 4740[slot_tr] * 50.0 + 0.5)));
    tr_g_mult = tr_g_val >= 0 ? (1.0 + tr_g_val / 100.0) : max(0.02, 1.0 + (tr_g_val / 100.0) * 0.98);
    m_g_mult = gui_master_gate >= 0 ? (1.0 + gui_master_gate / 100.0) : max(0.02, 1.0 + (gui_master_gate / 100.0) * 0.98);
    eff_g_mult = tr_g_mult * m_g_mult;
    eff_g_val = (eff_g_mult >= 1.0) ? floor((eff_g_mult - 1.0) * 100.0 + 0.5) : floor((eff_g_mult - 1.0) / 0.98 * 100.0 + 0.5);
    m_val = min(100, max(-100, eff_g_val));
  ) : cur_slot_b_m == 1 ? (
    m_val = 2120[slot_tr];
    4600[slot_tr] == 63 ? m_val = min(100, max(-100, floor(m_val + 4740[slot_tr] * 50.0 + 0.5)));
  ) : (
    m_val = min(100, max(-100, 1740[slot_tr] + gui_master_swing));
    4600[slot_tr] == 6 ? (
      m_val = min(100, max(-100, floor(m_val + 4740[slot_tr] * 50.0 + 0.5)));
    );
  );

  // Active fill with track color
  gfx_r = cr; gfx_g = cg; gfx_b = cb;
  m_val == 0 ? (
    // Center tick: 2px wide, 3px high
    gfx_rect(b_mid_x - 1, b_meter_y, max(1, W(2)), b_meter_h);
  ) : m_val > 0 ? (
    // Positive: fill towards right from center
    m_pct = min(1.0, m_val / 100.0);
    m_fill_w = max(1, floor(b_half_w * m_pct));
    gfx_rect(b_mid_x - 1, b_meter_y, m_fill_w + 1, b_meter_h);
  ) : (
    // Negative: fill towards left from center
    m_pct = min(1.0, -m_val / 100.0);
    m_fill_w = max(1, floor(b_half_w * m_pct));
    gfx_rect(b_mid_x - m_fill_w, b_meter_y, m_fill_w + 1, b_meter_h);
  );

  cur_slot_b_m == 2 ? (
    gate_val = m_val;
    gate_val == 0 ? ( #sw_str = "G 0"; ) : gate_val > 0 ? sprintf(#sw_str, "G +%d", gate_val) : sprintf(#sw_str, "G %d", gate_val);
  ) : cur_slot_b_m == 1 ? (
    pan_val = m_val;
    pan_val == 0 ? ( #sw_str = "P 0"; ) : pan_val > 0 ? sprintf(#sw_str, "P +%d", pan_val) : sprintf(#sw_str, "P %d", pan_val);
  ) : (
    sw = min(100, max(-100, 1740[slot_tr] + gui_master_swing));
    4600[slot_tr] == 6 ? (
      sw = min(100, max(-100, floor(sw + 4740[slot_tr] * 50.0 + 0.5)));
    );
    sw == 0 ? ( #sw_str = "S 0"; ) : sw > 0 ? sprintf(#sw_str, "S +%d", sw) : sprintf(#sw_str, "S %d", sw);
  );

  draw_display_val(bx_sw, by_sw, bw_sw, bh_sw, W(3), swing_hov, (edit_active == 6 && edit_tr == slot_tr), 10, #sw_str, 92 / 255, 193 / 255, 254 / 255, num_y_off);
  gfx_setfont(1, "Inter", sz_main, 'B');

  );
);

gui_dirty ? (
