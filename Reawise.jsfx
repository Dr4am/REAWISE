desc: REAWISE
// Author: DR4
// Version: 1.5
options:no_meter

in_pin:none
out_pin:none

@init
ext_noinit = 1;
NUM_TRACKS = 16;
TRACKS_PER_PAGE = 8;
MAX_STEPS = 64;

current_page = 0;
step_page = 0;         // Active step page (0: 1..16, 1: 17..32, 2: 33..48, 3: 49..64)
euc_mode = 0;          // Global Euclidean mode (0 = off, 1 = on)
playhead_sync_offset = 0; // Playhead sync offset (-16..+16)
last_mouse_r_down = 0;
ti_init = 0;
while (ti_init < NUM_TRACKS) (
  1900[ti_init] = 0;   // Per-track sync offset (default 0)
  1920[ti_init] = 0;   // Per-track play mode (0: Forward, 1: Reverse, 2: Ping-Pong, 3: Stochastic)
  ti_init += 1;
);

lfo_cur_tr = 0; // Active LFO track shown in top bar (0..15)
ti_lfo = 0;
while (ti_lfo < NUM_TRACKS) (
  4500[ti_lfo] = 0;   // Shape: 0=Sine, 1=Tri, 2=SawUp, 3=SawDown, 4=Square, 5=S&H
  4520[ti_lfo] = 1;   // Sync mode: 1=Sync, 0=Freq (Hz)
  4540[ti_lfo] = 6;   // Sync rate: index 6 ("1/2")
  4560[ti_lfo] = 2.0; // Free frequency: 2.0 Hz
  4580[ti_lfo] = 1;   // Retrigger: 1=On (transport sync), 0=Off (free-running)
  4600[ti_lfo] = 0;   // Destination: 0=Off, 1..12=Pitch..Chance, 13..28=LFO 1..16
  4620[ti_lfo] = 100; // Modulation depth (0..100%)
  4640[ti_lfo] = 0.0; // Running phase
  4660[ti_lfo] = 0.0; // S&H held value
  4680[ti_lfo] = -999999; // S&H cycle index
  ti_lfo += 1;
);
function draw_lfo_wave_icon(shape, bx, by, bw, bh, s) local(cx, cy, hw, hh, k, x0, y0, x1, y1) (
  cx = bx + bw * 0.5;
  cy = by + bh * 0.5;
  hw = max(5, floor(8 * s));
  hh = max(3, floor(5 * s));

  shape == 0 ? (
    // Sine wave
    k = 0;
    x0 = cx - hw;
    y0 = cy;
    while (k <= 12) (
      x1 = cx - hw + (k / 12.0) * (hw * 2);
      y1 = cy - sin((k / 12.0) * 6.283185307) * hh;
      gfx_line(x0, y0, x1, y1);
      x0 = x1; y0 = y1;
      k += 1;
    );
  ) :
  shape == 1 ? (
    // Triangle wave
    gfx_line(cx - hw, cy, cx - hw * 0.5, cy - hh);
    gfx_line(cx - hw * 0.5, cy - hh, cx + hw * 0.5, cy + hh);
    gfx_line(cx + hw * 0.5, cy + hh, cx + hw, cy);
  ) :
  shape == 2 ? (
    // Sawtooth up
    gfx_line(cx - hw, cy + hh, cx + hw, cy - hh);
    gfx_line(cx + hw, cy - hh, cx + hw, cy + hh);
  ) :
  shape == 3 ? (
    // Sawtooth down
    gfx_line(cx - hw, cy - hh, cx + hw, cy + hh);
    gfx_line(cx - hw, cy + hh, cx - hw, cy - hh);
  ) :
  shape == 4 ? (
    // Square wave
    gfx_line(cx - hw, cy - hh, cx, cy - hh);
    gfx_line(cx, cy - hh, cx, cy + hh);
    gfx_line(cx, cy + hh, cx + hw, cy + hh);
  ) : (
    // Sample & Hold steps
    gfx_line(cx - hw, cy + hh * 0.4, cx - hw * 0.35, cy + hh * 0.4);
    gfx_line(cx - hw * 0.35, cy + hh * 0.4, cx - hw * 0.35, cy - hh * 0.8);
    gfx_line(cx - hw * 0.35, cy - hh * 0.8, cx + hw * 0.35, cy - hh * 0.8);
    gfx_line(cx + hw * 0.35, cy - hh * 0.8, cx + hw * 0.35, cy + hh * 0.7);
    gfx_line(cx + hw * 0.35, cy + hh * 0.7, cx + hw, cy + hh * 0.7);
  );
);

function get_lfo_sync_beats(idx, typ) local(base_beats) (
  idx == 0  ? base_beats = 128.0 :
  idx == 1  ? base_beats = 64.0  :
  idx == 2  ? base_beats = 32.0  :
  idx == 3  ? base_beats = 16.0  :
  idx == 4  ? base_beats = 8.0   :
  idx == 5  ? base_beats = 4.0   :
  idx == 6  ? base_beats = 2.0   :
  idx == 7  ? base_beats = 1.0   :
  idx == 8  ? base_beats = 0.5   :
  idx == 9  ? base_beats = 0.25  :
  idx == 10 ? base_beats = 0.125 :
  base_beats = 0.0625;

  typ == 1 ? (
    base_beats * 1.5;
  ) :
  typ == 2 ? (
    base_beats * (2.0 / 3.0);
  ) : (
    base_beats;
  );
);

function get_lfo_sync_str(idx, typ) (
  idx == 0  ? #lfo_s_str = "32/1" :
  idx == 1  ? #lfo_s_str = "16/1" :
  idx == 2  ? #lfo_s_str = "8/1"  :
  idx == 3  ? #lfo_s_str = "4/1"  :
  idx == 4  ? #lfo_s_str = "2/1"  :
  idx == 5  ? #lfo_s_str = "1/1"  :
  idx == 6  ? #lfo_s_str = "1/2"  :
  idx == 7  ? #lfo_s_str = "1/4"  :
  idx == 8  ? #lfo_s_str = "1/8"  :
  idx == 9  ? #lfo_s_str = "1/16" :
  idx == 10 ? #lfo_s_str = "1/32" :
  #lfo_s_str = "1/64";

  typ == 1 ? strcat(#lfo_s_str, "D") :
  typ == 2 ? strcat(#lfo_s_str, "T") : 0;
);

function get_lfo_dest_str(dest_idx) (
  dest_idx == 0  ? #lfo_d_str = "OFF" :
  dest_idx == 1  ? #lfo_d_str = "PITCH" :
  dest_idx == 2  ? #lfo_d_str = "RATE" :
  dest_idx == 3  ? #lfo_d_str = "LEN" :
  dest_idx == 4  ? #lfo_d_str = "FILL" :
  dest_idx == 5  ? #lfo_d_str = "DENS" :
  dest_idx == 6  ? #lfo_d_str = "SWING" :
  dest_idx == 7  ? #lfo_d_str = "VEL" :
  dest_idx == 8  ? #lfo_d_str = "GATE" :
  dest_idx == 9  ? #lfo_d_str = "PAN" :
  dest_idx == 10 ? #lfo_d_str = "TIME" :
  dest_idx == 11 ? #lfo_d_str = "RATC" :
  dest_idx == 12 ? #lfo_d_str = "CHNC" :
  (dest_idx >= 13 && dest_idx <= 28) ? (
    sprintf(#lfo_d_str, "LFO %d", dest_idx - 12);
  ) :
  #lfo_d_str = "OFF";
);

function get_next_lfo_dest(cur_d, dir, cur_tr) local(next_d) (
  next_d = cur_d + dir;
  next_d == (13 + cur_tr) ? next_d += dir;
  next_d < 0 ? next_d = 0 :
  next_d > 28 ? next_d = 28;
  next_d == (13 + cur_tr) ? next_d -= dir;
  next_d;
);

function get_lfo_value(tr_idx, b_beat, b_time) local(is_sync, shp, r_beats, f_hz, ph, raw_val, cur_cyc, in_mod, is_retrig, cur_t, cur_b) (
  4600[tr_idx] == 0 ? (
    0.0;
  ) : (
    shp = 4500[tr_idx];
    is_sync = 4520[tr_idx];
    in_mod = 4720[tr_idx];
    is_retrig = 4580[tr_idx];

    // If retrig is off (0), free-run via time_precise(); if on (1), sync to transport position
    !is_retrig ? (
      cur_t = time_precise();
      cur_b = cur_t * (tempo / 60.0);
    ) : (
      cur_t = b_time;
      cur_b = b_beat;
    );

    is_sync ? (
      r_beats = get_lfo_sync_beats(4540[tr_idx], 4700[tr_idx]);
      r_beats <= 0 ? r_beats = 2.0;
      ph = (cur_b / r_beats + in_mod * 0.5);
      ph = ph - floor(ph);
      cur_cyc = floor(cur_b / r_beats);
    ) : (
      f_hz = 4560[tr_idx];
      f_hz <= 0 ? f_hz = 2.0;
      in_mod != 0.0 ? (
        f_hz = max(0.05, f_hz * exp(in_mod * 1.5));
      );
      ph = (cur_t * f_hz);
      ph = ph - floor(ph);
      cur_cyc = floor(cur_t * f_hz);
    );

    shp == 0 ? (
      raw_val = sin(ph * 6.283185307);
    ) :
    shp == 1 ? (
      raw_val = 4.0 * abs(ph - 0.5) - 1.0;
    ) :
    shp == 2 ? (
      raw_val = 2.0 * ph - 1.0;
    ) :
    shp == 3 ? (
      raw_val = 1.0 - 2.0 * ph;
    ) :
    shp == 4 ? (
      raw_val = ph < 0.5 ? 1.0 : -1.0;
    ) : (
      cur_cyc != 4680[tr_idx] ? (
        4680[tr_idx] = cur_cyc;
        4660[tr_idx] = (rand(2000) / 1000.0) - 1.0;
      );
      raw_val = 4660[tr_idx];
    );

    raw_val * (4620[tr_idx] / 100.0);
  );
);


kb_paint_mode = -1;    // -1: idle, 0: clear, 1: paint
last_painted_note = -1;
last_kb_paint_x = -1;
last_kb_paint_y = -1;

// Pitch Quantizer (12-note keyboard mask, Root Note 0..11, Scale type 0..3)
quant_root = 0;       // 0 = C (0..11)
quant_scale = 0;      // 0 = CHROMATIC, 1 = MAJOR, 2 = MINOR, 3 = CUSTOM
quant_mask_bits = 4095; // 0xFFF = all 12 semitones active (1..11)
// Default CHROMATIC: all 12 semitones active (4000[0..11] = 1)
qi_init = 0;
while (qi_init < 12) (
  4000[qi_init] = 1;
  qi_init += 1;
);

function get_bit_pow(idx) (
  idx == 0 ? 1 :
  idx == 1 ? 2 :
  idx == 2 ? 4 :
  idx == 3 ? 8 :
  idx == 4 ? 16 :
  idx == 5 ? 32 :
  idx == 6 ? 64 :
  idx == 7 ? 128 :
  idx == 8 ? 256 :
  idx == 9 ? 512 :
  idx == 10 ? 1024 :
  idx == 11 ? 2048 : 0;
);

function update_quant_mask_bits() local(i, bit) (
  quant_mask_bits = 0;
  i = 0;
  while (i < 12) (
    bit = get_bit_pow(i);
    4000[i] ? (
      quant_mask_bits += bit;
    );
    i += 1;
  );
  quant_mask_bits;
);

function get_kb_note_at(mx, my) local(rx, ry, n, wk_idx) (
  (mx >= 52 && mx <= 146 && my >= 12 && my <= 36) ? (
    rx = mx - 52;
    ry = my - 12;
    n = -1;
    ry <= 14 ? (
      (rx >= 9 && rx <= 18) ? n = 1 :
      (rx >= 22 && rx <= 31) ? n = 3 :
      (rx >= 49 && rx <= 58) ? n = 6 :
      (rx >= 63 && rx <= 72) ? n = 8 :
      (rx >= 76 && rx <= 85) ? n = 10;
    );
    n < 0 ? (
      wk_idx = floor(rx * 7.0 / 94.0);
      wk_idx = min(6, max(0, wk_idx));
      wk_idx == 0 ? n = 0 :
      wk_idx == 1 ? n = 2 :
      wk_idx == 2 ? n = 4 :
      wk_idx == 3 ? n = 5 :
      wk_idx == 4 ? n = 7 :
      wk_idx == 5 ? n = 9 : n = 11;
    );
    n;
  ) : -1;
);

function set_quant_scale(new_scale) local(i) (
  quant_scale = new_scale;
  new_scale == 0 ? (
    // CHROMATIC: all 12 notes active
    i = 0;
    while (i < 12) (
      4000[i] = 1;
      i += 1;
    );
  ) :
  new_scale == 1 ? (
    // MAJOR
    i = 0;
    while (i < 12) (
      4000[i] = 0;
      i += 1;
    );
    4000[(quant_root + 0) % 12] = 1;
    4000[(quant_root + 2) % 12] = 1;
    4000[(quant_root + 4) % 12] = 1;
    4000[(quant_root + 5) % 12] = 1;
    4000[(quant_root + 7) % 12] = 1;
    4000[(quant_root + 9) % 12] = 1;
    4000[(quant_root + 11) % 12] = 1;
  ) :
  new_scale == 2 ? (
    // MINOR
    i = 0;
    while (i < 12) (
      4000[i] = 0;
      i += 1;
    );
    4000[(quant_root + 0) % 12] = 1;
    4000[(quant_root + 2) % 12] = 1;
    4000[(quant_root + 3) % 12] = 1;
    4000[(quant_root + 5) % 12] = 1;
    4000[(quant_root + 7) % 12] = 1;
    4000[(quant_root + 8) % 12] = 1;
    4000[(quant_root + 10) % 12] = 1;
  );
  update_quant_mask_bits();
);

function set_quant_root(new_root) (
  quant_root = (new_root + 12) % 12;
  (quant_scale == 1 || quant_scale == 2) ? (
    set_quant_scale(quant_scale);
  );
);

function update_quant_scale_type() local(all_on, is_maj, is_min, semi_i, maj_note, min_note, target_s) (
  all_on = 1;
  semi_i = 0;
  while (semi_i < 12) (
    !4000[semi_i] ? all_on = 0;
    semi_i += 1;
  );

  all_on ? (
    quant_scale = 0; // CHROMATIC
  ) : (
    is_maj = 1;
    semi_i = 0;
    while (semi_i < 12) (
      maj_note = (semi_i == 0 || semi_i == 2 || semi_i == 4 || semi_i == 5 || semi_i == 7 || semi_i == 9 || semi_i == 11);
      target_s = (quant_root + semi_i) % 12;
      (4000[target_s] != maj_note) ? is_maj = 0;
      semi_i += 1;
    );

    is_min = 1;
    semi_i = 0;
    while (semi_i < 12) (
      min_note = (semi_i == 0 || semi_i == 2 || semi_i == 3 || semi_i == 5 || semi_i == 7 || semi_i == 8 || semi_i == 10);
      target_s = (quant_root + semi_i) % 12;
      (4000[target_s] != min_note) ? is_min = 0;
      semi_i += 1;
    );

    is_maj ? quant_scale = 1 :
    is_min ? quant_scale = 2 :
    quant_scale = 3; // CUSTOM
  );
  update_quant_mask_bits();
);

function apply_quant_mask_bits(bits) local(i, bit) (
  quant_mask_bits = bits;
  i = 0;
  while (i < 12) (
    bit = get_bit_pow(i);
    (bits & bit) ? (
      4000[i] = 1;
    ) : (
      4000[i] = 0;
    );
    i += 1;
  );
  update_quant_scale_type();
);

function quantize_pitch(raw_p) local(semi, has_active, i, best_p, d, s_down, s_up) (
  has_active = 0;
  i = 0;
  while (i < 12) (
    4000[i] ? has_active = 1;
    i += 1;
  );

  !has_active ? raw_p : (
    semi = raw_p % 12;
    4000[semi] ? raw_p : (
      best_p = raw_p;
      d = 1;
      while (d <= 6 && best_p == raw_p) (
        s_down = (semi - d + 12) % 12;
        s_up = (semi + d) % 12;
        4000[s_down] ? (
          best_p = raw_p - d;
        ) :
        4000[s_up] ? (
          best_p = raw_p + d;
        );
        d += 1;
      );
      best_p;
    );
  );
);

function get_next_scale_pitch(cur_p, dir) local(has_active, i, p, target_p) (
  has_active = 0;
  i = 0;
  while (i < 12) (
    4000[i] ? has_active = 1;
    i += 1;
  );

  !has_active ? (
    min(108, max(24, cur_p + dir))
  ) : (
    p = cur_p + dir;
    target_p = -1;
    dir > 0 ? (
      while (p <= 108 && target_p < 0) (
        4000[p % 12] ? target_p = p;
        p += 1;
      );
      target_p < 0 ? (
        p = 24;
        while (p <= cur_p && target_p < 0) (
          4000[p % 12] ? target_p = p;
          p += 1;
        );
      );
    ) : (
      while (p >= 24 && target_p < 0) (
        4000[p % 12] ? target_p = p;
        p -= 1;
      );
      target_p < 0 ? (
        p = 108;
        while (p >= cur_p && target_p < 0) (
          4000[p % 12] ? target_p = p;
          p -= 1;
        );
      );
    );
    target_p >= 0 ? target_p : cur_p;
  );
);

function get_next_scale_octave(cur_p, dir) local(has_active, i, q_p, p) (
  has_active = 0;
  i = 0;
  while (i < 12) (
    4000[i] ? has_active = 1;
    i += 1;
  );

  !has_active ? (
    min(108, max(24, cur_p + dir * 12))
  ) : (
    q_p = quantize_pitch(cur_p);
    p = q_p + dir * 12;
    (p >= 24 && p <= 108) ? p : q_p;
  );
);

edit_active = 0;       // Keyboard text edit state (0=none, 1=Ch, 2=Pitch, 3=Rate, 4=Len, 5=Density, 6=Swing, 7=Fill, 8=Amount, 9=RateHz, 10=LfoTr, 11=Root)
edit_tr = -1;          // Target track index for text editing
#edit_buf = "";        // Typed text buffer
edit_first_key = 0;    // 1 = newly focused field (first keystroke overwrites)
info_mode = 0;         // Global tooltips mode (0 = off, 1 = on)
info_lang = 1;         // Tooltip language (0 = ITA, 1 = ENG, default 1)
velocity_mode = 0;     // Wheel step velocity edit mode (0 = off, 1 = on)
gate_mode = 0;         // Wheel step gate length edit mode (0 = off, 1 = on)
pan_mode = 0;          // Wheel step pan edit mode (0 = off, 1 = on)
timing_mode = 0;       // Wheel step micro-timing edit mode (0 = off, 1 = on)
ratchet_mode = 0;      // Wheel step ratcheting edit mode (0 = off, 1 = on)
chance_mode = 0;       // Wheel step chance edit mode (0 = off, 1 = on)
cond_mode = 0;         // Wheel step trig condition edit mode (0 = off, 1 = on)
drag_mode = 0;
drag_tr = -1;
drag_start_y = 0;
drag_start_val = 0;
step_paint_mode = -1;  // Drag step paint state (-1: idle, 0: clear, 1: paint)
last_painted_offset = -1; // Last modified step offset (tr * 64 + step)
last_click_time = 0;
last_click_elem = -1;

gui_dirty = 1;
last_gfx_w = 0;
last_gfx_h = 0;
last_m_x = -1;
last_m_y = -1;

b_last_cur_beat = 0;
b_was_playing = 0;
b_last_play_pos = 0;
b_tr_init = 0;
while (b_tr_init < NUM_TRACKS) (
  1820[b_tr_init] = -999999;
  b_tr_init += 1;
);

// Internal Undo / Redo system (16 tracks x 64 steps = 1024 steps)
UNDO_MAX = 16;
UNDO_BLOCK_SIZE = 9000;
UNDO_BASE = 50000;
undo_count = 0;
undo_head = 0;

REDO_MAX = 16;
REDO_BLOCK_SIZE = 9000;
REDO_BASE = 250000;
redo_count = 0;
redo_head = 0;

function undo_push() local(dest_base, si, ti) (
  dest_base = UNDO_BASE + (undo_head % UNDO_MAX) * UNDO_BLOCK_SIZE;

  // Save step data: trigger, velocity, pan, gate, timing, ratchet, chance, cond
  si = 0;
  while (si < 1024) (
    dest_base[si]        = 10000[si];
    dest_base[1024 + si] = 12000[si];
    dest_base[2048 + si] = 14000[si];
    dest_base[3072 + si] = 16000[si];
    dest_base[4096 + si] = 18000[si];
    dest_base[5120 + si] = 20000[si];
    dest_base[6144 + si] = 22000[si];
    dest_base[7168 + si] = 24000[si];
    si += 1;
  );

  // Save 16-track parameters
  ti = 0;
  while (ti < 16) (
    dest_base[8192 + ti]       = 1600[ti]; // Pitch
    dest_base[8192 + 16 + ti]  = 1620[ti]; // Channel
    dest_base[8192 + 32 + ti]  = 1640[ti]; // Rate
    dest_base[8192 + 48 + ti]  = 1660[ti]; // Length
    dest_base[8192 + 64 + ti]  = 1680[ti]; // Solo
    dest_base[8192 + 80 + ti]  = 1700[ti]; // Mute
    dest_base[8192 + 96 + ti]  = 1720[ti]; // Chance
    dest_base[8192 + 112 + ti] = 1740[ti]; // Swing
    dest_base[8192 + 128 + ti] = 1860[ti]; // Euclidean Fill
    dest_base[8192 + 144 + ti] = 1900[ti]; // Sync offset
    dest_base[8192 + 160 + ti] = 1920[ti]; // Play mode
    ti += 1;
  );
  dest_base[8400] = euc_mode;
  dest_base[8401] = velocity_mode;
  dest_base[8402] = gate_mode;
  dest_base[8403] = pan_mode;
  dest_base[8404] = timing_mode;
  dest_base[8405] = ratchet_mode;
  dest_base[8406] = chance_mode;
  dest_base[8407] = cond_mode;
  dest_base[8408] = playhead_sync_offset;
  update_quant_mask_bits();
  dest_base[8409] = quant_root;
  dest_base[8410] = quant_scale;
  dest_base[8411] = quant_mask_bits;

  undo_head += 1;
  undo_count < UNDO_MAX ? undo_count += 1;

  // New action clears redo history
  redo_count = 0;
  redo_head = 0;
);

function undo_pop() local(r_dest, si, ti, src_base) (
  undo_count > 0 ? (
    // Save current state into redo buffer before restoring
    r_dest = REDO_BASE + (redo_head % REDO_MAX) * REDO_BLOCK_SIZE;
    si = 0;
    while (si < 1024) (
      r_dest[si]        = 10000[si];
      r_dest[1024 + si] = 12000[si];
      r_dest[2048 + si] = 14000[si];
      r_dest[3072 + si] = 16000[si];
      r_dest[4096 + si] = 18000[si];
      r_dest[5120 + si] = 20000[si];
      r_dest[6144 + si] = 22000[si];
      r_dest[7168 + si] = 24000[si];
      si += 1;
    );
    ti = 0;
    while (ti < 16) (
      r_dest[8192 + ti]       = 1600[ti];
      r_dest[8192 + 16 + ti]  = 1620[ti];
      r_dest[8192 + 32 + ti]  = 1640[ti];
      r_dest[8192 + 48 + ti]  = 1660[ti];
      r_dest[8192 + 64 + ti]  = 1680[ti];
      r_dest[8192 + 80 + ti]  = 1700[ti];
      r_dest[8192 + 96 + ti]  = 1720[ti];
      r_dest[8192 + 112 + ti] = 1740[ti];
      r_dest[8192 + 128 + ti] = 1860[ti];
      r_dest[8192 + 144 + ti] = 1900[ti];
      r_dest[8192 + 160 + ti] = 1920[ti];
      ti += 1;
    );
    r_dest[8400] = euc_mode;
    r_dest[8401] = velocity_mode;
    r_dest[8402] = gate_mode;
    r_dest[8403] = pan_mode;
    r_dest[8404] = timing_mode;
    r_dest[8405] = ratchet_mode;
    r_dest[8406] = chance_mode;
    r_dest[8407] = cond_mode;
    r_dest[8408] = playhead_sync_offset;
    r_dest[8409] = quant_root;
    r_dest[8410] = quant_scale;
    r_dest[8411] = quant_mask_bits;
    redo_head += 1;
    redo_count < REDO_MAX ? redo_count += 1;

    undo_head -= 1;
    undo_head < 0 ? undo_head += UNDO_MAX;
    src_base = UNDO_BASE + (undo_head % UNDO_MAX) * UNDO_BLOCK_SIZE;

    // Restore per-step states (1024 steps)
    si = 0;
    while (si < 1024) (
      10000[si] = src_base[si];
      12000[si] = src_base[1024 + si];
      14000[si] = src_base[2048 + si];
      16000[si] = src_base[3072 + si];
      18000[si] = src_base[4096 + si];
      20000[si] = src_base[5120 + si];
      22000[si] = src_base[6144 + si];
      24000[si] = src_base[7168 + si];
      si += 1;
    );

    // Restore 16-track parameters
    ti = 0;
    while (ti < 16) (
      1600[ti] = src_base[8192 + ti];
      1620[ti] = src_base[8192 + 16 + ti];
      1640[ti] = src_base[8192 + 32 + ti];
      1660[ti] = src_base[8192 + 48 + ti];
      1680[ti] = src_base[8192 + 64 + ti];
      1700[ti] = src_base[8192 + 80 + ti];
      1720[ti] = src_base[8192 + 96 + ti];
      1740[ti] = src_base[8192 + 112 + ti];
      1860[ti] = src_base[8192 + 128 + ti];
      1900[ti] = src_base[8192 + 144 + ti];
      1920[ti] = src_base[8192 + 160 + ti];
      ti += 1;
    );
    euc_mode = src_base[8400];
    velocity_mode = src_base[8401];
    gate_mode = src_base[8402];
    pan_mode = src_base[8403];
    timing_mode = src_base[8404];
    ratchet_mode = src_base[8405];
    chance_mode = src_base[8406];
    cond_mode = src_base[8407];
    playhead_sync_offset = src_base[8408];
    quant_root = src_base[8409];
    quant_scale = src_base[8410];
    apply_quant_mask_bits(src_base[8411]);

    undo_count -= 1;
  );
);

function redo_pop() local(u_dest, si, ti, r_src) (
  redo_count > 0 ? (
    // Save current state into undo buffer before restoring
    u_dest = UNDO_BASE + (undo_head % UNDO_MAX) * UNDO_BLOCK_SIZE;
    si = 0;
    while (si < 1024) (
      u_dest[si]        = 10000[si];
      u_dest[1024 + si] = 12000[si];
      u_dest[2048 + si] = 14000[si];
      u_dest[3072 + si] = 16000[si];
      u_dest[4096 + si] = 18000[si];
      u_dest[5120 + si] = 20000[si];
      u_dest[6144 + si] = 22000[si];
      u_dest[7168 + si] = 24000[si];
      si += 1;
    );
    ti = 0;
    while (ti < 16) (
      u_dest[8192 + ti]       = 1600[ti];
      u_dest[8192 + 16 + ti]  = 1620[ti];
      u_dest[8192 + 32 + ti]  = 1640[ti];
      u_dest[8192 + 48 + ti]  = 1660[ti];
      u_dest[8192 + 64 + ti]  = 1680[ti];
      u_dest[8192 + 80 + ti]  = 1700[ti];
      u_dest[8192 + 96 + ti]  = 1720[ti];
      u_dest[8192 + 112 + ti] = 1740[ti];
      u_dest[8192 + 128 + ti] = 1860[ti];
      u_dest[8192 + 144 + ti] = 1900[ti];
      u_dest[8192 + 160 + ti] = 1920[ti];
      ti += 1;
    );
    u_dest[8400] = euc_mode;
    u_dest[8401] = velocity_mode;
    u_dest[8402] = gate_mode;
    u_dest[8403] = pan_mode;
    u_dest[8404] = timing_mode;
    u_dest[8405] = ratchet_mode;
    u_dest[8406] = chance_mode;
    u_dest[8407] = cond_mode;
    u_dest[8408] = playhead_sync_offset;
    u_dest[8409] = quant_root;
    u_dest[8410] = quant_scale;
    u_dest[8411] = quant_mask_bits;
    undo_head += 1;
    undo_count < UNDO_MAX ? undo_count += 1;

    redo_head -= 1;
    redo_head < 0 ? redo_head += REDO_MAX;
    r_src = REDO_BASE + (redo_head % REDO_MAX) * REDO_BLOCK_SIZE;

    // Restore per-step states (1024 steps)
    si = 0;
    while (si < 1024) (
      10000[si] = r_src[si];
      12000[si] = r_src[1024 + si];
      14000[si] = r_src[2048 + si];
      16000[si] = r_src[3072 + si];
      18000[si] = r_src[4096 + si];
      20000[si] = r_src[5120 + si];
      22000[si] = r_src[6144 + si];
      24000[si] = r_src[7168 + si];
      si += 1;
    );

    // Restore 16-track parameters
    ti = 0;
    while (ti < 16) (
      1600[ti] = r_src[8192 + ti];
      1620[ti] = r_src[8192 + 16 + ti];
      1640[ti] = r_src[8192 + 32 + ti];
      1660[ti] = r_src[8192 + 48 + ti];
      1680[ti] = r_src[8192 + 64 + ti];
      1700[ti] = r_src[8192 + 80 + ti];
      1720[ti] = r_src[8192 + 96 + ti];
      1740[ti] = r_src[8192 + 112 + ti];
      1860[ti] = r_src[8192 + 128 + ti];
      1900[ti] = r_src[8192 + 144 + ti];
      1920[ti] = r_src[8192 + 160 + ti];
      ti += 1;
    );
    euc_mode = r_src[8400];
    velocity_mode = r_src[8401];
    gate_mode = r_src[8402];
    pan_mode = r_src[8403];
    timing_mode = r_src[8404];
    ratchet_mode = r_src[8405];
    chance_mode = r_src[8406];
    cond_mode = r_src[8407];
    playhead_sync_offset = r_src[8408];
    quant_root = r_src[8409];
    quant_scale = r_src[8410];
    apply_quant_mask_bits(r_src[8411]);

    redo_count -= 1;
  );
);

// Elektron trig condition labels (0..43)
function get_cond_str(c_idx) (
  c_idx == 0  ? #c_str = "---" :
  c_idx == 1  ? #c_str = "1:2" :
  c_idx == 2  ? #c_str = "2:2" :
  c_idx == 3  ? #c_str = "1:3" :
  c_idx == 4  ? #c_str = "2:3" :
  c_idx == 5  ? #c_str = "3:3" :
  c_idx == 6  ? #c_str = "1:4" :
  c_idx == 7  ? #c_str = "2:4" :
  c_idx == 8  ? #c_str = "3:4" :
  c_idx == 9  ? #c_str = "4:4" :
  c_idx == 10 ? #c_str = "1:5" :
  c_idx == 11 ? #c_str = "2:5" :
  c_idx == 12 ? #c_str = "3:5" :
  c_idx == 13 ? #c_str = "4:5" :
  c_idx == 14 ? #c_str = "5:5" :
  c_idx == 15 ? #c_str = "1:6" :
  c_idx == 16 ? #c_str = "2:6" :
  c_idx == 17 ? #c_str = "3:6" :
  c_idx == 18 ? #c_str = "4:6" :
  c_idx == 19 ? #c_str = "5:6" :
  c_idx == 20 ? #c_str = "6:6" :
  c_idx == 21 ? #c_str = "1:7" :
  c_idx == 22 ? #c_str = "2:7" :
  c_idx == 23 ? #c_str = "3:7" :
  c_idx == 24 ? #c_str = "4:7" :
  c_idx == 25 ? #c_str = "5:7" :
  c_idx == 26 ? #c_str = "6:7" :
  c_idx == 27 ? #c_str = "7:7" :
  c_idx == 28 ? #c_str = "1:8" :
  c_idx == 29 ? #c_str = "2:8" :
  c_idx == 30 ? #c_str = "3:8" :
  c_idx == 31 ? #c_str = "4:8" :
  c_idx == 32 ? #c_str = "5:8" :
  c_idx == 33 ? #c_str = "6:8" :
  c_idx == 34 ? #c_str = "7:8" :
  c_idx == 35 ? #c_str = "8:8" :
  c_idx == 36 ? #c_str = "1ST" :
  c_idx == 37 ? #c_str = "/1ST" :
  c_idx == 38 ? #c_str = "PRE" :
  c_idx == 39 ? #c_str = "/PRE" :
  c_idx == 40 ? #c_str = "NEI" :
  c_idx == 41 ? #c_str = "/NEI" :
  c_idx == 42 ? #c_str = "FILL" :
  c_idx == 43 ? #c_str = "/FILL" :
  #c_str = "---";
);

// Elektron trig condition descriptions (Bilingual ITA / ENG)
function get_cond_desc(c_idx, lang) (
  lang == 0 ? (
    c_idx == 0  ? #c_desc = "Sempre attivo (suona ad ogni ciclo del pattern)" :
    c_idx == 1  ? #c_desc = "Suona al 1° ciclo su 2 (ciclo 1 suona, ciclo 2 muto)" :
    c_idx == 2  ? #c_desc = "Suona al 2° ciclo su 2 (ciclo 1 muto, ciclo 2 suona)" :
    c_idx == 3  ? #c_desc = "Suona solo al 1° ciclo su 3" :
    c_idx == 4  ? #c_desc = "Suona solo al 2° ciclo su 3" :
    c_idx == 5  ? #c_desc = "Suona solo al 3° ciclo su 3" :
    c_idx == 6  ? #c_desc = "Suona solo al 1° ciclo su 4" :
    c_idx == 7  ? #c_desc = "Suona solo al 2° ciclo su 4" :
    c_idx == 8  ? #c_desc = "Suona solo al 3° ciclo su 4" :
    c_idx == 9  ? #c_desc = "Suona solo al 4° ciclo su 4 (es. fill ogni 4 battute)" :
    c_idx == 10 ? #c_desc = "Suona solo al 1° ciclo su 5" :
    c_idx == 11 ? #c_desc = "Suona solo al 2° ciclo su 5" :
    c_idx == 12 ? #c_desc = "Suona solo al 3° ciclo su 5" :
    c_idx == 13 ? #c_desc = "Suona solo al 4° ciclo su 5" :
    c_idx == 14 ? #c_desc = "Suona solo al 5° ciclo su 5" :
    c_idx == 15 ? #c_desc = "Suona solo al 1° ciclo su 6" :
    c_idx == 16 ? #c_desc = "Suona solo al 2° ciclo su 6" :
    c_idx == 17 ? #c_desc = "Suona solo al 3° ciclo su 6" :
    c_idx == 18 ? #c_desc = "Suona solo al 4° ciclo su 6" :
    c_idx == 19 ? #c_desc = "Suona solo al 5° ciclo su 6" :
    c_idx == 20 ? #c_desc = "Suona solo al 6° ciclo su 6" :
    c_idx == 21 ? #c_desc = "Suona solo al 1° ciclo su 7" :
    c_idx == 22 ? #c_desc = "Suona solo al 2° ciclo su 7" :
    c_idx == 23 ? #c_desc = "Suona solo al 3° ciclo su 7" :
    c_idx == 24 ? #c_desc = "Suona solo al 4° ciclo su 7" :
    c_idx == 25 ? #c_desc = "Suona solo al 5° ciclo su 7" :
    c_idx == 26 ? #c_desc = "Suona solo al 6° ciclo su 7" :
    c_idx == 27 ? #c_desc = "Suona solo al 7° ciclo su 7" :
    c_idx == 28 ? #c_desc = "Suona solo al 1° ciclo su 8" :
    c_idx == 29 ? #c_desc = "Suona solo al 2° ciclo su 8" :
    c_idx == 30 ? #c_desc = "Suona solo al 3° ciclo su 8" :
    c_idx == 31 ? #c_desc = "Suona solo al 4° ciclo su 8" :
    c_idx == 32 ? #c_desc = "Suona solo al 5° ciclo su 8" :
    c_idx == 33 ? #c_desc = "Suona solo al 6° ciclo su 8" :
    c_idx == 34 ? #c_desc = "Suona solo al 7° ciclo su 8" :
    c_idx == 35 ? #c_desc = "Suona solo al 8° ciclo su 8" :
    c_idx == 36 ? #c_desc = "Suona solo al primissimo avvio del playback, poi mai piu" :
    c_idx == 37 ? #c_desc = "Muto al primo avvio, suona in tutti i cicli successivi (/1ST)" :
    c_idx == 38 ? #c_desc = "Suona solo se la condizione dello step precedente era VERA" :
    c_idx == 39 ? #c_desc = "Suona solo se la condizione dello step precedente era FALSA" :
    c_idx == 40 ? #c_desc = "Suona solo se la traccia vicina precedente ha suonato" :
    c_idx == 41 ? #c_desc = "Suona solo se la traccia vicina precedente NON ha suonato" :
    c_idx == 42 ? #c_desc = "Suona solo quando Fill Euclideo o modalita EUC e attiva" :
    c_idx == 43 ? #c_desc = "Suona sempre, TRANNE quando Fill Euclideo o EUC e attiva" :
    #c_desc = "Sempre attivo";
  ) : (
    c_idx == 0  ? #c_desc = "Always active (triggers on every pattern loop)" :
    c_idx == 1  ? #c_desc = "Triggers on 1st loop out of 2 (plays loop 1, muted loop 2)" :
    c_idx == 2  ? #c_desc = "Triggers on 2nd loop out of 2 (muted loop 1, plays loop 2)" :
    c_idx == 3  ? #c_desc = "Triggers only on 1st loop out of 3" :
    c_idx == 4  ? #c_desc = "Triggers only on 2nd loop out of 3" :
    c_idx == 5  ? #c_desc = "Triggers only on 3rd loop out of 3" :
    c_idx == 6  ? #c_desc = "Triggers only on 1st loop out of 4" :
    c_idx == 7  ? #c_desc = "Triggers only on 2nd loop out of 4" :
    c_idx == 8  ? #c_desc = "Triggers only on 3rd loop out of 4" :
    c_idx == 9  ? #c_desc = "Triggers only on 4th loop out of 4 (e.g. fill on loop 4)" :
    c_idx == 10 ? #c_desc = "Triggers only on 1st loop out of 5" :
    c_idx == 11 ? #c_desc = "Triggers only on 2nd loop out of 5" :
    c_idx == 12 ? #c_desc = "Triggers only on 3rd loop out of 5" :
    c_idx == 13 ? #c_desc = "Triggers only on 4th loop out of 5" :
    c_idx == 14 ? #c_desc = "Triggers only on 5th loop out of 5" :
    c_idx == 15 ? #c_desc = "Triggers only on 1st loop out of 6" :
    c_idx == 16 ? #c_desc = "Triggers only on 2nd loop out of 6" :
    c_idx == 17 ? #c_desc = "Triggers only on 3rd loop out of 6" :
    c_idx == 18 ? #c_desc = "Triggers only on 4th loop out of 6" :
    c_idx == 19 ? #c_desc = "Triggers only on 5th loop out of 6" :
    c_idx == 20 ? #c_desc = "Triggers only on 6th loop out of 6" :
    c_idx == 21 ? #c_desc = "Triggers only on 1st loop out of 7" :
    c_idx == 22 ? #c_desc = "Triggers only on 2nd loop out of 7" :
    c_idx == 23 ? #c_desc = "Triggers only on 3rd loop out of 7" :
    c_idx == 24 ? #c_desc = "Triggers only on 4th loop out of 7" :
    c_idx == 25 ? #c_desc = "Triggers only on 5th loop out of 7" :
    c_idx == 26 ? #c_desc = "Triggers only on 6th loop out of 7" :
    c_idx == 27 ? #c_desc = "Triggers only on 7th loop out of 7" :
    c_idx == 28 ? #c_desc = "Triggers only on 1st loop out of 8" :
    c_idx == 29 ? #c_desc = "Triggers only on 2nd loop out of 8" :
    c_idx == 30 ? #c_desc = "Triggers only on 3rd loop out of 8" :
    c_idx == 31 ? #c_desc = "Triggers only on 4th loop out of 8" :
    c_idx == 32 ? #c_desc = "Triggers only on 5th loop out of 8" :
    c_idx == 33 ? #c_desc = "Triggers only on 6th loop out of 8" :
    c_idx == 34 ? #c_desc = "Triggers only on 7th loop out of 8" :
    c_idx == 35 ? #c_desc = "Triggers only on 8th loop out of 8" :
    c_idx == 36 ? #c_desc = "Plays once on first playback start, then never again" :
    c_idx == 37 ? #c_desc = "Muted on first start, plays on all subsequent loops (/1ST)" :
    c_idx == 38 ? #c_desc = "Plays only if previous conditional trig was TRUE" :
    c_idx == 39 ? #c_desc = "Plays only if previous conditional trig was FALSE" :
    c_idx == 40 ? #c_desc = "Plays only if previous neighboring track trig was TRUE" :
    c_idx == 41 ? #c_desc = "Plays only if previous neighboring track trig was FALSE" :
    c_idx == 42 ? #c_desc = "Plays only when Euclidean Fill or EUC mode is active" :
    c_idx == 43 ? #c_desc = "Plays always, EXCEPT when Euclidean Fill or EUC is active" :
    #c_desc = "Always active";
  );
);

// Continuous gate length calculation (0.125..0.75, 1..64 steps, INF)
// 0.05-step gap allows clean retriggering of monophonic/legato envelopes
function get_elektron_gate_dur(g_idx, step_beat_dur) local(st_count) (
  g_idx == 0 ? (0.125 * step_beat_dur) :
  g_idx == 1 ? (0.25  * step_beat_dur) :
  g_idx == 2 ? (0.5   * step_beat_dur) :
  g_idx == 3 ? (0.75  * step_beat_dur) :
  g_idx >= 4 && g_idx <= 67 ? (
    st_count = g_idx - 3; // 1..64 step esatti
    ((st_count - 0.05) * step_beat_dur)
  ) :
  g_idx == 68 ? 999999.0 : // INF: suona legato attraverso gli step fino al prossimo trig!
  (0.95 * step_beat_dur);
);

function get_elektron_gate_str(g_idx) (
  g_idx == 0 ? #g_str = ".125" :
  g_idx == 1 ? #g_str = ".25"  :
  g_idx == 2 ? #g_str = "0.5"  :
  g_idx == 3 ? #g_str = ".75"  :
  g_idx >= 4 && g_idx <= 67 ? sprintf(#g_str, "%d", g_idx - 3) :
  g_idx == 68 ? #g_str = "INF" :
  #g_str = "1";
);

function get_elektron_gate_full_str(g_idx) (
  g_idx == 0 ? #g_full_str = "0.125" :
  g_idx == 1 ? #g_full_str = "0.25"  :
  g_idx == 2 ? #g_full_str = "0.5"   :
  g_idx == 3 ? #g_full_str = "0.75"  :
  g_idx >= 4 && g_idx <= 67 ? sprintf(#g_full_str, "%d", g_idx - 3) :
  g_idx == 68 ? #g_full_str = "INF"  :
  #g_full_str = "1";
);

function eval_cond(c_idx, cur_cycle, tr_idx) local(res, nei_tr) (
  c_idx == 0 ? res = 1 :
  // 1:2 .. 2:2
  c_idx == 1 ? res = ((cur_cycle % 2) == 0) :
  c_idx == 2 ? res = ((cur_cycle % 2) == 1) :
  // 1:3 .. 3:3
  c_idx == 3 ? res = ((cur_cycle % 3) == 0) :
  c_idx == 4 ? res = ((cur_cycle % 3) == 1) :
  c_idx == 5 ? res = ((cur_cycle % 3) == 2) :
  // 1:4 .. 4:4
  c_idx == 6 ? res = ((cur_cycle % 4) == 0) :
  c_idx == 7 ? res = ((cur_cycle % 4) == 1) :
  c_idx == 8 ? res = ((cur_cycle % 4) == 2) :
  c_idx == 9 ? res = ((cur_cycle % 4) == 3) :
  // 1:5 .. 5:5
  c_idx == 10 ? res = ((cur_cycle % 5) == 0) :
  c_idx == 11 ? res = ((cur_cycle % 5) == 1) :
  c_idx == 12 ? res = ((cur_cycle % 5) == 2) :
  c_idx == 13 ? res = ((cur_cycle % 5) == 3) :
  c_idx == 14 ? res = ((cur_cycle % 5) == 4) :
  // 1:6 .. 6:6
  c_idx == 15 ? res = ((cur_cycle % 6) == 0) :
  c_idx == 16 ? res = ((cur_cycle % 6) == 1) :
  c_idx == 17 ? res = ((cur_cycle % 6) == 2) :
  c_idx == 18 ? res = ((cur_cycle % 6) == 3) :
  c_idx == 19 ? res = ((cur_cycle % 6) == 4) :
  c_idx == 20 ? res = ((cur_cycle % 6) == 5) :
  // 1:7 .. 7:7
  c_idx == 21 ? res = ((cur_cycle % 7) == 0) :
  c_idx == 22 ? res = ((cur_cycle % 7) == 1) :
  c_idx == 23 ? res = ((cur_cycle % 7) == 2) :
  c_idx == 24 ? res = ((cur_cycle % 7) == 3) :
  c_idx == 25 ? res = ((cur_cycle % 7) == 4) :
  c_idx == 26 ? res = ((cur_cycle % 7) == 5) :
  c_idx == 27 ? res = ((cur_cycle % 7) == 6) :
  // 1:8 .. 8:8
  c_idx == 28 ? res = ((cur_cycle % 8) == 0) :
  c_idx == 29 ? res = ((cur_cycle % 8) == 1) :
  c_idx == 30 ? res = ((cur_cycle % 8) == 2) :
  c_idx == 31 ? res = ((cur_cycle % 8) == 3) :
  c_idx == 32 ? res = ((cur_cycle % 8) == 4) :
  c_idx == 33 ? res = ((cur_cycle % 8) == 5) :
  c_idx == 34 ? res = ((cur_cycle % 8) == 6) :
  c_idx == 35 ? res = ((cur_cycle % 8) == 7) :
  // 1ST / /1ST
  c_idx == 36 ? res = (cur_cycle == 0) :
  c_idx == 37 ? res = (cur_cycle > 0) :
  // PRE / /PRE
  c_idx == 38 ? res = (3800[tr_idx] == 1) :
  c_idx == 39 ? res = (3800[tr_idx] == 0) :
  // NEI / /NEI
  c_idx == 40 ? (
    nei_tr = tr_idx > 0 ? tr_idx - 1 : NUM_TRACKS - 1;
    res = (3800[nei_tr] == 1);
  ) :
  c_idx == 41 ? (
    nei_tr = tr_idx > 0 ? tr_idx - 1 : NUM_TRACKS - 1;
    res = (3800[nei_tr] == 0);
  ) :
  // FILL / /FILL
  c_idx == 42 ? res = (1860[tr_idx] > 0 || euc_mode) :
  c_idx == 43 ? res = (1860[tr_idx] == 0 && !euc_mode) :
  res = 1;

  c_idx > 0 ? (
    3800[tr_idx] = res;
  );

  res;
);

// Real-time Euclidean step evaluation
function eval_euclidean_step(step, len, fill) local(num_zeros, j, z_idx, st, is_act) (
  fill <= 0 ? 0 :
  fill >= len ? 1 :
  (len == 16) ? (
    fill == 1  ? (step == 0) :
    fill == 2  ? (step == 0 || step == 8) :
    fill == 3  ? (step == 0 || step == 5 || step == 10) :
    fill == 4  ? (step == 0 || step == 4 || step == 8 || step == 12) :
    fill == 5  ? (step == 0 || step == 3 || step == 6 || step == 9 || step == 12) :
    fill == 6  ? (step == 0 || step == 2 || step == 5 || step == 8 || step == 10 || step == 13) :
    fill == 7  ? (step == 0 || step == 3 || step == 5 || step == 7 || step == 10 || step == 12 || step == 14) :
    fill == 8  ? (step == 0 || step == 2 || step == 4 || step == 6 || step == 8 || step == 10 || step == 12 || step == 14) :
    fill == 9  ? (step == 0 || step == 2 || step == 3 || step == 5 || step == 7 || step == 9 || step == 10 || step == 12 || step == 14) :
    fill == 10 ? (step == 0 || step == 1 || step == 3 || step == 4 || step == 6 || step == 8 || step == 9 || step == 11 || step == 12 || step == 14) :
    fill == 11 ? (step == 0 || step == 2 || step == 3 || step == 5 || step == 6 || step == 8 || step == 9 || step == 11 || step == 12 || step == 14 || step == 15) :
    fill == 12 ? (step == 0 || step == 1 || step == 2 || step == 3 || step == 5 || step == 6 || step == 7 || step == 9 || step == 10 || step == 11 || step == 13 || step == 14) :
    fill == 13 ? (step == 0 || step == 2 || step == 3 || step == 4 || step == 5 || step == 7 || step == 8 || step == 9 || step == 10 || step == 12 || step == 13 || step == 14 || step == 15) :
    fill == 14 ? (step == 0 || step == 1 || step == 2 || step == 3 || step == 4 || step == 5 || step == 6 || step == 8 || step == 9 || step == 10 || step == 11 || step == 12 || step == 13 || step == 14) :
    fill == 15 ? (step != 1) : 1;
  ) :
  fill > (len * 0.5) ? (
    is_act = 1;
    num_zeros = len - fill;
    j = 0;
    while (j < num_zeros && is_act) (
      z_idx = 1 + floor((j * len) / num_zeros);
      z_idx == step ? is_act = 0;
      j += 1;
    );
    is_act;
  ) : (
    (len == 13 && fill == 5) ? (
      (step == 0 || step == 3 || step == 5 || step == 8 || step == 10)
    ) : (
      is_act = 0;
      j = 0;
      while (j < fill && !is_act) (
        st = floor((j * len) / fill);
        st == step ? is_act = 1;
        j += 1;
      );
      is_act;
    );
  );
);

// Euclidean pattern generator
function apply_euclidean_track(t_idx) local(len, fill, si, num_zeros, j, z_idx, st) (
  len = 1660[t_idx];
  len <= 0 ? len = 16;
  len > 64 ? len = 64;
  fill = 1860[t_idx];
  fill < 0 ? fill = 0;
  fill > len ? fill = len;
  1860[t_idx] = fill;

  // Clear 64 steps
  si = 0;
  while (si < 64) (
    10000[t_idx * 64 + si] = 0;
    si += 1;
  );

  // Generate Euclidean pulses
  fill > 0 ? (
    (len == 16) ? (
      fill == 1  ? ( 10000[t_idx * 64 + 0] = 1; ) :
      fill == 2  ? ( 10000[t_idx * 64 + 0] = 1; 10000[t_idx * 64 + 8] = 1; ) :
      fill == 3  ? ( 10000[t_idx * 64 + 0] = 1; 10000[t_idx * 64 + 5] = 1; 10000[t_idx * 64 + 10] = 1; ) :
      fill == 4  ? ( 10000[t_idx * 64 + 0] = 1; 10000[t_idx * 64 + 4] = 1; 10000[t_idx * 64 + 8] = 1; 10000[t_idx * 64 + 12] = 1; ) :
      fill == 5  ? ( 10000[t_idx * 64 + 0] = 1; 10000[t_idx * 64 + 3] = 1; 10000[t_idx * 64 + 6] = 1; 10000[t_idx * 64 + 9] = 1; 10000[t_idx * 64 + 12] = 1; ) :
      fill == 6  ? ( 10000[t_idx * 64 + 0] = 1; 10000[t_idx * 64 + 2] = 1; 10000[t_idx * 64 + 5] = 1; 10000[t_idx * 64 + 8] = 1; 10000[t_idx * 64 + 10] = 1; 10000[t_idx * 64 + 13] = 1; ) :
      fill == 7  ? ( 10000[t_idx * 64 + 0] = 1; 10000[t_idx * 64 + 3] = 1; 10000[t_idx * 64 + 5] = 1; 10000[t_idx * 64 + 7] = 1; 10000[t_idx * 64 + 10] = 1; 10000[t_idx * 64 + 12] = 1; 10000[t_idx * 64 + 14] = 1; ) :
      fill == 8  ? ( 10000[t_idx * 64 + 0] = 1; 10000[t_idx * 64 + 2] = 1; 10000[t_idx * 64 + 4] = 1; 10000[t_idx * 64 + 6] = 1; 10000[t_idx * 64 + 8] = 1; 10000[t_idx * 64 + 10] = 1; 10000[t_idx * 64 + 12] = 1; 10000[t_idx * 64 + 14] = 1; ) :
      fill == 9  ? ( 10000[t_idx * 64 + 0] = 1; 10000[t_idx * 64 + 2] = 1; 10000[t_idx * 64 + 3] = 1; 10000[t_idx * 64 + 5] = 1; 10000[t_idx * 64 + 7] = 1; 10000[t_idx * 64 + 9] = 1; 10000[t_idx * 64 + 10] = 1; 10000[t_idx * 64 + 12] = 1; 10000[t_idx * 64 + 14] = 1; ) :
      fill == 10 ? ( 10000[t_idx * 64 + 0] = 1; 10000[t_idx * 64 + 1] = 1; 10000[t_idx * 64 + 3] = 1; 10000[t_idx * 64 + 4] = 1; 10000[t_idx * 64 + 6] = 1; 10000[t_idx * 64 + 8] = 1; 10000[t_idx * 64 + 9] = 1; 10000[t_idx * 64 + 11] = 1; 10000[t_idx * 64 + 12] = 1; 10000[t_idx * 64 + 14] = 1; ) :
      fill == 11 ? ( 10000[t_idx * 64 + 0] = 1; 10000[t_idx * 64 + 2] = 1; 10000[t_idx * 64 + 3] = 1; 10000[t_idx * 64 + 5] = 1; 10000[t_idx * 64 + 6] = 1; 10000[t_idx * 64 + 8] = 1; 10000[t_idx * 64 + 9] = 1; 10000[t_idx * 64 + 11] = 1; 10000[t_idx * 64 + 12] = 1; 10000[t_idx * 64 + 14] = 1; 10000[t_idx * 64 + 15] = 1; ) :
      fill == 12 ? ( 10000[t_idx * 64 + 0] = 1; 10000[t_idx * 64 + 1] = 1; 10000[t_idx * 64 + 2] = 1; 10000[t_idx * 64 + 3] = 1; 10000[t_idx * 64 + 5] = 1; 10000[t_idx * 64 + 6] = 1; 10000[t_idx * 64 + 7] = 1; 10000[t_idx * 64 + 9] = 1; 10000[t_idx * 64 + 10] = 1; 10000[t_idx * 64 + 11] = 1; 10000[t_idx * 64 + 13] = 1; 10000[t_idx * 64 + 14] = 1; ) :
      fill == 13 ? ( 10000[t_idx * 64 + 0] = 1; 10000[t_idx * 64 + 2] = 1; 10000[t_idx * 64 + 3] = 1; 10000[t_idx * 64 + 4] = 1; 10000[t_idx * 64 + 5] = 1; 10000[t_idx * 64 + 7] = 1; 10000[t_idx * 64 + 8] = 1; 10000[t_idx * 64 + 9] = 1; 10000[t_idx * 64 + 10] = 1; 10000[t_idx * 64 + 12] = 1; 10000[t_idx * 64 + 13] = 1; 10000[t_idx * 64 + 14] = 1; 10000[t_idx * 64 + 15] = 1; ) :
      fill == 14 ? ( 10000[t_idx * 64 + 0] = 1; 10000[t_idx * 64 + 1] = 1; 10000[t_idx * 64 + 2] = 1; 10000[t_idx * 64 + 3] = 1; 10000[t_idx * 64 + 4] = 1; 10000[t_idx * 64 + 5] = 1; 10000[t_idx * 64 + 6] = 1; 10000[t_idx * 64 + 8] = 1; 10000[t_idx * 64 + 9] = 1; 10000[t_idx * 64 + 10] = 1; 10000[t_idx * 64 + 11] = 1; 10000[t_idx * 64 + 12] = 1; 10000[t_idx * 64 + 13] = 1; 10000[t_idx * 64 + 14] = 1; ) :
      fill == 15 ? ( 10000[t_idx * 64 + 0] = 1; 10000[t_idx * 64 + 2] = 1; 10000[t_idx * 64 + 3] = 1; 10000[t_idx * 64 + 4] = 1; 10000[t_idx * 64 + 5] = 1; 10000[t_idx * 64 + 6] = 1; 10000[t_idx * 64 + 7] = 1; 10000[t_idx * 64 + 8] = 1; 10000[t_idx * 64 + 9] = 1; 10000[t_idx * 64 + 10] = 1; 10000[t_idx * 64 + 11] = 1; 10000[t_idx * 64 + 12] = 1; 10000[t_idx * 64 + 13] = 1; 10000[t_idx * 64 + 14] = 1; 10000[t_idx * 64 + 15] = 1; ) :
      fill >= 16 ? (
        si = 0; while (si < 16) ( 10000[t_idx * 64 + si] = 1; si += 1; );
      );

      si = 0;
      while (si < 16) (
        10000[t_idx * 64 + si] ? (
          12000[t_idx * 64 + si] <= 0 ? 12000[t_idx * 64 + si] = 100;
        );
        si += 1;
      );
    ) :
    // Arbitrary pattern length
    fill == len ? (
      si = 0;
      while (si < len) (
        10000[t_idx * 64 + si] = 1;
        12000[t_idx * 64 + si] <= 0 ? 12000[t_idx * 64 + si] = 100;
        si += 1;
      );
    ) :
    // Complementary zero distribution when fill > len / 2
    fill > (len * 0.5) ? (
      si = 0;
      while (si < len) (
        10000[t_idx * 64 + si] = 1;
        12000[t_idx * 64 + si] <= 0 ? 12000[t_idx * 64 + si] = 100;
        si += 1;
      );
      num_zeros = len - fill;
      j = 0;
      while (j < num_zeros) (
        z_idx = 1 + floor((j * len) / num_zeros);
        z_idx < len ? (
          10000[t_idx * 64 + z_idx] = 0;
        );
        j += 1;
      );
    ) : (
      (len == 13 && fill == 5) ? (
        // 13/5 asymmetric pulse pattern
        10000[t_idx * 64 + 0] = 1; 10000[t_idx * 64 + 3] = 1; 10000[t_idx * 64 + 5] = 1;
        10000[t_idx * 64 + 8] = 1; 10000[t_idx * 64 + 10] = 1;
      ) : (
        j = 0;
        while (j < fill) (
          st = floor((j * len) / fill);
          st < len ? (
            10000[t_idx * 64 + st] = 1;
            12000[t_idx * 64 + st] <= 0 ? 12000[t_idx * 64 + st] = 100;
          );
          j += 1;
        );
      );
    );
  );
);

function apply_all_euclidean() local(ti) (
  ti = 0;
  while (ti < NUM_TRACKS) (
    apply_euclidean_track(ti);
    ti += 1;
  );
);

// Base and hover border colors (RGB 64,64,64 base vs 105,105,105 hover)
BORDER_R = 64 / 255.0; BORDER_G = 64 / 255.0; BORDER_B = 64 / 255.0;
HOVER_R = 105 / 255.0; HOVER_G = 105 / 255.0; HOVER_B = 105 / 255.0;

function set_border_color(is_hov) (
  is_hov ? (
    gfx_r = HOVER_R; gfx_g = HOVER_G; gfx_b = HOVER_B;
  ) : (
    gfx_r = BORDER_R; gfx_g = BORDER_G; gfx_b = BORDER_B;
  );
);

function draw_bold_text(b_str, bx, by) (
  gfx_x = bx; gfx_y = by;
  gfx_drawstr(b_str);
);

t = 0;
while (t < NUM_TRACKS) (
  1600[t] = 60;          // Pitch: 60 (C4)
  1620[t] = t + 1;       // MIDI Channel (1..16)
  1640[t] = 7;           // Rate: index 7 ("x4" = 16th notes)
  1660[t] = 16;          // Pattern length: 16 steps
  1680[t] = 0;           // Solo: off
  1700[t] = 0;           // Mute: off
  1720[t] = 100;         // Track Chance / Density: 100%
  1740[t] = 0;           // Swing: 0%
  1860[t] = 0;           // Euclidean Fill: 0
  1760[t] = 0;           // Visual Playhead position
  1780[t] = -1;          // Active sounding note (-1 = none)
  1800[t] = t + 1;       // Active MIDI channel
  1820[t] = -1;          // Last triggered step index
  1840[t] = -1;          // Scheduled Note-Off beat position
  1880[t] = 64;          // Last sent Pan state (64 = Center)
  3800[t] = 1;           // Last evaluated trig condition result (1 = true)

  s = 0;
  while (s < MAX_STEPS) (
    offset = t * 64 + s;
    10000[offset] = 0;   // Step state: off (0)
    12000[offset] = 100; // Velocity: 100
    14000[offset] = 64;  // Pan: 64 (Center)
    16000[offset] = 4;   // Gate length: index 4 (1 step)
    18000[offset] = 0;   // Micro-timing: 0%
    20000[offset] = 1;   // Ratcheting: 1 sub-step (1..4)
    22000[offset] = 100; // Step Chance: 100%
    24000[offset] = 0;   // Trig Condition: 0 ("---")
    s += 1;
  );
  t += 1;
);

function get_track_play_step(raw_step, len, mode, tr_idx) local(st, cl, ph) (
  len <= 0 ? len = 16;
  mode == 0 ? (
    // Forward
    st = raw_step % len;
    st < 0 ? st += len;
    st;
  ) :
  mode == 1 ? (
    // Reverse
    st = raw_step % len;
    st < 0 ? st += len;
    (len - 1) - st;
  ) :
  mode == 2 ? (
    // Ping-Pong
    len <= 1 ? 0 : (
      cl = 2 * (len - 1);
      ph = raw_step % cl;
      ph < 0 ? ph += cl;
      ph < len ? ph : (cl - ph);
    );
  ) : (
    // Stochastic / Random
    len <= 1 ? 0 : (
      floor(abs(sin(raw_step * 12.9898 + (tr_idx + 1) * 78.233)) * 43758.5453) % len;
    );
  );
);

function get_beats_per_step(r_idx) (
  r_idx == 0 ? 16.0 :
  r_idx == 1 ? 12.0 :
  r_idx == 2 ? 8.0  :
  r_idx == 3 ? 4.0  :
  r_idx == 4 ? 2.0  :
  r_idx == 5 ? 1.0  :
  r_idx == 6 ? 0.5  :
  r_idx == 7 ? 0.25 :
  r_idx == 8 ? 0.125 :
  r_idx == 9 ? 1.0 / 12.0 :
  0.0625;
);

function draw_arrow_forward(bx, by, bw, bh, s) local(cx, cy, arr, head) (
  cx = bx + bw * 0.5; cy = by + bh * 0.5;
  arr = max(4, floor(5.5 * s));
  head = max(2, floor(3.5 * s));
  gfx_line(cx - arr, cy, cx + arr, cy);
  gfx_line(cx + arr, cy, cx + arr - head, cy - head);
  gfx_line(cx + arr, cy, cx + arr - head, cy + head);
);

function draw_arrow_backward(bx, by, bw, bh, s) local(cx, cy, arr, head) (
  cx = bx + bw * 0.5; cy = by + bh * 0.5;
  arr = max(4, floor(5.5 * s));
  head = max(2, floor(3.5 * s));
  gfx_line(cx + arr, cy, cx - arr, cy);
  gfx_line(cx - arr, cy, cx - arr + head, cy - head);
  gfx_line(cx - arr, cy, cx - arr + head, cy + head);
);

function draw_arrow_pingpong(bx, by, bw, bh, s) local(cx, cy, arr, head, y_off) (
  cx = bx + bw * 0.5; cy = by + bh * 0.5;
  arr = max(4, floor(5.5 * s));
  head = max(2, floor(2.5 * s));
  y_off = max(3, floor(3.5 * s));
  // Forward arrow
  gfx_line(cx - arr, cy - y_off, cx + arr, cy - y_off);
  gfx_line(cx + arr, cy - y_off, cx + arr - head, cy - y_off - head);
  gfx_line(cx + arr, cy - y_off, cx + arr - head, cy - y_off + head);
  // Reverse arrow
  gfx_line(cx + arr, cy + y_off, cx - arr, cy + y_off);
  gfx_line(cx - arr, cy + y_off, cx - arr + head, cy + y_off - head);
  gfx_line(cx - arr, cy + y_off, cx - arr + head, cy + y_off + head);
);

function draw_arrow_shuffle(bx, by, bw, bh, s) local(cx, cy, arr, mid, y_off, head) (
  cx = bx + bw * 0.5;
  cy = by + bh * 0.5;
  arr = max(5, floor(6.5 * s));
  mid = max(2, floor(2.5 * s));
  y_off = max(3, floor(3.5 * s));
  head = max(2, floor(2.5 * s));

  // Path 1: top-left to bottom-right
  gfx_line(cx - arr, cy - y_off, cx - mid, cy - y_off);
  gfx_line(cx - mid, cy - y_off, cx + mid, cy + y_off);
  gfx_line(cx + mid, cy + y_off, cx + arr, cy + y_off);
  gfx_line(cx + arr, cy + y_off, cx + arr - head, cy + y_off - head);
  gfx_line(cx + arr, cy + y_off, cx + arr - head, cy + y_off + head);

  // Path 2: bottom-left to top-right
  gfx_line(cx - arr, cy + y_off, cx - mid, cy + y_off);
  gfx_line(cx - mid, cy + y_off, cx + mid, cy - y_off);
  gfx_line(cx + mid, cy - y_off, cx + arr, cy - y_off);
  gfx_line(cx + arr, cy - y_off, cx + arr - head, cy - y_off - head);
  gfx_line(cx + arr, cy - y_off, cx + arr - head, cy - y_off + head);
);

function draw_note_name(pitch) (
  oct = floor(pitch / 12) - 1;
  semi = pitch % 12;
  semi == 0 ? note_ch = "C" :
  semi == 1 ? note_ch = "C#" :
  semi == 2 ? note_ch = "D" :
  semi == 3 ? note_ch = "D#" :
  semi == 4 ? note_ch = "E" :
  semi == 5 ? note_ch = "F" :
  semi == 6 ? note_ch = "F#" :
  semi == 7 ? note_ch = "G" :
  semi == 8 ? note_ch = "G#" :
  semi == 9 ? note_ch = "A" :
  semi == 10 ? note_ch = "A#" : note_ch = "B";
  sprintf(#note_full_str, "%s%d", note_ch, oct);
  gfx_drawstr(#note_full_str);
);

function draw_arrow_left(x, y, w, h, s) (
  cx = x + w * 0.5; cy = y + h * 0.5;
  arr = max(3, floor(4 * s));
  gfx_line(cx + arr, cy, cx - arr, cy);
  gfx_line(cx - arr, cy, cx, cy - arr);
  gfx_line(cx - arr, cy, cx, cy + arr);
);

function draw_arrow_right(x, y, w, h, s) (
  cx = x + w * 0.5; cy = y + h * 0.5;
  arr = max(3, floor(4 * s));
  gfx_line(cx - arr, cy, cx + arr, cy);
  gfx_line(cx, cy - arr, cx + arr, cy);
  gfx_line(cx, cy + arr, cx + arr, cy);
);

function draw_music_note_icon(x, y, s) (
  r = max(2, floor(2.5 * s));
  head_y = y + floor(7 * s);
  head_x = x + floor(2 * s);
  gfx_circle(head_x, head_y, r, 1);
  stem_x = head_x + r;
  stem_top = y + floor(1 * s);
  gfx_line(stem_x, head_y, stem_x, stem_top);
  flag_w = max(3, floor(4 * s));
  flag_h = max(2, floor(2.5 * s));
  gfx_line(stem_x, stem_top, stem_x + flag_w, stem_top + flag_h);
  gfx_line(stem_x, stem_top + flag_h, stem_x + flag_w, stem_top + flag_h * 2);
);

function draw_note_name_centered(pitch, bx, by, bw, bh) local(oct, semi, note_ch, has_sh, n_w, n_h, o_w, o_h, spc_w, spc_h, sh_w, sh_h, p_gap, tot_w, max_h, start_x, start_y) (
  oct = floor(pitch / 12) - 1;
  semi = pitch % 12;
  semi == 0 ? ( note_ch = "C"; has_sh = 0; ) :
  semi == 1 ? ( note_ch = "C"; has_sh = 1; ) :
  semi == 2 ? ( note_ch = "D"; has_sh = 0; ) :
  semi == 3 ? ( note_ch = "D"; has_sh = 1; ) :
  semi == 4 ? ( note_ch = "E"; has_sh = 0; ) :
  semi == 5 ? ( note_ch = "F"; has_sh = 0; ) :
  semi == 6 ? ( note_ch = "F"; has_sh = 1; ) :
  semi == 7 ? ( note_ch = "G"; has_sh = 0; ) :
  semi == 8 ? ( note_ch = "G"; has_sh = 1; ) :
  semi == 9 ? ( note_ch = "A"; has_sh = 0; ) :
  semi == 10 ? ( note_ch = "A"; has_sh = 1; ) :
               ( note_ch = "B"; has_sh = 0; );

  sprintf(#note_name_str, "%s", note_ch);
  sprintf(#oct_str, "%d", oct);

  gfx_setfont(9, "Inter Light", sz_param, 0);
  gfx_measurestr(#note_name_str, n_w, n_h);
  gfx_measurestr(#oct_str, o_w, o_h);
  gfx_measurestr(" ", spc_w, spc_h);

  has_sh ? (
    gfx_measurestr("#", sh_w, sh_h);
    p_gap = max(1, floor(1.5 * scale_font));
    tot_w = n_w + p_gap + sh_w + spc_w + o_w;
    max_h = max(n_h, max(sh_h, o_h));
    start_x = bx + floor((bw - tot_w) * 0.5);
    start_y = by + floor((bh - max_h) * 0.5);

    gfx_x = start_x; gfx_y = start_y;
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    gfx_drawstr(#note_name_str);

    gfx_x = start_x + n_w + p_gap; gfx_y = start_y;
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    gfx_drawstr("#");

    gfx_x = start_x + n_w + p_gap + sh_w + spc_w; gfx_y = start_y;
    gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
    gfx_drawstr(#oct_str);
  ) : (
    tot_w = n_w + spc_w + o_w;
    max_h = max(n_h, o_h);
    start_x = bx + floor((bw - tot_w) * 0.5);
    start_y = by + floor((bh - max_h) * 0.5);

    gfx_x = start_x; gfx_y = start_y;
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    gfx_drawstr(#note_name_str);

    gfx_x = start_x + n_w + spc_w; gfx_y = start_y;
    gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
    gfx_drawstr(#oct_str);
  );
);

function fill_roundrect(fx, fy, fw, fh, fr) local(ix, iy, iw, ih, ir) (
  ix = floor(fx);
  iy = floor(fy);
  iw = floor(fw);
  ih = floor(fh);
  ir = floor(fr);
  gfx_rect(ix + ir, iy, iw - 2 * ir, ih);
  gfx_rect(ix, iy + ir, ir, ih - 2 * ir);
  gfx_rect(ix + iw - ir, iy + ir, ir, ih - 2 * ir);
  gfx_circle(ix + ir, iy + ir, ir, 1, 1);
  gfx_circle(ix + iw - ir - 1, iy + ir, ir, 1, 1);
  gfx_circle(ix + ir, iy + ih - ir - 1, ir, 1, 1);
  gfx_circle(ix + iw - ir - 1, iy + ih - ir - 1, ir, 1, 1);
);

function fill_left_roundrect(fx, fy, fw, fh, fr) (
  gfx_rect(fx + fr, fy, fw - fr, fh);
  gfx_rect(fx, fy + fr, fr, fh - 2 * fr);
  gfx_circle(fx + fr, fy + fr, fr, 1);
  gfx_circle(fx + fr, fy + fh - fr - 1, fr, 1);
);

function fill_right_roundrect(fx, fy, fw, fh, fr) (
  gfx_rect(fx, fy, fw - fr, fh);
  gfx_rect(fx + fw - fr, fy + fr, fr, fh - 2 * fr);
  gfx_circle(fx + fw - fr - 1, fy + fr, fr, 1);
  gfx_circle(fx + fw - fr - 1, fy + fh - fr - 1, fr, 1);
);

function get_track_color(idx) local(mod) (
  mod = idx % 16;
  mod == 0 ? ( cr = 110 / 255.0; cg = 76 / 255.0;  cb = 225 / 255.0; ) :
  mod == 1 ? ( cr = 150 / 255.0; cg = 75 / 255.0;  cb = 225 / 255.0; ) :
  mod == 2 ? ( cr = 190 / 255.0; cg = 75 / 255.0;  cb = 225 / 255.0; ) :
  mod == 3 ? ( cr = 225 / 255.0; cg = 79 / 255.0;  cb = 209 / 255.0; ) :
  mod == 4 ? ( cr = 225 / 255.0; cg = 77 / 255.0;  cb = 162 / 255.0; ) :
  mod == 5 ? ( cr = 225 / 255.0; cg = 79 / 255.0;  cb = 118 / 255.0; ) :
  mod == 6 ? ( cr = 225 / 255.0; cg = 95 / 255.0;  cb = 91 / 255.0;  ) :
  mod == 7 ? ( cr = 225 / 255.0; cg = 122 / 255.0; cb = 73 / 255.0;  ) :
  mod == 8 ? ( cr = 225 / 255.0; cg = 159 / 255.0; cb = 71 / 255.0;  ) :
  mod == 9 ? ( cr = 193 / 255.0; cg = 220 / 255.0; cb = 81 / 255.0;  ) :
  mod == 10 ? ( cr = 92 / 255.0;  cg = 220 / 255.0; cb = 82 / 255.0;  ) :
  mod == 11 ? ( cr = 71 / 255.0;  cg = 220 / 255.0; cb = 128 / 255.0; ) :
  mod == 12 ? ( cr = 56 / 255.0;  cg = 220 / 255.0; cb = 182 / 255.0; ) :
  mod == 13 ? ( cr = 39 / 255.0;  cg = 181 / 255.0; cb = 225 / 255.0; ) :
  mod == 14 ? ( cr = 77 / 255.0;  cg = 164 / 255.0; cb = 225 / 255.0; ) :
              ( cr = 139 / 255.0; cg = 171 / 255.0; cb = 225 / 255.0; );
);

function send_pan_if_changed(s_sample, s_ch, s_pan, s_tr) local(p_sample, c_i) (
  (s_tr >= 0 && 1880[s_tr] != s_pan) ? (
    p_sample = max(0, s_sample - 1);
    s_ch == 0 ? (
      c_i = 0; while (c_i < 16) (
        midisend(p_sample, 0xB0 + c_i, 10, s_pan);
        c_i += 1;
      );
    ) : (
      midisend(p_sample, 0xB0 + (s_ch - 1), 10, s_pan);
    );
    1880[s_tr] = s_pan;
  );
);

function send_note_on(s_sample, s_pitch, s_ch, s_vel) local(c_i) (
  s_ch == 0 ? (
    c_i = 0; while (c_i < 16) (
      midisend(s_sample, 0x90 + c_i, s_pitch, s_vel);
      c_i += 1;
    );
  ) : (
    midisend(s_sample, 0x90 + (s_ch - 1), s_pitch, s_vel);
  );
);

function send_note_off(s_sample, s_pitch, s_ch) local(c_i) (
  s_ch == 0 ? (
    c_i = 0; while (c_i < 16) (
      midisend(s_sample, 0x80 + c_i, s_pitch, 0);
      c_i += 1;
    );
  ) : (
    midisend(s_sample, 0x80 + (s_ch - 1), s_pitch, 0);
  );
);

// Commit keyboard typed values
function commit_param_edit() local(val, p_semi, p_oct) (
  strlen(#edit_buf) > 0 && ((edit_tr >= 0 && edit_tr < NUM_TRACKS) || edit_active == 11) ? (
    undo_push();

    // 1: Channel (0..16, 0 = ALL)
    edit_active == 1 ? (
      matchi("*ALL*", #edit_buf) ? (
        1620[edit_tr] = 0;
      ) : (
        match("%d", #edit_buf, val) ? (
          1620[edit_tr] = min(16, max(0, val));
        );
      );
    ) :

    // 2: Pitch (24..108, support MIDI number, note name, or single-digit octave change)
    edit_active == 2 ? (
      c0 = str_getchar(#edit_buf, 0);
      c0 >= 'a' && c0 <= 'z' ? c0 -= 32;

      b_len = strlen(#edit_buf);

      // Single digit (0..8) changes octave while preserving note
      (b_len == 1 && c0 >= '0' && c0 <= '8') ? (
        cur_semi = 1600[edit_tr] % 12;
        new_oct = c0 - '0';
        1600[edit_tr] = min(108, max(24, (new_oct + 1) * 12 + cur_semi));
      ) :
      // 2+ digits: parse as MIDI note number
      (c0 >= '0' && c0 <= '9') ? (
        match("%d", #edit_buf, val) ? (
          1600[edit_tr] = min(108, max(24, val));
        );
      ) : (
        p_semi = -1;
        p_oct = floor(1600[edit_tr] / 12) - 1;
        next_idx = 1;

        // Solfege note names
        matchi("DO*", #edit_buf) ? ( p_semi = 0; next_idx = 2; ) :
        matchi("RE*", #edit_buf) ? ( p_semi = 2; next_idx = 2; ) :
        matchi("MI*", #edit_buf) ? ( p_semi = 4; next_idx = 2; ) :
        matchi("FA*", #edit_buf) ? ( p_semi = 5; next_idx = 2; ) :
        matchi("SOL*", #edit_buf) ? ( p_semi = 7; next_idx = 3; ) :
        matchi("LA*", #edit_buf) ? ( p_semi = 9; next_idx = 2; ) :
        matchi("SI*", #edit_buf) ? ( p_semi = 11; next_idx = 2; ) :
        // Standard note names
        c0 == 'C' ? ( p_semi = 0; next_idx = 1; ) :
        c0 == 'D' ? ( p_semi = 2; next_idx = 1; ) :
        c0 == 'E' ? ( p_semi = 4; next_idx = 1; ) :
        c0 == 'F' ? ( p_semi = 5; next_idx = 1; ) :
        c0 == 'G' ? ( p_semi = 7; next_idx = 1; ) :
        c0 == 'A' ? ( p_semi = 9; next_idx = 1; ) :
        c0 == 'B' ? ( p_semi = 11; next_idx = 1; ) : 0;

        p_semi >= 0 ? (
          c1 = str_getchar(#edit_buf, next_idx);
          // Sharp (#, +, s, S, £)
          (c1 == '#' || c1 == '+' || c1 == 's' || c1 == 'S' || c1 == 163) ? (
            p_semi = (p_semi + 1) % 12;
            next_idx += 1;
          ) :
          // Flat (b, -)
          (c1 == 'b' || c1 == '-') ? (
            p_semi = (p_semi + 11) % 12;
            next_idx += 1;
          );

          // Octave (0..8)
          c_oct = str_getchar(#edit_buf, next_idx);
          (c_oct >= '0' && c_oct <= '8') ? (
            p_oct = c_oct - '0';
          );

          1600[edit_tr] = min(108, max(24, (p_oct + 1) * 12 + p_semi));
        );
      );
    ) :

    // 3: Rate (0..10: /16..x16) with nearest match or rejection on ties
    edit_active == 3 ? (
      is_div = match("/*", #edit_buf) || match("-*", #edit_buf);
      r_val = -1;
      s_len = strlen(#edit_buf);
      n_idx = 0;
      found_d = -1;
      while (n_idx < s_len && found_d < 0) (
        ch = str_getchar(#edit_buf, n_idx);
        (ch >= '0' && ch <= '9') ? (
          found_d = n_idx;
        );
        n_idx += 1;
      );
      found_d >= 0 ? (
        strcpy_substr(#sub_num, #edit_buf, found_d, s_len - found_d);
        match("%d", #sub_num, r_val);
      );

      r_val > 0 ? (
        best_diff = 999;
        !is_div ? (
          d = abs(r_val - 1); d < best_diff ? best_diff = d;
        );
        d = abs(r_val - 2);  d < best_diff ? best_diff = d;
        d = abs(r_val - 4);  d < best_diff ? best_diff = d;
        d = abs(r_val - 8);  d < best_diff ? best_diff = d;
        d = abs(r_val - 12); d < best_diff ? best_diff = d;
        d = abs(r_val - 16); d < best_diff ? best_diff = d;

        tie_count = 0;
        closest_num = -1;
        !is_div ? (
          abs(r_val - 1) == best_diff ? ( tie_count += 1; closest_num = 1; );
        );
        abs(r_val - 2) == best_diff ? ( tie_count += 1; closest_num = 2; );
        abs(r_val - 4) == best_diff ? ( tie_count += 1; closest_num = 4; );
        abs(r_val - 8) == best_diff ? ( tie_count += 1; closest_num = 8; );
        abs(r_val - 12) == best_diff ? ( tie_count += 1; closest_num = 12; );
        abs(r_val - 16) == best_diff ? ( tie_count += 1; closest_num = 16; );

        // If tied, reject and keep current value
        tie_count == 1 ? (
          is_div ? (
            closest_num == 16 ? 1640[edit_tr] = 0 :
            closest_num == 12 ? 1640[edit_tr] = 1 :
            closest_num == 8  ? 1640[edit_tr] = 2 :
            closest_num == 4  ? 1640[edit_tr] = 3 :
            closest_num == 2  ? 1640[edit_tr] = 4 : 0;
          ) : (
            closest_num == 1  ? 1640[edit_tr] = 5 :
            closest_num == 2  ? 1640[edit_tr] = 6 :
            closest_num == 4  ? 1640[edit_tr] = 7 :
            closest_num == 8  ? 1640[edit_tr] = 8 :
            closest_num == 12 ? 1640[edit_tr] = 9 :
            closest_num == 16 ? 1640[edit_tr] = 10 : 0;
          );
        );
      );
    ) :

    // 4: Length (1..64)
    edit_active == 4 ? (
      match("%d", #edit_buf, val) ? (
        1660[edit_tr] = min(64, max(1, val));
        1860[edit_tr] > 1660[edit_tr] ? 1860[edit_tr] = 1660[edit_tr];
      );
    ) :

    // 5: Density / Track Chance (0..100)
    edit_active == 5 ? (
      match("%d", #edit_buf, val) ? (
        1720[edit_tr] = min(100, max(0, val));
      );
    ) :

    // 6: Swing (-100..+100)
    edit_active == 6 ? (
      match("%d", #edit_buf, val) ? (
        match("-*", #edit_buf) ? val = -val;
        1740[edit_tr] = min(100, max(-100, val));
      );
    ) :

    // 7: Fill (0..Length, active when Euclidean mode is on)
    edit_active == 7 ? (
      match("%d", #edit_buf, val) ? (
        cur_l = 1660[edit_tr];
        cur_l <= 0 ? cur_l = 16;
        cur_l > 64 ? cur_l = 64;
        1860[edit_tr] = min(cur_l, max(0, val));
        euc_mode ? apply_euclidean_track(edit_tr);
      );
    ) :
    edit_active == 8 ? (
      match("%d", #edit_buf, val) ? (
        4620[edit_tr] = min(100, max(0, val));
      );
    ) :
    edit_active == 9 ? (
      c_i = 0;
      b_len = strlen(#edit_buf);
      while (c_i < b_len) (
        str_getchar(#edit_buf, c_i) == ',' ? str_setchar(#edit_buf, c_i, '.');
        c_i += 1;
      );
      match("%f", #edit_buf, f_val) ? (
        4560[edit_tr] = min(20.0, max(0.1, floor(f_val * 10 + 0.5) / 10.0));
      ) :
      match("%d", #edit_buf, d_val) ? (
        4560[edit_tr] = min(20.0, max(0.1, d_val * 1.0));
      );
    ) :
    edit_active == 10 ? (
      tr_val = -1;
      match("%d", #edit_buf, tr_val) ? 0 : (
        match("*%d", #edit_buf, tr_val);
      );
      tr_val > 0 ? (
        lfo_cur_tr = min(NUM_TRACKS - 1, max(0, tr_val - 1));
      );
    ) :
    edit_active == 11 ? (
      c0 = str_getchar(#edit_buf, 0);
      c0 >= 'a' && c0 <= 'z' ? c0 -= 32;

      p_semi = -1;
      next_idx = 1;

      // Solfege note names
      matchi("DO*", #edit_buf) ? ( p_semi = 0; next_idx = 2; ) :
      matchi("RE*", #edit_buf) ? ( p_semi = 2; next_idx = 2; ) :
      matchi("MI*", #edit_buf) ? ( p_semi = 4; next_idx = 2; ) :
      matchi("FA*", #edit_buf) ? ( p_semi = 5; next_idx = 2; ) :
      matchi("SOL*", #edit_buf) ? ( p_semi = 7; next_idx = 3; ) :
      matchi("LA*", #edit_buf) ? ( p_semi = 9; next_idx = 2; ) :
      matchi("SI*", #edit_buf) ? ( p_semi = 11; next_idx = 2; ) :
      // Standard note names
      c0 == 'C' ? ( p_semi = 0; next_idx = 1; ) :
      c0 == 'D' ? ( p_semi = 2; next_idx = 1; ) :
      c0 == 'E' ? ( p_semi = 4; next_idx = 1; ) :
      c0 == 'F' ? ( p_semi = 5; next_idx = 1; ) :
      c0 == 'G' ? ( p_semi = 7; next_idx = 1; ) :
      c0 == 'A' ? ( p_semi = 9; next_idx = 1; ) :
      c0 == 'B' ? ( p_semi = 11; next_idx = 1; ) :
      // Numeric pitch
      (c0 >= '0' && c0 <= '9') ? (
        match("%d", #edit_buf, val) ? (
          p_semi = (val % 12 + 12) % 12;
        );
      );

      p_semi >= 0 ? (
        c1 = str_getchar(#edit_buf, next_idx);
        // Sharp (#, +, s, S, £)
        (c1 == '#' || c1 == '+' || c1 == 's' || c1 == 'S' || c1 == 163) ? (
          p_semi = (p_semi + 1) % 12;
        ) :
        // Flat (b, -)
        (c1 == 'b' || c1 == '-') ? (
          p_semi = (p_semi + 11) % 12;
        );

        set_quant_root(p_semi);
      );
    );
  );
);

function queue_add(q_st, q_p, q_c, q_v, q_pn, q_tr, q_on, q_off) local(qi, found) (
  qi = 0; found = -1;
  while (found < 0 && qi < 64) (
    30000[qi] == 0 ? found = qi;
    qi += 1;
  );
  found >= 0 ? (
    30000[found] = q_st;
    30100[found] = q_p;
    30200[found] = q_c;
    30300[found] = q_v;
    30400[found] = q_pn;
    30700[found] = q_tr;
    30500[found] = q_on;
    30600[found] = q_off;
  );
  found;
);

@serialize
file_version = 1;
file_var(file, file_version);

// Global parameters
file_var(file, euc_mode);
file_var(file, playhead_sync_offset);
file_var(file, velocity_mode);
file_var(file, gate_mode);
file_var(file, pan_mode);
file_var(file, timing_mode);
file_var(file, ratchet_mode);
file_var(file, chance_mode);
file_var(file, cond_mode);
file_var(file, info_mode);
file_var(file, info_lang);
file_var(file, current_page);
file_var(file, step_page);
file_var(file, quant_root);
file_var(file, quant_scale);
update_quant_mask_bits();
file_var(file, quant_mask_bits);
quant_mask_bits <= 0 ? (
  quant_scale == 1 || quant_scale == 2 ? (
    set_quant_scale(quant_scale);
  ) : (
    set_quant_scale(0); // Chromatic default: all 12 semitones active
  );
) : (
  apply_quant_mask_bits(quant_mask_bits);
);

// 16-track parameters
file_mem(file, 1600, 16); // Pitch
file_mem(file, 1620, 16); // Channel
file_mem(file, 1640, 16); // Rate
file_mem(file, 1660, 16); // Length
file_mem(file, 1680, 16); // Solo
file_mem(file, 1700, 16); // Mute
file_mem(file, 1720, 16); // Density / Chance
file_mem(file, 1740, 16); // Swing
file_mem(file, 1860, 16); // Euclidean Fill
file_mem(file, 1900, 16); // Per-track sync offset
file_mem(file, 1920, 16); // Per-track play mode

// Per-step parameters (16 tracks x 64 steps = 1024)
file_mem(file, 10000, 1024); // Step State (0/1)
file_mem(file, 12000, 1024); // Velocity
file_mem(file, 14000, 1024); // Pan
file_mem(file, 16000, 1024); // Gate Length index
file_mem(file, 18000, 1024); // Micro-timing
file_mem(file, 20000, 1024); // Ratcheting
file_mem(file, 22000, 1024); // Step Chance
file_mem(file, 24000, 1024); // Trig Conditions
file_var(file, lfo_cur_tr);
file_mem(file, 4500, 16);
file_mem(file, 4520, 16);
file_mem(file, 4540, 16);
file_mem(file, 4560, 16);
file_mem(file, 4580, 16);
file_mem(file, 4600, 16);
file_mem(file, 4620, 16);
file_mem(file, 4700, 16);

gui_dirty = 1;

@block
b_is_playing = play_state & 1;

b_is_playing ? (
  b_sec_per_beat = 60.0 / tempo;
  b_samples_per_beat = srate * b_sec_per_beat;
  b_block_beats = samplesblock / b_samples_per_beat;
  b_cur_beat = max(0.0, play_position * (tempo / 60.0));

  // Detect transport start, loop wrap, or timeline seek
  b_is_starting = !b_was_playing;
  b_is_loop_wrap = play_position < (b_last_play_pos - 0.05);
  b_is_seek = abs(play_position - b_last_play_pos) > max(0.05, b_block_beats * 2.0);

  (b_is_starting || b_is_loop_wrap || b_is_seek) ? (
    b_tr_i = 0;
    while (b_tr_i < NUM_TRACKS) (
      b_rate = 1640[b_tr_i];
      b_step_dur = get_beats_per_step(b_rate);
      b_start_step = floor((b_cur_beat + 0.00001) / b_step_dur);
      b_start_step = max(0, b_start_step);
      1820[b_tr_i] = b_start_step - 1;
      1760[b_tr_i] = b_start_step;
      4800[b_tr_i] = -1;
      1780[b_tr_i] >= 0 ? (
        send_note_off(0, 1780[b_tr_i], 1800[b_tr_i]);
        1780[b_tr_i] = -1;
      );
      1880[b_tr_i] != 64 ? (
        b_ch_rst = 1620[b_tr_i];
        b_ch_rst == 0 ? (
          c_i = 0; while (c_i < 16) ( midisend(0, 0xB0 + c_i, 10, 64); c_i += 1; );
        ) : (
          midisend(0, 0xB0 + (b_ch_rst - 1), 10, 64);
        );
        1880[b_tr_i] = 64;
      );
      1840[b_tr_i] = -1;
      b_tr_i += 1;
    );
    // Clear sub-step note queue on transport start or seek
    q_clr_i = 0;
    while (q_clr_i < 64) (
      30000[q_clr_i] > 0 ? (
        send_note_off(0, 30100[q_clr_i], 30200[q_clr_i]);
        30000[q_clr_i] = 0;
      );
      q_clr_i += 1;
    );
  );

  b_cur_beat = play_position * (tempo / 60.0);
  g_cur_beat = b_cur_beat;
  block_cur_beat = b_cur_beat;
  b_rel_start_beat = b_cur_beat;
  b_rel_end_beat = b_rel_start_beat + b_block_beats;

  // LFO cross-modulation (LFO -> LFO)
  ti_in = 0;
  while (ti_in < NUM_TRACKS) (
    4720[ti_in] = 0.0;
    ti_in += 1;
  );

  ti_src = 0;
  while (ti_src < NUM_TRACKS) (
    src_dst = 4600[ti_src];
    (src_dst >= 13 && src_dst <= 28) ? (
      tgt_lfo = src_dst - 13;
      tgt_lfo != ti_src ? (
        src_val = get_lfo_value(ti_src, b_cur_beat, play_position);
        4720[tgt_lfo] += src_val;
      );
    );
    ti_src += 1;
  );

  b_has_solo = 0;
  b_s = 0;
  while (b_s < NUM_TRACKS) (
    1680[b_s] ? b_has_solo = 1;
    b_s += 1;
  );

  // Process scheduled sub-step note queue (Note-On / Note-Off)
  qi = 0;
  while (qi < 64) (
    q_state = 30000[qi];
    q_state == 2 ? (
      // Active note scheduled to turn off (Note-Off)
      30600[qi] < b_rel_end_beat ? (
        off_samp = floor((30600[qi] - b_rel_start_beat) * b_samples_per_beat);
        off_samp = max(0, min(samplesblock - 1, off_samp));
        send_note_off(off_samp, 30100[qi], 30200[qi]);
        30000[qi] = 0;
      );
    ) :
    q_state == 1 ? (
      // Scheduled note awaiting trigger (Note-On)
      30500[qi] < b_rel_end_beat ? (
        on_samp = floor((30500[qi] - b_rel_start_beat) * b_samples_per_beat);
        on_samp = max(0, min(samplesblock - 1, on_samp));
        send_pan_if_changed(on_samp, 30200[qi], 30400[qi], 30700[qi]);
        send_note_on(on_samp, 30100[qi], 30200[qi], 30300[qi]);

        30600[qi] < b_rel_end_beat ? (
          off_samp = floor((30600[qi] - b_rel_start_beat) * b_samples_per_beat);
          off_samp = max(on_samp + 1, min(samplesblock - 1, off_samp));
          send_note_off(off_samp, 30100[qi], 30200[qi]);
          30000[qi] = 0;
        ) : (
          30000[qi] = 2; // Active note spanning to next block
        );
      );
    );
    qi += 1;
  );

  b_tr = 0;
  while (b_tr < NUM_TRACKS) (
    b_is_muted = 1700[b_tr];
    b_is_soloed = 1680[b_tr];
    b_can_play = (!b_has_solo || b_is_soloed) && !b_is_muted;

    b_len = 1660[b_tr];
    b_len <= 0 ? b_len = 16;
    b_rate_idx = 1640[b_tr];
    b_sw = 1740[b_tr];

    // Per-track LFO modulation (active only when connected to a destination)
    b_lfo_dst = 4600[b_tr];
    b_lfo_dst != 0 ? (
      b_lfo_mod = get_lfo_value(b_tr, b_cur_beat, play_position);
      4740[b_tr] = b_lfo_mod; // Modulation feedback buffer
    ) : (
      b_lfo_mod = 0.0;
      4740[b_tr] = 0.0;
    );

    // Apply LFO rate modulation before step duration calculation
    b_lfo_dst == 2 ? (
      b_rate_idx = min(10, max(0, floor(b_rate_idx + b_lfo_mod * 3.0 + 0.5)));
    );
    b_step_beat_dur = get_beats_per_step(b_rate_idx);

    // Detect rate changes to recalculate step index and prevent timing bursts
    3900[b_tr] != b_rate_idx ? (
      3900[b_tr] = b_rate_idx;
      b_cur_st = floor((b_cur_beat + 0.00001) / b_step_beat_dur);
      1820[b_tr] = b_cur_st - 1;
    );

    b_lfo_dst == 3 ? ( b_len = min(64, max(1, floor(b_len + b_lfo_mod * 16.0 + 0.5))); );
    b_lfo_dst == 6 ? ( b_sw = min(100, max(-100, floor(b_sw + b_lfo_mod * 50.0 + 0.5))); );

    // Standard track Note-Off
    (1780[b_tr] >= 0 && 1840[b_tr] < b_rel_end_beat) ? (
      b_off_sample = floor((1840[b_tr] - b_rel_start_beat) * b_samples_per_beat);
      b_off_sample = max(0, min(samplesblock - 1, b_off_sample));
      send_note_off(b_off_sample, 1780[b_tr], 1800[b_tr]);
      1780[b_tr] = -1;
      1840[b_tr] = -1;
    );

    // Update visual playhead buffer 1760 with correct track rate
    b_pm = 1920[b_tr];
    b_st_p = get_track_play_step(floor((b_cur_beat + 0.00001) / b_step_beat_dur), b_len, b_pm, b_tr);
    1760[b_tr] = floor((b_cur_beat + 0.00001) / b_step_beat_dur);

    b_keep_checking = 1;
    while (b_keep_checking) (
      b_st = 1820[b_tr] + 1;
      b_step_in_pattern = get_track_play_step(b_st, b_len, b_pm, b_tr);

      b_step_offset = b_tr * 64 + b_step_in_pattern;

      b_fill = 1860[b_tr];
      b_lfo_dst == 4 ? (
        fill_mod = floor(b_lfo_mod * (b_len * 0.5) + 0.5);
        b_fill = min(b_len, max(0, b_fill + fill_mod));
      );

      euc_mode ? (
        b_step_active = eval_euclidean_step(b_step_in_pattern, b_len, b_fill);
      ) : (
        b_step_active = 10000[b_step_offset];
      );

      b_step_vel = 12000[b_step_offset];
      b_step_vel <= 0 ? b_step_vel = 100;

      b_step_gate_idx = 16000[b_step_offset];
      (b_step_gate_idx < 0 || b_step_gate_idx > 68) ? b_step_gate_idx = 4;
      b_gate_dur = get_elektron_gate_dur(b_step_gate_idx, b_step_beat_dur);

      b_sw_offset = (b_step_in_pattern % 2 == 1 && b_sw != 0) ? ((b_sw / 100.0) * b_step_beat_dur * 0.5) : 0.0;
      b_step_timing = 18000[b_step_offset];
      b_lfo_dst == 10 ? ( b_step_timing = min(50, max(-50, floor(b_step_timing + b_lfo_mod * 50.0 + 0.5))); );
      b_mt_offset = (b_step_timing / 100.0) * b_step_beat_dur * 0.5;
      b_st_sound_beat = b_st * b_step_beat_dur + b_sw_offset + b_mt_offset;

      // Swing gate compensation: shorten shifted notes to prevent overlap with next step
      b_step_gate_idx != 68 ? ( // Bypass when gate is INF
        b_sw > 0 && (b_step_in_pattern % 2 == 1) ? (
          avail_gate = max(0.01 * b_step_beat_dur, b_step_beat_dur - b_sw_offset - (0.015 * b_step_beat_dur));
          b_gate_dur = min(b_gate_dur, avail_gate);
        ) :
        b_sw < 0 && (b_step_in_pattern % 2 == 0) ? (
          avail_gate = max(0.01 * b_step_beat_dur, b_step_beat_dur - abs(b_sw_offset) - (0.015 * b_step_beat_dur));
          b_gate_dur = min(b_gate_dur, avail_gate);
        );
      );

      (b_st_sound_beat < b_rel_end_beat) ? (
        (b_st_sound_beat >= (b_rel_start_beat - 0.001) || b_st == floor((b_cur_beat + 0.0001) / b_step_beat_dur)) ? (
          b_target_sample = floor((b_st_sound_beat - b_rel_start_beat) * b_samples_per_beat);
          // On transport start, offset to sample 1 to prevent REAPER CC/Note-Off reset at sample 0 from canceling note
          b_target_sample = max(b_is_starting ? 1 : 0, min(samplesblock - 1, b_target_sample));

          b_can_play && b_step_active ? (
            b_cycle = floor(b_st / b_len);
            b_step_cond = 24000[b_step_offset];
            b_pass_cond = eval_cond(b_step_cond, b_cycle, b_tr);

            b_pass_cond ? (
              b_track_chance = 1720[b_tr];
              b_lfo_dst == 5 ? ( b_track_chance = min(100, max(0, floor(b_track_chance + b_lfo_mod * 50.0 + 0.5))); );
              b_step_chance = 22000[b_step_offset];
              b_lfo_dst == 12 ? ( b_step_chance = min(100, max(0, floor(b_step_chance + b_lfo_mod * 50.0 + 0.5))); );
              b_effective_chance = max(0, min(100, b_step_chance + b_track_chance - 100));
              b_pass_chance = (b_effective_chance >= 100 || (b_effective_chance > 0 && rand(100) < b_effective_chance));

              b_pass_chance ? (
                // Choke previous sounding note before triggering new note
                1780[b_tr] >= 0 ? (
                  b_kill_sample = max(0, b_target_sample - 2);
                  (b_target_sample <= 1) ? (
                    send_note_off(0, 1780[b_tr], 1800[b_tr]);
                    b_target_sample = max(b_target_sample, 2);
                  ) : (
                    send_note_off(b_kill_sample, 1780[b_tr], 1800[b_tr]);
                  );
                  1780[b_tr] = -1;
                  1840[b_tr] = -1;
                );

                b_pitch = 1600[b_tr];
                b_lfo_dst == 1 ? ( b_pitch = min(108, max(24, floor(b_pitch + b_lfo_mod * 12.0 + 0.5))); );
                b_pitch = quantize_pitch(b_pitch);
                b_ch = 1620[b_tr];
                b_step_pan = 14000[b_step_offset];
                (b_step_pan < 0 || b_step_pan > 127) ? b_step_pan = 64;
                b_lfo_dst == 9 ? ( b_step_pan = min(127, max(0, floor(b_step_pan + b_lfo_mod * 64.0 + 0.5))); );

                // Ratcheting (1..4 sub-steps)
                b_ratchet = 20000[b_step_offset];
                (b_ratchet < 1 || b_ratchet > 4) ? b_ratchet = 1;
                b_lfo_dst == 11 ? ( b_ratchet = min(4, max(1, floor(b_ratchet + b_lfo_mod * 2.0 + 0.5))); );
                b_lfo_dst == 7 ? ( b_step_vel = min(127, max(1, floor(b_step_vel + b_lfo_mod * 64.0 + 0.5))); );
                b_lfo_dst == 8 ? (
                  b_step_gate_idx = min(68, max(0, floor(b_step_gate_idx + b_lfo_mod * 34.0 + 0.5)));
                  b_gate_dur = get_elektron_gate_dur(b_step_gate_idx, b_step_beat_dur);
                );

                b_sub_dur = b_step_beat_dur / b_ratchet;

                b_ratchet == 1 ? (
                  // Standard single step
                  send_pan_if_changed(b_target_sample, b_ch, b_step_pan, b_tr);
                  send_note_on(b_target_sample, b_pitch, b_ch, b_step_vel);

                  b_note_off_beat = b_st_sound_beat + b_gate_dur;
                  (b_note_off_beat < b_rel_end_beat) ? (
                    b_off_sample = floor((b_note_off_beat - b_rel_start_beat) * b_samples_per_beat);
                    b_off_sample = max(b_target_sample + 1, min(samplesblock - 1, b_off_sample));
                    send_note_off(b_off_sample, b_pitch, b_ch);
                    1780[b_tr] = -1;
                    1840[b_tr] = -1;
                  ) : (
                    1780[b_tr] = b_pitch;
                    1800[b_tr] = b_ch;
                    1840[b_tr] = b_note_off_beat;
                  );
                ) : (
                  // Multiple sub-steps
                  r_i = 0;
                  while (r_i < b_ratchet) (
                    sub_on_beat = b_st_sound_beat + r_i * b_sub_dur;
                    sub_g_dur = min(b_sub_dur * 0.85, max(0.005, b_gate_dur / b_ratchet));
                    sub_off_beat = sub_on_beat + sub_g_dur;

                    (sub_on_beat < b_rel_end_beat) ? (
                      (sub_on_beat >= b_rel_start_beat) ? (
                        sub_on_samp = floor((sub_on_beat - b_rel_start_beat) * b_samples_per_beat);
                        sub_on_samp = max(0, min(samplesblock - 1, sub_on_samp));
                        send_pan_if_changed(sub_on_samp, b_ch, b_step_pan, b_tr);
                        send_note_on(sub_on_samp, b_pitch, b_ch, b_step_vel);

                        (sub_off_beat < b_rel_end_beat) ? (
                          sub_off_samp = floor((sub_off_beat - b_rel_start_beat) * b_samples_per_beat);
                          sub_off_samp = max(sub_on_samp + 1, min(samplesblock - 1, sub_off_samp));
                          send_note_off(sub_off_samp, b_pitch, b_ch);
                        ) : (
                          queue_add(2, b_pitch, b_ch, b_step_vel, b_step_pan, b_tr, sub_on_beat, sub_off_beat);
                        );
                      ) : (
                        (sub_off_beat > b_rel_start_beat && sub_off_beat < b_rel_end_beat) ? (
                          sub_off_samp = floor((sub_off_beat - b_rel_start_beat) * b_samples_per_beat);
                          sub_off_samp = max(0, min(samplesblock - 1, sub_off_samp));
                          send_note_off(sub_off_samp, b_pitch, b_ch);
                        );
                      );
                    ) : (
                      // Schedule for future block
                      queue_add(1, b_pitch, b_ch, b_step_vel, b_step_pan, b_tr, sub_on_beat, sub_off_beat);
                    );

                    r_i += 1;
                  );
                );
              );
            );
          );
        );

        1820[b_tr] = b_st;
      ) : (
        b_keep_checking = 0;
      );
    );

    b_tr += 1;
  );
) : (
  g_cur_beat = max(0.0, play_position * (tempo / 60.0));
  stopped_cursor_pos = play_position;
  b_t = 0;
  while (b_t < NUM_TRACKS) (
    1780[b_t] >= 0 ? (
      send_note_off(0, 1780[b_t], 1800[b_t]);
      1780[b_t] = -1;
    );
    1880[b_t] != 64 ? (
      b_ch_rst = 1620[b_t];
      b_ch_rst == 0 ? (
        c_i = 0; while (c_i < 16) ( midisend(0, 0xB0 + c_i, 10, 64); c_i += 1; );
      ) : (
        midisend(0, 0xB0 + (b_ch_rst - 1), 10, 64);
      );
      1880[b_t] = 64;
    );
    1820[b_t] = -1;
    1840[b_t] = -1;
    b_r_t = 1640[b_t];
    b_dur_t = get_beats_per_step(b_r_t);
    b_len_t = 1660[b_t]; b_len_t <= 0 ? b_len_t = 16;
    1760[b_t] = floor((g_cur_beat + 0.00001) / b_dur_t);
    4800[b_t] = -1;
    b_t += 1;
  );
  // Turn off all queued sub-step notes
  q_t_i = 0;
  while (q_t_i < 64) (
    30000[q_t_i] > 0 ? (
      send_note_off(0, 30100[q_t_i], 30200[q_t_i]);
      30000[q_t_i] = 0;
    );
    q_t_i += 1;
  );
);

b_was_playing = b_is_playing;
b_last_cur_beat = b_cur_beat;
b_last_play_pos = play_position;

@gfx 1271 538
gfx_clear = 0x242424;

// Window resolution scaling (1271x538, base 1059x448)
cur_w = max(100, gfx_w);
cur_h = max(50, gfx_h);
sx = cur_w / 1059.0;
sy = cur_h / 448.0;
scale_font = max(min(sx, sy), min(sx, sy * 1.35) * 0.70 + (sx + sy) * 0.15);

// Font size scaling (Slot 9: 16px params, Slot 7: 15px pages)
sz_param = max(13, min(54, floor(16 * scale_font)));
sz_page  = max(13, min(50, floor(15 * scale_font)));
sz_main  = max(12, min(48, floor(14 * scale_font)));
sz_btn   = max(10, min(42, floor(12 * scale_font)));
sz_sub   = max(9,  min(36, floor(10 * scale_font)));
sz_q     = max(13, min(56, floor(16 * scale_font)));
sz_tt_title = max(14, min(48, floor(15 * scale_font)));
sz_tt_desc  = max(12, min(42, floor(13 * scale_font)));
sz_reawise  = max(22, min(96, floor(28 * scale_font)));
sz_readout  = max(12, min(48, floor(14 * scale_font)));

// System fonts
gfx_setfont(1, "Inter",       sz_main,  'B');
gfx_setfont(2, "Inter",       sz_btn,   'B');
gfx_setfont(3, "Inter",       sz_sub,   'B');
gfx_setfont(4, "Inter",       sz_q,     'B');
gfx_setfont(5, "Inter",       sz_tt_title, 'B');
gfx_setfont(6, "Inter",       sz_tt_desc,  'B');
gfx_setfont(7, "Inter Light", sz_page,  0);
gfx_setfont(8, "Inter Light", sz_btn,   0);
gfx_setfont(9, "Inter Light", sz_param, 0);
gfx_setfont(10, "Inter Light", sz_main, 0);
gfx_setfont(11, "Inter",       sz_reawise, 'B');
gfx_setfont(12, "Inter",       sz_readout, 'B');

function X(val) ( floor(val * sx); );
function Y(val) ( floor(val * sy); );
function W(val) ( max(1, floor(val * sx)); );
function H(val) ( max(1, floor(val * sy)); );

// Step grid horizontal alignment between FILL box and CHANCE meter
fill_end_px = X(310);
chance_start_px = X(787);
avail_space_px = chance_start_px - fill_end_px;

box_w_px = W(23);
box_gap_px = max(2, floor(4 * sx + 0.5));
box_pitch_px = box_w_px + box_gap_px;
box_h_px = H(24);
sb_txt_y_off = max(1, floor(1 * sy));

grid_total_w_px = 16 * box_w_px + 15 * box_gap_px;
left_margin_px = floor((avail_space_px - grid_total_w_px) * 0.5);
screen_grid_x = fill_end_px + left_margin_px;

// Top bar button alignment above step grid
by_top_btn = floor(Y(15));
bh_top_btn = floor(H(18));

bw_vel = floor(W(64));
bw_gate = floor(W(44));
bw_pan = floor(W(36));
bw_tm = floor(W(54));
bw_rt = floor(W(76));
bw_ch_btn = floor(W(56));
bw_cnd_btn = floor(W(44));

tot_btns_w = bw_vel + bw_gate + bw_pan + bw_tm + bw_rt + bw_ch_btn + bw_cnd_btn;
tot_gaps_w = grid_total_w_px - tot_btns_w;
btn_gap_px = tot_gaps_w / 6.0;

bx_vel = floor(screen_grid_x);
bx_gate = floor(screen_grid_x + bw_vel + btn_gap_px);
bx_pan = floor(screen_grid_x + (bw_vel + bw_gate) + btn_gap_px * 2);
bx_tm = floor(screen_grid_x + (bw_vel + bw_gate + bw_pan) + btn_gap_px * 3);
bx_rt = floor(screen_grid_x + (bw_vel + bw_gate + bw_pan + bw_tm) + btn_gap_px * 4);
bx_ch_btn = floor(screen_grid_x + (bw_vel + bw_gate + bw_pan + bw_tm + bw_rt) + btn_gap_px * 5);
bx_cnd_btn = floor(screen_grid_x + grid_total_w_px - bw_cnd_btn);

// Top bar LFO strip layout
by_lfo = Y(12);
bh_lfo = H(24);
lfo_box_w_px = max(20, floor(41 * (cur_w / 1271.0) + 0.5));
lfo_gap_px = max(2, floor(4 * sx + 0.5));
bw_lfo = lfo_box_w_px;

pm_right_px = X(1006) + W(44);
bx_lfo_am = pm_right_px - bw_lfo;
bx_lfo_ds = bx_lfo_am - lfo_gap_px - bw_lfo;
bx_lfo_tg = bx_lfo_ds - lfo_gap_px - bw_lfo;
bx_lfo_rt = bx_lfo_tg - lfo_gap_px - bw_lfo;
bx_lfo_sy = bx_lfo_rt - lfo_gap_px - bw_lfo;
bx_lfo_sh = bx_lfo_sy - lfo_gap_px - bw_lfo;
bx_lfo_tr = bx_lfo_sh - lfo_gap_px - bw_lfo;

// Keyboard input and direct parameter text editing
edit_active > 0 ? (
  gui_dirty = 1;
  key_char = gfx_getchar();
  while (key_char > 0) (
    key_char == 13 ? ( // Enter (confirm)
      commit_param_edit();
      edit_active = 0;
      edit_tr = -1;
      edit_first_key = 0;
      gui_dirty = 1;
    ) :
    key_char == 27 ? ( // Escape (cancel)
      edit_active = 0;
      edit_tr = -1;
      edit_first_key = 0;
      gui_dirty = 1;
    ) :
    key_char == 8 ? ( // Backspace
      edit_first_key ? (
        #edit_buf = "";
        edit_first_key = 0;
        gui_dirty = 1;
      ) : (
        b_len = strlen(#edit_buf);
        b_len > 0 ? (
          strcpy_substr(#edit_buf, #edit_buf, 0, b_len - 1);
          gui_dirty = 1;
        );
      );
    ) :
    (key_char >= 32 && key_char <= 255) ? (
      edit_first_key ? (
        #edit_buf = "";
        edit_first_key = 0;
      );
      // Map sharp key variants ('s', 'S', '+', '£') to '#' for Pitch or Root Note
      (edit_active == 2 || edit_active == 11) ? (
        (key_char == 's' || key_char == 'S' || key_char == '+' || key_char == 163) ? (
          key_char = '#';
        );
      );
      strlen(#edit_buf) < 10 ? (
        sprintf(#k_chr, "%c", key_char);
        strcat(#edit_buf, #k_chr);
        gui_dirty = 1;
      );
    );
    key_char = gfx_getchar();
  );
) : (
  key_char = gfx_getchar();
  while (key_char > 0) (
    key_char = gfx_getchar();
  );
);

now_time = time_precise();
is_playing_transport = play_state & 1;
gfx_cur_beat = play_position * (tempo / 60.0);

// Normalized mouse coordinates
m_x = floor(mouse_x / sx);
m_y = floor(mouse_y / sy);

mouse_down = (mouse_cap & 1);
mouse_press = mouse_down && !mouse_was_down;
mouse_release = !mouse_down && mouse_was_down;
mouse_was_down = mouse_down;

mouse_middle_down = (mouse_cap & 64);
mouse_middle_press = mouse_middle_down && !mouse_middle_was_down;
mouse_middle_was_down = mouse_middle_down;

// Close and commit active text edit field on outside click
edit_active > 0 && mouse_press ? (
  is_in_box = 0;
  ed_row = (edit_tr % 8);
  ed_ry = 52 + ed_row * 44;
  ed_page = floor(edit_tr / 8);
  ed_page == current_page ? (
    edit_active == 1 ? ( is_in_box = (m_x >= 100 && m_x <= 146 && m_y >= ed_ry + 6 && m_y <= ed_ry + 30); ) :
    edit_active == 2 ? ( is_in_box = (m_x >= 150 && m_x <= 188 && m_y >= ed_ry + 6 && m_y <= ed_ry + 30); ) :
    edit_active == 3 ? ( is_in_box = (m_x >= 192 && m_x <= 226 && m_y >= ed_ry + 6 && m_y <= ed_ry + 30); ) :
    edit_active == 4 ? ( is_in_box = (m_x >= 230 && m_x <= 268 && m_y >= ed_ry + 6 && m_y <= ed_ry + 30); ) :
    edit_active == 7 ? ( is_in_box = (m_x >= 272 && m_x <= 310 && m_y >= ed_ry + 6 && m_y <= ed_ry + 30); ) :
    edit_active == 5 ? ( is_in_box = (m_x >= 786 && m_x <= 836 && m_y >= ed_ry + 6 && m_y <= ed_ry + 30); ) :
    edit_active == 6 ? ( is_in_box = (m_x >= 840 && m_x <= 888 && m_y >= ed_ry + 6 && m_y <= ed_ry + 30); );
  );
  edit_active == 8 ? (
    is_in_box = lfo_am_hov;
  );
  edit_active == 9 ? (
    is_in_box = lfo_rt_hov;
  );
  edit_active == 10 ? (
    is_in_box = lfo_tr_hov;
  );
  edit_active == 11 ? (
    is_in_box = root_hov;
  );

  !is_in_box ? (
    commit_param_edit();
    edit_active = 0;
    edit_tr = -1;
    edit_first_key = 0;
    gui_dirty = 1;
  );
);

mouse_r_down = (mouse_cap & 2) != 0;
mouse_r_press = mouse_r_down && !last_mouse_r_down;
last_mouse_r_down = mouse_r_down;

// Sidebar and top bar hover detection
mode_btns_hov = mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn && mouse_x >= bx_vel && mouse_x <= (bx_cnd_btn + bw_cnd_btn);
vel_btn_hov = mouse_x >= bx_vel && mouse_x <= bx_vel + bw_vel && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
gate_btn_hov = mouse_x >= bx_gate && mouse_x <= bx_gate + bw_gate && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
pan_btn_hov = mouse_x >= bx_pan && mouse_x <= bx_pan + bw_pan && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
timing_btn_hov = mouse_x >= bx_tm && mouse_x <= bx_tm + bw_tm && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
ratchet_btn_hov = mouse_x >= bx_rt && mouse_x <= bx_rt + bw_rt && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
chance_btn_hov = mouse_x >= bx_ch_btn && mouse_x <= bx_ch_btn + bw_ch_btn && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
cond_btn_hov = mouse_x >= bx_cnd_btn && mouse_x <= bx_cnd_btn + bw_cnd_btn && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;

lfo_tr_hov = mouse_x >= bx_lfo_tr && mouse_x <= bx_lfo_tr + bw_lfo && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
lfo_sh_hov = mouse_x >= bx_lfo_sh && mouse_x <= bx_lfo_sh + bw_lfo && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
lfo_sy_hov = mouse_x >= bx_lfo_sy && mouse_x <= bx_lfo_sy + bw_lfo && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
lfo_rt_hov = mouse_x >= bx_lfo_rt && mouse_x <= bx_lfo_rt + bw_lfo && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
lfo_tg_hov = mouse_x >= bx_lfo_tg && mouse_x <= bx_lfo_tg + bw_lfo && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
lfo_ds_hov = mouse_x >= bx_lfo_ds && mouse_x <= bx_lfo_ds + bw_lfo && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
lfo_am_hov = mouse_x >= bx_lfo_am && mouse_x <= bx_lfo_am + bw_lfo && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;

kb_hov = m_x >= 52 && m_x <= 146 && m_y >= 12 && m_y <= 36;
root_hov = m_x >= 150 && m_x <= 188 && m_y >= 12 && m_y <= 36;
scale_hov = m_x >= 192 && m_x <= 310 && m_y >= 12 && m_y <= 36;
p0_hov = m_x >= 4 && m_x <= 40 && m_y >= 28 && m_y <= 50;
p1_hov = m_x >= 4 && m_x <= 40 && m_y >= 54 && m_y <= 76;
sp0_hov = m_x >= 4 && m_x <= 40 && m_y >= 117 && m_y <= 139;
sp1_hov = m_x >= 4 && m_x <= 40 && m_y >= 143 && m_y <= 165;
sp2_hov = m_x >= 4 && m_x <= 40 && m_y >= 169 && m_y <= 191;
sp3_hov = m_x >= 4 && m_x <= 40 && m_y >= 195 && m_y <= 217;
euc_hov = m_x >= 4 && m_x <= 40 && m_y >= 242 && m_y <= 264;
undo_hov = m_x >= 4 && m_x <= 40 && m_y >= 289 && m_y <= 311;
redo_hov = m_x >= 4 && m_x <= 40 && m_y >= 315 && m_y <= 337;
del_hov = m_x >= 4 && m_x <= 40 && m_y >= 341 && m_y <= 363;
info_hov = m_x >= 4 && m_x <= 40 && m_y >= 388 && m_y <= 410;
lang_hov = m_x >= 4 && m_x <= 40 && m_y >= 414 && m_y <= 436;
vel_btn_hov = mouse_x >= bx_vel && mouse_x <= bx_vel + bw_vel && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
gate_btn_hov = mouse_x >= bx_gate && mouse_x <= bx_gate + bw_gate && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
pan_btn_hov = mouse_x >= bx_pan && mouse_x <= bx_pan + bw_pan && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
timing_btn_hov = mouse_x >= bx_tm && mouse_x <= bx_tm + bw_tm && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
ratchet_btn_hov = mouse_x >= bx_rt && mouse_x <= bx_rt + bw_rt && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
chance_btn_hov = mouse_x >= bx_ch_btn && mouse_x <= bx_ch_btn + bw_ch_btn && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
cond_btn_hov = mouse_x >= bx_cnd_btn && mouse_x <= bx_cnd_btn + bw_cnd_btn && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;

#tt_title = "";
#tt_desc = "";

// Mouse wheel handling
mouse_wheel != 0 ? (
  wheel_dir = (mouse_wheel > 0) ? 1 : -1;
  wheel_delta_vel = (mouse_wheel > 0) ? 1 : -1;
  mouse_wheel = 0;
  gui_dirty = 1;

  root_hov ? (
    undo_push();
    set_quant_root(quant_root + wheel_dir);
  ) :
  scale_hov ? (
    undo_push();
    next_s = wheel_dir > 0 ? ((quant_scale + 1) % 3) : ((quant_scale - 1 + 3) % 3);
    set_quant_scale(next_s);
  ) :
  lfo_tr_hov ? (
    lfo_cur_tr = min(15, max(0, lfo_cur_tr - wheel_dir));
    drag_mode == 16 ? (
      drag_start_val = lfo_cur_tr;
      drag_start_y = m_y;
    );
  ) :
  lfo_sh_hov ? (
    4500[lfo_cur_tr] = min(5, max(0, 4500[lfo_cur_tr] - wheel_dir));
    drag_mode == 12 ? (
      drag_start_val = 4500[lfo_cur_tr];
      drag_start_y = m_y;
    );
  ) :
  lfo_rt_hov ? (
    undo_push();
    4520[lfo_cur_tr] ? (
      cur_rt = 4540[lfo_cur_tr];
      4540[lfo_cur_tr] = min(11, max(0, cur_rt + wheel_dir));
      drag_mode == 11 ? (
        drag_start_val = 4540[lfo_cur_tr];
        drag_start_y = m_y;
      );
    ) : (
      step_hz = (mouse_cap & 1) ? 0.1 : 0.5;
      new_hz = floor((4560[lfo_cur_tr] + wheel_dir * step_hz) * 10 + 0.5) / 10.0;
      4560[lfo_cur_tr] = min(20.0, max(0.1, new_hz));
      drag_mode == 11 ? (
        drag_start_val = 4560[lfo_cur_tr];
        drag_start_y = m_y;
      );
    );
  ) :
  lfo_ds_hov ? (
    undo_push();
    cur_dst = 4600[lfo_cur_tr];
    4600[lfo_cur_tr] = get_next_lfo_dest(cur_dst, -wheel_dir, lfo_cur_tr);
  ) :
  lfo_am_hov ? (
    undo_push();
    delta_am = (mouse_cap & 1) ? 1 : 5;
    4620[lfo_cur_tr] = min(100, max(0, 4620[lfo_cur_tr] + wheel_dir * delta_am));
    drag_mode == 15 ? (
      drag_start_val = 4620[lfo_cur_tr];
      drag_start_y = m_y;
    );
  );

  row_idx = 0;
  while (row_idx < TRACKS_PER_PAGE) (
    tr = current_page * 8 + row_idx;
    ry = 52 + row_idx * 44;

    m_x >= 100 && m_x <= 146 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      cur_ch = 1620[tr];
      new_ch = cur_ch + wheel_dir;
      1620[tr] = min(16, max(0, new_ch));
    );

    m_x >= 150 && m_x <= 188 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      cur_pitch = 1600[tr];
      (mouse_cap & 1) ? (
        new_pitch = get_next_scale_octave(cur_pitch, wheel_dir);
      ) : (
        new_pitch = get_next_scale_pitch(cur_pitch, wheel_dir);
      );
      1600[tr] = new_pitch;
      drag_mode == 1 ? (
        drag_start_val = new_pitch;
        drag_start_y = m_y;
      );
    );

    m_x >= 1005 && m_x <= 1050 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      cur_pm = 1920[tr];
      next_pm = min(3, max(0, cur_pm - wheel_dir));
      1920[tr] = next_pm;
      drag_mode == 10 ? (
        drag_start_val = next_pm;
        drag_start_y = m_y;
      );
    );

    m_x >= 192 && m_x <= 226 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      cur_rate = 1640[tr];
      new_rate = cur_rate + wheel_dir;
      1640[tr] = min(10, max(0, new_rate));
    );

    m_x >= 230 && m_x <= 268 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      cur_len = 1660[tr];
      new_len = cur_len + wheel_dir;
      1660[tr] = min(64, max(1, new_len));
      1860[tr] > 1660[tr] ? 1860[tr] = 1660[tr];
    );

    euc_mode && m_x >= 272 && m_x <= 310 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      cur_fill = 1860[tr];
      cur_len = 1660[tr];
      cur_len <= 0 ? cur_len = 16;
      cur_len > 64 ? cur_len = 64;
      new_fill = min(cur_len, max(0, cur_fill + wheel_dir));
      1860[tr] = new_fill;
      euc_mode ? apply_euclidean_track(tr);
    );

    // Chance and Swing wheel adjustment
    chance_x = 787;
    m_x >= chance_x && m_x <= chance_x + 50 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      cur_chance = 1720[tr];
      delta_chc = (mouse_cap & 3) ? 1 : 5;
      new_chance = min(100, max(0, cur_chance + (wheel_dir * delta_chc)));
      1720[tr] = new_chance;
      drag_mode == 5 ? (
        drag_start_val = new_chance;
        drag_start_y = m_y;
      );
    );

    swing_x = 841;
    m_x >= swing_x && m_x <= swing_x + 48 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      cur_swing = 1740[tr];
      delta_sw = (mouse_cap & 3) ? 1 : 5;
      new_swing = min(100, max(-100, cur_swing + (wheel_dir * delta_sw)));
      1740[tr] = new_swing;
      drag_mode == 6 ? (
        drag_start_val = new_swing;
        drag_start_y = m_y;
      );
    );

    (velocity_mode || gate_mode || pan_mode || timing_mode || ratchet_mode || chance_mode || cond_mode) ? (
      s_i = 0;
      while (s_i < 16) (
        bx = screen_grid_x + s_i * box_pitch_px;
        by = Y(ry + 6);
        mouse_x >= bx && mouse_x <= bx + box_w_px && mouse_y >= by && mouse_y <= by + box_h_px ? (
          global_step = step_page * 16 + s_i;
          step_offset = tr * 64 + global_step;
          10000[step_offset] ? (
            undo_push();
            velocity_mode ? (
              cur_vel = 12000[step_offset];
              cur_vel <= 0 ? cur_vel = 100;
              wheel_delta_vel = (mouse_cap & 2) ? (wheel_dir * 1) : (wheel_dir * 5);
              12000[step_offset] = min(127, max(1, cur_vel + wheel_delta_vel));
            ) :
            gate_mode ? (
              cur_gate = 16000[step_offset];
              (cur_gate < 0 || cur_gate > 68) ? cur_gate = 4;
              wheel_delta_gate = (wheel_dir > 0) ? 1 : -1;
              16000[step_offset] = min(68, max(0, cur_gate + wheel_delta_gate));
            ) :
            pan_mode ? (
              cur_pan = 14000[step_offset];
              cur_pan <= 0 && cur_pan != 0 ? cur_pan = 64;
              delta_pan = (mouse_cap & 2) ? 1 : 5;
              wheel_delta_pan = wheel_dir * delta_pan;
              14000[step_offset] = min(127, max(0, cur_pan + wheel_delta_pan));
            ) :
            timing_mode ? (
              cur_timing = 18000[step_offset];
              delta_timing = (mouse_cap & 2) ? 1 : 5;
              wheel_delta_timing = wheel_dir * delta_timing;
              18000[step_offset] = min(50, max(-50, cur_timing + wheel_delta_timing));
            ) :
            ratchet_mode ? (
              cur_ratchet = 20000[step_offset];
              cur_ratchet <= 0 ? cur_ratchet = 1;
              wheel_delta_ratchet = (wheel_dir > 0) ? 1 : -1;
              20000[step_offset] = min(4, max(1, cur_ratchet + wheel_delta_ratchet));
            ) :
            chance_mode ? (
              cur_st_chance = 22000[step_offset];
              delta_st_chance = (mouse_cap & 2) ? 1 : 5;
              wheel_delta_chance = wheel_dir * delta_st_chance;
              22000[step_offset] = min(100, max(0, cur_st_chance + wheel_delta_chance));
            ) : (
              cur_cond_val = 24000[step_offset];
              wheel_delta_cond = (wheel_dir > 0) ? 1 : -1;
              24000[step_offset] = min(43, max(0, cur_cond_val + wheel_delta_cond));
            );
          );
        );
        s_i += 1;
      );
    );
    row_idx += 1;
  );
);

// Middle-click step parameter reset (Velocity, Gate, Pan, Timing, Ratchet, Chance, Cond)
mouse_middle_press && (velocity_mode || gate_mode || pan_mode || timing_mode || ratchet_mode || chance_mode || cond_mode) ? (
  row_m = 0;
  while (row_m < TRACKS_PER_PAGE) (
    tr_m = current_page * 8 + row_m;
    ry_m = 52 + row_m * 44;
    sm_i = 0;
    while (sm_i < 16) (
      bx_m = screen_grid_x + sm_i * box_pitch_px;
      by_m = Y(ry_m + 6);
      mouse_x >= bx_m && mouse_x <= bx_m + box_w_px && mouse_y >= by_m && mouse_y <= by_m + box_h_px ? (
        global_step = step_page * 16 + sm_i;
        st_off = tr_m * 64 + global_step;
        10000[st_off] ? (
          undo_push();
          velocity_mode ? (
            12000[st_off] = 100;
          ) :
          gate_mode ? (
            16000[st_off] = 4; // Reset to 1 step
          ) :
          pan_mode ? (
            14000[st_off] = 64;
          ) :
          timing_mode ? (
            18000[st_off] = 0;
          ) :
          ratchet_mode ? (
            20000[st_off] = 1;
          ) :
          chance_mode ? (
            22000[st_off] = 100;
          ) : (
            24000[st_off] = 0;
          );
          gui_dirty = 1;
        );
      );
      sm_i += 1;
    );
    row_m += 1;
  );
);

// Context menu (gfx_showmenu) or right-click direct text input
mouse_r_press ? (
  is_on_ctrl = 0;
  m_x < 44 ? is_on_ctrl = 1; // Left sidebar

  mode_btns_hov ? is_on_ctrl = 1; // VELOCITY, GATE, PAN, TIMING, RATCHETING, CHANCE, COND
  root_hov ? (
    is_on_ctrl = 1;
    edit_active > 0 ? commit_param_edit();
    edit_active = 11;
    edit_tr = 0;
    edit_first_key = 1;
    #edit_buf = "";
    quant_root == 0 ? #edit_buf = "C" :
    quant_root == 1 ? #edit_buf = "C#" :
    quant_root == 2 ? #edit_buf = "D" :
    quant_root == 3 ? #edit_buf = "D#" :
    quant_root == 4 ? #edit_buf = "E" :
    quant_root == 5 ? #edit_buf = "F" :
    quant_root == 6 ? #edit_buf = "F#" :
    quant_root == 7 ? #edit_buf = "G" :
    quant_root == 8 ? #edit_buf = "G#" :
    quant_root == 9 ? #edit_buf = "A" :
    quant_root == 10 ? #edit_buf = "A#" : #edit_buf = "B";
    gui_dirty = 1;
  ) :
  scale_hov ? (
    is_on_ctrl = 1;
    strcpy(#scale_menu, (quant_scale == 0 ? "!" : ""));
    strcat(#scale_menu, "Chromatic|");
    strcat(#scale_menu, (quant_scale == 1 ? "!" : ""));
    strcat(#scale_menu, "Major|");
    strcat(#scale_menu, (quant_scale == 2 ? "!" : ""));
    strcat(#scale_menu, "Natural Minor");

    gfx_x = mouse_x; gfx_y = mouse_y;
    sel_scale = gfx_showmenu(#scale_menu);
    sel_scale >= 1 ? (
      undo_push();
      set_quant_scale(sel_scale - 1);
      gui_dirty = 1;
    );
  ) :
  kb_hov ? (
    is_on_ctrl = 1;
  ) :
  lfo_ds_hov ? (
    is_on_ctrl = 1;
    cur_d = 4600[lfo_cur_tr];
    strcpy(#lfo_menu, (cur_d == 0 ? "!" : ""));
    strcat(#lfo_menu, "OFF|");
    strcat(#lfo_menu, (cur_d == 1 ? "!" : ""));
    strcat(#lfo_menu, "Pitch|");
    strcat(#lfo_menu, (cur_d == 2 ? "!" : ""));
    strcat(#lfo_menu, "Rate|");
    strcat(#lfo_menu, (cur_d == 3 ? "!" : ""));
    strcat(#lfo_menu, "Length|");
    strcat(#lfo_menu, (cur_d == 4 ? "!" : ""));
    strcat(#lfo_menu, "Fill|");
    strcat(#lfo_menu, (cur_d == 5 ? "!" : ""));
    strcat(#lfo_menu, "Density|");
    strcat(#lfo_menu, (cur_d == 6 ? "!" : ""));
    strcat(#lfo_menu, "Swing|");
    strcat(#lfo_menu, (cur_d == 7 ? "!" : ""));
    strcat(#lfo_menu, "Velocity|");
    strcat(#lfo_menu, (cur_d == 8 ? "!" : ""));
    strcat(#lfo_menu, "Gate|");
    strcat(#lfo_menu, (cur_d == 9 ? "!" : ""));
    strcat(#lfo_menu, "Pan|");
    strcat(#lfo_menu, (cur_d == 10 ? "!" : ""));
    strcat(#lfo_menu, "Timing|");
    strcat(#lfo_menu, (cur_d == 11 ? "!" : ""));
    strcat(#lfo_menu, "Ratcheting|");
    strcat(#lfo_menu, (cur_d == 12 ? "!" : ""));
    strcat(#lfo_menu, "Chance|");

    // Append LFO 1..16 targets excluding current LFO
    ti_m = 0;
    while (ti_m < NUM_TRACKS) (
      ti_m != lfo_cur_tr ? (
        dest_val = 13 + ti_m;
        cur_d == dest_val ? strcat(#lfo_menu, "!") : 0;
        sprintf(#m_lfo_item, "LFO %d|", ti_m + 1);
        strcat(#lfo_menu, #m_lfo_item);
      );
      ti_m += 1;
    );

    gfx_x = mouse_x; gfx_y = mouse_y;
    sel_dst = gfx_showmenu(#lfo_menu);
    sel_dst >= 1 ? (
      undo_push();
      sel_dst <= 13 ? (
        4600[lfo_cur_tr] = sel_dst - 1;
      ) : (
        lfo_choice_idx = sel_dst - 14;
        ti_m = 0;
        match_count = 0;
        found_target = -1;
        while (ti_m < NUM_TRACKS && found_target < 0) (
          ti_m != lfo_cur_tr ? (
            match_count == lfo_choice_idx ? (
              found_target = ti_m;
            );
            match_count += 1;
          );
          ti_m += 1;
        );
        found_target >= 0 ? (
          4600[lfo_cur_tr] = 13 + found_target;
        );
      );
      gui_dirty = 1;
    );
  ) :
  lfo_sh_hov ? (
    is_on_ctrl = 1;
    cur_sh = 4500[lfo_cur_tr];
    strcpy(#lfo_sh_menu, (cur_sh == 0 ? "!" : ""));
    strcat(#lfo_sh_menu, "Sine|");
    strcat(#lfo_sh_menu, (cur_sh == 1 ? "!" : ""));
    strcat(#lfo_sh_menu, "Triangle|");
    strcat(#lfo_sh_menu, (cur_sh == 2 ? "!" : ""));
    strcat(#lfo_sh_menu, "Saw Up|");
    strcat(#lfo_sh_menu, (cur_sh == 3 ? "!" : ""));
    strcat(#lfo_sh_menu, "Saw Down|");
    strcat(#lfo_sh_menu, (cur_sh == 4 ? "!" : ""));
    strcat(#lfo_sh_menu, "Square|");
    strcat(#lfo_sh_menu, (cur_sh == 5 ? "!" : ""));
    strcat(#lfo_sh_menu, "Sample && Hold");

    gfx_x = mouse_x; gfx_y = mouse_y;
    sel_sh = gfx_showmenu(#lfo_sh_menu);
    sel_sh >= 1 ? (
      undo_push();
      4500[lfo_cur_tr] = sel_sh - 1;
      gui_dirty = 1;
    );
  ) :
  lfo_rt_hov ? (
    is_on_ctrl = 1;
    4520[lfo_cur_tr] ? (
      cur_typ = 4700[lfo_cur_tr];
      strcpy(#lfo_rt_menu, (cur_typ == 0 ? "!" : ""));
      strcat(#lfo_rt_menu, "Tempo|");
      strcat(#lfo_rt_menu, (cur_typ == 1 ? "!" : ""));
      strcat(#lfo_rt_menu, "Tempo Dotted|");
      strcat(#lfo_rt_menu, (cur_typ == 2 ? "!" : ""));
      strcat(#lfo_rt_menu, "Tempo Triplets");

      gfx_x = mouse_x; gfx_y = mouse_y;
      sel_rt = gfx_showmenu(#lfo_rt_menu);
      sel_rt >= 1 ? (
        undo_push();
        4700[lfo_cur_tr] = sel_rt - 1;
        gui_dirty = 1;
      );
    ) : (
      edit_active > 0 ? commit_param_edit();
      edit_active = 9;
      edit_tr = lfo_cur_tr;
      edit_first_key = 1;
      #edit_buf = "";
      sprintf(#edit_buf, (4560[lfo_cur_tr] == floor(4560[lfo_cur_tr])) ? "%d" : "%.1f", 4560[lfo_cur_tr]);
      gui_dirty = 1;
    );
  ) :
  lfo_am_hov ? (
    is_on_ctrl = 1;
    edit_active > 0 ? commit_param_edit();
    edit_active = 8;
    edit_tr = lfo_cur_tr;
    edit_first_key = 1;
    #edit_buf = "";
    sprintf(#edit_buf, "%d", 4620[lfo_cur_tr]);
    gui_dirty = 1;
  ) :
  lfo_tr_hov ? (
    is_on_ctrl = 1;
    edit_active > 0 ? commit_param_edit();
    edit_active = 10;
    edit_tr = lfo_cur_tr;
    edit_first_key = 1;
    #edit_buf = "";
    sprintf(#edit_buf, "%d", lfo_cur_tr + 1);
    gui_dirty = 1;
  ) :
  (lfo_sy_hov || lfo_tg_hov) ? (
    is_on_ctrl = 1;
  ) :
  (vel_btn_hov || gate_btn_hov || pan_btn_hov || timing_btn_hov || ratchet_btn_hov || chance_btn_hov || cond_btn_hov) ? (
    is_on_ctrl = 1;
  );

  // Track row controls
  row_c = 0;
  while (row_c < TRACKS_PER_PAGE && !is_on_ctrl) (
    ry_c = 52 + row_c * 44;
    m_y >= ry_c + 6 && m_y <= ry_c + 30 ? (
      tr_c = current_page * 8 + row_c;
      (m_x >= 52 && m_x <= 96) ? is_on_ctrl = 1; // Solo / Mute

      // Channel
      (m_x >= 100 && m_x <= 146) ? (
        edit_active > 0 ? commit_param_edit();
        edit_active = 1; edit_tr = tr_c; edit_first_key = 1;
        #edit_buf = "";
        1620[tr_c] == 0 ? #edit_buf = "ALL" : sprintf(#edit_buf, "%d", 1620[tr_c]);
        is_on_ctrl = 1; gui_dirty = 1;
      ) :
      // Pitch
      (m_x >= 150 && m_x <= 188) ? (
        edit_active > 0 ? commit_param_edit();
        edit_active = 2; edit_tr = tr_c; edit_first_key = 1;
        #edit_buf = "";
        draw_note_name(1600[tr_c]);
        strcpy(#edit_buf, #note_full_str);
        is_on_ctrl = 1; gui_dirty = 1;
      ) :
      // Rate
      (m_x >= 192 && m_x <= 226) ? (
        edit_active > 0 ? commit_param_edit();
        edit_active = 3; edit_tr = tr_c; edit_first_key = 1;
        #edit_buf = "";
        r_c_idx = 1640[tr_c];
        r_c_idx == 0 ? #edit_buf = "/16" :
        r_c_idx == 1 ? #edit_buf = "/12" :
        r_c_idx == 2 ? #edit_buf = "/8" :
        r_c_idx == 3 ? #edit_buf = "/4" :
        r_c_idx == 4 ? #edit_buf = "/2" :
        r_c_idx == 5 ? #edit_buf = "x1" :
        r_c_idx == 6 ? #edit_buf = "x2" :
        r_c_idx == 7 ? #edit_buf = "x4" :
        r_c_idx == 8 ? #edit_buf = "x8" :
        r_c_idx == 9 ? #edit_buf = "x12" : #edit_buf = "x16";
        is_on_ctrl = 1; gui_dirty = 1;
      ) :
      // Length
      (m_x >= 230 && m_x <= 268) ? (
        edit_active > 0 ? commit_param_edit();
        edit_active = 4; edit_tr = tr_c; edit_first_key = 1;
        #edit_buf = "";
        sprintf(#edit_buf, "%d", 1660[tr_c]);
        is_on_ctrl = 1; gui_dirty = 1;
      ) :
      // Euclidean Fill (active when euc_mode is on)
      (m_x >= 272 && m_x <= 310) ? (
        euc_mode ? (
          edit_active > 0 ? commit_param_edit();
          edit_active = 7; edit_tr = tr_c; edit_first_key = 1;
          #edit_buf = "";
          sprintf(#edit_buf, "%d", 1860[tr_c]);
          gui_dirty = 1;
        );
        is_on_ctrl = 1;
      ) :
      (mouse_x >= screen_grid_x && mouse_x <= screen_grid_x + 16 * box_pitch_px) ? is_on_ctrl = 1; // Step grid
      // Chance / Density
      (m_x >= 786 && m_x <= 836) ? (
        edit_active > 0 ? commit_param_edit();
        edit_active = 5; edit_tr = tr_c; edit_first_key = 1;
        #edit_buf = "";
        sprintf(#edit_buf, "%d", 1720[tr_c]);
        is_on_ctrl = 1; gui_dirty = 1;
      ) :
      // Swing
      (m_x >= 840 && m_x <= 888) ? (
        edit_active > 0 ? commit_param_edit();
        edit_active = 6; edit_tr = tr_c; edit_first_key = 1;
        #edit_buf = "";
        sprintf(#edit_buf, "%d", 1740[tr_c]);
        is_on_ctrl = 1; gui_dirty = 1;
      ) :
      (m_x >= 892 && m_x <= 1050) ? is_on_ctrl = 1; // Shift / Flip / Random / Play Mode
    );
    row_c += 1;
  );

  !is_on_ctrl ? (
    edit_active > 0 ? (
      commit_param_edit();
      edit_active = 0; edit_tr = -1; edit_first_key = 0; gui_dirty = 1;
    );
    strcpy(#menu_str, "#PLAYHEAD SYNC OFFSET (PDC Latency)|");

    g_i = 0;
    while (g_i <= NUM_TRACKS) (
      g_i == 0 ? (
        strcat(#menu_str, ">Global|");
        cur_val = playhead_sync_offset;
      ) : (
        sprintf(#grp_title, ">Track %d|", g_i);
        strcat(#menu_str, #grp_title);
        cur_val = 1900[g_i - 1];
      );

      off_i = 16;
      while (off_i >= -16) (
        cur_val == off_i ? strcat(#menu_str, "!") : 0;
        off_i == -16 ? strcat(#menu_str, "<") : 0;
        off_i > 0 ? (
          sprintf(#item_str, "+%d|", off_i);
        ) : (
          sprintf(#item_str, "%d|", off_i);
        );
        strcat(#menu_str, #item_str);
        off_i -= 1;
      );

      g_i += 1;
    );

    gfx_x = mouse_x;
    gfx_y = mouse_y;
    menu_choice = gfx_showmenu(#menu_str);

    menu_choice >= 2 ? (
      sel_idx = menu_choice - 2;
      group_idx = floor(sel_idx / 33);
      opt_idx = sel_idx % 33;
      chosen_off = 16 - opt_idx; // +16 .. -16

      undo_push();
      group_idx == 0 ? (
        playhead_sync_offset = chosen_off;
        ti_sync = 0;
        while (ti_sync < NUM_TRACKS) (
          1900[ti_sync] = chosen_off;
          ti_sync += 1;
        );
      ) : (
        target_tr = group_idx - 1;
        1900[target_tr] = chosen_off;
      );
      gui_dirty = 1;
    );
  );
);

// Sidebar click handling
mouse_cap & 1 ? (
  !mouse_clicked && drag_mode == 0 ? (
    kb_hov && kb_paint_mode < 0 ? (
      target_note = get_kb_note_at(m_x, m_y);
      target_note >= 0 ? (
        undo_push();
        kb_paint_mode = !4000[target_note];
        4000[target_note] = kb_paint_mode;
        last_painted_note = target_note;
        last_kb_paint_x = m_x;
        last_kb_paint_y = m_y;
        update_quant_scale_type();
        mouse_clicked = 1;
        gui_dirty = 1;
      );
    ) :
    root_hov ? (
      now_t = time_precise();
      (now_t - last_click_time < 0.3 && last_click_elem == 7000) ? (
        undo_push();
        set_quant_root(0); // Reset to C (0)
        mouse_clicked = 1;
        last_click_elem = -1;
      ) : (
        undo_push();
        drag_mode = 8; drag_start_y = m_y; drag_start_val = quant_root;
        last_click_time = now_t; last_click_elem = 7000;
        mouse_clicked = 1;
      );
    ) :
    scale_hov ? (
      now_t = time_precise();
      (now_t - last_click_time < 0.3 && last_click_elem == 7001) ? (
        undo_push();
        set_quant_scale(0); // Reset to Chromatic (0)
        mouse_clicked = 1;
        last_click_elem = -1;
      ) : (
        undo_push();
        drag_mode = 9; drag_start_y = m_y; drag_start_val = quant_scale;
        last_click_time = now_t; last_click_elem = 7001;
        mouse_clicked = 1;
      );
    ) :
    p0_hov ? (
      current_page = 0; mouse_clicked = 1; gui_dirty = 1;
    ) :
    p1_hov ? (
      current_page = 1; mouse_clicked = 1; gui_dirty = 1;
    ) :
    sp0_hov ? (
      step_page = 0; mouse_clicked = 1; gui_dirty = 1;
    ) :
    sp1_hov ? (
      step_page = 1; mouse_clicked = 1; gui_dirty = 1;
    ) :
    sp2_hov ? (
      step_page = 2; mouse_clicked = 1; gui_dirty = 1;
    ) :
    sp3_hov ? (
      step_page = 3; mouse_clicked = 1; gui_dirty = 1;
    ) :
    vel_btn_hov ? (
      undo_push();
      velocity_mode = !velocity_mode;
      velocity_mode ? ( pan_mode = 0; gate_mode = 0; timing_mode = 0; ratchet_mode = 0; chance_mode = 0; cond_mode = 0; );
      mouse_clicked = 1; gui_dirty = 1;
    ) :
    gate_btn_hov ? (
      undo_push();
      gate_mode = !gate_mode;
      gate_mode ? ( velocity_mode = 0; pan_mode = 0; timing_mode = 0; ratchet_mode = 0; chance_mode = 0; cond_mode = 0; );
      mouse_clicked = 1; gui_dirty = 1;
    ) :
    pan_btn_hov ? (
      undo_push();
      pan_mode = !pan_mode;
      pan_mode ? ( velocity_mode = 0; gate_mode = 0; timing_mode = 0; ratchet_mode = 0; chance_mode = 0; cond_mode = 0; );
      mouse_clicked = 1; gui_dirty = 1;
    ) :
    timing_btn_hov ? (
      undo_push();
      timing_mode = !timing_mode;
      timing_mode ? ( velocity_mode = 0; gate_mode = 0; pan_mode = 0; ratchet_mode = 0; chance_mode = 0; cond_mode = 0; );
      mouse_clicked = 1; gui_dirty = 1;
    ) :
    ratchet_btn_hov ? (
      undo_push();
      ratchet_mode = !ratchet_mode;
      ratchet_mode ? ( velocity_mode = 0; gate_mode = 0; pan_mode = 0; timing_mode = 0; chance_mode = 0; cond_mode = 0; );
      mouse_clicked = 1; gui_dirty = 1;
    ) :
    chance_btn_hov ? (
      undo_push();
      chance_mode = !chance_mode;
      chance_mode ? ( velocity_mode = 0; gate_mode = 0; pan_mode = 0; timing_mode = 0; ratchet_mode = 0; cond_mode = 0; );
      mouse_clicked = 1; gui_dirty = 1;
    ) :
    cond_btn_hov ? (
      undo_push();
      cond_mode = !cond_mode;
      cond_mode ? ( velocity_mode = 0; gate_mode = 0; pan_mode = 0; timing_mode = 0; ratchet_mode = 0; chance_mode = 0; );
      mouse_clicked = 1; gui_dirty = 1;
    ) :
    lfo_tr_hov ? (
      now_t = time_precise();
      (now_t - last_click_time < 0.3 && last_click_elem == 9916) ? (
        undo_push();
        lfo_cur_tr = 0;
        mouse_clicked = 1;
        last_click_elem = -1;
      ) : (
        undo_push();
        drag_mode = 16;
        drag_start_y = m_y;
        drag_start_val = lfo_cur_tr;
        last_click_time = now_t;
        last_click_elem = 9916;
        mouse_clicked = 1;
      );
      gui_dirty = 1;
    ) :
    lfo_sh_hov ? (
      now_t = time_precise();
      (now_t - last_click_time < 0.3 && last_click_elem == 9912) ? (
        undo_push();
        4500[lfo_cur_tr] = 0;
        mouse_clicked = 1;
        last_click_elem = -1;
      ) : (
        undo_push();
        drag_mode = 12;
        drag_start_y = m_y;
        drag_start_val = 4500[lfo_cur_tr];
        last_click_time = now_t;
        last_click_elem = 9912;
        mouse_clicked = 1;
      );
      gui_dirty = 1;
    ) :
    lfo_sy_hov ? (
      4520[lfo_cur_tr] = !4520[lfo_cur_tr];
      mouse_clicked = 1; gui_dirty = 1;
    ) :
    lfo_tg_hov ? (
      4580[lfo_cur_tr] = !4580[lfo_cur_tr];
      mouse_clicked = 1; gui_dirty = 1;
    ) :
    lfo_rt_hov ? (
      now_t = time_precise();
      (now_t - last_click_time < 0.3 && last_click_elem == 9910) ? (
        undo_push();
        4520[lfo_cur_tr] ? (
          4540[lfo_cur_tr] = 6; // Reset to default 1/2
          4700[lfo_cur_tr] = 0; // Reset to Straight
        ) : (
          4560[lfo_cur_tr] = 2.0; // Reset to default 2.0 Hz
        );
        mouse_clicked = 1;
        last_click_elem = -1;
      ) : (
        undo_push();
        drag_mode = 11;
        drag_start_y = m_y;
        drag_start_val = 4520[lfo_cur_tr] ? 4540[lfo_cur_tr] : 4560[lfo_cur_tr];
        last_click_time = now_t;
        last_click_elem = 9910;
        mouse_clicked = 1;
      );
      gui_dirty = 1;
    ) :
    lfo_ds_hov ? (
      now_t = time_precise();
      (now_t - last_click_time < 0.3 && last_click_elem == 9914) ? (
        undo_push();
        4600[lfo_cur_tr] = 0; // Reset to OFF
        mouse_clicked = 1;
        last_click_elem = -1;
      ) : (
        undo_push();
        drag_mode = 14; drag_start_y = m_y; drag_start_val = 4600[lfo_cur_tr];
        last_click_time = now_t; last_click_elem = 9914;
        mouse_clicked = 1;
      );
      gui_dirty = 1;
    ) :
    lfo_am_hov ? (
      now_t = time_precise();
      (now_t - last_click_time < 0.3 && last_click_elem == 9900) ? (
        undo_push();
        4620[lfo_cur_tr] = 100;
        mouse_clicked = 1;
        last_click_elem = -1;
      ) : (
        undo_push();
        drag_mode = 15;
        drag_start_y = m_y;
        drag_start_val = 4620[lfo_cur_tr];
        last_click_time = now_t;
        last_click_elem = 9900;
        mouse_clicked = 1;
      );
      gui_dirty = 1;
    ) :
    euc_hov ? (
      undo_push();
      euc_mode = !euc_mode;
      mouse_clicked = 1; gui_dirty = 1;
    ) :
    info_hov ? (
      info_mode = !info_mode;
      mouse_clicked = 1; gui_dirty = 1;
    ) :
    lang_hov ? (
      info_lang = !info_lang;
      mouse_clicked = 1; gui_dirty = 1;
    ) :
    del_hov ? (
      undo_push();
      euc_mode = 0;
      clr_i = 0;
      while (clr_i < 1024) (
        10000[clr_i] = 0;   // Step off
        12000[clr_i] = 100; // Velocity default 100
        14000[clr_i] = 64;  // Pan default 64 (Center)
        16000[clr_i] = 4;   // Gate Length default index 4 (1 step)
        18000[clr_i] = 0;   // Micro Timing default 0%
        20000[clr_i] = 1;   // Ratcheting default 1 sub-step
        22000[clr_i] = 100; // Step Chance default 100%
        24000[clr_i] = 0;   // Step Trig Condition default 0 ("---")
        clr_i += 1;
      );
      clr_t = 0;
      while (clr_t < NUM_TRACKS) (
        1860[clr_t] = 0;    // Reset Euclidean Fill
        clr_t += 1;
      );
      mouse_clicked = 1; gui_dirty = 1;
    ) :
    undo_hov ? (
      undo_pop(); mouse_clicked = 1; gui_dirty = 1;
    ) :
    redo_hov ? (
      redo_pop(); mouse_clicked = 1; gui_dirty = 1;
    );
  );
);

// Dynamic GUI redraw triggers
(cur_w != last_gfx_w || cur_h != last_gfx_h) ? (
  last_gfx_w = cur_w;
  last_gfx_h = cur_h;
  gfx_setimgdim(1, cur_w, cur_h);
  gui_dirty = 1;
);

mouse_press || mouse_release || mouse_down || mouse_middle_press || drag_mode > 0 || step_paint_mode >= 0 || kb_paint_mode >= 0 ? (
  gui_dirty = 1;
);

(m_x != last_m_x || m_y != last_m_y) ? (
  last_m_x = m_x;
  last_m_y = m_y;
  gui_dirty = 1;
);

is_playing_transport != last_transport_play ? (
  last_transport_play = is_playing_transport;
  gui_dirty = 1;
);

// Continuous GUI animation refresh when active LFO is connected or modulating visible parameters
has_lfo_gui_anim = 0;
(4600[lfo_cur_tr] != 0) ? has_lfo_gui_anim = 1;

ti_hf = 0;
while (ti_hf < NUM_TRACKS) (
  (euc_mode && 4600[ti_hf] == 4) ? has_lfo_gui_anim = 1;
  (4600[ti_hf] == 3) ? has_lfo_gui_anim = 1;
  (4600[ti_hf] == 2) ? has_lfo_gui_anim = 1;
  (4600[ti_hf] == 1) ? has_lfo_gui_anim = 1;
  (4600[ti_hf] == 5) ? has_lfo_gui_anim = 1;
  (4600[ti_hf] == 6) ? has_lfo_gui_anim = 1;
  (4600[ti_hf] == 7) ? has_lfo_gui_anim = 1;
  (gate_mode && 4600[ti_hf] == 8) ? has_lfo_gui_anim = 1;
  (pan_mode && 4600[ti_hf] == 9) ? has_lfo_gui_anim = 1;
  (timing_mode && 4600[ti_hf] == 10) ? has_lfo_gui_anim = 1;
  (ratchet_mode && 4600[ti_hf] == 11) ? has_lfo_gui_anim = 1;
  (chance_mode && 4600[ti_hf] == 12) ? has_lfo_gui_anim = 1;
  ti_hf += 1;
);
(is_playing_transport && has_lfo_gui_anim) ? (
  gui_dirty = 1;
);

mouse_release ? (
  drag_mode = 0;
  drag_tr = -1;
  step_paint_mode = -1;
  last_painted_offset = -1;
  kb_paint_mode = -1;
  last_painted_note = -1;
  mouse_clicked = 0;
);

gui_dirty ? (
  gfx_dest = 1;

  // Main background (#242424)
  gfx_r = 36 / 255.0; gfx_g = 36 / 255.0; gfx_b = 36 / 255.0;
  gfx_rect(0, 0, cur_w, cur_h);

sb_w = W(44);

// Sidebar background (#1c1c1c)
gfx_r = 28 / 255.0; gfx_g = 28 / 255.0; gfx_b = 28 / 255.0;
gfx_rect(0, 0, sb_w, cur_h);
gfx_r = 64 / 255.0; gfx_g = 64 / 255.0; gfx_b = 64 / 255.0;
gfx_line(sb_w, 0, sb_w, cur_h);

// Sidebar divider lines
gfx_line(X(6), Y(88), X(38), Y(88));
gfx_line(X(6), Y(229), X(38), Y(229));
gfx_line(X(6), Y(276), X(38), Y(276));
gfx_line(X(6), Y(375), X(38), Y(375));

// "TRACK" sidebar header
// MARK_TRACK_HEADER
gfx_setfont(8, "Inter", sz_btn, 0);
gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;

gfx_measurestr("T", t1_w, trk_h);
gfx_measurestr("R", t2_w, trk_h);
gfx_measurestr("A", t3_w, trk_h);
gfx_measurestr("C", t4_w, trk_h);
gfx_measurestr("K", t5_w, trk_h);

trk_track = max(1, floor(1.2 * scale_font));
tot_trk_w = t1_w + t2_w + t3_w + t4_w + t5_w + trk_track * 4;

start_trk_x = floor((sb_w - tot_trk_w) * 0.5);
start_trk_y = Y(12) + floor((H(12) - trk_h) * 0.5) + sb_txt_y_off;

gfx_x = start_trk_x; gfx_y = start_trk_y; gfx_drawstr("T");
gfx_x = start_trk_x + t1_w + trk_track; gfx_y = start_trk_y; gfx_drawstr("R");
gfx_x = start_trk_x + t1_w + t2_w + trk_track * 2; gfx_y = start_trk_y; gfx_drawstr("A");
gfx_x = start_trk_x + t1_w + t2_w + t3_w + trk_track * 3; gfx_y = start_trk_y; gfx_drawstr("C");
gfx_x = start_trk_x + t1_w + t2_w + t3_w + t4_w + trk_track * 4; gfx_y = start_trk_y; gfx_drawstr("K");

// 1. 12-note keyboard (X: 52..146, Y: 12..36, W: 94, H: 24)
bx_kb = X(52); bw_kb = W(94); by_kb = Y(12); bh_kb = H(24);
bh_bk = max(8, floor(bh_kb * 0.60));
bw_bk = max(6, floor(bw_kb * 0.09));
bw_bk_half = floor(bw_bk * 0.5);

// Hover key calculation (0..11)
hov_key = -1;
kb_hov ? (
  rel_x = m_x - 52;
  rel_y = m_y - 12;
  rel_y <= bh_bk ? (
    (rel_x >= 9 && rel_x <= 18) ? hov_key = 1 :
    (rel_x >= 22 && rel_x <= 31) ? hov_key = 3 :
    (rel_x >= 49 && rel_x <= 58) ? hov_key = 6 :
    (rel_x >= 63 && rel_x <= 72) ? hov_key = 8 :
    (rel_x >= 76 && rel_x <= 85) ? hov_key = 10;
  );
  hov_key < 0 ? (
    wk_i_hov = floor(rel_x * 7.0 / 94.0);
    wk_i_hov = min(6, max(0, wk_i_hov));
    wk_i_hov == 0 ? hov_key = 0 :
    wk_i_hov == 1 ? hov_key = 2 :
    wk_i_hov == 2 ? hov_key = 4 :
    wk_i_hov == 3 ? hov_key = 5 :
    wk_i_hov == 4 ? hov_key = 7 :
    wk_i_hov == 5 ? hov_key = 9 : hov_key = 11;
  );
);

// White keys (7)
kb_rad = max(2, floor(bh_kb * 0.15));
wk_i = 0;
while (wk_i < 7) (
  wk_x = bx_kb + floor(wk_i * bw_kb / 7.0);
  wk_x_next = bx_kb + floor((wk_i + 1) * bw_kb / 7.0);
  wk_w = wk_x_next - wk_x;
  wk_note = (wk_i == 0 ? 0 : wk_i == 1 ? 2 : wk_i == 2 ? 4 : wk_i == 3 ? 5 : wk_i == 4 ? 7 : wk_i == 5 ? 9 : 11);
  wk_active = (4000[wk_note] == 1);
  wk_is_hov = (hov_key == wk_note);

  wk_active ? (
    wk_is_hov ? (
      gfx_r = 120 / 255.0; gfx_g = 203 / 255.0; gfx_b = 254 / 255.0;
    ) : (
      gfx_r = 92 / 255.0; gfx_g = 193 / 255.0; gfx_b = 254 / 255.0;
    );
  ) : (
    wk_is_hov ? (
      gfx_r = 224 / 255.0; gfx_g = 224 / 255.0; gfx_b = 224 / 255.0;
    ) : (
      gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
    );
  );

  wk_i == 0 ? (
    fill_left_roundrect(wk_x, by_kb, wk_w, bh_kb, kb_rad);
  ) :
  wk_i == 6 ? (
    fill_right_roundrect(wk_x, by_kb, wk_w, bh_kb, kb_rad);
  ) : (
    gfx_rect(wk_x, by_kb, wk_w, bh_kb);
  );

  wk_i > 0 ? (
    gfx_r = 50 / 255.0; gfx_g = 50 / 255.0; gfx_b = 55 / 255.0;
    gfx_rect(wk_x, by_kb, 1, bh_kb);
  );
  wk_i += 1;
);

// Black keys (5)
bk_i = 0;
while (bk_i < 5) (
  bk_i == 0 ? ( bk_boundary = 1; bk_note = 1; ) :
  bk_i == 1 ? ( bk_boundary = 2; bk_note = 3; ) :
  bk_i == 2 ? ( bk_boundary = 4; bk_note = 6; ) :
  bk_i == 3 ? ( bk_boundary = 5; bk_note = 8; ) :
              ( bk_boundary = 6; bk_note = 10; );

  bk_center_x = bx_kb + floor(bk_boundary * bw_kb / 7.0);
  bk_x = bk_center_x - bw_bk_half;
  bk_active = (4000[bk_note] == 1);
  bk_is_hov = (hov_key == bk_note);

  bk_active ? (
    bk_is_hov ? (
      gfx_r = 53 / 255.0; gfx_g = 132 / 255.0; gfx_b = 203 / 255.0;
    ) : (
      gfx_r = 40 / 255.0; gfx_g = 110 / 255.0; gfx_b = 170 / 255.0;
    );
  ) : (
    bk_is_hov ? (
      gfx_r = 40 / 255.0; gfx_g = 40 / 255.0; gfx_b = 46 / 255.0;
    ) : (
      gfx_r = 18 / 255.0; gfx_g = 18 / 255.0; gfx_b = 20 / 255.0;
    );
  );
  gfx_rect(bk_x, by_kb, bw_bk, bh_bk);

  bk_active ? (
    gfx_r = 65 / 255.0; gfx_g = 145 / 255.0; gfx_b = 210 / 255.0;
  ) : (
    gfx_r = 45 / 255.0; gfx_g = 45 / 255.0; gfx_b = 50 / 255.0;
  );
  gfx_roundrect(bk_x, by_kb, bw_bk, bh_bk, 0, 1);
  bk_i += 1;
);

// Fixed border
set_border_color(0);
gfx_roundrect(bx_kb, by_kb, bw_kb, bh_kb, kb_rad, 1);

// 2. Root Note box (X: 150..188, Y: 12..36, W: 38, H: 24)
bx_root = X(150); bw_root = W(38); by_root = Y(12); bh_root = H(24);

edit_active == 11 ? (
  gfx_r = 0.12; gfx_g = 0.22; gfx_b = 0.32;
  fill_roundrect(bx_root, by_root, bw_root, bh_root, W(3));
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  gfx_roundrect(bx_root, by_root, bw_root, bh_root, W(3), 1);
  gfx_setfont(9, "Inter Light", sz_param, 0);
  strcpy(#draw_buf, #edit_buf);
  gfx_measurestr(#draw_buf, db_w, db_h);
  dt_x = bx_root + floor((bw_root - db_w) * 0.5);
  dt_y = by_root + floor((bh_root - db_h) * 0.5);
  edit_first_key ? (
    gfx_r = 0.22; gfx_g = 0.45; gfx_b = 0.75;
    gfx_rect(dt_x - W(2), dt_y - H(1), db_w + W(4), db_h + H(2));
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  ) : (
    (time_precise() * 2) % 1 < 0.5 ? strcat(#draw_buf, "|");
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  );
  gfx_x = dt_x; gfx_y = dt_y;
  gfx_drawstr(#draw_buf);
) : (
  set_border_color(root_hov);
  gfx_roundrect(bx_root, by_root, bw_root, bh_root, W(3), 1);

  gfx_setfont(9, "Inter Light", sz_param, 0);
  quant_root == 0 ? #root_str = "C" :
  quant_root == 1 ? #root_str = "C#" :
  quant_root == 2 ? #root_str = "D" :
  quant_root == 3 ? #root_str = "D#" :
  quant_root == 4 ? #root_str = "E" :
  quant_root == 5 ? #root_str = "F" :
  quant_root == 6 ? #root_str = "F#" :
  quant_root == 7 ? #root_str = "G" :
  quant_root == 8 ? #root_str = "G#" :
  quant_root == 9 ? #root_str = "A" :
  quant_root == 10 ? #root_str = "A#" : #root_str = "B";

  gfx_measurestr(#root_str, r_lbl_w, r_lbl_h);
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  gfx_x = bx_root + floor((bw_root - r_lbl_w) * 0.5);
  gfx_y = by_root + floor((bh_root - r_lbl_h) * 0.5);
  gfx_drawstr(#root_str);
);

// 3. Scale box (X: 192..310, Y: 12..36, W: 118, H: 24)
bx_scale = X(192); bw_scale = W(118); by_scale = Y(12); bh_scale = H(24);
set_border_color(scale_hov);
gfx_roundrect(bx_scale, by_scale, bw_scale, bh_scale, W(3), 1);

gfx_setfont(8, "Inter", sz_btn, 0);
quant_scale == 0 ? #sc_str = "CHROMATIC" :
quant_scale == 1 ? #sc_str = "MAJOR" :
quant_scale == 2 ? (
  gfx_measurestr("NATURAL MINOR", test_sc_w, test_sc_h);
  test_sc_w <= (bw_scale - W(8)) ? (
    #sc_str = "NATURAL MINOR";
  ) : (
    #sc_str = "NAT MINOR";
  );
) :
#sc_str = "CUSTOM";

gfx_measurestr(#sc_str, sc_lbl_w, sc_lbl_h);
gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
gfx_x = bx_scale + floor((bw_scale - sc_lbl_w) * 0.5) + max(1, floor(1 * sx));
gfx_y = by_scale + floor((bh_scale - sc_lbl_h) * 0.5) + max(1, floor(1 * sy));
gfx_drawstr(#sc_str);

// VELOCITY mode button
is_vel_pressed = (mouse_cap & 1) && vel_btn_hov;
by_vel = by_top_btn; bh_vel = bh_top_btn;

velocity_mode ? (
  is_vel_pressed ? (
    gfx_r = 65 / 255; gfx_g = 145 / 255; gfx_b = 200 / 255;
  ) : (
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  );
  fill_roundrect(bx_vel, by_vel, bw_vel, bh_vel, W(3));
  set_border_color(vel_btn_hov);
  gfx_roundrect(bx_vel, by_vel, bw_vel, bh_vel, W(3), 1);
  gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
) : (
  is_vel_pressed ? (
    gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
  ) : (
    gfx_r = 0.16; gfx_g = 0.16; gfx_b = 0.18;
  );
  fill_roundrect(bx_vel, by_vel, bw_vel, bh_vel, W(3));
  set_border_color(vel_btn_hov);
  gfx_roundrect(bx_vel, by_vel, bw_vel, bh_vel, W(3), 1);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
);
gfx_setfont(8, "Inter", sz_btn, 0);
gfx_measurestr("VELOCITY", vel_lbl_w, vel_lbl_h);
btn_txt_x_off = max(1, floor(1 * sx));
btn_txt_y_off = max(1, floor(1 * sy));
gfx_x = bx_vel + floor((bw_vel - vel_lbl_w) * 0.5) + btn_txt_x_off;
gfx_y = by_vel + floor((bh_vel - vel_lbl_h) * 0.5) + btn_txt_y_off + (is_vel_pressed ? 1 : 0);
gfx_drawstr("VELOCITY");

// GATE mode button
is_gate_pressed = (mouse_cap & 1) && gate_btn_hov;
by_gate = by_top_btn; bh_gate = bh_top_btn;

gate_mode ? (
  is_gate_pressed ? (
    gfx_r = 65 / 255; gfx_g = 145 / 255; gfx_b = 200 / 255;
  ) : (
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  );
  fill_roundrect(bx_gate, by_gate, bw_gate, bh_gate, W(3));
  set_border_color(gate_btn_hov);
  gfx_roundrect(bx_gate, by_gate, bw_gate, bh_gate, W(3), 1);
  gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
) : (
  is_gate_pressed ? (
    gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
  ) : (
    gfx_r = 0.16; gfx_g = 0.16; gfx_b = 0.18;
  );
  fill_roundrect(bx_gate, by_gate, bw_gate, bh_gate, W(3));
  set_border_color(gate_btn_hov);
  gfx_roundrect(bx_gate, by_gate, bw_gate, bh_gate, W(3), 1);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
);
gfx_setfont(8, "Inter", sz_btn, 0);
gfx_measurestr("GATE", gate_lbl_w, gate_lbl_h);
gfx_x = bx_gate + floor((bw_gate - gate_lbl_w) * 0.5) + btn_txt_x_off;
gfx_y = by_gate + floor((bh_gate - gate_lbl_h) * 0.5) + btn_txt_y_off + (is_gate_pressed ? 1 : 0);
gfx_drawstr("GATE");

// PAN mode button
is_pan_pressed = (mouse_cap & 1) && pan_btn_hov;
by_pan = by_top_btn; bh_pan = bh_top_btn;

pan_mode ? (
  is_pan_pressed ? (
    gfx_r = 65 / 255; gfx_g = 145 / 255; gfx_b = 200 / 255;
  ) : (
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  );
  fill_roundrect(bx_pan, by_pan, bw_pan, bh_pan, W(3));
  set_border_color(pan_btn_hov);
  gfx_roundrect(bx_pan, by_pan, bw_pan, bh_pan, W(3), 1);
  gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
) : (
  is_pan_pressed ? (
    gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
  ) : (
    gfx_r = 0.16; gfx_g = 0.16; gfx_b = 0.18;
  );
  fill_roundrect(bx_pan, by_pan, bw_pan, bh_pan, W(3));
  set_border_color(pan_btn_hov);
  gfx_roundrect(bx_pan, by_pan, bw_pan, bh_pan, W(3), 1);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
);
gfx_setfont(8, "Inter", sz_btn, 0);
gfx_measurestr("PAN", pan_lbl_w, pan_lbl_h);
gfx_x = bx_pan + floor((bw_pan - pan_lbl_w) * 0.5) + btn_txt_x_off;
gfx_y = by_pan + floor((bh_pan - pan_lbl_h) * 0.5) + btn_txt_y_off + (is_pan_pressed ? 1 : 0);
gfx_drawstr("PAN");

// TIMING mode button
is_timing_pressed = (mouse_cap & 1) && timing_btn_hov;
by_tm = by_top_btn; bh_tm = bh_top_btn;

timing_mode ? (
  is_timing_pressed ? (
    gfx_r = 65 / 255; gfx_g = 145 / 255; gfx_b = 200 / 255;
  ) : (
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  );
  fill_roundrect(bx_tm, by_tm, bw_tm, bh_tm, W(3));
  set_border_color(timing_btn_hov);
  gfx_roundrect(bx_tm, by_tm, bw_tm, bh_tm, W(3), 1);
  gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
) : (
