      chance_mode = 1;
      velocity_mode = 0; gate_mode = 0; pan_mode = 0; timing_mode = 0; ratchet_mode = 0; cond_mode = 0; );
    mouse_clicked = 1; gui_dirty = 1;
  ) :
  cond_btn_hov ? (
