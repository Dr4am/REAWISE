);

// Track row tooltip tracking
row_idx = 0;
while (row_idx < TRACKS_PER_PAGE) (
  tr_t = current_page * 8 + row_idx;
  ry_t = 52 + row_idx * 44;

  m_x >= 52 && m_x <= 72 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    #tt_title = "SOLO";
    info_lang == 0 ? sprintf(#tt_desc, "Traccia %d: Isola l'ascolto di questa traccia escludendo le altre", tr_t + 1)
                   : sprintf(#tt_desc, "Track %d: Solo and isolate playback of this track", tr_t + 1);
  ) :
  m_x >= 76 && m_x <= 96 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    #tt_title = "MUTE";
    info_lang == 0 ? sprintf(#tt_desc, "Traccia %d: Disattiva temporaneamente l'audio di questa traccia", tr_t + 1)
                   : sprintf(#tt_desc, "Track %d: Mute audio output of this track", tr_t + 1);
  ) :
  m_x >= 100 && m_x <= 146 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "CANALE MIDI";
      sprintf(#tt_desc, "Traccia %d: Canale di uscita MIDI (1..16, 0 = ALL). Trascinamento, rotella o click destro per digitare", tr_t + 1);
    ) : (
      #tt_title = "MIDI CHANNEL";
      sprintf(#tt_desc, "Track %d: Output MIDI channel (1..16, 0 = ALL). Drag, wheel or right-click to type", tr_t + 1);
    );
  ) :
  m_x >= 150 && m_x <= 188 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "NOTA";
      sprintf(#tt_desc, "Traccia %d: Nota MIDI. Rotella: note in scala (+/-1), Click Sx + Rotella: ottave (+/-12), Trascinamento, Click Dx per digitare", tr_t + 1);
    ) : (
      #tt_title = "PITCH";
      sprintf(#tt_desc, "Track %d: Output MIDI pitch. Wheel: scale notes (+/-1), Left-Click + Wheel: octaves (+/-12), Drag, Right-click to type", tr_t + 1);
    );
  ) :
  m_x >= 192 && m_x <= 226 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "VELOCITA";
      sprintf(#tt_desc, "Traccia %d: Risoluzione metrica dello step da /16 a x16, default x4. Trascinamento, rotella o click destro per digitare", tr_t + 1);
    ) : (
      #tt_title = "RATE";
      sprintf(#tt_desc, "Track %d: Step metric rate from /16 to x16, default x4. Drag, wheel or right-click to type", tr_t + 1);
    );
  ) :
  m_x >= 230 && m_x <= 268 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "LUNGHEZZA PATTERN";
      sprintf(#tt_desc, "Traccia %d: Numero di step attivi nel loop (1..64). Trascinamento, rotella o click destro per digitare", tr_t + 1);
    ) : (
      #tt_title = "PATTERN LENGTH";
      sprintf(#tt_desc, "Track %d: Active loop steps (1..64). Drag, wheel or right-click to type", tr_t + 1);
    );
  ) :
  m_x >= 272 && m_x <= 310 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "FILL EUCLIDEO";
      sprintf(#tt_desc, "Traccia %d: Numero di impulsi euclidei (0..64, attivo con EUC acceso). Trascinamento, rotella o click destro per digitare", tr_t + 1);
    ) : (
      #tt_title = "EUCLIDEAN FILL";
      sprintf(#tt_desc, "Track %d: Number of Euclidean pulses (0..64, active when EUC is on). Drag, wheel or right-click to type", tr_t + 1);
    );
  ) :
  m_x >= 786 && m_x <= 836 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "DENSITA'";
      sprintf(#tt_desc, "Traccia %d: Densita step (%d%%). Rotella (+/-5%%), Click Sx + Rotella (+/-1%% fine), Click Dx per digitare", tr_t + 1, 1720[tr_t]);
    ) : (
      #tt_title = "DENSITY";
      sprintf(#tt_desc, "Track %d: Step density (%d%%). Wheel (+/-5%%), Left-Click + Wheel (+/-1%% fine), Right-Click to type", tr_t + 1, 1720[tr_t]);
    );
  ) :
  m_x >= 840 && m_x <= 888 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    #tt_title = "SWING";
    info_lang == 0 ? sprintf(#tt_desc, "Traccia %d: Swing sul levare degli step dispari (%+d%%). Rotella (+/-5%%), Click Sx + Rotella (+/-1%% fine), Click Dx per digitare", tr_t + 1, 1740[tr_t])
                   : sprintf(#tt_desc, "Track %d: Off-beat groove swing amount (%+d%%). Wheel (+/-5%%), Left-Click + Wheel (+/-1%% fine), Right-Click to type", tr_t + 1, 1740[tr_t]);
  ) :
  m_x >= 892 && m_x <= 912 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "SPOSTA A SINISTRA";
      sprintf(#tt_desc, "Traccia %d: Scorre il pattern di uno step a sinistra", tr_t + 1);
    ) : (
      #tt_title = "SHIFT LEFT";
      sprintf(#tt_desc, "Track %d: Shift pattern one step left", tr_t + 1);
    );
  ) :
  m_x >= 916 && m_x <= 936 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "SPOSTA A DESTRA";
      sprintf(#tt_desc, "Traccia %d: Scorre il pattern di uno step a destra", tr_t + 1);
    ) : (
      #tt_title = "SHIFT RIGHT";
      sprintf(#tt_desc, "Track %d: Shift pattern one step right", tr_t + 1);
    );
  ) :
  m_x >= 940 && m_x <= 974 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "INVERTI";
      sprintf(#tt_desc, "Traccia %d: Inverte l'ordine temporale degli step", tr_t + 1);
    ) : (
      #tt_title = "REVERSE";
      sprintf(#tt_desc, "Track %d: Reverse step order horizontally", tr_t + 1);
    );
  ) :
  m_x >= 978 && m_x <= 1002 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "CASUALE";
      sprintf(#tt_desc, "Traccia %d: Genera un pattern casuale di step", tr_t + 1);
    ) : (
      #tt_title = "RANDOM";
      sprintf(#tt_desc, "Track %d: Generate random step pattern", tr_t + 1);
    );
  ) :
  m_x >= 1005 && m_x <= 1050 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    pm_t = 1920[tr_t];
    pm_t == 0 ? ( #pm_lbl = (info_lang == 0 ? "Avanti" : "Forward"); ) :
    pm_t == 1 ? ( #pm_lbl = (info_lang == 0 ? "Indietro" : "Reverse"); ) :
    pm_t == 2 ? ( #pm_lbl = (info_lang == 0 ? "Ping Pong" : "Ping Pong"); ) :
                ( #pm_lbl = (info_lang == 0 ? "Stocastica" : "Stochastic"); );
    info_lang == 0 ? (
      #tt_title = "MODALITA' RIPRODUZIONE";
      sprintf(#tt_desc, "Traccia %d: Modo attivo: %s. Trascinamento o rotella per cambiare. Doppio click: reset ad Avanti", tr_t + 1, #pm_lbl);
    ) : (
      #tt_title = "PLAY MODE";
      sprintf(#tt_desc, "Track %d: Active mode: %s. Drag or mouse wheel to change. Double-click to reset to Forward", tr_t + 1, #pm_lbl);
    );
  ) : (
    // 16-step grid tooltip check
    st_i = 0;
    while (st_i < 16) (
      bx_st = screen_grid_x + st_i * box_pitch_px;
      by_st = Y(ry_t + 6);
      mouse_x >= bx_st && mouse_x <= bx_st + box_w_px && mouse_y >= by_st && mouse_y <= by_st + box_h_px ? (
        #tt_title = "STEP";
        tt_g_step = step_page * 16 + st_i;
        tt_s_off = tr_t * 64 + tt_g_step;
        cond_mode ? (
          step_cond_val = 24000[tt_s_off];
          get_cond_str(step_cond_val);
          get_cond_desc(step_cond_val, info_lang);
          sprintf(#tt_title, "COND [%s]", #c_str);
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: %s. Rotella: cambia, Click rotella: reset (---)", tr_t + 1, tt_g_step + 1, #c_desc)
                         : sprintf(#tt_desc, "Track %d, Step %d: %s. Mouse wheel: change, Wheel-click: reset (---)", tr_t + 1, tt_g_step + 1, #c_desc);
        ) :
        chance_mode ? (
          step_chance_val = 22000[tt_s_off];
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: Chance: %d%%. Rotella (+/-5%%), Tasto Destro + Rotella (+/-1%% fine), Click rotella: reset (100%%)", tr_t + 1, tt_g_step + 1, step_chance_val)
                         : sprintf(#tt_desc, "Track %d, Step %d: Chance: %d%%. Wheel (+/-5%%), Right-Click + Wheel (+/-1%% fine), Wheel-click: reset (100%%)", tr_t + 1, tt_g_step + 1, step_chance_val);
        ) :
        ratchet_mode ? (
          step_ratchet = 20000[tt_s_off];
          step_ratchet <= 0 ? step_ratchet = 1;
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: Click/trascina on/off. Rotella mouse per RATCHETING (%d sub-step), click rotella per reset (1)", tr_t + 1, tt_g_step + 1, step_ratchet)
                         : sprintf(#tt_desc, "Track %d, Step %d: Click/drag on/off. Mouse wheel for RATCHETING (%d sub-steps), wheel-click to reset (1)", tr_t + 1, tt_g_step + 1, step_ratchet);
        ) :
        timing_mode ? (
          step_timing = 18000[tt_s_off];
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: Micro Timing: %+d%%. Rotella (+/-5%%), Tasto Destro + Rotella (+/-1%% fine), Click rotella: reset (0%%)", tr_t + 1, tt_g_step + 1, step_timing)
                         : sprintf(#tt_desc, "Track %d, Step %d: Micro Timing: %+d%%. Wheel (+/-5%%), Right-Click + Wheel (+/-1%% fine), Wheel-click: reset (0%%)", tr_t + 1, tt_g_step + 1, step_timing);
        ) :
        pan_mode ? (
          step_pan = 14000[tt_s_off];
          step_pan <= 0 && step_pan != 0 ? step_pan = 64;
          step_pan == 64 ? ( #p_str = "C"; ) :
          step_pan > 64 ? ( sprintf(#p_str, "+%d", step_pan - 64); ) :
                          ( sprintf(#p_str, "%d", step_pan - 64); );
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: Pan: %s. Rotella (+/-5), Tasto Destro + Rotella (+/-1 fine), Click rotella: reset (C)", tr_t + 1, tt_g_step + 1, #p_str)
                         : sprintf(#tt_desc, "Track %d, Step %d: Pan: %s. Wheel (+/-5), Right-Click + Wheel (+/-1 fine), Wheel-click: reset (C)", tr_t + 1, tt_g_step + 1, #p_str);
        ) :
        gate_mode ? (
          step_gate_idx = 16000[tt_s_off];
          (step_gate_idx < 0 || step_gate_idx > 68) ? step_gate_idx = 4;
          get_elektron_gate_full_str(step_gate_idx);
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: Click/trascina on/off. Rotella mouse per GATE (%s step), click rotella per reset (1)", tr_t + 1, tt_g_step + 1, #g_full_str)
                         : sprintf(#tt_desc, "Track %d, Step %d: Click/drag on/off. Mouse wheel for GATE (%s steps), wheel-click to reset (1)", tr_t + 1, tt_g_step + 1, #g_full_str);
        ) :
        velocity_mode ? (
          step_vel = 12000[tt_s_off];
          step_vel <= 0 ? step_vel = 100;
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: Velocity: %d. Rotella (+/-5), Tasto Destro + Rotella (+/-1 fine), Click rotella: reset (100)", tr_t + 1, tt_g_step + 1, step_vel)
                         : sprintf(#tt_desc, "Track %d, Step %d: Velocity: %d. Wheel (+/-5), Right-Click + Wheel (+/-1 fine), Wheel-click: reset (100)", tr_t + 1, tt_g_step + 1, step_vel);
        ) : (
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: Click o trascinamento per attivare/disattivare lo step", tr_t + 1, tt_g_step + 1)
                         : sprintf(#tt_desc, "Track %d, Step %d: Click or drag to toggle step on/off", tr_t + 1, tt_g_step + 1);
        );
      );
      st_i += 1;
    );
  );

  row_idx += 1;
);

// Background tooltip
strlen(#tt_title) == 0 && !is_on_ctrl && m_x >= 44 ? (
  info_lang == 0 ? (
    #tt_title = "SYNC PLAYHEAD";
    #tt_desc = "Fai click destro sullo sfondo per aprire il menu e regolare l'offset di sincronizzazione del playhead in caso di necessita.";
  ) : (
    #tt_title = "PLAYHEAD SYNC";
    #tt_desc = "Right-click on the background to open the menu and adjust playhead sync offset if needed.";
  );
);

// Floating tooltip box rendering
info_mode && strlen(#tt_title) > 0 ? (
  gfx_setfont(5, "Inter", sz_tt_title, 'B');
  gfx_measurestr(#tt_title, tt_t_w, tt_t_h);
  gfx_setfont(6, "Inter", sz_tt_desc, 'B');
  gfx_measurestr(#tt_desc, tt_d_w, tt_d_h);

  tt_content_w = max(tt_t_w, tt_d_w);
  tt_pad_x = W(14);
  tt_pad_y = H(8);
  tt_box_w = tt_content_w + tt_pad_x * 2;
  tt_box_h = tt_t_h + tt_d_h + tt_pad_y * 2 + H(4);

  // Position tooltip near cursor
  tt_draw_x = mouse_x + W(16);
  tt_draw_y = mouse_y + H(18);

  tt_draw_x + tt_box_w > cur_w - W(12) ? (
    tt_draw_x = mouse_x - tt_box_w - W(12);
  );
  tt_draw_x < W(10) ? tt_draw_x = W(10);

  tt_draw_y + tt_box_h > cur_h - H(12) ? (
    tt_draw_y = mouse_y - tt_box_h - H(12);
  );
  tt_draw_y < H(10) ? tt_draw_y = H(10);

  gfx_r = 14 / 255.0; gfx_g = 14 / 255.0; gfx_b = 18 / 255.0;
  fill_roundrect(tt_draw_x, tt_draw_y, tt_box_w, tt_box_h, W(4));
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  gfx_roundrect(tt_draw_x, tt_draw_y, tt_box_w, tt_box_h, W(4), 1);

  gfx_setfont(5, "Inter", sz_tt_title, 'b');
  gfx_x = tt_draw_x + tt_pad_x;
  gfx_y = tt_draw_y + tt_pad_y;
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  gfx_drawstr(#tt_title);

  gfx_setfont(6, "Inter", sz_tt_desc, 'b');
  gfx_x = tt_draw_x + tt_pad_x;
  gfx_y = tt_draw_y + tt_pad_y + tt_t_h + H(4);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
  gfx_drawstr(#tt_desc);
  gfx_setfont(1, "Inter", sz_main, 'b');
);
