// Sidebar divider lines
gfx_r = 64 / 255.0; gfx_g = 64 / 255.0; gfx_b = 64 / 255.0;
gfx_line(X(6), Y(82), X(38), Y(82));
gfx_line(X(6), Y(227), X(38), Y(227));
gfx_line(X(6), Y(278), X(38), Y(278));
gfx_line(X(6), Y(381), X(38), Y(381));

// "TRACK" sidebar header
gfx_setfont(8, "Inter", sz_btn, 0);
gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;

gfx_measurestr("T", t1_w, trk_h);
gfx_measurestr("R", t2_w, trk_h);
gfx_measurestr("A", t3_w, trk_h);
gfx_measurestr("C", t4_w, trk_h);
gfx_measurestr("K", t5_w, trk_h);

trk_track = max(1, floor(1.2 * scale_font));
tot_trk_w = t1_w + t2_w + t3_w + t4_w + t5_w + trk_track * 4;

start_trk_x = floor((sb_w - tot_trk_w) * 0.5);
start_trk_y = Y(4) + floor((H(12) - trk_h) * 0.5) + sb_txt_y_off;

gfx_x = start_trk_x; gfx_y = start_trk_y; gfx_drawstr("T");
gfx_x = start_trk_x + t1_w + trk_track; gfx_y = start_trk_y; gfx_drawstr("R");
gfx_x = start_trk_x + t1_w + t2_w + trk_track * 2; gfx_y = start_trk_y; gfx_drawstr("A");
gfx_x = start_trk_x + t1_w + t2_w + t3_w + trk_track * 3; gfx_y = start_trk_y; gfx_drawstr("C");
gfx_x = start_trk_x + t1_w + t2_w + t3_w + t4_w + trk_track * 4; gfx_y = start_trk_y; gfx_drawstr("K");

// 1. 12-note keyboard (X: 52..146, Y: 12..36, W: 94, H: 24)
bx_kb = X(52); bw_kb = W(94); by_kb = Y(12); bh_kb = H(24);
bh_bk = max(8, floor(bh_kb * 0.60));
bw_bk = max(6, floor(bw_kb * 0.09));
bw_bk_half = floor(bw_bk * 0.5);

// Hover key calculation (0..11)
hov_key = -1;

kb_hov ? (
  rel_x = m_x - 52;
  rel_y = m_y - 12;
  rel_y <= bh_bk ? (
    (rel_x >= 9 && rel_x <= 18) ? hov_key = 1 :
    (rel_x >= 22 && rel_x <= 31) ? hov_key = 3 :
    (rel_x >= 49 && rel_x <= 58) ? hov_key = 6 :
    (rel_x >= 63 && rel_x <= 72) ? hov_key = 8 :
    (rel_x >= 76 && rel_x <= 85) ? hov_key = 10;
  );
  hov_key < 0 ? (
    wk_i_hov = floor(rel_x * 7.0 / 94.0);
    wk_i_hov = min(6, max(0, wk_i_hov));
    wk_i_hov == 0 ? hov_key = 0 :
    wk_i_hov == 1 ? hov_key = 2 :
    wk_i_hov == 2 ? hov_key = 4 :
    wk_i_hov == 3 ? hov_key = 5 :
    wk_i_hov == 4 ? hov_key = 7 :
    wk_i_hov == 5 ? hov_key = 9 : hov_key = 11;
  );
);

// White keys (7)
kb_rad = max(2, floor(bh_kb * 0.15));
wk_i = 0;
while (wk_i < 7) (
  wk_x = bx_kb + floor(wk_i * bw_kb / 7.0);
  wk_x_next = bx_kb + floor((wk_i + 1) * bw_kb / 7.0);
  wk_w = wk_x_next - wk_x;
  wk_note = (wk_i == 0 ? 0 : wk_i == 1 ? 2 : wk_i == 2 ? 4 : wk_i == 3 ? 5 : wk_i == 4 ? 7 : wk_i == 5 ? 9 : 11);
  wk_active = (4000[wk_note] == 1);
  wk_is_hov = (hov_key == wk_note);
  wk_is_pressed = (mouse_cap & 1) && wk_is_hov;

  wk_is_pressed ? (
    // Sunken pressed state on click
    wk_active ? (
      gfx_r = 60 / 255.0; gfx_g = 150 / 255.0; gfx_b = 210 / 255.0;
    ) : (
      gfx_r = 165 / 255.0; gfx_g = 168 / 255.0; gfx_b = 175 / 255.0;
    );
  ) : (
    wk_active ? (
      wk_is_hov ? (
        gfx_r = 120 / 255.0; gfx_g = 203 / 255.0; gfx_b = 254 / 255.0;
      ) : (
        gfx_r = 92 / 255.0; gfx_g = 193 / 255.0; gfx_b = 254 / 255.0;
      );
    ) : (
      wk_is_hov ? (
        gfx_r = 224 / 255.0; gfx_g = 224 / 255.0; gfx_b = 224 / 255.0;
      ) : (
        gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
      );
    );
  );

  wk_i == 0 ? (
    fill_left_roundrect(wk_x, by_kb, wk_w, bh_kb, kb_rad);
  ) :
  wk_i == 6 ? (
    fill_right_roundrect(wk_x, by_kb, wk_w, bh_kb, kb_rad);
  ) : (
    gfx_rect(wk_x, by_kb, wk_w, bh_kb);
  );

  // Bevel tactile depth on white keys
  wk_is_pressed ? (
    // Top shadow showing key depressed into keyboard chassis
    gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.40;
    gfx_line(wk_x + (wk_i == 0 ? kb_rad : 1), by_kb + 1, wk_x + wk_w - (wk_i == 6 ? kb_rad : 1), by_kb + 1);
    gfx_line(wk_x + (wk_i == 0 ? kb_rad : 1), by_kb + 2, wk_x + wk_w - (wk_i == 6 ? kb_rad : 1), by_kb + 2);
    gfx_a = 1.0;
  ) : (
    // Subtle top reflection highlight
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_a = wk_is_hov ? 0.35 : 0.20;
    gfx_line(wk_x + (wk_i == 0 ? kb_rad : 1), by_kb + 1, wk_x + wk_w - (wk_i == 6 ? kb_rad : 1), by_kb + 1);
    // Subtle bottom edge lip
    gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.25;
    gfx_line(wk_x + (wk_i == 0 ? kb_rad : 1), by_kb + bh_kb - 1, wk_x + wk_w - (wk_i == 6 ? kb_rad : 1), by_kb + bh_kb - 1);
    gfx_a = 1.0;
  );

  wk_i > 0 ? (
    gfx_r = 50 / 255.0; gfx_g = 50 / 255.0; gfx_b = 55 / 255.0;
    gfx_rect(wk_x, by_kb, 1, bh_kb);
  );
  wk_i += 1;
);

// Black keys (5)
bk_i = 0;
while (bk_i < 5) (
  bk_i == 0 ? ( bk_boundary = 1; bk_note = 1; ) :
  bk_i == 1 ? ( bk_boundary = 2; bk_note = 3; ) :
  bk_i == 2 ? ( bk_boundary = 4; bk_note = 6; ) :
  bk_i == 3 ? ( bk_boundary = 5; bk_note = 8; ) :
              ( bk_boundary = 6; bk_note = 10; );

  bk_center_x = bx_kb + floor(bk_boundary * bw_kb / 7.0);
  bk_x = bk_center_x - bw_bk_half;
  bk_active = (4000[bk_note] == 1);
  bk_is_hov = (hov_key == bk_note);
  bk_is_pressed = (mouse_cap & 1) && bk_is_hov;

  bk_is_pressed ? (
    // Sunken pressed state
    bk_active ? (
      gfx_r = 25 / 255.0; gfx_g = 80 / 255.0; gfx_b = 130 / 255.0;
    ) : (
      gfx_r = 10 / 255.0; gfx_g = 10 / 255.0; gfx_b = 12 / 255.0;
    );
  ) : (
    bk_active ? (
      bk_is_hov ? (
        gfx_r = 53 / 255.0; gfx_g = 132 / 255.0; gfx_b = 203 / 255.0;
      ) : (
        gfx_r = 40 / 255.0; gfx_g = 110 / 255.0; gfx_b = 170 / 255.0;
      );
    ) : (
      bk_is_hov ? (
        gfx_r = 40 / 255.0; gfx_g = 40 / 255.0; gfx_b = 46 / 255.0;
      ) : (
        gfx_r = 18 / 255.0; gfx_g = 18 / 255.0; gfx_b = 20 / 255.0;
      );
    );
  );

  gfx_rect(bk_x, by_kb, bw_bk, bh_bk);

  bk_is_pressed ? (
    // Top shadow inside depressed black key
    gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.60;
    gfx_line(bk_x, by_kb + 1, bk_x + bw_bk - 1, by_kb + 1);
    gfx_line(bk_x, by_kb + 2, bk_x + bw_bk - 1, by_kb + 2);
    gfx_a = 1.0;
    bk_active ? (
      gfx_r = 30 / 255.0; gfx_g = 90 / 255.0; gfx_b = 150 / 255.0;
    ) : (
      gfx_r = 25 / 255.0; gfx_g = 25 / 255.0; gfx_b = 28 / 255.0;
    );
  ) : (
    // Raised highlight on top edge
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    gfx_a = bk_is_hov ? 0.30 : 0.18;
    gfx_line(bk_x, by_kb + 1, bk_x + bw_bk - 1, by_kb + 1);

    // Drop shadow beneath black key on top of white key
    gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.50;
    gfx_line(bk_x, by_kb + bh_bk, bk_x + bw_bk - 1, by_kb + bh_bk);
    gfx_a = 1.0;

    bk_active ? (
      gfx_r = 65 / 255.0; gfx_g = 145 / 255.0; gfx_b = 210 / 255.0;
    ) : (
      gfx_r = 45 / 255.0; gfx_g = 45 / 255.0; gfx_b = 50 / 255.0;
    );
  );
  gfx_roundrect(bk_x, by_kb, bw_bk, bh_bk, 0, 1);
  bk_i += 1;
);

// Fixed border
set_border_color(0);
gfx_roundrect(bx_kb, by_kb, bw_kb, bh_kb, kb_rad, 1);

// 2. Root Note box (X: 150..188, Y: 12..36, W: 38, H: 24)
bx_root = X(150); bw_root = W(38); by_root = Y(12); bh_root = H(24);
quant_root == 0 ? #root_str = "C" :
quant_root == 1 ? #root_str = "C#" :
quant_root == 2 ? #root_str = "D" :
quant_root == 3 ? #root_str = "D#" :
quant_root == 4 ? #root_str = "E" :
quant_root == 5 ? #root_str = "F" :
quant_root == 6 ? #root_str = "F#" :
quant_root == 7 ? #root_str = "G" :
quant_root == 8 ? #root_str = "G#" :
quant_root == 9 ? #root_str = "A" :
quant_root == 10 ? #root_str = "A#" : #root_str = "B";

draw_display_val(bx_root, by_root, bw_root, bh_root, W(3), root_hov, (edit_active == 11), 9, #root_str, 92 / 255, 193 / 255, 254 / 255, 0);

// 3. Scale box (X: 192..310, Y: 12..36, W: 118, H: 24)
bx_scale = X(192); bw_scale = W(118); by_scale = Y(12); bh_scale = H(24);
get_scale_name(quant_scale);
draw_display_scale(bx_scale, by_scale, bw_scale, bh_scale, W(3), scale_hov, #sc_name);

btn_txt_x_off = max(1, floor(1 * sx));
btn_txt_y_off = max(1, floor(1 * sy));

// VELOCITY mode button
is_vel_pressed = (captured_btn_id == 1 && vel_btn_hov);
draw_button(bx_vel, by_top_btn, bw_vel, bh_top_btn, W(3), "VELOCITY", 8, velocity_mode, is_vel_pressed, vel_btn_hov, 0, 92 / 255, 193 / 255, 254 / 255, max(1, floor(1 * sx)));

// GATE mode button
is_gate_pressed = (captured_btn_id == 2 && gate_btn_hov);
draw_button(bx_gate, by_top_btn, bw_gate, bh_top_btn, W(3), "GATE", 8, gate_mode, is_gate_pressed, gate_btn_hov, 0, 92 / 255, 193 / 255, 254 / 255, max(1, floor(1 * sx)));

// PAN mode button
is_pan_pressed = (captured_btn_id == 3 && pan_btn_hov);
draw_button(bx_pan, by_top_btn, bw_pan, bh_top_btn, W(3), "PAN", 8, pan_mode, is_pan_pressed, pan_btn_hov, 0, 92 / 255, 193 / 255, 254 / 255, max(1, floor(1 * sx)));

// TIMING mode button
is_timing_pressed = (captured_btn_id == 4 && timing_btn_hov);
draw_button(bx_tm, by_top_btn, bw_tm, bh_top_btn, W(3), "TIMING", 8, timing_mode, is_timing_pressed, timing_btn_hov, 0, 92 / 255, 193 / 255, 254 / 255, max(1, floor(1 * sx)));

// RATCHETING mode button
is_ratchet_pressed = (captured_btn_id == 5 && ratchet_btn_hov);
draw_button(bx_rt, by_top_btn, bw_rt, bh_top_btn, W(3), "RATCHETING", 8, ratchet_mode, is_ratchet_pressed, ratchet_btn_hov, 0, 92 / 255, 193 / 255, 254 / 255, max(1, floor(1 * sx)));

// CHANCE mode button
is_chance_pressed = (captured_btn_id == 6 && chance_btn_hov);
draw_button(bx_chance_mode, by_top_btn, bw_chance_mode, bh_top_btn, W(3), "CHANCE", 8, chance_mode, is_chance_pressed, chance_btn_hov, 0, 92 / 255, 193 / 255, 254 / 255, max(1, floor(1 * sx)));

// COND mode button
is_cond_pressed = (captured_btn_id == 7 && cond_btn_hov);
draw_button(bx_cnd_btn, by_top_btn, bw_cnd_btn, bh_top_btn, W(3), "COND", 8, cond_mode, is_cond_pressed, cond_btn_hov, 0, 92 / 255, 193 / 255, 254 / 255, max(1, floor(1 * sx)));

// =====================================================================
// Per-track LFO strip (top bar right, 7 boxes)
// =====================================================================
// 1. LFO Track selector [ 1..16 ]
bw_lfo_tr = bw_lfo;
lfo_tr_hov = mouse_x >= bx_lfo_tr && mouse_x <= bx_lfo_tr + bw_lfo_tr && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
sprintf(#lfo_tr_str, "T %d", lfo_cur_tr + 1);
draw_display_val(bx_lfo_tr, by_lfo, bw_lfo_tr, bh_lfo, W(3), lfo_tr_hov, (edit_active == 10), 8, #lfo_tr_str, 92 / 255, 193 / 255, 254 / 255, btn_txt_y_off);

// 2. LFO waveform is drawn over the cached interface below.

// 3. SYNC / FREQ toggle button
bw_lfo_sy = bw_lfo;
lfo_sy_hov = mouse_x >= bx_lfo_sy && mouse_x <= bx_lfo_sy + bw_lfo_sy && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
is_lfo_sy_pressed = (captured_btn_id == 24 && lfo_sy_hov);
is_sync_active = 4520[lfo_cur_tr];
#lfo_sy_str = is_sync_active ? "SYNC" : "FREQ";
draw_button(bx_lfo_sy, by_lfo, bw_lfo_sy, bh_lfo, W(3), #lfo_sy_str, 8, 0, is_lfo_sy_pressed, lfo_sy_hov, 0, 92 / 255, 193 / 255, 254 / 255, btn_txt_x_off);

// 4. LFO Rate / Frequency [ 1/2 ]
bw_lfo_rt = bw_lfo;
lfo_rt_hov = mouse_x >= bx_lfo_rt && mouse_x <= bx_lfo_rt + bw_lfo_rt && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
is_sync_active ? (
  get_lfo_sync_str(4540[lfo_cur_tr], 4700[lfo_cur_tr]);
  strcpy(#lfo_rt_display, #lfo_s_str);
) : (
  sprintf(#lfo_rt_display, "%.2f", 4560[lfo_cur_tr]);
);
draw_display_val(bx_lfo_rt, by_lfo, bw_lfo_rt, bh_lfo, W(3), lfo_rt_hov, (edit_active == 9 && edit_tr == lfo_cur_tr), 8, #lfo_rt_display, 92 / 255, 193 / 255, 254 / 255, btn_txt_y_off);

// 5. Retrigger button [ RTG ]
bw_lfo_tg = bw_lfo;
lfo_tg_hov = mouse_x >= bx_lfo_tg && mouse_x <= bx_lfo_tg + bw_lfo_tg && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
is_lfo_tg_pressed = (captured_btn_id == 25 && lfo_tg_hov);
is_rtg_active = 4580[lfo_cur_tr];
draw_button(bx_lfo_tg, by_lfo, bw_lfo_tg, bh_lfo, W(3), "RTG", 8, is_rtg_active, is_lfo_tg_pressed, lfo_tg_hov, 0, 92 / 255, 193 / 255, 254 / 255, btn_txt_x_off);

// 6. LFO Destination box [ VEL / OFF ]
bw_lfo_ds = bw_lfo;
lfo_ds_hov = mouse_x >= bx_lfo_ds && mouse_x <= bx_lfo_ds + bw_lfo_ds && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
cur_lfo_dst = 4600[lfo_cur_tr];
(cur_lfo_dst >= 13 && cur_lfo_dst <= 60 && floor((cur_lfo_dst - 13) / 3) == lfo_cur_tr) ? (
  4600[lfo_cur_tr] = 0;
  cur_lfo_dst = 0;
);

get_lfo_dest_str(cur_lfo_dst);

cur_lfo_dst == 0 ? (
  dst_r = 50 / 255.0; dst_g = 105 / 255.0; dst_b = 140 / 255.0;
) : (
  dst_r = 92 / 255; dst_g = 193 / 255; dst_b = 254 / 255;
);
cur_lfo_dst == 67 ? (
  // Slight optical adjustment for the M-GT label.
  draw_display_frame(bx_lfo_ds, by_lfo, bw_lfo_ds, bh_lfo, W(3), lfo_ds_hov);
  gfx_setfont(8, "Inter", sz_btn, 0);
  gfx_measurestr(#lfo_d_str, lfo_dst_text_w, lfo_dst_text_h);
  gfx_r = dst_r; gfx_g = dst_g; gfx_b = dst_b;
  gfx_x = bx_lfo_ds + floor((bw_lfo_ds - lfo_dst_text_w) * 0.5) + max(1, floor(sx));
  gfx_y = by_lfo + floor((bh_lfo - lfo_dst_text_h) * 0.5) + btn_txt_y_off;
  gfx_drawstr(#lfo_d_str);
) : (
  draw_display_val(bx_lfo_ds, by_lfo, bw_lfo_ds, bh_lfo, W(3), lfo_ds_hov, 0, 8, #lfo_d_str, dst_r, dst_g, dst_b, btn_txt_y_off);
);

// 7. LFO Amount / Depth box [ 100% ]
bw_lfo_am = bw_lfo;
lfo_am_hov = mouse_x >= bx_lfo_am && mouse_x <= bx_lfo_am + bw_lfo_am && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
sprintf(#lfo_am_str, "%d%%", 4620[lfo_cur_tr]);
draw_display_val(bx_lfo_am, by_lfo, bw_lfo_am, bh_lfo, W(3), lfo_am_hov, (edit_active == 8 && edit_tr == lfo_cur_tr), 8, #lfo_am_str, 92 / 255, 193 / 255, 254 / 255, btn_txt_y_off);
// Track page buttons (1-8 and 9-16)
p0_active = (current_page == 0);
is_p0_pressed = (captured_btn_id == 8 && p0_hov);
draw_button(X(4), Y(20), W(36), H(22), W(3), "1-8", 8, p0_active, is_p0_pressed, p0_hov, 0, 92 / 255, 193 / 255, 254 / 255, 0);

p1_active = (current_page == 1);
is_p1_pressed = (captured_btn_id == 9 && p1_hov);
draw_button(X(4), Y(46), W(36), H(22), W(3), "9-16", 8, p1_active, is_p1_pressed, p1_hov, 0, 92 / 255, 193 / 255, 254 / 255, 0);
// STEP sidebar header
gfx_setfont(8, "Inter", sz_btn, 0);
gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;

gfx_measurestr("S", s1_w, stp_h);
gfx_measurestr("T", s2_w, stp_h);
gfx_measurestr("E", s3_w, stp_h);
gfx_measurestr("P", s4_w, stp_h);

stp_track = max(1, floor(1.2 * scale_font));
tot_stp_w = s1_w + s2_w + s3_w + s4_w + stp_track * 3;

start_stp_x = floor((sb_w - tot_stp_w) * 0.5);
start_stp_y = Y(97) + floor((H(12) - stp_h) * 0.5) + sb_txt_y_off;

gfx_x = start_stp_x; gfx_y = start_stp_y; gfx_drawstr("S");
gfx_x = start_stp_x + s1_w + stp_track; gfx_y = start_stp_y; gfx_drawstr("T");
gfx_x = start_stp_x + s1_w + s2_w + stp_track * 2; gfx_y = start_stp_y; gfx_drawstr("E");
gfx_x = start_stp_x + s1_w + s2_w + s3_w + stp_track * 3; gfx_y = start_stp_y; gfx_drawstr("P");

// Step page buttons (1-16, 17-32, 33-48, 49-64)
// Page 1-16
is_sp0_pressed = (captured_btn_id == 10 && sp0_hov);
draw_button(X(4), Y(113), W(36), H(22), W(3), "1-16", 8, step_page == 0, is_sp0_pressed, sp0_hov, 0, 92 / 255, 193 / 255, 254 / 255, 0);

// Page 17-32
is_sp1_pressed = (captured_btn_id == 11 && sp1_hov);
draw_button(X(4), Y(139), W(36), H(22), W(3), "17-32", 8, step_page == 1, is_sp1_pressed, sp1_hov, 0, 92 / 255, 193 / 255, 254 / 255, 0);

// Page 33-48
is_sp2_pressed = (captured_btn_id == 12 && sp2_hov);
draw_button(X(4), Y(165), W(36), H(22), W(3), "33-48", 8, step_page == 2, is_sp2_pressed, sp2_hov, 0, 92 / 255, 193 / 255, 254 / 255, 0);

// Page 49-64
is_sp3_pressed = (captured_btn_id == 13 && sp3_hov);
draw_button(X(4), Y(191), W(36), H(22), W(3), "49-64", 8, step_page == 3, is_sp3_pressed, sp3_hov, 0, 92 / 255, 193 / 255, 254 / 255, 0);

// EUC button
is_euc_pressed = (captured_btn_id == 14 && euc_hov);
draw_button(X(4), Y(242), W(36), H(22), W(3), "EUC", 8, euc_mode, is_euc_pressed, euc_hov, 0, 92 / 255, 193 / 255, 254 / 255, 0);

// UNDO, REDO, DEL buttons
// 1. UNDO button
is_undo_pressed = (captured_btn_id == 15 && undo_hov);
draw_button(X(4), Y(293), W(36), H(22), W(3), "UNDO", 8, 0, is_undo_pressed, undo_hov, undo_count <= 0, 92 / 255, 193 / 255, 254 / 255, 0);

// 2. REDO button
is_redo_pressed = (captured_btn_id == 16 && redo_hov);
draw_button(X(4), Y(319), W(36), H(22), W(3), "REDO", 8, 0, is_redo_pressed, redo_hov, redo_count <= 0, 92 / 255, 193 / 255, 254 / 255, 0);

// 3. DEL button (clear grid)
is_del_pressed = (captured_btn_id == 17 && del_hov);
draw_button(X(4), Y(345), W(36), H(22), W(3), "DEL", 8, 0, is_del_pressed, del_hov, 0, 235 / 255.0, 55 / 255.0, 75 / 255.0, 0);

// TIPS and Language selector
// 1. TIPS button
is_info_pressed = (captured_btn_id == 18 && info_hov);
draw_button(X(4), Y(396), W(36), H(22), W(3), "TIPS", 8, info_mode, is_info_pressed, info_hov, 0, 92 / 255, 193 / 255, 254 / 255, 0);

// 2. Language button (ITA / ENG)
info_lang == 0 ? #lang_str = "ITA" : #lang_str = "ENG";
is_lang_pressed = (captured_btn_id == 19 && lang_hov);
draw_button(X(4), Y(422), W(36), H(22), W(3), #lang_str, 8, 0, is_lang_pressed, lang_hov, 0, 92 / 255, 193 / 255, 254 / 255, 0);
gfx_setfont(1, "Inter", sz_main, 'B');

// Vertical drag adjustments
mouse_cap & 1 ? (
  drag_mode > 0 ? (
    delta = drag_start_y - m_y;
    drag_mode == 1 ? (
      abs(delta) >= 6 ? (
        step_delta = delta > 0 ? floor(delta / 6) : -floor(-delta / 6);
        dir = (step_delta > 0) ? 1 : -1;
        cnt = abs(step_delta);
        p_val = 1600[drag_tr];
        k_d = 0;
        while (k_d < cnt) (
          p_val = get_next_scale_pitch(p_val, dir);
          k_d += 1;
        );
        p_val != 1600[drag_tr] ? (
          !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
          1600[drag_tr] = p_val;
          save_pattern_to_mem(active_edit_pat);
        );
        drag_start_y = m_y;
      );
    ) :
    drag_mode == 2 ? (
      new_ch = min(16, max(0, drag_start_val - floor(delta / 8)));
      new_ch != 1620[drag_tr] ? (
        !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
        1620[drag_tr] = new_ch;
        save_pattern_to_mem(active_edit_pat);
      );
    ) :
    drag_mode == 3 ? (
      new_rate = min(10, max(0, drag_start_val + floor(delta / 12)));
      new_rate != 1640[drag_tr] ? (
        !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
        1640[drag_tr] = new_rate;
        save_pattern_to_mem(active_edit_pat);
      );
    ) :
    drag_mode == 4 ? (
      new_len = min(64, max(1, drag_start_val + floor(delta / 6)));
      new_len != 1660[drag_tr] ? (
        !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
        1660[drag_tr] = new_len;
        1860[drag_tr] > 1660[drag_tr] ? 1860[drag_tr] = 1660[drag_tr];
        euc_mode ? apply_euclidean_track(drag_tr);
        save_pattern_to_mem(active_edit_pat);
      );
    ) :
    drag_mode == 5 ? (
      abs(delta) >= 2 ? (
        step_delta = delta > 0 ? floor(delta / 2) : -floor(-delta / 2);
        2100[drag_tr] == 0 ? (
          new_val = min(100, max(0, 1940[drag_tr] + step_delta));
          new_val != 1940[drag_tr] ? (
            !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
            1940[drag_tr] = new_val;
            save_pattern_to_mem(active_edit_pat);
          );
        ) : (
          new_val = min(100, max(0, 1720[drag_tr] + step_delta));
          new_val != 1720[drag_tr] ? (
            !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
            1720[drag_tr] = new_val;
            save_pattern_to_mem(active_edit_pat);
          );
        );
        drag_start_y = m_y;
      );
    ) :
    drag_mode == 6 ? (
      abs(delta) >= 2 ? (
        step_delta = delta > 0 ? floor(delta / 2) : -floor(-delta / 2);
        2140[drag_tr] == 2 ? (
          new_val = min(100, max(-100, 2160[drag_tr] + step_delta));
          new_val != 2160[drag_tr] ? (
            !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
            2160[drag_tr] = new_val;
            save_pattern_to_mem(active_edit_pat);
          );
        ) : 2140[drag_tr] == 1 ? (
          new_val = min(100, max(-100, 2120[drag_tr] + step_delta));
          new_val != 2120[drag_tr] ? (
            !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
            2120[drag_tr] = new_val;
            save_pattern_to_mem(active_edit_pat);
          );
        ) : (
          new_val = min(100, max(-100, 1740[drag_tr] + step_delta));
          new_val != 1740[drag_tr] ? (
            !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
            1740[drag_tr] = new_val;
            save_pattern_to_mem(active_edit_pat);
          );
        );
        drag_start_y = m_y;
      );
    ) :
    drag_mode == 7 ? (
      cur_l = 1660[drag_tr];
      cur_l <= 0 ? cur_l = 16;
      cur_l > 64 ? cur_l = 64;
      new_f = min(cur_l, max(0, drag_start_val + floor(delta / 6)));
      new_f != 1860[drag_tr] ? (
        !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
        1860[drag_tr] = new_f;
        euc_mode ? apply_euclidean_track(drag_tr);
        save_pattern_to_mem(active_edit_pat);
      );
    ) :
    drag_mode == 8 ? (
      abs(delta) >= 8 ? (
        step_delta = delta > 0 ? floor(delta / 8) : -floor(-delta / 8);
        step_delta != 0 ? (
          !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
          set_quant_root(quant_root + step_delta);
        );
        drag_start_y = m_y;
      );
    ) :
    drag_mode == 9 ? (
      abs(delta) >= 6 ? (
        step_delta = delta < 0 ? 1 : -1;
        next_s = quant_scale == 99 ? 0 : (quant_scale + step_delta);
        next_s = min(53, max(0, next_s));
        next_s != quant_scale ? (
          !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
          set_quant_scale(next_s);
        );
        drag_start_y = m_y;
      );
    ) :
    drag_mode == 10 ? (
      abs(delta) >= 8 ? (
        step_delta = delta < 0 ? 1 : -1;
        new_pm = min(3, max(0, 1920[drag_tr] + step_delta));
        new_pm != 1920[drag_tr] ? (
          !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
          1920[drag_tr] = new_pm;
          save_pattern_to_mem(active_edit_pat);
          gui_dirty = 1;
        );
        drag_start_y = m_y;
      );
    ) :
    drag_mode == 11 ? (
      4520[lfo_cur_tr] ? (
        new_s = min(11, max(0, floor(drag_start_val + delta / 10)));
        new_s != 4540[lfo_cur_tr] ? (
          !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
          4540[lfo_cur_tr] = new_s;
        );
      ) : (
new_hz = floor((drag_start_val + delta * 0.01) * 100 + 0.5) / 100.0;
        new_hz = min(20.0, max(0.01, new_hz));
        new_hz != 4560[lfo_cur_tr] ? (
          !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
          4560[lfo_cur_tr] = new_hz;
        );
      );
      gui_dirty = 1;
    ) :
    drag_mode == 12 ? (
      new_shp = min(5, max(0, floor(drag_start_val - delta / 12)));
      new_shp != 4500[lfo_cur_tr] ? (
        !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
        4500[lfo_cur_tr] = new_shp;
      );
      gui_dirty = 1;
    ) :
    drag_mode == 14 ? (
      abs(delta) >= 8 ? (
        step_delta = delta > 0 ? 1 : -1;
        new_dst = get_next_lfo_dest(4600[lfo_cur_tr], step_delta, lfo_cur_tr);
        new_dst != 4600[lfo_cur_tr] ? (
          !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
          4600[lfo_cur_tr] = new_dst;
        );
        drag_start_y = m_y;
      );
      gui_dirty = 1;
    ) :
    drag_mode == 15 ? (
      step_scale = (mouse_cap & 8) ? 0.2 : 0.75;
      new_am = min(100, max(0, floor(drag_start_val + delta * step_scale + 0.5)));
      new_am != 4620[lfo_cur_tr] ? (
        !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
        4620[lfo_cur_tr] = new_am;
      );
      gui_dirty = 1;
    ) :
    drag_mode == 16 ? (
      lfo_cur_tr = min(15, max(0, floor(drag_start_val - delta / 10)));
      gui_dirty = 1;
    ) :
    drag_mode == 18 ? (
      abs(delta) >= 10 ? (
        step_delta = delta > 0 ? 1 : -1;
        transpose_all_tracks(step_delta * 12, 1);
        drag_start_y = m_y;
        gui_dirty = 1;
      );
    ) :
    drag_mode == 19 ? (
      abs(delta) >= 8 ? (
        step_delta = delta > 0 ? 1 : -1;
        transpose_all_tracks(step_delta, 0);
        drag_start_y = m_y;
        gui_dirty = 1;
      );
    ) :
    drag_mode == 20 ? (
      step_scale = 0.6;
      new_mv = min(100, max(0, floor(drag_start_val + delta * step_scale + 0.5)));
      new_mv != master_vol ? (
        !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
        master_vol = new_mv;
      );
      gui_dirty = 1;
    ) :
    drag_mode == 21 ? (
      step_scale = (mouse_cap & 8) ? 0.2 : 0.6;
      new_mg = min(100, max(-100, floor(drag_start_val + delta * step_scale + 0.5)));
      new_mg != master_gate ? (
        !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
        master_gate = new_mg;
      );
      gui_dirty = 1;
    ) :
    drag_mode == 24 ? (
      step_scale = (mouse_cap & 8) ? 0.2 : 0.6;
      new_md = min(100, max(0, floor(drag_start_val + delta * step_scale + 0.5)));
      new_md != master_density ? (
        !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
        master_density = new_md;
      );
      gui_dirty = 1;
    ) :
    drag_mode == 23 ? (
      abs(delta) >= 2 ? (
        step_delta = delta > 0 ? floor(delta / 2) : -floor(-delta / 2);
        modify_master_swing(step_delta);
        drag_start_y = m_y;
        gui_dirty = 1;
      );
    ) :
    drag_mode == 22 ? (
      abs(delta) >= 6 ? (
        step_delta = delta > 0 ? floor(delta / 6) : -floor(-delta / 6);
        modify_master_len(step_delta);
        drag_start_y = m_y;
        gui_dirty = 1;
      );
    );
  );
) : (
  drag_mode = 0;
  drag_tr = -1;
  drag_pushed_undo = 0;
  step_paint_mode = -1;
  last_painted_offset = -1;
  mouse_clicked = 0;
);

// Top horizontal separator line (Y: 48)
gfx_r = 64 / 255.0; gfx_g = 64 / 255.0; gfx_b = 64 / 255.0;
gfx_line(sb_w + W(6), Y(48), rsb_x - W(6), Y(48));

// Reset step hover state for bottom bar readout
hov_step_tr = -1;
hov_step_num = -1;

row_idx = 0;
while (row_idx < TRACKS_PER_PAGE) (
  tr = current_page * 8 + row_idx;
  ry = 52 + row_idx * 44;
  get_track_color(tr);

  gfx_r = 64 / 255.0; gfx_g = 64 / 255.0; gfx_b = 64 / 255.0;
  gfx_line(sb_w + W(6), Y(ry + 40), rsb_x - W(6), Y(ry + 40));

  // Solo (S)
  is_s = 1680[tr];
  s_hov = m_x >= 52 && m_x <= 72 && m_y >= ry + 6 && m_y <= ry + 30;
  is_s_pressed = (active_mouse_zone == 5 && s_hov) || (captured_btn_id == (100 + tr) && s_hov);
  draw_button(X(52), Y(ry + 6), W(20), H(24), W(3), "S", 8, is_s, is_s_pressed, s_hov, 0, 244 / 255.0, 195 / 255.0, 67 / 255.0, max(1, floor(1 * sx)));

  // Mute (M)
  is_m = 1700[tr];
  m_hov = m_x >= 76 && m_x <= 96 && m_y >= ry + 6 && m_y <= ry + 30;
  is_m_pressed = (active_mouse_zone == 6 && m_hov) || (captured_btn_id == (200 + tr) && m_hov);
  draw_button(X(76), Y(ry + 6), W(20), H(24), W(3), "M", 8, is_m, is_m_pressed, m_hov, 0, 235 / 255.0, 55 / 255.0, 75 / 255.0, max(1, floor(1 * sx)));
  gfx_setfont(1, "Inter", sz_main, 'B');

  // Channel Box
  ch_val = 1620[tr];
  ch_hov = m_x >= 100 && m_x <= 146 && m_y >= ry + 6 && m_y <= ry + 30;
  bx_ch = X(100); bw_ch = W(46); by_ch = Y(ry + 6); bh_ch = H(24);
  ch_val == 0 ? (
    #ch_num_str = "ALL";
    ch_r = 244 / 255.0; ch_g = 195 / 255.0; ch_b = 67 / 255.0;
  ) : (
    sprintf(#ch_num_str, "%d", ch_val);
    ch_r = 200 / 255.0; ch_g = 200 / 255.0; ch_b = 200 / 255.0;
  );
  draw_display_labeled(bx_ch, by_ch, bw_ch, bh_ch, W(3), ch_hov, (edit_active == 1 && edit_tr == tr), 0, 9, "Ch", #ch_num_str, 92 / 255, 193 / 255, 254 / 255, ch_r, ch_g, ch_b);
  gfx_setfont(1, "Inter", sz_main, 'B');

  // Pitch Box
  pitch_hov = m_x >= 150 && m_x <= 188 && m_y >= ry + 6 && m_y <= ry + 30;
  bx_p = X(150); bw_p = W(38); by_p = Y(ry + 6); bh_p = H(24);
  disp_pitch = 1600[tr];
  4600[tr] == 1 ? (
    disp_pitch = min(108, max(24, floor(disp_pitch + 4740[tr] * 12.0 + 0.5)));
    disp_pitch = quantize_pitch(disp_pitch);
  );
  4600[tr] != 1 ? draw_display_pitch(bx_p, by_p, bw_p, bh_p, W(3), pitch_hov, (edit_active == 2 && edit_tr == tr), disp_pitch);
  gfx_setfont(1, "Inter", sz_main, 'B');

  // Rate Box
  rate_hov = m_x >= 192 && m_x <= 226 && m_y >= ry + 6 && m_y <= ry + 30;
  bx_r = X(192); bw_r = W(34); by_r = Y(ry + 6); bh_r = H(24);
  r_idx = 1640[tr];
  4600[tr] == 2 ? (
    r_idx = min(10, max(0, floor(r_idx + 4740[tr] * 3.0 + 0.5)));
  );
  r_idx == 0 ? ( #r_sym = "/"; #r_num = "16"; ) :
  r_idx == 1 ? ( #r_sym = "/"; #r_num = "12"; ) :
  r_idx == 2 ? ( #r_sym = "/"; #r_num = "8";  ) :
  r_idx == 3 ? ( #r_sym = "/"; #r_num = "4";  ) :
  r_idx == 4 ? ( #r_sym = "/"; #r_num = "2";  ) :
  r_idx == 5 ? ( #r_sym = "x"; #r_num = "1";  ) :
  r_idx == 6 ? ( #r_sym = "x"; #r_num = "2";  ) :
  r_idx == 7 ? ( #r_sym = "x"; #r_num = "4";  ) :
  r_idx == 8 ? ( #r_sym = "x"; #r_num = "8";  ) :
  r_idx == 9 ? ( #r_sym = "x"; #r_num = "12"; ) :
               ( #r_sym = "x"; #r_num = "16"; );

  4600[tr] != 2 ? draw_display_labeled(bx_r, by_r, bw_r, bh_r, W(3), rate_hov, (edit_active == 3 && edit_tr == tr), 0, 9, #r_sym, #r_num, 92 / 255, 193 / 255, 254 / 255, 200 / 255.0, 200 / 255.0, 200 / 255.0);
  gfx_setfont(1, "Inter", sz_main, 'B');

  // Length Box (1..64)
  len_hov = m_x >= 230 && m_x <= 268 && m_y >= ry + 6 && m_y <= ry + 30;
  bx_l = X(230); bw_l = W(38); by_l = Y(ry + 6); bh_l = H(24);
  (4600[tr] == 3 || gui_master_len != 0) ? (
    cur_l_raw = 1660[tr]; cur_l_raw <= 0 ? cur_l_raw = 16;
    disp_l = min(64, max(1, floor(cur_l_raw + gui_master_len + (4600[tr] == 3 ? 4740[tr] * 16.0 : 0) + 0.5)));
    sprintf(#len_num_str, "%d", disp_l);
  ) : (
    sprintf(#len_num_str, "%d", 1660[tr]);
  );
  draw_display_labeled(bx_l, by_l, bw_l, bh_l, W(3), len_hov, (edit_active == 4 && edit_tr == tr), 0, 9, "L", #len_num_str, 92 / 255, 193 / 255, 254 / 255, 200 / 255.0, 200 / 255.0, 200 / 255.0);
  gfx_setfont(1, "Inter", sz_main, 'B');

  // Euclidean Fill Box
  fill_hov = euc_mode && (m_x >= 272 && m_x <= 310 && m_y >= ry + 6 && m_y <= ry + 30);
  bx_f = X(272); bw_f = W(38); by_f = Y(ry + 6); bh_f = H(24);
  euc_mode && (4600[tr] == 4) ? (
    cur_l_disp = 1660[tr]; cur_l_disp <= 0 ? cur_l_disp = 16;
    disp_fill = 1860[tr] + floor(4740[tr] * (cur_l_disp * 0.5) + 0.5);
    disp_fill = min(cur_l_disp, max(0, disp_fill));
    sprintf(#fill_num_str, "%d", disp_fill);
  ) : (
    sprintf(#fill_num_str, "%d", 1860[tr]);
  );
  draw_display_labeled(bx_f, by_f, bw_f, bh_f, W(3), fill_hov, (edit_active == 7 && edit_tr == tr), !euc_mode, 9, "B", #fill_num_str, 92 / 255, 193 / 255, 254 / 255, 200 / 255.0, 200 / 255.0, 200 / 255.0);
  gfx_setfont(1, "Inter", sz_main, 'B');

  len = 1660[tr];
  len <= 0 ? len = 16;
  len = min(64, max(1, len + gui_master_len));
  4600[tr] == 3 ? (
    len = min(64, max(1, floor(len + 4740[tr] * 16.0 + 0.5)));
  );

  // 16-step grid
  step = 0;
  while (step < 16) (
    cur_bx = screen_grid_x + step * box_pitch_px;
    cur_by = Y(ry + 6);
    global_step = step_page * 16 + step;
    step_offset = tr * 64 + global_step;

    euc_mode && (4600[tr] == 4 || (gui_master_len != 0 && 1860[tr] > 0)) ? (
      disp_fill = 1860[tr] + (4600[tr] == 4 ? floor(4740[tr] * (len * 0.5) + 0.5) : 0);
      disp_fill = min(len, max(0, disp_fill));
      active = eval_euclidean_step(global_step, len, disp_fill);
    ) : (
      active = 10000[step_offset];
    );
    vel = 12000[step_offset];
    vel <= 0 ? vel = 100;
    4600[tr] == 7 ? (
      vel = min(127, max(1, floor(vel + 4740[tr] * 64.0 + 0.5)));
    );

    is_in_range = (global_step < len);
    step_hov = !is_over_lfo_menu && mouse_x >= cur_bx && mouse_x <= cur_bx + box_w_px && mouse_y >= cur_by && mouse_y <= cur_by + box_h_px;

    is_in_range ? (
      is_quarter = (global_step % 4 == 0);

      step_hov ? (
        hov_step_tr = tr;
        hov_step_num = global_step;
      );

      active ? (
        // Scale step velocity brightness by Track Volume and Master Volume
        visual_track_vol = 1940[tr];
        4600[tr] == 61 ? visual_track_vol = min(100, max(0, floor(visual_track_vol + 4740[tr] * 50.0 + 0.5)));
        eff_vel = floor(vel * (visual_track_vol / 100.0) * (master_vol / 100.0) + 0.5);
        vel_alpha = max(0.18, min(1.0, (eff_vel / 127.0) * (eff_vel / 127.0)));
        step_hov ? (
          gfx_r = min(1.0, cr * 1.25 * vel_alpha + 0.10);
          gfx_g = min(1.0, cg * 1.25 * vel_alpha + 0.10);
          gfx_b = min(1.0, cb * 1.25 * vel_alpha + 0.10);
        ) : (
          gfx_r = cr * vel_alpha;
          gfx_g = cg * vel_alpha;
          gfx_b = cb * vel_alpha;
        );
        gfx_a = 1.0;
        fill_roundrect(cur_bx, cur_by, box_w_px, box_h_px, W(2));

        // Soft frosted rubber top edge highlight (riflesso satinato silicone)
        gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
        gfx_a = step_hov ? 0.22 : 0.14;
        gfx_line(cur_bx + W(2), cur_by + 1, cur_bx + box_w_px - W(2), cur_by + 1);

        // Soft rubber bottom lip shadow (profondità gomma)
        gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.35;
        gfx_line(cur_bx + W(2), cur_by + box_h_px - 1, cur_bx + box_w_px - W(2), cur_by + box_h_px - 1);
        gfx_a = 1.0;

        gate_mode ? (
          step_gate_idx = 16000[step_offset];
          (step_gate_idx < 0 || step_gate_idx > 69) ? step_gate_idx = 4;
          (4600[tr] == 8 && step_gate_idx != 69) ? (
            step_gate_idx = min(68, max(0, floor(step_gate_idx + 4740[tr] * 34.0 + 0.5)));
          );

          step_gate_idx >= 68 ? (
            get_elektron_gate_full_str(step_gate_idx);
            gfx_setfont(3, "Inter", sz_sub, 'B');
            gfx_measurestr(#g_full_str, gate_txt_w, gate_txt_h);
            gate_draw_x = cur_bx + floor((box_w_px - gate_txt_w) * 0.5);
            gate_draw_y = cur_by + floor((box_h_px - gate_txt_h) * 0.5) + max(0, floor(0.8 * sy));

            gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.85;
            gfx_x = gate_draw_x + 1; gfx_y = gate_draw_y + 1;
            gfx_drawstr(#g_full_str);
            gfx_r = min(1.0, cr * 1.35 + 0.30);
            gfx_g = min(1.0, cg * 1.35 + 0.30);
            gfx_b = min(1.0, cb * 1.35 + 0.30);
            gfx_a = 1.0;
            gfx_x = gate_draw_x; gfx_y = gate_draw_y;
            gfx_drawstr(#g_full_str);
          ) : (
            avail_gw = box_w_px - 2;
            // Continuous mapping for finite gate values
            gate_line_w = max(2, min(avail_gw, floor(2.0 + (min(68, step_gate_idx) / 68.0) * (avail_gw - 2.0) + 0.5)));
  
            // Scale by Effective Track Gate multiplier (scaled by Master Gate)
            step_gate_idx < 68 ? (
              tr_g_val = 2160[tr];
              4600[tr] == 62 ? tr_g_val = min(100, max(-100, floor(tr_g_val + 4740[tr] * 50.0 + 0.5)));
              tr_g_mult = tr_g_val >= 0 ? (1.0 + tr_g_val / 100.0) : max(0.02, 1.0 + (tr_g_val / 100.0) * 0.98);
              m_g_mult = gui_master_gate >= 0 ? (1.0 + gui_master_gate / 100.0) : max(0.02, 1.0 + (gui_master_gate / 100.0) * 0.98);
              eff_g_mult = tr_g_mult * m_g_mult;
              gate_line_w = max(2, min(avail_gw, floor(gate_line_w * eff_g_mult + 0.5)));
            );
  
            gate_line_y = cur_by + floor(box_h_px * 0.5);
            gfx_r = min(1.0, cr * 1.35 + 0.25);
            gfx_g = min(1.0, cg * 1.35 + 0.25);
            gfx_b = min(1.0, cb * 1.35 + 0.25);
            gfx_a = 1.0;
            gfx_line(cur_bx + 1, gate_line_y, cur_bx + 1 + gate_line_w, gate_line_y);
            box_h_px >= 20 ? (
              gfx_line(cur_bx + 1, gate_line_y + 1, cur_bx + 1 + gate_line_w, gate_line_y + 1);
            );
          );
        );

        pan_mode ? (
          step_pan = 14000[step_offset];
          step_pan <= 0 && step_pan != 0 ? step_pan = 64;
          4600[tr] == 9 ? (
            step_pan = min(127, max(0, floor(step_pan + 4740[tr] * 64.0 + 0.5)));
          );
          // Combine with Track Pan (2120: -100..+100)
          tr_p_val = 2120[tr];
          4600[tr] == 63 ? tr_p_val = min(100, max(-100, floor(tr_p_val + 4740[tr] * 50.0 + 0.5)));
          eff_step_pan = min(127, max(0, floor(step_pan + (tr_p_val * 64.0 / 100.0) + 0.5)));
          pan_tick_x = cur_bx + 2 + floor((box_w_px - 4) * (eff_step_pan / 127.0));
          gfx_r = min(1.0, cr * 1.35 + 0.25);
          gfx_g = min(1.0, cg * 1.35 + 0.25);
          gfx_b = min(1.0, cb * 1.35 + 0.25);
          gfx_a = 1.0;
          gfx_line(pan_tick_x, cur_by + 3, pan_tick_x, cur_by + box_h_px - 3);
          box_w_px >= 20 ? (
            gfx_line(pan_tick_x + 1, cur_by + 3, pan_tick_x + 1, cur_by + box_h_px - 3);
          );
        );

        timing_mode ? (
          step_timing = 18000[step_offset];
          4600[tr] == 10 ? (
            step_timing = min(50, max(-50, floor(step_timing + 4740[tr] * 50.0 + 0.5)));
          );
          timing_norm = (step_timing + 50) / 100.0;
          timing_tick_x = cur_bx + 2 + floor((box_w_px - 4) * timing_norm);
          gfx_r = min(1.0, cr * 1.35 + 0.25);
          gfx_g = min(1.0, cg * 1.35 + 0.25);
          gfx_b = min(1.0, cb * 1.35 + 0.25);
          gfx_a = 1.0;
          gfx_line(timing_tick_x, cur_by + 3, timing_tick_x, cur_by + box_h_px - 3);
          box_w_px >= 20 ? (
            gfx_line(timing_tick_x + 1, cur_by + 3, timing_tick_x + 1, cur_by + box_h_px - 3);
          );
        );

        chance_mode ? (
          st_chance_val = 22000[step_offset];
          4600[tr] == 12 ? (
            st_chance_val = min(100, max(0, floor(st_chance_val + 4740[tr] * 50.0 + 0.5)));
          );
          // Match the audio engine: modulate track density before applying master density.
          eff_tr_chance = 1720[tr];
          4600[tr] == 5 ? (
            eff_tr_chance = min(100, max(0, floor(eff_tr_chance + 4740[tr] * 50.0 + 0.5)));
          );
          eff_tr_chance = max(0, min(100, eff_tr_chance + gui_master_density - 100));
          eff_st_chance = max(0, min(100, st_chance_val + eff_tr_chance - 100));
          eff_st_chance > 0 ? (
            chance_line_h = floor((box_h_px - 4) * (eff_st_chance / 100.0));
            chance_line_h = max(2, chance_line_h);
            chance_tick_x = cur_bx + floor(box_w_px * 0.5);
            chance_bottom = cur_by + box_h_px - 2;
            gfx_r = min(1.0, cr * 1.35 + 0.25);
            gfx_g = min(1.0, cg * 1.35 + 0.25);
            gfx_b = min(1.0, cb * 1.35 + 0.25);
            gfx_a = 1.0;
            gfx_line(chance_tick_x, chance_bottom, chance_tick_x, chance_bottom - chance_line_h);
            box_w_px >= 20 ? (
              gfx_line(chance_tick_x + 1, chance_bottom, chance_tick_x + 1, chance_bottom - chance_line_h);
            );
          );
        );

        cond_mode ? (
          cnd_idx = 24000[step_offset];
          get_cond_str(cnd_idx);
          gfx_setfont(3, "Inter", sz_sub, 'B');
          cnd_ratio = cond_ratio_ord(cnd_idx) > 0;
          cnd_ratio ? (
            cnd_colon = 0;
            while (cnd_colon < strlen(#c_str) && str_getchar(#c_str, cnd_colon) != ':') ( cnd_colon += 1; );
            cnd_inv = cond_inverse(cnd_idx);
            strcpy_substr(#cnd_top, #c_str, cnd_inv, cnd_colon - cnd_inv);
            strcpy_substr(#cnd_bottom, #c_str, cnd_colon + 1, strlen(#c_str) - cnd_colon - 1);
          ) : strcpy(#cnd_top, #c_str);
          gfx_measurestr(#cnd_top, cnd_top_w, cnd_txt_h);
          cnd_ratio ? gfx_measurestr(#cnd_bottom, cnd_bottom_w, cnd_bottom_h);
          cnd_line_h = cnd_txt_h;
          cnd_draw_y = cur_by + floor((box_h_px - (cnd_ratio ? cnd_line_h * 2 : cnd_line_h)) * 0.5);
          cnd_top_x = cur_bx + floor((box_w_px - cnd_top_w) * 0.5);
          cnd_bottom_x = cur_bx + floor((box_w_px - cnd_bottom_w) * 0.5);
          cnd_ratio && cnd_inv ? gfx_measurestr("/", cnd_slash_w, cnd_slash_h);

          gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.85;
          gfx_x = cnd_top_x + 1; gfx_y = cnd_draw_y + 1; gfx_drawstr(#cnd_top);
          cnd_ratio && cnd_inv ? ( gfx_x = cnd_top_x - cnd_slash_w + 1; gfx_y = cnd_draw_y + 1; gfx_drawstr("/"); );
          cnd_ratio ? ( gfx_x = cnd_bottom_x + 1; gfx_y = cnd_draw_y + cnd_line_h + 1; gfx_drawstr(#cnd_bottom); );
          cnd_idx > 0 ? (
            gfx_r = min(1.0, cr * 1.35 + 0.30);
            gfx_g = min(1.0, cg * 1.35 + 0.30);
            gfx_b = min(1.0, cb * 1.35 + 0.30);
            gfx_a = 1.0;
          ) : (
            gfx_r = min(1.0, cr * 1.25 + 0.20);
            gfx_g = min(1.0, cg * 1.25 + 0.20);
            gfx_b = min(1.0, cb * 1.25 + 0.20);
            gfx_a = 0.75;
          );
          gfx_x = cnd_top_x; gfx_y = cnd_draw_y; gfx_drawstr(#cnd_top);
          cnd_ratio && cnd_inv ? ( gfx_x = cnd_top_x - cnd_slash_w; gfx_y = cnd_draw_y; gfx_drawstr("/"); );
          cnd_ratio ? ( gfx_x = cnd_bottom_x; gfx_y = cnd_draw_y + cnd_line_h; gfx_drawstr(#cnd_bottom); );
          gfx_a = 1.0;
        );

        ratchet_mode ? (
          step_ratchet = 20000[step_offset];
          (step_ratchet < 1 || step_ratchet > 4) ? step_ratchet = 1;
          4600[tr] == 11 ? (
            step_ratchet = min(4, max(1, floor(step_ratchet + 4740[tr] * 2.0 + 0.5)));
          );
          step_ratchet > 1 ? (
            gfx_r = min(1.0, cr * 1.35 + 0.25);
            gfx_g = min(1.0, cg * 1.35 + 0.25);
            gfx_b = min(1.0, cb * 1.35 + 0.25);
            gfx_a = 1.0;
            step_ratchet == 2 ? (
              div_x = cur_bx + floor(box_w_px * 0.5);
              gfx_rect(div_x, cur_by + 1, 1, box_h_px - 2);
            ) :
            step_ratchet == 3 ? (
              div_1_x = cur_bx + floor((box_w_px - 1) * (1.0 / 3.0));
              div_2_x = cur_bx + floor((box_w_px - 1) * (2.0 / 3.0) + 0.5);
              gfx_rect(div_1_x, cur_by + 1, 1, box_h_px - 2);
              gfx_rect(div_2_x, cur_by + 1, 1, box_h_px - 2);
            ) : (
              div_1_x = cur_bx + floor((box_w_px - 1) * 0.25);
              div_2_x = cur_bx + floor(box_w_px * 0.5);
              div_3_x = cur_bx + floor((box_w_px - 1) * 0.75 + 0.5);
              gfx_rect(div_1_x, cur_by + 1, 1, box_h_px - 2);
              gfx_rect(div_2_x, cur_by + 1, 1, box_h_px - 2);
              gfx_rect(div_3_x, cur_by + 1, 1, box_h_px - 2);
            );
          );
        );

        // Natural pad border (darker than body to prevent digital neon effect)
        gfx_r = cr * vel_alpha * 0.55;
        gfx_g = cg * vel_alpha * 0.55;
        gfx_b = cb * vel_alpha * 0.55;
        gfx_roundrect(cur_bx, cur_by, box_w_px, box_h_px, W(2), 0);
      ) : (
        // Matte silicone rubber pad body with internal hover
        step_hov ? (
          gfx_r = 0.15; gfx_g = 0.15; gfx_b = 0.17;
        ) : (
          gfx_r = 0.11; gfx_g = 0.11; gfx_b = 0.13;
        );
        gfx_a = 1.0;
        fill_roundrect(cur_bx, cur_by, box_w_px, box_h_px, W(2));

        // Soft frosted rubber top edge highlight (off state satin reflection)
        gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
        gfx_a = step_hov ? 0.22 : 0.12;
        gfx_line(cur_bx + W(2), cur_by + 1, cur_bx + box_w_px - W(2), cur_by + 1);

        // Soft rubber bottom lip shadow
        gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
        gfx_a = 0.45;
        gfx_line(cur_bx + W(2), cur_by + box_h_px - 1, cur_bx + box_w_px - W(2), cur_by + box_h_px - 1);
        gfx_a = 1.0;

        // Fixed perimeter bezel (no border hover effect)
        is_quarter ? (
          gfx_r = cr * 0.55;
          gfx_g = cg * 0.55;
          gfx_b = cb * 0.55;
        ) : (
          gfx_r = 34 / 255.0;
          gfx_g = 34 / 255.0;
          gfx_b = 38 / 255.0;
        );
        gfx_roundrect(cur_bx, cur_by, box_w_px, box_h_px, W(2), 0);
      );

      // Text entry overlay for the active step parameter.
      (edit_active >= 18 && edit_active <= 24 && edit_step_offset == step_offset) ? (
        draw_text_edit_box(cur_bx, cur_by, box_w_px, box_h_px, W(2), 8);
      );

      // Mouse down initiation for step toggle / paint
      mouse_press && active_mouse_zone == 0 && step_hov ? (
        active_mouse_zone = 2;
        undo_push();
        step_paint_mode = !10000[step_offset];
        last_painted_offset = step_offset;
        last_paint_x = mouse_x;
        last_paint_y = mouse_y;
        10000[step_offset] = step_paint_mode;
        12000[step_offset] <= 0 ? 12000[step_offset] = 100;
        gui_dirty = 1;
      );
    ) : (
      is_quarter = (global_step % 4 == 0);
      gfx_r = 0.08; gfx_g = 0.08; gfx_b = 0.10;
      fill_roundrect(cur_bx, cur_by, box_w_px, box_h_px, W(2));

      // Subtle dimmed relief to preserve physical pad shape
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_a = 0.05;
      gfx_line(cur_bx + W(2), cur_by + 1, cur_bx + box_w_px - W(2), cur_by + 1);

      gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.25;
      gfx_line(cur_bx + W(2), cur_by + box_h_px - 1, cur_bx + box_w_px - W(2), cur_by + box_h_px - 1);
      gfx_a = 1.0;

      // Dimmed border (disabled parameter style) with quarter beat reference
      is_quarter ? (
        gfx_r = cr * 0.25;
        gfx_g = cg * 0.25;
        gfx_b = cb * 0.25;
      ) : (
        gfx_r = 34 / 255.0;
        gfx_g = 34 / 255.0;
        gfx_b = 38 / 255.0;
      );
      gfx_roundrect(cur_bx, cur_by, box_w_px, box_h_px, W(2), 0);
    );
    step += 1;
  );

  // Animated Density and Swing slots are drawn over the cache below.
  chance_x = 787;
  swing_x = 841;
  draw_track_slots(tr, ry, !(4600[tr] == 5 && 2100[tr] == 1), !(4600[tr] == 6 && 2140[tr] == 0));

  // Shift Left (<)
  bx_shl = X(893); bw_shl = W(20); by_shl = Y(ry + 6); bh_shl = H(24);
  shl_hov = m_x >= 893 && m_x <= 913 && m_y >= ry + 6 && m_y <= ry + 30;
  is_shl_pressed = (captured_btn_id == (300 + tr) && shl_hov);
  draw_button(bx_shl, by_shl, bw_shl, bh_shl, W(3), "", 8, 0, is_shl_pressed, shl_hov, 0, cr, cg, cb, 0);
  is_shl_pressed ? (
    gfx_r = cr; gfx_g = cg; gfx_b = cb;
  ) : (
    gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
  );
  shl_press_y_off = is_shl_pressed ? max(1, floor(1 * sy)) : 0;
  draw_arrow_left(bx_shl, by_shl + shl_press_y_off, bw_shl, bh_shl, scale_font);

  // Shift Right (>)
  bx_shr = X(917); bw_shr = W(20); by_shr = Y(ry + 6); bh_shr = H(24);
  shr_hov = m_x >= 917 && m_x <= 937 && m_y >= ry + 6 && m_y <= ry + 30;
  is_shr_pressed = (captured_btn_id == (400 + tr) && shr_hov);
  draw_button(bx_shr, by_shr, bw_shr, bh_shr, W(3), "", 8, 0, is_shr_pressed, shr_hov, 0, cr, cg, cb, 0);
  is_shr_pressed ? (
    gfx_r = cr; gfx_g = cg; gfx_b = cb;
  ) : (
    gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
  );
  shr_press_y_off = is_shr_pressed ? max(1, floor(1 * sy)) : 0;
  draw_arrow_right(bx_shr, by_shr + shr_press_y_off, bw_shr, bh_shr, scale_font);

  // FLIP
  bx_flp = X(941); bw_flp = W(34); by_flp = Y(ry + 6); bh_flp = H(24);
  flip_hov = m_x >= 941 && m_x <= 975 && m_y >= ry + 6 && m_y <= ry + 30;
  is_flip_pressed = (captured_btn_id == (500 + tr) && flip_hov);
  draw_button(bx_flp, by_flp, bw_flp, bh_flp, W(3), "FLIP", 8, 0, is_flip_pressed, flip_hov, 0, cr, cg, cb, max(1, floor(1 * sx)));
  gfx_setfont(1, "Inter", sz_main, 'B');

  // Random (?)
  bx_rnd = X(979); bw_rnd = W(24); by_rnd = Y(ry + 6); bh_rnd = H(24);
  r_hov = m_x >= 979 && m_x <= 1003 && m_y >= ry + 6 && m_y <= ry + 30;
  is_r_pressed = ((captured_btn_id == (600 + tr) || active_mouse_zone == 7) && r_hov);
  draw_color_button(bx_rnd, by_rnd, bw_rnd, bh_rnd, W(3), "?", 4, is_r_pressed, r_hov, cr, cg, cb, (bw_rnd <= 32) ? 1 : 0);
  gfx_setfont(1, "Inter", sz_main, 'B');

  // Play Mode Box
  bw_pm = W(44);
  bx_pm = pm_right_edge - bw_pm;
  by_pm = Y(ry + 6);
  bh_pm = H(24);
  pm_hov = mouse_x >= bx_pm && mouse_x <= pm_right_edge && mouse_y >= by_pm && mouse_y <= by_pm + bh_pm;
  draw_display_play_mode(bx_pm, by_pm, bw_pm, bh_pm, W(3), pm_hov, 1920[tr], cr, cg, cb, scale_font);

  mouse_press && active_mouse_zone == 0 ? (
    !mouse_clicked && drag_mode == 0 ? (
      m_x >= 52 && m_x <= 72 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        active_mouse_zone = 5; undo_push(); solo_paint_mode = !1680[tr]; 1680[tr] = solo_paint_mode; mouse_clicked = 1; gui_dirty = 1;
      ) :
      m_x >= 76 && m_x <= 96 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        active_mouse_zone = 6; undo_push(); mute_paint_mode = !1700[tr]; 1700[tr] = mute_paint_mode; mouse_clicked = 1; gui_dirty = 1;
      ) :
      m_x >= 100 && m_x <= 146 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 1000 + tr) ? (
          undo_push(); 1620[tr] = (tr % 16) + 1;
          mouse_clicked = 1;
        ) : (
          drag_pushed_undo = 0;
          drag_mode = 2; drag_tr = tr; drag_start_y = m_y; drag_start_val = 1620[tr];
          last_click_time = now_t; last_click_elem = 1000 + tr;
        );
      ) :
      m_x >= 150 && m_x <= 188 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 2000 + tr) ? (
          undo_push();
          1600[tr] = 60; // Reset to C4 (60)
          mouse_clicked = 1;
        ) : (
          drag_pushed_undo = 0;
          drag_mode = 1; drag_tr = tr; drag_start_y = m_y; drag_start_val = 1600[tr];
          last_click_time = now_t; last_click_elem = 2000 + tr;
        );
      ) :
      m_x >= 192 && m_x <= 226 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 3000 + tr) ? (
          undo_push(); 1640[tr] = 7;
          mouse_clicked = 1;
        ) : (
          drag_pushed_undo = 0;
          drag_mode = 3; drag_tr = tr; drag_start_y = m_y; drag_start_val = 1640[tr];
          last_click_time = now_t; last_click_elem = 3000 + tr;
        );
      ) :
      m_x >= 230 && m_x <= 268 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 4000 + tr) ? (
          undo_push(); 1660[tr] = 16;
          1860[tr] > 16 ? 1860[tr] = 16;
          euc_mode ? apply_euclidean_track(tr);
          mouse_clicked = 1;
        ) : (
          drag_pushed_undo = 0;
          drag_mode = 4; drag_tr = tr; drag_start_y = m_y; drag_start_val = 1660[tr];
          last_click_time = now_t; last_click_elem = 4000 + tr;
        );
      ) :
      euc_mode && m_x >= 272 && m_x <= 310 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 4500 + tr) ? (
          undo_push(); 1860[tr] = 0;
          euc_mode ? apply_euclidean_track(tr);
          mouse_clicked = 1;
        ) : (
          drag_pushed_undo = 0;
          drag_mode = 7; drag_tr = tr; drag_start_y = m_y; drag_start_val = 1860[tr];
          last_click_time = now_t; last_click_elem = 4500 + tr;
        );
      ) :
      m_x >= chance_x && m_x <= chance_x + 50 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 5000 + tr) ? (
          undo_push();
          2100[tr] == 0 ? 1940[tr] = 100 : 1720[tr] = 100;
          mouse_clicked = 1;
        ) : (
          drag_pushed_undo = 0;
          drag_mode = 5; drag_tr = tr; drag_start_y = m_y;
          drag_start_val = 2100[tr] == 0 ? 1940[tr] : 1720[tr];
          last_click_time = now_t; last_click_elem = 5000 + tr;
        );
      ) :
      m_x >= swing_x && m_x <= swing_x + 48 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 6000 + tr) ? (
          undo_push();
          2140[tr] == 2 ? 2160[tr] = 0 : 2140[tr] == 1 ? 2120[tr] = 0 : 1740[tr] = 0;
          mouse_clicked = 1;
        ) : (
          drag_pushed_undo = 0;
          drag_mode = 6; drag_tr = tr; drag_start_y = m_y;
          drag_start_val = 2140[tr] == 2 ? 2160[tr] : 2140[tr] == 1 ? 2120[tr] : 1740[tr];
          last_click_time = now_t; last_click_elem = 6000 + tr;
        );
      ) :
      m_x >= 1005 && m_x <= 1055 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 8000 + tr) ? (
          undo_push();
          1920[tr] = 0; // Double-click reset to Forward (0)
          save_pattern_to_mem(active_edit_pat);
          mouse_clicked = 1;
          last_click_elem = -1;
          gui_dirty = 1;
        ) : (
          drag_pushed_undo = 0;
          drag_mode = 10; drag_tr = tr; drag_start_y = m_y; drag_start_val = 1920[tr];
          last_click_time = now_t; last_click_elem = 8000 + tr;
          mouse_clicked = 1;
        );
      );
    );
  );

  // Continuous drag painting for Solo (zone 5) and Mute (zone 6)
  (mouse_cap & 1) && active_mouse_zone == 5 && (m_x >= 48 && m_x <= 74 && m_y >= ry && m_y < ry + 44) ? (
    1680[tr] != solo_paint_mode ? (
      1680[tr] = solo_paint_mode;
      gui_dirty = 1;
    );
  );

  (mouse_cap & 1) && active_mouse_zone == 6 && (m_x >= 75 && m_x <= 98 && m_y >= ry && m_y < ry + 44) ? (
    1700[tr] != mute_paint_mode ? (
      1700[tr] = mute_paint_mode;
      gui_dirty = 1;
    );
  );

  // Continuous drag painting for Random (?) (zone 7)
  (mouse_cap & 1) && active_mouse_zone == 7 && (m_x >= 975 && m_x <= 1005 && m_y >= ry && m_y < ry + 44) ? (
    tr != last_painted_random_tr ? (
      last_painted_random_tr = tr;
      undo_push();
      do_track_rnd(tr);
      gui_dirty = 1;
    );
  );

  row_idx += 1;
);

// Continuous interpolated step painting
(mouse_cap & 1) && active_mouse_zone == 2 && step_paint_mode >= 0 ? (
  p_dist = max(abs(mouse_x - last_paint_x), abs(mouse_y - last_paint_y));
  p_substeps = max(1, min(32, ceil(p_dist / 10)));
  p_k = 1;
  while (p_k <= p_substeps) (
    pix = last_paint_x + (mouse_x - last_paint_x) * (p_k / p_substeps);
    piy = last_paint_y + (mouse_y - last_paint_y) * (p_k / p_substeps);
    p_row = floor((piy - Y(52)) / H(44));
    (p_row >= 0 && p_row < TRACKS_PER_PAGE) ? (
      p_tr = current_page * 8 + p_row;
      p_ry = Y(52) + p_row * H(44);
      (piy >= p_ry + Y(2) && piy <= p_ry + Y(34)) ? (
        p_len = 1660[p_tr];
        p_len <= 0 ? p_len = 16;
        p_st = floor((pix - screen_grid_x) / box_pitch_px);
        (p_st >= 0 && p_st < 16) ? (
          global_p_st = step_page * 16 + p_st;
          (global_p_st < p_len) ? (
            p_off = p_tr * 64 + global_p_st;
            10000[p_off] != step_paint_mode ? (
              10000[p_off] = step_paint_mode;
              12000[p_off] <= 0 ? 12000[p_off] = 100;
            );
          );
        );
      );
    );
    p_k += 1;
  );
  last_paint_x = mouse_x;
  last_paint_y = mouse_y;
);

// Continuous interpolated right-click painting: reset the active step parameter.
// This follows the same horizontal and vertical path interpolation as step on/off painting.
(mouse_cap & 2) && active_mouse_zone == 8 ? (
  rp_dist = max(abs(mouse_x - last_reset_paint_x), abs(mouse_y - last_reset_paint_y));
  rp_substeps = max(1, min(32, ceil(rp_dist / 10)));
  rp_k = 1;
  while (rp_k <= rp_substeps) (
    rpx = last_reset_paint_x + (mouse_x - last_reset_paint_x) * (rp_k / rp_substeps);
    rpy = last_reset_paint_y + (mouse_y - last_reset_paint_y) * (rp_k / rp_substeps);
    rp_row = floor((rpy - Y(52)) / H(44));
    (rp_row >= 0 && rp_row < TRACKS_PER_PAGE) ? (
      rp_tr = current_page * 8 + rp_row;
      rp_ry = Y(52) + rp_row * H(44);
      (rpy >= rp_ry + Y(6) && rpy <= rp_ry + box_h_px + Y(6)) ? (
        rp_st = floor((rpx - screen_grid_x) / box_pitch_px);
        (rp_st >= 0 && rp_st < 16) ? (
          rp_global_st = step_page * 16 + rp_st;
          rp_off = rp_tr * 64 + rp_global_st;
          10000[rp_off] ? (
            velocity_mode ? (
              12000[rp_off] = 100;
            ) :
            gate_mode ? (
              16000[rp_off] = 4;
            ) :
            pan_mode ? (
              14000[rp_off] = 64;
            ) :
            timing_mode ? (
              18000[rp_off] = 0;
            ) :
            ratchet_mode ? (
              20000[rp_off] = 1;
            ) :
            chance_mode ? (
              22000[rp_off] = 100;
            ) :
            cond_mode ? (
              24000[rp_off] = 0;
            );
          );
        );
      );
    );
    rp_k += 1;
  );
  last_reset_paint_x = mouse_x;
  last_reset_paint_y = mouse_y;
  save_pattern_to_mem(active_edit_pat);
  gui_dirty = 1;
);

// Continuous interpolated keyboard painting
(mouse_cap & 1) && active_mouse_zone == 3 && kb_paint_mode >= 0 ? (
  kb_dist = max(abs(m_x - last_kb_paint_x), abs(m_y - last_kb_paint_y));
  kb_substeps = max(1, min(16, ceil(kb_dist / 3)));
  kb_k = 1;
  while (kb_k <= kb_substeps) (
    interp_x = last_kb_paint_x + (m_x - last_kb_paint_x) * (kb_k / kb_substeps);
    interp_y = last_kb_paint_y + (m_y - last_kb_paint_y) * (kb_k / kb_substeps);
    interp_n = get_kb_note_at(interp_x, interp_y);
    (interp_n >= 0 && interp_n != last_painted_note) ? (
      4000[interp_n] != kb_paint_mode ? (
        4000[interp_n] = kb_paint_mode;
        update_quant_scale_type();
        gui_dirty = 1;
      );
      last_painted_note = interp_n;
    );
    kb_k += 1;
  );
  last_kb_paint_x = m_x;
  last_kb_paint_y = m_y;
);

// REAWISE bottom bar logo
gfx_setfont(11, "Inter", sz_reawise, 'B');
gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
gfx_measurestr("REAWISE", rw_w, rw_h);
gfx_x = floor((cur_w - rw_w) * 0.5);
gfx_y = bot_bar_y + floor((bot_bar_h - rw_h) * 0.5);
gfx_drawstr("REAWISE");

// Step parameter readout (14px)
hov_step_tr >= 0 ? (
  gfx_setfont(12, "Inter", sz_readout, 'B');
  gfx_measurestr("M", h_m_w, h_m_h);
  readout_y = bot_bar_y + floor((bot_bar_h - h_m_h) * 0.5);
  readout_x = sb_w + W(8);

  hov_off = hov_step_tr * 64 + hov_step_num;
  hov_vel = 12000[hov_off];
  hov_vel <= 0 ? hov_vel = 100;
  4600[hov_step_tr] == 7 ? (
    hov_vel = min(127, max(1, floor(hov_vel + 4740[hov_step_tr] * 64.0 + 0.5)));
  );

  // Scale readout velocity by Track Volume and Master Volume
  visual_track_vol = 1940[hov_step_tr];
        4600[hov_step_tr] == 61 ? visual_track_vol = min(100, max(0, floor(visual_track_vol + 4740[hov_step_tr] * 50.0 + 0.5)));
        eff_readout_vel = floor(hov_vel * (visual_track_vol / 100.0) * (master_vol / 100.0) + 0.5);

  hov_gate_idx = 16000[hov_off];
  (hov_gate_idx < 0 || hov_gate_idx > 69) ? hov_gate_idx = 4;
  (4600[hov_step_tr] == 8 && hov_gate_idx != 69) ? (
    hov_gate_idx = min(68, max(0, floor(hov_gate_idx + 4740[hov_step_tr] * 34.0 + 0.5)));
  );
  get_elektron_gate_full_str(hov_gate_idx);

  hov_pan = 14000[hov_off];
  (hov_pan < 0 || hov_pan > 127) ? hov_pan = 64;
  4600[hov_step_tr] == 9 ? (
    hov_pan = min(127, max(0, floor(hov_pan + 4740[hov_step_tr] * 64.0 + 0.5)));
  );

  // Combine readout pan with Track Pan (2120: -100..+100)
  readout_track_pan = 2120[hov_step_tr];
  4600[hov_step_tr] == 63 ? readout_track_pan = min(100, max(-100, floor(readout_track_pan + 4740[hov_step_tr] * 50.0 + 0.5)));
  eff_readout_pan = min(127, max(0, floor(hov_pan + (readout_track_pan * 64.0 / 100.0) + 0.5)));
  eff_readout_pan == 64 ? ( #hov_pan_str = "C"; ) :
  eff_readout_pan > 64 ? ( sprintf(#hov_pan_str, "+%d", eff_readout_pan - 64); ) :
                         ( sprintf(#hov_pan_str, "%d", eff_readout_pan - 64); );

  hov_tm = 18000[hov_off];
  4600[hov_step_tr] == 10 ? (
    hov_tm = min(50, max(-50, floor(hov_tm + 4740[hov_step_tr] * 50.0 + 0.5)));
  );

  hov_tm > 0 ? sprintf(#hov_tm_str, "+%d%%", hov_tm) : sprintf(#hov_tm_str, "%d%%", hov_tm);

  hov_rt = 20000[hov_off];
  hov_rt <= 0 ? hov_rt = 1;
  4600[hov_step_tr] == 11 ? (
    hov_rt = min(4, max(1, floor(hov_rt + 4740[hov_step_tr] * 2.0 + 0.5)));
  );

  hov_chc = 22000[hov_off];
  4600[hov_step_tr] == 12 ? (
    hov_chc = min(100, max(0, floor(hov_chc + 4740[hov_step_tr] * 50.0 + 0.5)));
  );
  // Combine readout chance with Track Density (1720: 0..100%) and Master Density
  eff_track_dens = 1720[hov_step_tr];
  4600[hov_step_tr] == 5 ? (
    eff_track_dens = min(100, max(0, floor(eff_track_dens + 4740[hov_step_tr] * 50.0 + 0.5)));
  );
  eff_track_dens = max(0, min(100, eff_track_dens + gui_master_density - 100));
  eff_readout_chc = max(0, min(100, hov_chc + eff_track_dens - 100));
  hov_cnd = 24000[hov_off];
  get_cond_str(hov_cnd);

  // VELOCITY
  gfx_x = readout_x; gfx_y = readout_y;
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; gfx_drawstr("VEL ");
  gfx_r = 220 / 255; gfx_g = 220 / 255; gfx_b = 220 / 255;
  sprintf(#s_val, "%d ", eff_readout_vel); gfx_drawstr(#s_val);

  gfx_r = 70 / 255; gfx_g = 70 / 255; gfx_b = 75 / 255; gfx_drawstr("| ");

  // GATE L
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; gfx_drawstr("GATE ");
  gfx_r = 220 / 255; gfx_g = 220 / 255; gfx_b = 220 / 255;
  sprintf(#s_val, "%s ", #g_full_str); gfx_drawstr(#s_val);

  gfx_r = 70 / 255; gfx_g = 70 / 255; gfx_b = 75 / 255; gfx_drawstr("| ");

  // PAN
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; gfx_drawstr("PAN ");
  gfx_r = 220 / 255; gfx_g = 220 / 255; gfx_b = 220 / 255;
  sprintf(#s_val, "%s ", #hov_pan_str); gfx_drawstr(#s_val);

  gfx_r = 70 / 255; gfx_g = 70 / 255; gfx_b = 75 / 255; gfx_drawstr("| ");

  // TIMING
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; gfx_drawstr("TIMING ");
  gfx_r = 220 / 255; gfx_g = 220 / 255; gfx_b = 220 / 255;
  sprintf(#s_val, "%s ", #hov_tm_str); gfx_drawstr(#s_val);

  gfx_r = 70 / 255; gfx_g = 70 / 255; gfx_b = 75 / 255; gfx_drawstr("| ");

  // RATCHET
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; gfx_drawstr("RATCHET ");
  gfx_r = 220 / 255; gfx_g = 220 / 255; gfx_b = 220 / 255;
  sprintf(#s_val, "%d ", hov_rt); gfx_drawstr(#s_val);

  gfx_r = 70 / 255; gfx_g = 70 / 255; gfx_b = 75 / 255; gfx_drawstr("| ");

  // CHANCE
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; gfx_drawstr("CHANCE ");
  gfx_r = 220 / 255; gfx_g = 220 / 255; gfx_b = 220 / 255;
  sprintf(#s_val, "%d%% ", eff_readout_chc); gfx_drawstr(#s_val);

  gfx_r = 70 / 255; gfx_g = 70 / 255; gfx_b = 75 / 255; gfx_drawstr("| ");

  // COND
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; gfx_drawstr("COND ");
  gfx_r = 220 / 255; gfx_g = 220 / 255; gfx_b = 220 / 255;
  gfx_drawstr(#c_str);
);


// =====================================================================
// Bottom Bar Pattern Matrix & CHAIN button (right of REAWISE logo)
// =====================================================================
is_chain_pressed = (captured_btn_id == 20 && chain_btn_hov);
chain_len > 0 && chain_mode ? (
  sprintf(#ch_lbl, "CHAINING (%d)", chain_len);
) : (
  #ch_lbl = "CHAINING";
);
draw_button(bx_chain_btn, by_chain_btn, bw_chain_btn, bh_chain_btn, W(3), #ch_lbl, 8, chain_mode, is_chain_pressed, chain_btn_hov, 0, 92 / 255, 193 / 255, 254 / 255, 0);

// 16 Pattern Pads in 2 rows of 8 (Digitakt style)
p_i = 0;
while (p_i < 16) (
  px = bx_pats_area + (p_i % 8) * (pw_pat + pgap_x);
  py = (p_i < 8) ? py_pats_top : py_pats_top + ph_pat + pgap_y;
  is_hov_p = (hov_pat_idx == p_i);
  is_play_p = (active_play_pat == p_i);
  is_edit_p = (active_edit_pat == p_i);
  is_queued_p = (queued_play_pat == p_i);
  is_pat_pressed = (captured_btn_id == (1000 + p_i) && is_hov_p);

  sprintf(#p_num, "%d", p_i + 1);
  pn_x_off = (p_i < 9) ? max(1, floor(1.0 * sx)) : 0;
  p_i == 4 ? pn_x_off += max(1, floor(1.0 * sx));
  p_i == 6 ? pn_x_off += max(0.5, 0.5 * sx);

  is_queued_flash = is_queued_p && ((time_precise() * 4) % 1 < 0.5);
  is_act_p = is_play_p || is_queued_flash;

  is_queued_flash ? (
    pad_r = 244 / 255.0; pad_g = 195 / 255.0; pad_b = 67 / 255.0;
  ) : (
    pad_r = 92 / 255.0;  pad_g = 193 / 255.0; pad_b = 254 / 255.0;
  );

  draw_button(px, py, pw_pat, ph_pat, W(2), #p_num, 8, is_act_p, is_pat_pressed, is_hov_p, 0, pad_r, pad_g, pad_b, pn_x_off);

  (is_edit_p && !is_play_p) ? (
    gfx_r = 92 / 255.0; gfx_g = 193 / 255.0; gfx_b = 254 / 255.0;
    gfx_roundrect(px, py, pw_pat, ph_pat, W(2), 1);
  );

  p_i += 1;
);

  gui_dirty = 0;
);

// Blit offscreen buffer to screen (gfx_dest = -1)
gfx_dest = -1;
gfx_x = 0; gfx_y = 0;
gfx_blit(1, 1, 0);

// Pitch and rate modulation can be drawn without rebuilding the track rows.
// The same controls remain in the cached rows for ordinary editing and hover.
lfo_overlay_row = 0;
while (lfo_overlay_row < TRACKS_PER_PAGE) (
  lfo_overlay_tr = current_page * 8 + lfo_overlay_row;
  lfo_overlay_dst = 4600[lfo_overlay_tr];
  ((lfo_overlay_dst == 5 && 2100[lfo_overlay_tr] == 1) ||
   (lfo_overlay_dst == 6 && 2140[lfo_overlay_tr] == 0)) ? (
    get_track_color(lfo_overlay_tr);
    draw_track_slots(lfo_overlay_tr, 52 + lfo_overlay_row * 44,
                     lfo_overlay_dst == 5, lfo_overlay_dst == 6);
  );
  (lfo_overlay_dst == 1 || lfo_overlay_dst == 2) ? (
    lfo_overlay_ry = 52 + lfo_overlay_row * 44;
    lfo_overlay_by = Y(lfo_overlay_ry + 6);
    get_track_color(lfo_overlay_tr);
    lfo_overlay_dst == 1 ? (
      lfo_overlay_pitch = min(108, max(24, floor(1600[lfo_overlay_tr] + 4740[lfo_overlay_tr] * 12.0 + 0.5)));
      lfo_overlay_pitch = quantize_pitch(lfo_overlay_pitch);
      lfo_overlay_hov = m_x >= 150 && m_x <= 188 && m_y >= lfo_overlay_ry + 6 && m_y <= lfo_overlay_ry + 30;
      draw_display_pitch(X(150), lfo_overlay_by, W(38), H(24), W(3), lfo_overlay_hov, (edit_active == 2 && edit_tr == lfo_overlay_tr), lfo_overlay_pitch);
    ) : (
      lfo_overlay_rate = min(10, max(0, floor(1640[lfo_overlay_tr] + 4740[lfo_overlay_tr] * 3.0 + 0.5)));
      lfo_overlay_rate == 0 ? ( #lfo_overlay_sym = "/"; #lfo_overlay_num = "16"; ) :
      lfo_overlay_rate == 1 ? ( #lfo_overlay_sym = "/"; #lfo_overlay_num = "12"; ) :
      lfo_overlay_rate == 2 ? ( #lfo_overlay_sym = "/"; #lfo_overlay_num = "8"; ) :
      lfo_overlay_rate == 3 ? ( #lfo_overlay_sym = "/"; #lfo_overlay_num = "4"; ) :
      lfo_overlay_rate == 4 ? ( #lfo_overlay_sym = "/"; #lfo_overlay_num = "2"; ) :
      lfo_overlay_rate == 5 ? ( #lfo_overlay_sym = "x"; #lfo_overlay_num = "1"; ) :
      lfo_overlay_rate == 6 ? ( #lfo_overlay_sym = "x"; #lfo_overlay_num = "2"; ) :
      lfo_overlay_rate == 7 ? ( #lfo_overlay_sym = "x"; #lfo_overlay_num = "4"; ) :
      lfo_overlay_rate == 8 ? ( #lfo_overlay_sym = "x"; #lfo_overlay_num = "8"; ) :
      lfo_overlay_rate == 9 ? ( #lfo_overlay_sym = "x"; #lfo_overlay_num = "12"; ) :
                              ( #lfo_overlay_sym = "x"; #lfo_overlay_num = "16"; );
      lfo_overlay_hov = m_x >= 192 && m_x <= 226 && m_y >= lfo_overlay_ry + 6 && m_y <= lfo_overlay_ry + 30;
      draw_display_labeled(X(192), lfo_overlay_by, W(34), H(24), W(3), lfo_overlay_hov, (edit_active == 3 && edit_tr == lfo_overlay_tr), 0, 9, #lfo_overlay_sym, #lfo_overlay_num, 92 / 255, 193 / 255, 254 / 255, 200 / 255.0, 200 / 255.0, 200 / 255.0);
    );
  );
  lfo_overlay_row += 1;
);

// The waveform animates independently of the cached interface.
draw_display_lfo_wave(bx_lfo_sh, by_lfo, bw_lfo, bh_lfo, W(3), lfo_sh_hov, lfo_cur_tr);

// Draw the meter over the cached interface, below playhead and menus.
col_l_x = rsb_x + W(6);
col_r_x = rsb_x + W(24);
col_w = W(14);
seg_h = max(2, H(5));

// Numeric Peak Velocity Meters (L & R) with 4px gap above meter
gap_mtr_pk = max(2, H(4));
readout_pk_h = max(14, H(16));
readout_pk_y = Y(279) - gap_mtr_pk - readout_pk_h;
box_pk_w = W(17);
box_l_pk_x = rsb_x + W(4);
box_r_pk_x = rsb_x + W(23);

// Left channel peak readout
draw_display_frame(box_l_pk_x, readout_pk_y, box_pk_w, readout_pk_h, W(2), 0);
sprintf(#pk_l_str, "%d", meter_l_num_peak);
gfx_setfont(14, "Inter Light", sz_mtr_pk, 0);
gfx_measurestr(#pk_l_str, pkl_w, pkl_h);
meter_l_num_peak > 0 ? (
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
) : (
  gfx_r = 50 / 255.0; gfx_g = 80 / 255.0; gfx_b = 105 / 255.0;
);
gfx_x = box_l_pk_x + floor((box_pk_w - pkl_w) * 0.5);
gfx_y = readout_pk_y + floor((readout_pk_h - pkl_h) * 0.5) + sb_txt_y_off;
gfx_drawstr(#pk_l_str);

// Right channel peak readout
draw_display_frame(box_r_pk_x, readout_pk_y, box_pk_w, readout_pk_h, W(2), 0);
sprintf(#pk_r_str, "%d", meter_r_num_peak);
gfx_setfont(14, "Inter Light", sz_mtr_pk, 0);
gfx_measurestr(#pk_r_str, pkr_w, pkr_h);
meter_r_num_peak > 0 ? (
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
) : (
  gfx_r = 50 / 255.0; gfx_g = 80 / 255.0; gfx_b = 105 / 255.0;
);
gfx_x = box_r_pk_x + floor((box_pk_w - pkr_w) * 0.5);
gfx_y = readout_pk_y + floor((readout_pk_h - pkr_h) * 0.5) + sb_txt_y_off;
gfx_drawstr(#pk_r_str);

mtr_top_y = Y(279);
mtr_bot_y = Y(440);

num_lit_l = ceil(meter_l_disp * 24.0);
num_lit_r = ceil(meter_r_disp * 24.0);
peak_seg_l = min(23, max(0, floor(meter_l_peak * 24.0 - 0.0001)));
peak_seg_r = min(23, max(0, floor(meter_r_peak * 24.0 - 0.0001)));
num_lit_l = min(24, max(0, num_lit_l));
num_lit_r = min(24, max(0, num_lit_r));

s_idx = 0;
while (s_idx < 24) (
  seg_y = mtr_top_y + floor((23 - s_idx) * (mtr_bot_y - mtr_top_y - seg_h) / 23.0);
  t_seg = s_idx / 23.0;

  // Azure gradient: deep dark cyan at bottom (18, 55, 95) up to signature electric cyan (92, 193, 254) at peak
  seg_r = (18.0 + t_seg * 74.0) / 255.0;
  seg_g = (55.0 + t_seg * 138.0) / 255.0;
  seg_b = (95.0 + t_seg * 159.0) / 255.0;

  // Draw left and right channel LEDs with the same segment styling.
  is_lit_l = (s_idx < num_lit_l) || (s_idx == peak_seg_l && meter_l_peak > 0.02);
  draw_midi_meter_segment(col_l_x, seg_y, col_w, seg_h, is_lit_l);
  is_lit_r = (s_idx < num_lit_r) || (s_idx == peak_seg_r && meter_r_peak > 0.02);
  draw_midi_meter_segment(col_r_x, seg_y, col_w, seg_h, is_lit_r);

  // Subtle center scale ticks at reference levels (0, 6, 12, 18, 23)
  (s_idx == 0 || s_idx == 6 || s_idx == 12 || s_idx == 18 || s_idx == 23) ? (
    gfx_r = 50 / 255.0; gfx_g = 50 / 255.0; gfx_b = 55 / 255.0;
    gfx_rect(rsb_x + W(21), seg_y + floor(seg_h * 0.5), W(2), 1);
  );

  s_idx += 1;
);


// Advance the meter even on frames that reuse the cached interface.
decay_coeff = exp(-dt_mtr * 5.0);
meter_l_disp *= decay_coeff;
meter_r_disp *= decay_coeff;
meter_l_disp < 0.005 ? meter_l_disp = 0.0;
meter_r_disp < 0.005 ? meter_r_disp = 0.0;


// Playhead rendering (60 fps)
is_playing_transport ? (
  gfx_cur_b = max(0.0, play_position * (tempo / 60.0));
  row_p = 0;
  while (row_p < TRACKS_PER_PAGE) (
    tr_p = current_page * 8 + row_p;
    ry_p = 52 + row_p * 44;
    len_p = 1660[tr_p]; len_p <= 0 ? len_p = 16;
    len_p = min(64, max(1, len_p + gui_master_len));
    4600[tr_p] == 3 ? (
      len_p = min(64, max(1, floor(len_p + 4740[tr_p] * 16.0 + 0.5)));
    );
    rate_p = 1640[tr_p];
    4600[tr_p] == 2 ? (
      rate_p = min(10, max(0, floor(rate_p + 4740[tr_p] * 3.0 + 0.5)));
    );
    step_dur_p = get_beats_per_step(rate_p);

    raw_step_p = floor((gfx_cur_b + 0.00001) / step_dur_p);
    c_playhead = get_track_play_step(raw_step_p, len_p, 1920[tr_p], tr_p);
    playhead_page = floor(c_playhead / 16);
    (playhead_page == step_page) ? (
      playhead_sub_step = c_playhead % 16;
      bx_ph = screen_grid_x + playhead_sub_step * box_pitch_px;
      by_ph = Y(ry_p + 6);
      gx_ph = bx_ph + 1;
      gy_ph = by_ph + 1;
      gw_ph = box_w_px - 2;
      gh_ph = box_h_px - 2;
      ph_step_offset = tr_p * 64 + c_playhead;
      euc_mode && (4600[tr_p] == 4 || (gui_master_len != 0 && 1860[tr_p] > 0)) ? (
        disp_fill_p = 1860[tr_p] + (4600[tr_p] == 4 ? floor(4740[tr_p] * (len_p * 0.5) + 0.5) : 0);
        disp_fill_p = min(len_p, max(0, disp_fill_p));
        ph_active = eval_euclidean_step(c_playhead, len_p, disp_fill_p);
      ) : (
        ph_active = 10000[ph_step_offset];
      );
      ph_active ? (
        get_track_color(tr_p);
        vel_p = 12000[ph_step_offset];
        vel_p <= 0 ? vel_p = 100;
        4600[tr_p] == 7 ? (
          vel_p = min(127, max(1, floor(vel_p + 4740[tr_p] * 64.0 + 0.5)));
        );
        visual_track_vol = 1940[tr_p];
        4600[tr_p] == 61 ? visual_track_vol = min(100, max(0, floor(visual_track_vol + 4740[tr_p] * 50.0 + 0.5)));
        vel_p = floor(vel_p * (visual_track_vol / 100.0) * (master_vol / 100.0) + 0.5);
        vel_alpha_p = max(0.25, vel_p / 127.0);

        gfx_r = min(1.0, cr * 1.35 * vel_alpha_p + 0.15);
        gfx_g = min(1.0, cg * 1.35 * vel_alpha_p + 0.15);
        gfx_b = min(1.0, cb * 1.35 * vel_alpha_p + 0.15);
        gfx_a = 1.0;
        gfx_line(gx_ph + 1, gy_ph, gx_ph + gw_ph - 2, gy_ph);
        gfx_rect(gx_ph, gy_ph + 1, gw_ph, gh_ph - 2);
        gfx_line(gx_ph + 1, gy_ph + gh_ph - 1, gx_ph + gw_ph - 2, gy_ph + gh_ph - 1);

        gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
        gfx_a = 0.25;
        gfx_line(gx_ph + 1, gy_ph, gx_ph + gw_ph - 2, gy_ph);
        gfx_a = 1.0;
      ) : (
        gfx_r = 105 / 255.0; gfx_g = 115 / 255.0; gfx_b = 130 / 255.0;
        gfx_a = 1.0;
        gfx_line(gx_ph + 1, gy_ph, gx_ph + gw_ph - 2, gy_ph);
        gfx_rect(gx_ph, gy_ph + 1, gw_ph, gh_ph - 2);
        gfx_line(gx_ph + 1, gy_ph + gh_ph - 1, gx_ph + gw_ph - 2, gy_ph + gh_ph - 1);

        gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
        gfx_a = 0.25;
        gfx_line(gx_ph + 1, gy_ph, gx_ph + gw_ph - 2, gy_ph);
        gfx_a = 1.0;
      );
    );

    row_p += 1;
  );
);

// Bilingual tooltip engine (ITA / ENG)
kb_hov ? (
  info_lang == 0 ? (
    #tt_title = "QUANTIZZATORE";
    #tt_desc = "Clicca sui tasti per attivare o disattivare le note consentite. Il sequencer suonera solo le note attive.";
  ) : (
    #tt_title = "QUANTIZER";
    #tt_desc = "Click keys to enable or disable allowed notes. The sequencer will only play active scale notes.";
  );
) :
root_hov ? (
  info_lang == 0 ? (
    #tt_title = "NOTA FONDAMENTALE";
