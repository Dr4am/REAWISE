// 1. TIPS button
info_hov = m_x >= 4 && m_x <= 40 && m_y >= 388 && m_y <= 410;
is_info_pressed = (mouse_cap & 1) && info_hov;

info_mode ? (
  is_info_pressed ? (
    gfx_r = 65 / 255; gfx_g = 145 / 255; gfx_b = 200 / 255;
  ) : (
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  );
  fill_roundrect(X(4), Y(388), W(36), H(22), W(3));
  set_border_color(info_hov);
  gfx_roundrect(X(4), Y(388), W(36), H(22), W(3), 1);
  gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
) : (
  is_info_pressed ? (
    gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
  ) : (
    gfx_r = 0.16; gfx_g = 0.16; gfx_b = 0.18;
  );
  fill_roundrect(X(4), Y(388), W(36), H(22), W(3));
  set_border_color(info_hov);
  gfx_roundrect(X(4), Y(388), W(36), H(22), W(3), 1);
  gfx_r = 200 / 255; gfx_g = 200 / 255; gfx_b = 200 / 255;
);
gfx_setfont(8, "Inter", sz_btn, 0);
gfx_measurestr("TIPS", info_w, info_h);
gfx_x = X(4) + floor((W(36) - info_w) * 0.5);
gfx_y = Y(388) + floor((H(22) - info_h) * 0.5) + sb_txt_y_off + (is_info_pressed ? 1 : 0);
gfx_drawstr("TIPS");

// 2. Language button (ITA / ENG)
lang_hov = m_x >= 4 && m_x <= 40 && m_y >= 414 && m_y <= 436;
is_lang_pressed = (mouse_cap & 1) && lang_hov;

is_lang_pressed ? (
  gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
) : (
  gfx_r = 0.16; gfx_g = 0.16; gfx_b = 0.18;
);
fill_roundrect(X(4), Y(414), W(36), H(22), W(3));
set_border_color(lang_hov);
gfx_roundrect(X(4), Y(414), W(36), H(22), W(3), 1);

info_mode ? (
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
) : (
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
);

info_lang == 0 ? (
  #lang_str = "ITA";
) : (
  #lang_str = "ENG";
);
gfx_setfont(8, "Inter", sz_btn, 0);
gfx_measurestr(#lang_str, l_w, l_h);
gfx_x = X(4) + floor((W(36) - l_w) * 0.5);
gfx_y = Y(414) + floor((H(22) - l_h) * 0.5) + sb_txt_y_off + (is_lang_pressed ? 1 : 0);
gfx_drawstr(#lang_str);
gfx_setfont(1, "Inter", sz_main, 'B');

// Vertical drag adjustments
mouse_cap & 1 ? (
  drag_mode > 0 ? (
    delta = drag_start_y - m_y;
    drag_mode == 1 ? (
      delta = drag_start_y - m_y;
      abs(delta) >= 6 ? (
        step_delta = delta > 0 ? floor(delta / 6) : -floor(-delta / 6);
        dir = (step_delta > 0) ? 1 : -1;
        cnt = abs(step_delta);
        p_val = 1600[drag_tr];
        k_d = 0;
        while (k_d < cnt) (
          p_val = get_next_scale_pitch(p_val, dir);
          k_d += 1;
        );
        1600[drag_tr] = p_val;
        drag_start_y = m_y;
      );
    ) :
    drag_mode == 2 ? (
      1620[drag_tr] = min(16, max(0, drag_start_val + floor(delta / 8)));
    ) :
    drag_mode == 3 ? (
      1640[drag_tr] = min(10, max(0, drag_start_val + floor(delta / 12)));
    ) :
    drag_mode == 4 ? (
      1660[drag_tr] = min(64, max(1, drag_start_val + floor(delta / 6)));
      1860[drag_tr] > 1660[drag_tr] ? 1860[drag_tr] = 1660[drag_tr];
    ) :
    drag_mode == 5 ? (
      delta = drag_start_y - m_y;
      abs(delta) >= 2 ? (
        step_delta = delta > 0 ? floor(delta / 2) : -floor(-delta / 2);
        1720[drag_tr] = min(100, max(0, 1720[drag_tr] + step_delta));
        drag_start_y = m_y;
      );
    ) :
    drag_mode == 6 ? (
      delta = drag_start_y - m_y;
      abs(delta) >= 2 ? (
        step_delta = delta > 0 ? floor(delta / 2) : -floor(-delta / 2);
        1740[drag_tr] = min(100, max(-100, 1740[drag_tr] + step_delta));
        drag_start_y = m_y;
      );
    ) :
    drag_mode == 7 ? (
      cur_l = 1660[drag_tr];
      cur_l <= 0 ? cur_l = 16;
      cur_l > 64 ? cur_l = 64;
      new_f = min(cur_l, max(0, drag_start_val + floor(delta / 6)));
      1860[drag_tr] = new_f;
      euc_mode ? apply_euclidean_track(drag_tr);
    ) :
    drag_mode == 8 ? (
      delta = drag_start_y - m_y;
      abs(delta) >= 8 ? (
        step_delta = delta > 0 ? floor(delta / 8) : -floor(-delta / 8);
        set_quant_root(quant_root + step_delta);
        drag_start_y = m_y;
      );
    ) :
    drag_mode == 9 ? (
      delta = drag_start_y - m_y;
      abs(delta) >= 12 ? (
        step_delta = delta > 0 ? 1 : -1;
        next_s = quant_scale + step_delta;
        next_s < 0 ? ( next_s = next_s + 3; );
        next_s >= 3 ? ( next_s = next_s - 3; );
        set_quant_scale(next_s);
        drag_start_y = m_y;
      );
    ) :
    drag_mode == 10 ? (
      delta = drag_start_y - m_y;
      abs(delta) >= 10 ? (
        step_delta = delta < 0 ? 1 : -1;
        1920[drag_tr] = min(3, max(0, 1920[drag_tr] + step_delta));
        drag_start_y = m_y;
        gui_dirty = 1;
      );
    ) :
    drag_mode == 11 ? (
      4520[lfo_cur_tr] ? (
        4540[lfo_cur_tr] = min(11, max(0, floor(drag_start_val + delta / 10)));
      ) : (
        new_hz = floor((drag_start_val + delta * 0.05) * 10 + 0.5) / 10.0;
        4560[lfo_cur_tr] = min(20.0, max(0.1, new_hz));
      );
      gui_dirty = 1;
    ) :
    drag_mode == 12 ? (
      4500[lfo_cur_tr] = min(5, max(0, floor(drag_start_val - delta / 12)));
      gui_dirty = 1;
    ) :
    drag_mode == 14 ? (
      delta = drag_start_y - m_y;
      abs(delta) >= 8 ? (
        step_delta = delta > 0 ? 1 : -1;
        4600[lfo_cur_tr] = get_next_lfo_dest(4600[lfo_cur_tr], step_delta, lfo_cur_tr);
        drag_start_y = m_y;
      );
      gui_dirty = 1;
    ) :
    drag_mode == 15 ? (
      delta = drag_start_y - m_y;
      step_scale = (mouse_cap & 8) ? 0.2 : 0.75;
      4620[lfo_cur_tr] = min(100, max(0, floor(drag_start_val + delta * step_scale + 0.5)));
      gui_dirty = 1;
    ) :
    drag_mode == 16 ? (
      lfo_cur_tr = min(15, max(0, floor(drag_start_val - delta / 10)));
      gui_dirty = 1;
    );
  );
) : (
  drag_mode = 0;
  drag_tr = -1;
  step_paint_mode = -1;
  last_painted_offset = -1;
  mouse_clicked = 0;
);

// Top horizontal separator line (Y: 48)
gfx_r = 64 / 255.0; gfx_g = 64 / 255.0; gfx_b = 64 / 255.0;
gfx_line(sb_w + W(6), Y(48), cur_w - W(6), Y(48));

// Reset step hover state for bottom bar readout
hov_step_tr = -1;
hov_step_num = -1;

row_idx = 0;
while (row_idx < TRACKS_PER_PAGE) (
  tr = current_page * 8 + row_idx;
  ry = 52 + row_idx * 44;
  get_track_color(tr);

  gfx_r = 64 / 255.0; gfx_g = 64 / 255.0; gfx_b = 64 / 255.0;
  gfx_line(sb_w + W(6), Y(ry + 40), cur_w - W(6), Y(ry + 40));

  // Solo (S)
  is_s = 1680[tr];
  s_hov = m_x >= 52 && m_x <= 72 && m_y >= ry + 6 && m_y <= ry + 30;
  is_s_pressed = (mouse_cap & 1) && s_hov;
  gfx_mode = 0;
  is_s ? (
    is_s_pressed ? (
      gfx_r = 195 / 255.0; gfx_g = 156 / 255.0; gfx_b = 53 / 255.0;
    ) : (
      gfx_r = 244 / 255.0; gfx_g = 195 / 255.0; gfx_b = 67 / 255.0;
    );
    fill_roundrect(X(52), Y(ry + 6), W(20), H(24), W(3));
    set_border_color(s_hov);
    gfx_roundrect(X(52), Y(ry + 6), W(20), H(24), W(3), 1);
    gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
  ) : (
    is_s_pressed ? (
      gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
    ) : (
      gfx_r = 0.16; gfx_g = 0.16; gfx_b = 0.18;
    );
    fill_roundrect(X(52), Y(ry + 6), W(20), H(24), W(3));
    set_border_color(s_hov);
    gfx_roundrect(X(52), Y(ry + 6), W(20), H(24), W(3), 1);
    gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
  );
  gfx_setfont(8, "Inter", sz_btn, 0);
  gfx_measurestr("S", s_w, s_h);
  s_x_offset = max(1, floor(1 * sx));
  gfx_x = X(52) + floor((W(20) - s_w) * 0.5) + s_x_offset;
  gfx_y = Y(ry + 6) + floor((H(24) - s_h) * 0.5) + max(1, floor(1 * sy)) + (is_s_pressed ? 1 : 0);
  gfx_drawstr("S");

  // Mute (M)
  is_m = 1700[tr];
  m_hov = m_x >= 76 && m_x <= 96 && m_y >= ry + 6 && m_y <= ry + 30;
  is_m_pressed = (mouse_cap & 1) && m_hov;
  gfx_mode = 0;
  is_m ? (
    is_m_pressed ? (
      gfx_r = 145 / 255.0; gfx_g = 35 / 255.0; gfx_b = 52 / 255.0;
    ) : (
      gfx_r = 183 / 255.0; gfx_g = 44 / 255.0; gfx_b = 65 / 255.0;
    );
    fill_roundrect(X(76), Y(ry + 6), W(20), H(24), W(3));
    set_border_color(m_hov);
    gfx_roundrect(X(76), Y(ry + 6), W(20), H(24), W(3), 1);
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  ) : (
    is_m_pressed ? (
      gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
    ) : (
      gfx_r = 0.16; gfx_g = 0.16; gfx_b = 0.18;
    );
    fill_roundrect(X(76), Y(ry + 6), W(20), H(24), W(3));
    set_border_color(m_hov);
    gfx_roundrect(X(76), Y(ry + 6), W(20), H(24), W(3), 1);
    gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
  );
  gfx_setfont(8, "Inter", sz_btn, 0);
  gfx_measurestr("M", m_w, m_h);
  m_x_offset = max(1, floor(1 * sx));
  gfx_x = X(76) + floor((W(20) - m_w) * 0.5) + m_x_offset;
  gfx_y = Y(ry + 6) + floor((H(24) - m_h) * 0.5) + max(1, floor(1 * sy)) + (is_m_pressed ? 1 : 0);
  gfx_drawstr("M");
  gfx_setfont(1, "Inter", sz_main, 'B');

  // Channel Box
  ch_val = 1620[tr];
  ch_hov = m_x >= 100 && m_x <= 146 && m_y >= ry + 6 && m_y <= ry + 30;
  bx_ch = X(100); bw_ch = W(46); by_ch = Y(ry + 6); bh_ch = H(24);
  (edit_active == 1 && edit_tr == tr) ? (
    gfx_r = 0.12; gfx_g = 0.22; gfx_b = 0.32;
    fill_roundrect(bx_ch, by_ch, bw_ch, bh_ch, W(3));
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    gfx_roundrect(bx_ch, by_ch, bw_ch, bh_ch, W(3), 1);
    gfx_setfont(9, "Inter Light", sz_param, 0);
    strcpy(#draw_buf, #edit_buf);
    gfx_measurestr(#draw_buf, db_w, db_h);
    dt_x = bx_ch + floor((bw_ch - db_w) * 0.5);
    dt_y = by_ch + floor((bh_ch - db_h) * 0.5);
    edit_first_key ? (
      gfx_r = 0.22; gfx_g = 0.45; gfx_b = 0.75;
      gfx_rect(dt_x - W(2), dt_y - H(1), db_w + W(4), db_h + H(2));
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    ) : (
      (time_precise() * 2) % 1 < 0.5 ? strcat(#draw_buf, "|");
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    );
    gfx_x = dt_x; gfx_y = dt_y;
    gfx_drawstr(#draw_buf);
  ) : (
    set_border_color(ch_hov);
    gfx_roundrect(bx_ch, by_ch, bw_ch, bh_ch, W(3), 1);

    ch_val == 0 ? (
      #ch_num_str = "ALL";
    ) : (
      sprintf(#ch_num_str, "%d", ch_val);
    );
    gfx_setfont(9, "Inter Light", sz_param, 0);
    gfx_measurestr("Ch", ch_lbl_w, ch_h);
    gfx_measurestr(#ch_num_str, ch_val_w, ch_h);
    ch_gap = max(3, floor(3.5 * scale_font));
    tot_ch_w = ch_lbl_w + ch_gap + ch_val_w;

    start_ch_x = bx_ch + floor((bw_ch - tot_ch_w) * 0.5);
    start_ch_y = by_ch + floor((bh_ch - ch_h) * 0.5);

    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    gfx_x = start_ch_x; gfx_y = start_ch_y;
    gfx_drawstr("Ch");

    ch_val == 0 ? (
      gfx_r = 244 / 255.0; gfx_g = 195 / 255.0; gfx_b = 67 / 255.0;
    ) : (
      gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
    );
    gfx_x = start_ch_x + ch_lbl_w + ch_gap; gfx_y = start_ch_y;
    gfx_drawstr(#ch_num_str);
  );
  gfx_setfont(1, "Inter", sz_main, 'B');

  // Pitch Box
  pitch_hov = m_x >= 150 && m_x <= 188 && m_y >= ry + 6 && m_y <= ry + 30;
  bx_p = X(150); bw_p = W(38); by_p = Y(ry + 6); bh_p = H(24);
  (edit_active == 2 && edit_tr == tr) ? (
    gfx_r = 0.12; gfx_g = 0.22; gfx_b = 0.32;
    fill_roundrect(bx_p, by_p, bw_p, bh_p, W(3));
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    gfx_roundrect(bx_p, by_p, bw_p, bh_p, W(3), 1);
    gfx_setfont(9, "Inter Light", sz_param, 0);
    strcpy(#draw_buf, #edit_buf);
    gfx_measurestr(#draw_buf, db_w, db_h);
    dt_x = bx_p + floor((bw_p - db_w) * 0.5);
    dt_y = by_p + floor((bh_p - db_h) * 0.5);
    edit_first_key ? (
      gfx_r = 0.22; gfx_g = 0.45; gfx_b = 0.75;
      gfx_rect(dt_x - W(2), dt_y - H(1), db_w + W(4), db_h + H(2));
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    ) : (
      (time_precise() * 2) % 1 < 0.5 ? strcat(#draw_buf, "|");
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    );
    gfx_x = dt_x; gfx_y = dt_y;
    gfx_drawstr(#draw_buf);
  ) : (
    set_border_color(pitch_hov);
    gfx_roundrect(bx_p, by_p, bw_p, bh_p, W(3), 1);
    gfx_r = 0.65; gfx_g = 0.65; gfx_b = 0.70;
    disp_pitch = 1600[tr];
    4600[tr] == 1 ? (
      disp_pitch = min(108, max(24, floor(disp_pitch + 4740[tr] * 12.0 + 0.5)));
      disp_pitch = quantize_pitch(disp_pitch);
    );
    draw_note_name_centered(disp_pitch, bx_p, by_p, bw_p, bh_p);
  );

  // Rate Box
  rate_hov = m_x >= 192 && m_x <= 226 && m_y >= ry + 6 && m_y <= ry + 30;
  bx_r = X(192); bw_r = W(34); by_r = Y(ry + 6); bh_r = H(24);
  (edit_active == 3 && edit_tr == tr) ? (
    gfx_r = 0.12; gfx_g = 0.22; gfx_b = 0.32;
    fill_roundrect(bx_r, by_r, bw_r, bh_r, W(3));
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    gfx_roundrect(bx_r, by_r, bw_r, bh_r, W(3), 1);
    gfx_setfont(9, "Inter Light", sz_param, 0);
    strcpy(#draw_buf, #edit_buf);
    gfx_measurestr(#draw_buf, db_w, db_h);
    dt_x = bx_r + floor((bw_r - db_w) * 0.5);
    dt_y = by_r + floor((bh_r - db_h) * 0.5);
    edit_first_key ? (
      gfx_r = 0.22; gfx_g = 0.45; gfx_b = 0.75;
      gfx_rect(dt_x - W(2), dt_y - H(1), db_w + W(4), db_h + H(2));
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    ) : (
      (time_precise() * 2) % 1 < 0.5 ? strcat(#draw_buf, "|");
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    );
    gfx_x = dt_x; gfx_y = dt_y;
    gfx_drawstr(#draw_buf);
  ) : (
    set_border_color(rate_hov);
    gfx_roundrect(bx_r, by_r, bw_r, bh_r, W(3), 1);

    r_idx = 1640[tr];
    4600[tr] == 2 ? (
      r_idx = min(10, max(0, floor(r_idx + 4740[tr] * 3.0 + 0.5)));
    );
    r_idx == 0 ? ( #r_sym = "/"; #r_num = "16"; ) :
    r_idx == 1 ? ( #r_sym = "/"; #r_num = "12"; ) :
    r_idx == 2 ? ( #r_sym = "/"; #r_num = "8";  ) :
    r_idx == 3 ? ( #r_sym = "/"; #r_num = "4";  ) :
    r_idx == 4 ? ( #r_sym = "/"; #r_num = "2";  ) :
    r_idx == 5 ? ( #r_sym = "x"; #r_num = "1";  ) :
    r_idx == 6 ? ( #r_sym = "x"; #r_num = "2";  ) :
    r_idx == 7 ? ( #r_sym = "x"; #r_num = "4";  ) :
    r_idx == 8 ? ( #r_sym = "x"; #r_num = "8";  ) :
    r_idx == 9 ? ( #r_sym = "x"; #r_num = "12"; ) :
                 ( #r_sym = "x"; #r_num = "16"; );

    gfx_setfont(9, "Inter Light", sz_param, 0);
    has_sym = strlen(#r_sym) > 0;
    has_sym ? (
      gfx_measurestr(" ", r_spc_w, r_spc_h);
      gfx_measurestr(#r_sym, sym_w, sym_h);
    ) : (
      r_spc_w = 0; sym_w = 0; sym_h = 0;
    );
    gfx_measurestr(#r_num, num_w, num_h);
    tot_rate_w = sym_w + r_spc_w + num_w;
    max_rate_h = max(sym_h, num_h);

    start_rate_x = bx_r + floor((bw_r - tot_rate_w) * 0.5);
    start_rate_y = by_r + floor((bh_r - max_rate_h) * 0.5);

    has_sym ? (
      gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
      gfx_x = start_rate_x; gfx_y = start_rate_y;
      gfx_drawstr(#r_sym);
    );

    gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
    gfx_x = start_rate_x + sym_w + r_spc_w; gfx_y = start_rate_y;
    gfx_drawstr(#r_num);
  );
  gfx_setfont(1, "Inter", sz_main, 'B');

  // Length Box (1..64)
  len_hov = m_x >= 230 && m_x <= 268 && m_y >= ry + 6 && m_y <= ry + 30;
  bx_l = X(230); bw_l = W(38); by_l = Y(ry + 6); bh_l = H(24);
  (edit_active == 4 && edit_tr == tr) ? (
    gfx_r = 0.12; gfx_g = 0.22; gfx_b = 0.32;
    fill_roundrect(bx_l, by_l, bw_l, bh_l, W(3));
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    gfx_roundrect(bx_l, by_l, bw_l, bh_l, W(3), 1);
    gfx_setfont(9, "Inter Light", sz_param, 0);
    strcpy(#draw_buf, #edit_buf);
    gfx_measurestr(#draw_buf, db_w, db_h);
    dt_x = bx_l + floor((bw_l - db_w) * 0.5);
    dt_y = by_l + floor((bh_l - db_h) * 0.5);
    edit_first_key ? (
      gfx_r = 0.22; gfx_g = 0.45; gfx_b = 0.75;
      gfx_rect(dt_x - W(2), dt_y - H(1), db_w + W(4), db_h + H(2));
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    ) : (
      (time_precise() * 2) % 1 < 0.5 ? strcat(#draw_buf, "|");
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    );
    gfx_x = dt_x; gfx_y = dt_y;
    gfx_drawstr(#draw_buf);
  ) : (
    set_border_color(len_hov);
    gfx_roundrect(bx_l, by_l, bw_l, bh_l, W(3), 1);

    gfx_setfont(9, "Inter Light", sz_param, 0);
    4600[tr] == 3 ? (
      cur_l_raw = 1660[tr]; cur_l_raw <= 0 ? cur_l_raw = 16;
      disp_l = min(64, max(1, floor(cur_l_raw + 4740[tr] * 16.0 + 0.5)));
      sprintf(#len_num_str, "%d", disp_l);
    ) : (
      sprintf(#len_num_str, "%d", 1660[tr]);
    );
    gfx_measurestr("S", l_lbl_w, l_h);
    gfx_measurestr(#len_num_str, l_num_w, l_h);
    l_gap = max(3, floor(3.5 * scale_font));
    tot_len_w = l_lbl_w + l_gap + l_num_w;

    start_len_x = bx_l + floor((bw_l - tot_len_w) * 0.5);
    start_len_y = by_l + floor((bh_l - l_h) * 0.5);

    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    gfx_x = start_len_x; gfx_y = start_len_y;
    gfx_drawstr("S");

    gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
    gfx_x = start_len_x + l_lbl_w + l_gap; gfx_y = start_len_y;
    gfx_drawstr(#len_num_str);
  );
  gfx_setfont(1, "Inter", sz_main, 'B');

  // Euclidean Fill Box
  fill_hov = euc_mode && (m_x >= 272 && m_x <= 310 && m_y >= ry + 6 && m_y <= ry + 30);
  bx_f = X(272); bw_f = W(38); by_f = Y(ry + 6); bh_f = H(24);

  (edit_active == 7 && edit_tr == tr) ? (
    gfx_r = 0.12; gfx_g = 0.22; gfx_b = 0.32;
    fill_roundrect(bx_f, by_f, bw_f, bh_f, W(3));
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    gfx_roundrect(bx_f, by_f, bw_f, bh_f, W(3), 1);
    gfx_setfont(9, "Inter Light", sz_param, 0);
    strcpy(#draw_buf, #edit_buf);
    gfx_measurestr(#draw_buf, db_w, db_h);
    dt_x = bx_f + floor((bw_f - db_w) * 0.5);
    dt_y = by_f + floor((bh_f - db_h) * 0.5);
    edit_first_key ? (
      gfx_r = 0.22; gfx_g = 0.45; gfx_b = 0.75;
      gfx_rect(dt_x - W(2), dt_y - H(1), db_w + W(4), db_h + H(2));
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    ) : (
      (time_precise() * 2) % 1 < 0.5 ? strcat(#draw_buf, "|");
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    );
    gfx_x = dt_x; gfx_y = dt_y;
    gfx_drawstr(#draw_buf);
  ) : (
    euc_mode ? (
      gfx_r = 0.15; gfx_g = 0.15; gfx_b = 0.17;
      fill_roundrect(bx_f, by_f, bw_f, bh_f, W(3));
      set_border_color(fill_hov);
      gfx_roundrect(bx_f, by_f, bw_f, bh_f, W(3), 1);
    ) : (
      gfx_r = 0.12; gfx_g = 0.12; gfx_b = 0.14;
      fill_roundrect(bx_f, by_f, bw_f, bh_f, W(3));
      gfx_r = 48 / 255.0; gfx_g = 48 / 255.0; gfx_b = 48 / 255.0;
      gfx_roundrect(bx_f, by_f, bw_f, bh_f, W(3), 1);
    );

    gfx_setfont(9, "Inter Light", sz_param, 0);
    euc_mode && (4600[tr] == 4) ? (
      cur_l_disp = 1660[tr]; cur_l_disp <= 0 ? cur_l_disp = 16;
      disp_fill = 1860[tr] + floor(4740[tr] * (cur_l_disp * 0.5) + 0.5);
      disp_fill = min(cur_l_disp, max(0, disp_fill));
      sprintf(#fill_num_str, "%d", disp_fill);
    ) : (
      sprintf(#fill_num_str, "%d", 1860[tr]);
    );
    gfx_measurestr("F", f_lbl_w, f_h);
    gfx_measurestr(#fill_num_str, f_num_w, f_h);
    f_gap = max(3, floor(3.5 * scale_font));
    tot_fill_w = f_lbl_w + f_gap + f_num_w;

    start_fill_x = bx_f + floor((bw_f - tot_fill_w) * 0.5);
    start_fill_y = by_f + floor((bh_f - f_h) * 0.5);

    euc_mode ? (
      gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    ) : (
      gfx_r = 100 / 255; gfx_g = 100 / 255; gfx_b = 100 / 255;
    );
    gfx_x = start_fill_x; gfx_y = start_fill_y;
    gfx_drawstr("F");

    euc_mode ? (
      gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
    ) : (
      gfx_r = 100 / 255; gfx_g = 100 / 255; gfx_b = 100 / 255;
    );
    gfx_x = start_fill_x + f_lbl_w + f_gap; gfx_y = start_fill_y;
    gfx_drawstr(#fill_num_str);
  );
  gfx_setfont(1, "Inter", sz_main, 'B');

  rate_idx = 1640[tr];
  4600[tr] == 2 ? (
    rate_idx = min(10, max(0, floor(rate_idx + 4740[tr] * 3.0 + 0.5)));
  );
  step_beat_dur = get_beats_per_step(rate_idx);
  len = 1660[tr];
  len <= 0 ? len = 16;
  4600[tr] == 3 ? (
    len = min(64, max(1, floor(len + 4740[tr] * 16.0 + 0.5)));
  );
  base_off = rate_idx == 10 ? -5 : (rate_idx == 9 ? -4 : (rate_idx == 8 ? -2 : (rate_idx >= 7 ? -1 : 0)));
  raw_ph = 1760[tr] + base_off + 1900[tr];
  cur_playhead = get_track_play_step(raw_ph, len, 1920[tr], tr);

  // 16-step grid
  step = 0;
  while (step < 16) (
    cur_bx = screen_grid_x + step * box_pitch_px;
    cur_by = Y(ry + 6);
    global_step = step_page * 16 + step;
    step_offset = tr * 64 + global_step;

    euc_mode && (4600[tr] == 4) ? (
      disp_fill = 1860[tr] + floor(4740[tr] * (len * 0.5) + 0.5);
      disp_fill = min(len, max(0, disp_fill));
      active = eval_euclidean_step(global_step, len, disp_fill);
    ) : (
      active = 10000[step_offset];
    );
    vel = 12000[step_offset];
    vel <= 0 ? vel = 100;
    4600[tr] == 7 ? (
      vel = min(127, max(1, floor(vel + 4740[tr] * 64.0 + 0.5)));
    );

    is_playhead = (play_state & 1) && (cur_playhead == global_step);
    is_in_range = (global_step < len);
    step_hov = mouse_x >= cur_bx && mouse_x <= cur_bx + box_w_px && mouse_y >= cur_by && mouse_y <= cur_by + box_h_px;

    is_in_range ? (
      is_quarter = (global_step % 4 == 0);

      step_hov ? (
        hov_step_tr = tr;
        hov_step_num = global_step;
      );

      active ? (
        vel_alpha = max(0.2, vel / 127);
        gfx_r = cr * vel_alpha;
        gfx_g = cg * vel_alpha;
        gfx_b = cb * vel_alpha;
        gfx_a = 1.0;
        gfx_rect(cur_bx, cur_by, box_w_px, box_h_px);

        gate_mode ? (
          step_gate_idx = 16000[step_offset];
          (step_gate_idx < 0 || step_gate_idx > 68) ? step_gate_idx = 4;
          4600[tr] == 8 ? (
            step_gate_idx = min(68, max(0, floor(step_gate_idx + 4740[tr] * 34.0 + 0.5)));
          );

          avail_gw = box_w_px - 2;
          // Mappatura biiettiva continua e strettamente crescente su tutti i 69 step (0..68)
          gate_line_w = max(2, min(avail_gw, floor(2.0 + (step_gate_idx / 68.0) * (avail_gw - 2.0) + 0.5)));

          gate_line_y = cur_by + floor(box_h_px * 0.5);
          gfx_r = min(1.0, cr * 1.35 + 0.25);
          gfx_g = min(1.0, cg * 1.35 + 0.25);
          gfx_b = min(1.0, cb * 1.35 + 0.25);
          gfx_a = 1.0;
          gfx_line(cur_bx + 1, gate_line_y, cur_bx + 1 + gate_line_w, gate_line_y);
          box_h_px >= 20 ? (
            gfx_line(cur_bx + 1, gate_line_y + 1, cur_bx + 1 + gate_line_w, gate_line_y + 1);
          );
        );

        pan_mode ? (
          step_pan = 14000[step_offset];
          step_pan <= 0 && step_pan != 0 ? step_pan = 64;
          4600[tr] == 9 ? (
            step_pan = min(127, max(0, floor(step_pan + 4740[tr] * 64.0 + 0.5)));
          );
          pan_tick_x = cur_bx + 2 + floor((box_w_px - 4) * (step_pan / 127.0));
          gfx_r = min(1.0, cr * 1.35 + 0.25);
          gfx_g = min(1.0, cg * 1.35 + 0.25);
          gfx_b = min(1.0, cb * 1.35 + 0.25);
          gfx_a = 1.0;
          gfx_line(pan_tick_x, cur_by + 3, pan_tick_x, cur_by + box_h_px - 3);
          box_w_px >= 20 ? (
            gfx_line(pan_tick_x + 1, cur_by + 3, pan_tick_x + 1, cur_by + box_h_px - 3);
          );
        );

        timing_mode ? (
          step_timing = 18000[step_offset];
          4600[tr] == 10 ? (
            step_timing = min(50, max(-50, floor(step_timing + 4740[tr] * 50.0 + 0.5)));
          );
          timing_norm = (step_timing + 50) / 100.0;
          timing_tick_x = cur_bx + 2 + floor((box_w_px - 4) * timing_norm);
          gfx_r = min(1.0, cr * 1.35 + 0.25);
          gfx_g = min(1.0, cg * 1.35 + 0.25);
          gfx_b = min(1.0, cb * 1.35 + 0.25);
          gfx_a = 1.0;
          gfx_line(timing_tick_x, cur_by + 3, timing_tick_x, cur_by + box_h_px - 3);
          box_w_px >= 20 ? (
            gfx_line(timing_tick_x + 1, cur_by + 3, timing_tick_x + 1, cur_by + box_h_px - 3);
          );
        );

        chance_mode ? (
          st_chance_val = 22000[step_offset];
          4600[tr] == 12 ? (
            st_chance_val = min(100, max(0, floor(st_chance_val + 4740[tr] * 50.0 + 0.5)));
          );
          st_chance_val > 0 ? (
            chance_line_h = floor((box_h_px - 4) * (st_chance_val / 100.0));
            chance_line_h = max(2, chance_line_h);
            chance_tick_x = cur_bx + floor(box_w_px * 0.5);
            chance_bottom = cur_by + box_h_px - 2;
            gfx_r = min(1.0, cr * 1.35 + 0.25);
            gfx_g = min(1.0, cg * 1.35 + 0.25);
            gfx_b = min(1.0, cb * 1.35 + 0.25);
            gfx_a = 1.0;
            gfx_line(chance_tick_x, chance_bottom, chance_tick_x, chance_bottom - chance_line_h);
            box_w_px >= 20 ? (
              gfx_line(chance_tick_x + 1, chance_bottom, chance_tick_x + 1, chance_bottom - chance_line_h);
            );
          );
        );

        cond_mode ? (
          cnd_idx = 24000[step_offset];
          get_cond_str(cnd_idx);
          gfx_setfont(3, "Inter", sz_sub, 'B');
          gfx_measurestr(#c_str, cnd_txt_w, cnd_txt_h);

          // Calibrazione ottica orizzontale specifica per tipologia di condizione
          cnd_idx == 0 ? (
            cnd_x_off = max(1, floor(1.0 * sx));
          ) :
          (cnd_idx >= 1 && cnd_idx <= 35) ? (
            cnd_x_off = max(1, floor(1.0 * sx));
          ) :
          (cnd_idx == 37 || cnd_idx == 39 || cnd_idx == 41 || cnd_idx == 43) ? (
            cnd_x_off = max(1, floor(0.8 * sx));
          ) : (
            cnd_x_off = 0;
          );

          cnd_y_off = max(0, floor(0.8 * sy));

          cnd_draw_x = cur_bx + floor((box_w_px - cnd_txt_w) * 0.5) + cnd_x_off;
          cnd_draw_y = cur_by + floor((box_h_px - cnd_txt_h) * 0.5) + cnd_y_off;

          // Ombra scura per contrasto perfetto su qualsiasi sfondo
          gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.85;
          gfx_x = cnd_draw_x + 1; gfx_y = cnd_draw_y + 1;
          gfx_drawstr(#c_str);

          // Testo luminoso e brillante con il colore della traccia (stile linee PAN)
          cnd_idx > 0 ? (
            gfx_r = min(1.0, cr * 1.35 + 0.30);
            gfx_g = min(1.0, cg * 1.35 + 0.30);
            gfx_b = min(1.0, cb * 1.35 + 0.30);
            gfx_a = 1.0;
          ) : (
            gfx_r = min(1.0, cr * 1.25 + 0.20);
            gfx_g = min(1.0, cg * 1.25 + 0.20);
            gfx_b = min(1.0, cb * 1.25 + 0.20);
            gfx_a = 0.75;
          );
          gfx_x = cnd_draw_x; gfx_y = cnd_draw_y;
          gfx_drawstr(#c_str);
          gfx_a = 1.0;
        );

        ratchet_mode ? (
          step_ratchet = 20000[step_offset];
          (step_ratchet < 1 || step_ratchet > 4) ? step_ratchet = 1;
          4600[tr] == 11 ? (
            step_ratchet = min(4, max(1, floor(step_ratchet + 4740[tr] * 2.0 + 0.5)));
          );
          step_ratchet > 1 ? (
            gfx_r = min(1.0, cr * 1.35 + 0.25);
            gfx_g = min(1.0, cg * 1.35 + 0.25);
            gfx_b = min(1.0, cb * 1.35 + 0.25);
            gfx_a = 1.0;
            step_ratchet == 2 ? (
              div_x = cur_bx + floor(box_w_px * 0.5);
              gfx_rect(div_x, cur_by + 1, 1, box_h_px - 2);
            ) :
            step_ratchet == 3 ? (
              div_1_x = cur_bx + floor((box_w_px - 1) * (1.0 / 3.0));
              div_2_x = cur_bx + floor((box_w_px - 1) * (2.0 / 3.0) + 0.5);
              gfx_rect(div_1_x, cur_by + 1, 1, box_h_px - 2);
              gfx_rect(div_2_x, cur_by + 1, 1, box_h_px - 2);
            ) : (
              div_1_x = cur_bx + floor((box_w_px - 1) * 0.25);
              div_2_x = cur_bx + floor(box_w_px * 0.5);
              div_3_x = cur_bx + floor((box_w_px - 1) * 0.75 + 0.5);
              gfx_rect(div_1_x, cur_by + 1, 1, box_h_px - 2);
              gfx_rect(div_2_x, cur_by + 1, 1, box_h_px - 2);
              gfx_rect(div_3_x, cur_by + 1, 1, box_h_px - 2);
            );
          );
        );

        step_hov ? (
          gfx_r = min(1.0, cr * 1.35); gfx_g = min(1.0, cg * 1.35); gfx_b = min(1.0, cb * 1.35);
        ) : (
          gfx_r = cr; gfx_g = cg; gfx_b = cb;
        );
        gfx_roundrect(cur_bx, cur_by, box_w_px, box_h_px, W(2), 0);
      ) : (
        gfx_r = 28 / 255.0; gfx_g = 28 / 255.0; gfx_b = 28 / 255.0;
        gfx_a = 1.0;
        gfx_rect(cur_bx, cur_by, box_w_px, box_h_px);

        is_quarter ? (
          q_alpha = step_hov ? 0.75 : 0.50;
          gfx_r = cr * q_alpha;
          gfx_g = cg * q_alpha;
          gfx_b = cb * q_alpha;
        ) : (
          set_border_color(step_hov);
        );
        gfx_roundrect(cur_bx, cur_by, box_w_px, box_h_px, W(2), 0);
      );

      mouse_cap & 1 ? (
        drag_mode == 0 ? (
          step_hov ? (
            step_paint_mode < 0 ? (
              undo_push();
              step_paint_mode = !10000[step_offset];
              last_painted_offset = step_offset;
              last_paint_x = mouse_x;
              last_paint_y = mouse_y;
              10000[step_offset] = step_paint_mode;
              12000[step_offset] <= 0 ? 12000[step_offset] = 100;
            );
          );
        );
      );
    ) : (
      gfx_r = 20 / 255.0; gfx_g = 20 / 255.0; gfx_b = 20 / 255.0;
      gfx_roundrect(cur_bx, cur_by, box_w_px, box_h_px, W(3), 1);
      gfx_r = 48 / 255.0; gfx_g = 48 / 255.0; gfx_b = 48 / 255.0;
      gfx_roundrect(cur_bx, cur_by, box_w_px, box_h_px, W(3), 0);
    );

    step += 1;
  );

  // Chance meter (24px)
  chance_x = 787;
  chance_meter_val = 1720[tr];
  4600[tr] == 5 ? (
    chance_meter_val = min(100, max(0, floor(chance_meter_val + 4740[tr] * 50.0 + 0.5)));
  );
  ch_pct = chance_meter_val / 100.0;
  bar_h = H(24);
  fill_h = chance_meter_val > 0 ? max(floor(2 * sy), floor(bar_h * ch_pct)) : 0;

  gfx_r = 28 / 255.0; gfx_g = 28 / 255.0; gfx_b = 28 / 255.0;
  gfx_rect(X(chance_x), Y(ry + 6), W(3), bar_h);

  fill_h > 0 ? (
    gfx_r = cr; gfx_g = cg; gfx_b = cb;
    gfx_rect(X(chance_x), Y(ry + 6) + (bar_h - fill_h), W(3), fill_h);
  );

  // Chance Box
  chance_hov = m_x >= chance_x + 6 && m_x <= chance_x + 50 && m_y >= ry + 6 && m_y <= ry + 30;
  bx_chc = X(chance_x + 6); bw_chc = W(44); by_chc = Y(ry + 6); bh_chc = H(24);
  num_y_off = max(1, floor(1 * sy));
  (edit_active == 5 && edit_tr == tr) ? (
    gfx_r = 0.12; gfx_g = 0.22; gfx_b = 0.32;
    fill_roundrect(bx_chc, by_chc, bw_chc, bh_chc, W(3));
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    gfx_roundrect(bx_chc, by_chc, bw_chc, bh_chc, W(3), 1);
    gfx_setfont(10, "Inter", sz_main, 0);
    strcpy(#draw_buf, #edit_buf);
    gfx_measurestr(#draw_buf, db_w, db_h);
    dt_x = bx_chc + floor((bw_chc - db_w) * 0.5);
    dt_y = by_chc + floor((bh_chc - db_h) * 0.5) + num_y_off;
    edit_first_key ? (
      gfx_r = 0.22; gfx_g = 0.45; gfx_b = 0.75;
      gfx_rect(dt_x - W(2), dt_y - H(1), db_w + W(4), db_h + H(2));
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    ) : (
      (time_precise() * 2) % 1 < 0.5 ? strcat(#draw_buf, "|");
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    );
    gfx_x = dt_x; gfx_y = dt_y;
    gfx_drawstr(#draw_buf);
  ) : (
    set_border_color(chance_hov);
    gfx_roundrect(bx_chc, by_chc, bw_chc, bh_chc, W(3), 1);
    gfx_setfont(10, "Inter", sz_main, 0);
    gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
    sprintf(#chance_str, "%d%%", chance_meter_val);
    gfx_measurestr(#chance_str, ch_w, ch_h);
    gfx_x = bx_chc + floor((bw_chc - ch_w) * 0.5);
    gfx_y = by_chc + floor((bh_chc - ch_h) * 0.5) + num_y_off;
    gfx_drawstr(#chance_str);
  );
  gfx_setfont(1, "Inter", sz_main, 'B');

  // Swing Box
  swing_x = 841;
  swing_hov = m_x >= swing_x && m_x <= swing_x + 48 && m_y >= ry + 6 && m_y <= ry + 30;
  bx_sw = X(swing_x); bw_sw = W(48); by_sw = Y(ry + 6); bh_sw = H(24);
  (edit_active == 6 && edit_tr == tr) ? (
    gfx_r = 0.12; gfx_g = 0.22; gfx_b = 0.32;
    fill_roundrect(bx_sw, by_sw, bw_sw, bh_sw, W(3));
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    gfx_roundrect(bx_sw, by_sw, bw_sw, bh_sw, W(3), 1);
    gfx_setfont(10, "Inter", sz_main, 0);
    strcpy(#draw_buf, #edit_buf);
    gfx_measurestr(#draw_buf, db_w, db_h);
    dt_x = bx_sw + floor((bw_sw - db_w) * 0.5);
    dt_y = by_sw + floor((bh_sw - db_h) * 0.5) + num_y_off;
    edit_first_key ? (
      gfx_r = 0.22; gfx_g = 0.45; gfx_b = 0.75;
      gfx_rect(dt_x - W(2), dt_y - H(1), db_w + W(4), db_h + H(2));
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    ) : (
      (time_precise() * 2) % 1 < 0.5 ? strcat(#draw_buf, "|");
      gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
    );
    gfx_x = dt_x; gfx_y = dt_y;
    gfx_drawstr(#draw_buf);
  ) : (
    set_border_color(swing_hov);
    gfx_roundrect(bx_sw, by_sw, bw_sw, bh_sw, W(3), 1);
    gfx_setfont(10, "Inter", sz_main, 0);
    gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
    sw = 1740[tr];
    4600[tr] == 6 ? (
      sw = min(100, max(-100, floor(sw + 4740[tr] * 50.0 + 0.5)));
    );
    sw > 0 ? sprintf(#sw_str, "+%d%%", sw) : sprintf(#sw_str, "%d%%", sw);
    gfx_measurestr(#sw_str, sw_w, sw_h);
    gfx_x = bx_sw + floor((bw_sw - sw_w) * 0.5);
    gfx_y = by_sw + floor((bh_sw - sw_h) * 0.5) + num_y_off;
    gfx_drawstr(#sw_str);
  );
  gfx_setfont(1, "Inter", sz_main, 'B');

  // Shift Left (<)
  shl_hov = m_x >= 893 && m_x <= 913 && m_y >= ry + 6 && m_y <= ry + 30;
  is_shl_pressed = (mouse_cap & 1) && shl_hov;
  bx_shl = X(893); bw_shl = W(20); by_shl = Y(ry + 6); bh_shl = H(24);
  gfx_mode = 0;
  is_shl_pressed ? (
    gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
  ) : (
    gfx_r = 0.18; gfx_g = 0.18; gfx_b = 0.20;
  );
  fill_roundrect(bx_shl, by_shl, bw_shl, bh_shl, W(3));
  set_border_color(shl_hov);
  gfx_roundrect(bx_shl, by_shl, bw_shl, bh_shl, W(3), 1);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
  draw_arrow_left(bx_shl, by_shl + (is_shl_pressed ? 1 : 0), bw_shl, bh_shl, scale_font);

  // Shift Right (>)
  shr_hov = m_x >= 917 && m_x <= 937 && m_y >= ry + 6 && m_y <= ry + 30;
  is_shr_pressed = (mouse_cap & 1) && shr_hov;
  bx_shr = X(917); bw_shr = W(20); by_shr = Y(ry + 6); bh_shr = H(24);
  gfx_mode = 0;
  is_shr_pressed ? (
    gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
  ) : (
    gfx_r = 0.18; gfx_g = 0.18; gfx_b = 0.20;
  );
  fill_roundrect(bx_shr, by_shr, bw_shr, bh_shr, W(3));
  set_border_color(shr_hov);
  gfx_roundrect(bx_shr, by_shr, bw_shr, bh_shr, W(3), 1);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
  draw_arrow_right(bx_shr, by_shr + (is_shr_pressed ? 1 : 0), bw_shr, bh_shr, scale_font);

  // FLIP
  bx_flp = X(941); bw_flp = W(34); by_flp = Y(ry + 6); bh_flp = H(24);
  flip_hov = m_x >= 941 && m_x <= 975 && m_y >= ry + 6 && m_y <= ry + 30;
  is_flip_pressed = (mouse_cap & 1) && flip_hov;
  gfx_mode = 0;
  is_flip_pressed ? (
    gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
  ) : (
    gfx_r = 0.18; gfx_g = 0.18; gfx_b = 0.20;
  );
  fill_roundrect(bx_flp, by_flp, bw_flp, bh_flp, W(3));
  set_border_color(flip_hov);
  gfx_roundrect(bx_flp, by_flp, bw_flp, bh_flp, W(3), 1);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;

  gfx_setfont(8, "Inter", sz_btn, 0);
  gfx_measurestr("FLIP", flp_w, flp_h);
  flp_x_offset = max(1, floor(1 * sx));
  flp_y_offset = max(1, floor(1 * sy));
  gfx_x = bx_flp + floor((bw_flp - flp_w) * 0.5) + flp_x_offset;
  gfx_y = by_flp + floor((bh_flp - flp_h) * 0.5) + flp_y_offset + (is_flip_pressed ? 1 : 0);
  gfx_drawstr("FLIP");
  gfx_setfont(1, "Inter", sz_main, 'B');

  // Random (?)
  is_r_pressed = (mouse_cap & 1) && (m_x >= 979 && m_x <= 1003 && m_y >= ry + 6 && m_y <= ry + 30);
  r_hov = m_x >= 979 && m_x <= 1003 && m_y >= ry + 6 && m_y <= ry + 30;
  
  // 80% opacity idle, 100% hover
  r_alpha = is_r_pressed ? 0.65 : (r_hov ? 1.0 : 0.80);

  bx_rnd = X(979); bw_rnd = W(24); by_rnd = Y(ry + 6); bh_rnd = H(24);
  gfx_mode = 0;
  gfx_r = cr * r_alpha; gfx_g = cg * r_alpha; gfx_b = cb * r_alpha;
  fill_roundrect(bx_rnd, by_rnd, bw_rnd, bh_rnd, W(3));
  set_border_color(r_hov);
  gfx_roundrect(bx_rnd, by_rnd, bw_rnd, bh_rnd, W(3), 1);

  gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
  gfx_setfont(4, "Inter", sz_q, 'B');
  gfx_measurestr("?", q_w, q_h);
  q_x_offset = (bw_rnd <= 32) ? 1 : 0;
  gfx_x = bx_rnd + floor((bw_rnd - q_w) * 0.5) + q_x_offset;
  gfx_y = by_rnd + floor((bh_rnd - q_h) * 0.5) + (is_r_pressed ? 1 : 0);
  gfx_drawstr("?");
  gfx_setfont(1, "Inter", sz_main, 'B');

  // Play Mode Box
  bx_pm = X(1006); bw_pm = W(44); by_pm = Y(ry + 6); bh_pm = H(24);
  pm_hov = m_x >= 1006 && m_x <= 1050 && m_y >= ry + 6 && m_y <= ry + 30;
  cur_pm = 1920[tr];

  set_border_color(pm_hov);
  gfx_roundrect(bx_pm, by_pm, bw_pm, bh_pm, W(3), 1);

  pm_hov ? (
    gfx_r = min(1.0, cr * 1.30); gfx_g = min(1.0, cg * 1.30); gfx_b = min(1.0, cb * 1.30);
  ) : (
    gfx_r = cr; gfx_g = cg; gfx_b = cb;
  );

  cur_pm == 0 ? (
    draw_arrow_forward(bx_pm, by_pm, bw_pm, bh_pm, scale_font);
  ) :
  cur_pm == 1 ? (
    draw_arrow_backward(bx_pm, by_pm, bw_pm, bh_pm, scale_font);
  ) :
  cur_pm == 2 ? (
    draw_arrow_pingpong(bx_pm, by_pm, bw_pm, bh_pm, scale_font);
  ) : (
    draw_arrow_shuffle(bx_pm, by_pm, bw_pm, bh_pm, scale_font);
  );

  mouse_cap & 1 ? (
    !mouse_clicked && drag_mode == 0 ? (
      m_x >= 52 && m_x <= 72 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        undo_push(); 1680[tr] = !1680[tr]; mouse_clicked = 1;
      ) :
      m_x >= 76 && m_x <= 96 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        undo_push(); 1700[tr] = !1700[tr]; mouse_clicked = 1;
      ) :
      m_x >= 100 && m_x <= 146 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 1000 + tr) ? (
          undo_push(); 1620[tr] = (tr % 16) + 1;
          mouse_clicked = 1;
        ) : (
          undo_push();
          drag_mode = 2; drag_tr = tr; drag_start_y = m_y; drag_start_val = 1620[tr];
          last_click_time = now_t; last_click_elem = 1000 + tr;
        );
      ) :
      m_x >= 150 && m_x <= 188 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 2000 + tr) ? (
          undo_push();
          1600[tr] = 60; // Reset to C4 (60)
          mouse_clicked = 1;
        ) : (
          undo_push();
          drag_mode = 1; drag_tr = tr; drag_start_y = m_y; drag_start_val = 1600[tr];
          last_click_time = now_t; last_click_elem = 2000 + tr;
        );
      ) :
      m_x >= 192 && m_x <= 226 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 3000 + tr) ? (
          undo_push(); 1640[tr] = 7;
          mouse_clicked = 1;
        ) : (
          undo_push();
          drag_mode = 3; drag_tr = tr; drag_start_y = m_y; drag_start_val = 1640[tr];
          last_click_time = now_t; last_click_elem = 3000 + tr;
        );
      ) :
      m_x >= 230 && m_x <= 268 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 4000 + tr) ? (
          undo_push(); 1660[tr] = 16;
          1860[tr] > 16 ? 1860[tr] = 16;
          mouse_clicked = 1;
        ) : (
          undo_push();
          drag_mode = 4; drag_tr = tr; drag_start_y = m_y; drag_start_val = 1660[tr];
          last_click_time = now_t; last_click_elem = 4000 + tr;
        );
      ) :
      euc_mode && m_x >= 272 && m_x <= 310 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 4500 + tr) ? (
          undo_push(); 1860[tr] = 0;
          euc_mode ? apply_euclidean_track(tr);
          mouse_clicked = 1;
        ) : (
          undo_push();
          drag_mode = 7; drag_tr = tr; drag_start_y = m_y; drag_start_val = 1860[tr];
          last_click_time = now_t; last_click_elem = 4500 + tr;
        );
      ) :
      m_x >= chance_x && m_x <= chance_x + 50 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 5000 + tr) ? (
          undo_push(); 1720[tr] = 100;
          mouse_clicked = 1;
        ) : (
          undo_push();
          drag_mode = 5; drag_tr = tr; drag_start_y = m_y; drag_start_val = 1720[tr];
          last_click_time = now_t; last_click_elem = 5000 + tr;
        );
      ) :
      m_x >= swing_x && m_x <= swing_x + 48 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 6000 + tr) ? (
          undo_push(); 1740[tr] = 0;
          mouse_clicked = 1;
        ) : (
          undo_push();
          drag_mode = 6; drag_tr = tr; drag_start_y = m_y; drag_start_val = 1740[tr];
          last_click_time = now_t; last_click_elem = 6000 + tr;
        );
      ) :
      m_x >= 892 && m_x <= 912 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        undo_push();
        cur_len = 1660[tr];
        first_step = 10000[tr * 64];
        first_vel = 12000[tr * 64];
        first_pan = 14000[tr * 64];
        first_gate = 16000[tr * 64];
        first_timing = 18000[tr * 64];
        first_ratchet = 20000[tr * 64];
        first_chc = 22000[tr * 64];
        first_cnd = 24000[tr * 64];
        si = 0;
        while (si < cur_len - 1) (
          10000[tr * 64 + si] = 10000[tr * 64 + si + 1];
          12000[tr * 64 + si] = 12000[tr * 64 + si + 1];
          14000[tr * 64 + si] = 14000[tr * 64 + si + 1];
          16000[tr * 64 + si] = 16000[tr * 64 + si + 1];
          18000[tr * 64 + si] = 18000[tr * 64 + si + 1];
          20000[tr * 64 + si] = 20000[tr * 64 + si + 1];
          22000[tr * 64 + si] = 22000[tr * 64 + si + 1];
          24000[tr * 64 + si] = 24000[tr * 64 + si + 1];
          si += 1;
        );
        10000[tr * 64 + cur_len - 1] = first_step;
        12000[tr * 64 + cur_len - 1] = first_vel;
        14000[tr * 64 + cur_len - 1] = first_pan;
        16000[tr * 64 + cur_len - 1] = first_gate;
        18000[tr * 64 + cur_len - 1] = first_timing;
        20000[tr * 64 + cur_len - 1] = first_ratchet;
        22000[tr * 64 + cur_len - 1] = first_chc;
        24000[tr * 64 + cur_len - 1] = first_cnd;
        mouse_clicked = 1;
      ) :
      m_x >= 916 && m_x <= 936 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        undo_push();
        cur_len = 1660[tr];
        last_step = 10000[tr * 64 + cur_len - 1];
        last_vel = 12000[tr * 64 + cur_len - 1];
        last_pan = 14000[tr * 64 + cur_len - 1];
        last_gate = 16000[tr * 64 + cur_len - 1];
        last_timing = 18000[tr * 64 + cur_len - 1];
        last_ratchet = 20000[tr * 64 + cur_len - 1];
        last_chc = 22000[tr * 64 + cur_len - 1];
        last_cnd = 24000[tr * 64 + cur_len - 1];
        si = cur_len - 1;
        while (si > 0) (
          10000[tr * 64 + si] = 10000[tr * 64 + si - 1];
          12000[tr * 64 + si] = 12000[tr * 64 + si - 1];
          14000[tr * 64 + si] = 14000[tr * 64 + si - 1];
          16000[tr * 64 + si] = 16000[tr * 64 + si - 1];
          18000[tr * 64 + si] = 18000[tr * 64 + si - 1];
          20000[tr * 64 + si] = 20000[tr * 64 + si - 1];
          22000[tr * 64 + si] = 22000[tr * 64 + si - 1];
          24000[tr * 64 + si] = 24000[tr * 64 + si - 1];
          si -= 1;
        );
        10000[tr * 64] = last_step;
        12000[tr * 64] = last_vel;
        14000[tr * 64] = last_pan;
        16000[tr * 64] = last_gate;
        18000[tr * 64] = last_timing;
        20000[tr * 64] = last_ratchet;
        22000[tr * 64] = last_chc;
        24000[tr * 64] = last_cnd;
        mouse_clicked = 1;
      ) :
      m_x >= 940 && m_x <= 974 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        undo_push();
        cur_len = 1660[tr];
        half = floor(cur_len / 2);
        si = 0;
        while (si < half) (
          other_i = cur_len - 1 - si;
          tmp_s = 10000[tr * 64 + si];
          tmp_v = 12000[tr * 64 + si];
          tmp_p = 14000[tr * 64 + si];
          tmp_g = 16000[tr * 64 + si];
          tmp_t = 18000[tr * 64 + si];
          tmp_r = 20000[tr * 64 + si];
          tmp_c = 22000[tr * 64 + si];
          tmp_cond = 24000[tr * 64 + si];

          10000[tr * 64 + si] = 10000[tr * 64 + other_i];
          12000[tr * 64 + si] = 12000[tr * 64 + other_i];
          14000[tr * 64 + si] = 14000[tr * 64 + other_i];
          16000[tr * 64 + si] = 16000[tr * 64 + other_i];
          18000[tr * 64 + si] = 18000[tr * 64 + other_i];
          20000[tr * 64 + si] = 20000[tr * 64 + other_i];
          22000[tr * 64 + si] = 22000[tr * 64 + other_i];
          24000[tr * 64 + si] = 24000[tr * 64 + other_i];

          10000[tr * 64 + other_i] = tmp_s;
          12000[tr * 64 + other_i] = tmp_v;
          14000[tr * 64 + other_i] = tmp_p;
          16000[tr * 64 + other_i] = tmp_g;
          18000[tr * 64 + other_i] = tmp_t;
          20000[tr * 64 + other_i] = tmp_r;
          22000[tr * 64 + other_i] = tmp_c;
          24000[tr * 64 + other_i] = tmp_cond;

          si += 1;
        );
        mouse_clicked = 1;
      ) :
      m_x >= 978 && m_x <= 1002 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        undo_push();
        cur_len = 1660[tr];
        si = 0;
        while (si < cur_len) (
          10000[tr * 64 + si] = rand(100) > 60;
          12000[tr * 64 + si] = 100;
          si += 1;
        );
        mouse_clicked = 1;
      ) :
      m_x >= 1005 && m_x <= 1050 && m_y >= ry + 6 && m_y <= ry + 30 ? (
        now_t = time_precise();
        (now_t - last_click_time < 0.3 && last_click_elem == 8000 + tr) ? (
          undo_push();
          1920[tr] = 0; // Reset to Forward (0)
          mouse_clicked = 1;
          last_click_elem = -1;
        ) : (
          undo_push();
          drag_mode = 10; drag_tr = tr; drag_start_y = m_y; drag_start_val = 1920[tr];
          last_click_time = now_t; last_click_elem = 8000 + tr;
          mouse_clicked = 1;
        );
      );
    );
  );

  row_idx += 1;
);

// Continuous interpolated step painting
(mouse_cap & 1) && drag_mode == 0 && step_paint_mode >= 0 ? (
  p_dist = max(abs(mouse_x - last_paint_x), abs(mouse_y - last_paint_y));
  p_substeps = max(1, min(32, ceil(p_dist / 10)));
  p_k = 1;
  while (p_k <= p_substeps) (
    pix = last_paint_x + (mouse_x - last_paint_x) * (p_k / p_substeps);
    piy = last_paint_y + (mouse_y - last_paint_y) * (p_k / p_substeps);

    p_row = floor((piy - Y(52)) / H(44));
    (p_row >= 0 && p_row < TRACKS_PER_PAGE) ? (
      p_tr = current_page * 8 + p_row;
      p_ry = Y(52) + p_row * H(44);
      (piy >= p_ry + Y(2) && piy <= p_ry + Y(34)) ? (
        p_len = 1660[p_tr];
        p_len <= 0 ? p_len = 16;
        p_st = floor((pix - screen_grid_x) / box_pitch_px);
        (p_st >= 0 && p_st < 16) ? (
          global_p_st = step_page * 16 + p_st;
          (global_p_st < p_len) ? (
            p_off = p_tr * 64 + global_p_st;
            10000[p_off] != step_paint_mode ? (
              10000[p_off] = step_paint_mode;
              12000[p_off] <= 0 ? 12000[p_off] = 100;
            );
          );
        );
      );
    );
    p_k += 1;
  );
  last_paint_x = mouse_x;
  last_paint_y = mouse_y;
);

// Continuous interpolated keyboard painting
(mouse_cap & 1) && kb_paint_mode >= 0 ? (
  kb_dist = max(abs(m_x - last_kb_paint_x), abs(m_y - last_kb_paint_y));
  kb_substeps = max(1, min(16, ceil(kb_dist / 3)));
  kb_k = 1;
  while (kb_k <= kb_substeps) (
    interp_x = last_kb_paint_x + (m_x - last_kb_paint_x) * (kb_k / kb_substeps);
    interp_y = last_kb_paint_y + (m_y - last_kb_paint_y) * (kb_k / kb_substeps);
    interp_n = get_kb_note_at(interp_x, interp_y);
    (interp_n >= 0 && interp_n != last_painted_note) ? (
      4000[interp_n] != kb_paint_mode ? (
        4000[interp_n] = kb_paint_mode;
        update_quant_scale_type();
        gui_dirty = 1;
      );
      last_painted_note = interp_n;
    );
    kb_k += 1;
  );
  last_kb_paint_x = m_x;
  last_kb_paint_y = m_y;
);

// REAWISE bottom bar logo
gfx_setfont(11, "Inter", sz_reawise, 'B');
gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
gfx_measurestr("REAWISE", rw_w, rw_h);
gfx_x = floor((cur_w - rw_w) * 0.5);
gfx_y = Y(400) + floor((H(48) - rw_h) * 0.5);
gfx_drawstr("REAWISE");

// Step parameter readout (14px)
hov_step_tr >= 0 ? (
  gfx_setfont(12, "Inter", sz_readout, 'B');
  gfx_measurestr("M", h_m_w, h_m_h);
  readout_y = Y(400) + floor((H(48) - h_m_h) * 0.5);
  readout_x = sb_w + W(8);

  hov_off = hov_step_tr * 64 + hov_step_num;
  hov_vel = 12000[hov_off];
  hov_vel <= 0 ? hov_vel = 100;
  4600[hov_step_tr] == 7 ? (
    hov_vel = min(127, max(1, floor(hov_vel + 4740[hov_step_tr] * 64.0 + 0.5)));
  );

  hov_gate_idx = 16000[hov_off];
  (hov_gate_idx < 0 || hov_gate_idx > 68) ? hov_gate_idx = 4;
  4600[hov_step_tr] == 8 ? (
    hov_gate_idx = min(68, max(0, floor(hov_gate_idx + 4740[hov_step_tr] * 34.0 + 0.5)));
  );
  get_elektron_gate_full_str(hov_gate_idx);

  hov_pan = 14000[hov_off];
  (hov_pan < 0 || hov_pan > 127) ? hov_pan = 64;
  4600[hov_step_tr] == 9 ? (
    hov_pan = min(127, max(0, floor(hov_pan + 4740[hov_step_tr] * 64.0 + 0.5)));
  );
  hov_pan == 64 ? ( #hov_pan_str = "C"; ) :
  hov_pan > 64 ? ( sprintf(#hov_pan_str, "+%d", hov_pan - 64); ) :
                 ( sprintf(#hov_pan_str, "%d", hov_pan - 64); );

  hov_tm = 18000[hov_off];
  4600[hov_step_tr] == 10 ? (
    hov_tm = min(50, max(-50, floor(hov_tm + 4740[hov_step_tr] * 50.0 + 0.5)));
  );
  hov_tm > 0 ? sprintf(#hov_tm_str, "+%d%%", hov_tm) : sprintf(#hov_tm_str, "%d%%", hov_tm);

  hov_rt = 20000[hov_off];
  hov_rt <= 0 ? hov_rt = 1;
  4600[hov_step_tr] == 11 ? (
    hov_rt = min(4, max(1, floor(hov_rt + 4740[hov_step_tr] * 2.0 + 0.5)));
  );

  hov_chc = 22000[hov_off];
  4600[hov_step_tr] == 12 ? (
    hov_chc = min(100, max(0, floor(hov_chc + 4740[hov_step_tr] * 50.0 + 0.5)));
  );
  hov_cnd = 24000[hov_off];
  get_cond_str(hov_cnd);

  // VELOCITY
  gfx_x = readout_x; gfx_y = readout_y;
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; gfx_drawstr("VEL ");
  gfx_r = 220 / 255; gfx_g = 220 / 255; gfx_b = 220 / 255;
  sprintf(#s_val, "%d ", hov_vel); gfx_drawstr(#s_val);

  gfx_r = 70 / 255; gfx_g = 70 / 255; gfx_b = 75 / 255; gfx_drawstr("| ");

  // GATE L
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; gfx_drawstr("GATE ");
  gfx_r = 220 / 255; gfx_g = 220 / 255; gfx_b = 220 / 255;
  sprintf(#s_val, "%s ", #g_full_str); gfx_drawstr(#s_val);

  gfx_r = 70 / 255; gfx_g = 70 / 255; gfx_b = 75 / 255; gfx_drawstr("| ");

  // PAN
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; gfx_drawstr("PAN ");
  gfx_r = 220 / 255; gfx_g = 220 / 255; gfx_b = 220 / 255;
  sprintf(#s_val, "%s ", #hov_pan_str); gfx_drawstr(#s_val);

  gfx_r = 70 / 255; gfx_g = 70 / 255; gfx_b = 75 / 255; gfx_drawstr("| ");

  // TIMING
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; gfx_drawstr("TIMING ");
  gfx_r = 220 / 255; gfx_g = 220 / 255; gfx_b = 220 / 255;
  sprintf(#s_val, "%s ", #hov_tm_str); gfx_drawstr(#s_val);

  gfx_r = 70 / 255; gfx_g = 70 / 255; gfx_b = 75 / 255; gfx_drawstr("| ");

  // RATCHET
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; gfx_drawstr("RATCHET ");
  gfx_r = 220 / 255; gfx_g = 220 / 255; gfx_b = 220 / 255;
  sprintf(#s_val, "%d ", hov_rt); gfx_drawstr(#s_val);

  gfx_r = 70 / 255; gfx_g = 70 / 255; gfx_b = 75 / 255; gfx_drawstr("| ");

  // CHANCE
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; gfx_drawstr("CHANCE ");
  gfx_r = 220 / 255; gfx_g = 220 / 255; gfx_b = 220 / 255;
  sprintf(#s_val, "%d%% ", hov_chc); gfx_drawstr(#s_val);

  gfx_r = 70 / 255; gfx_g = 70 / 255; gfx_b = 75 / 255; gfx_drawstr("| ");

  // COND
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; gfx_drawstr("COND ");
  gfx_r = 220 / 255; gfx_g = 220 / 255; gfx_b = 220 / 255;
  gfx_drawstr(#c_str);
);

  gui_dirty = 0;
);

// Blit offscreen buffer to screen (gfx_dest = -1)
gfx_dest = -1;
gfx_x = 0; gfx_y = 0;
gfx_blit(1, 1, 0);

// Playhead rendering (60 fps)
is_playing_transport ? (
  row_p = 0;
  while (row_p < TRACKS_PER_PAGE) (
    tr_p = current_page * 8 + row_p;
    ry_p = 52 + row_p * 44;
    len_p = 1660[tr_p]; len_p <= 0 ? len_p = 16;
    4600[tr_p] == 3 ? (
      len_p = min(64, max(1, floor(len_p + 4740[tr_p] * 16.0 + 0.5)));
    );
    rate_p = 1640[tr_p];
    4600[tr_p] == 2 ? (
      rate_p = min(10, max(0, floor(rate_p + 4740[tr_p] * 3.0 + 0.5)));
    );

    base_off = rate_p == 10 ? -5 : (rate_p == 9 ? -4 : (rate_p == 8 ? -2 : (rate_p >= 7 ? -1 : 0)));
    raw_ph = 1760[tr_p] + base_off + 1900[tr_p];
    c_playhead = get_track_play_step(raw_ph, len_p, 1920[tr_p], tr_p);

    playhead_page = floor(c_playhead / 16);
    (playhead_page == step_page) ? (
      playhead_sub_step = c_playhead % 16;
      bx_ph = screen_grid_x + playhead_sub_step * box_pitch_px;
      by_ph = Y(ry_p + 6);
      gfx_a = 0.60;
      gfx_r = 181 / 255.0; gfx_g = 186 / 255.0; gfx_b = 195 / 255.0;
      gfx_rect(bx_ph, by_ph, box_w_px, box_h_px);
      gfx_a = 1.0;
    );

    row_p += 1;
  );
);

