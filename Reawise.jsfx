  redo_hov ? (
    active_mouse_zone = 1; captured_btn_id = 16;
    redo_pop(); mouse_clicked = 1; gui_dirty = 1;
  );

  !mouse_clicked ? (
    row_btn_i = 0;
    while (row_btn_i < TRACKS_PER_PAGE && !mouse_clicked) (
      tr_btn = current_page * 8 + row_btn_i;
      ry_btn = 52 + row_btn_i * 44;
      m_y >= ry_btn + 6 && m_y <= ry_btn + 30 ? (
