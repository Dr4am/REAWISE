  );
) :
lfo_tr_hov ? (
  info_lang == 0 ? (
    #tt_title = "TRACCIA LFO";
    sprintf(#tt_desc, "Traccia attiva per l'LFO: %d. Trascinamento, rotella o click rotella per digitare il numero (1..16); doppio click: traccia 1", lfo_cur_tr + 1);
  ) : (
    #tt_title = "LFO TRACK";
    sprintf(#tt_desc, "Active track for LFO: %d. Drag, mouse wheel or wheel-click to type track number (1..16); double-click: track 1", lfo_cur_tr + 1);
  );
) :
lfo_sh_hov ? (
  info_lang == 0 ? (
    #tt_title = "FORMA D'ONDA LFO";
    #tt_desc = "Forma d'onda: Sinusoide, Triangolo, Sega ascendente, Sega discendente, Quadra, Sample & Hold. Trascinamento o rotella per cambiare, click destro: menu, doppio click: sinusoide";
  ) : (
    #tt_title = "LFO WAVEFORM";
    #tt_desc = "Waveform: Sine, Triangle, Saw Up, Saw Down, Square, Sample & Hold. Drag or mouse wheel to change; right-click: menu, double-click: sine";
  );
) :
lfo_sy_hov ? (
  info_lang == 0 ? (
    #tt_title = "LFO SYNC / FREQ";
    #tt_desc = "Sincronizza l'LFO ai BPM di REAPER (SYNC) oppure usa una frequenza libera in Hertz (FREQ)";
  ) : (
    #tt_title = "LFO SYNC / FREQ";
    #tt_desc = "Synchronize LFO to REAPER tempo (SYNC) or use free frequency in Hertz (FREQ)";
  );
) :
lfo_rt_hov ? (
  info_lang == 0 ? (
    #tt_title = "VELOCITA' LFO";
    4520[lfo_cur_tr] ? (
      #tt_desc = "Divisione metrica (in SYNC, default 1/2). Trascinamento o rotella: regola, Doppio click: reset, Click destro: menu tempo/dotted/triplets";
    ) : (
      #tt_desc = "Frequenza libera in Hertz. Rotella (+/-0.10 Hz), click sinistro o destro + rotella (+/-0.01 Hz); trascina per regolare, Doppio click: reset (2.0), Click rotella per digitare";
    );
  ) : (
    #tt_title = "LFO RATE / SPEED";
    4520[lfo_cur_tr] ? (
      #tt_desc = "Metric division (in SYNC, default 1/2). Drag or mouse wheel: adjust, Double-click: reset, Right-click: straight/dotted/triplets menu";
    ) : (
      #tt_desc = "Free frequency in Hertz. Wheel (+/-0.10 Hz), left or right button + wheel (+/-0.01 Hz); drag to adjust, Double-click: reset (2.0), Wheel-click to type";
    );
  );
) :
lfo_tg_hov ? (
  info_lang == 0 ? (
    #tt_title = "LFO RETRIGGER";
    #tt_desc = "Se attivo (azzurro), la fase si resetta a ogni avvio di REAPER. Se disattivato, scorre liberamente";
  ) : (
    #tt_title = "LFO RETRIGGER";
    #tt_desc = "When active (blue), phase resets on playback start. When off, runs freely";
  );
) :
lfo_ds_hov ? (
  cur_dst_tip = 4600[lfo_cur_tr];
  info_lang == 0 ? (
    #tt_title = "DESTINAZIONE LFO";
    cur_dst_tip == 0  ? #tt_desc = "Nessuna destinazione assegnata. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 1  ? #tt_desc = "Modula l'intonazione della traccia. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 2  ? #tt_desc = "Modula la divisione temporale della traccia. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 3  ? #tt_desc = "Modula la lunghezza del pattern. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 4  ? #tt_desc = "Modula i beat euclidei della traccia. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 64 ? #tt_desc = "Modula la lunghezza di tutte le tracce. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 65 ? #tt_desc = "Modula la densità master. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 66 ? #tt_desc = "Modula lo swing di tutte le tracce. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 67 ? #tt_desc = "Modula il gate master. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 62 ? #tt_desc = "Modula il gate della traccia. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 63 ? #tt_desc = "Modula il pan della traccia. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 61 ? #tt_desc = "Modula il volume della traccia. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 5  ? #tt_desc = "Modula la densità della traccia. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 6  ? #tt_desc = "Modula lo swing della traccia. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 7  ? #tt_desc = "Modula la velocity degli step. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 8  ? #tt_desc = "Modula la durata del gate degli step. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 9  ? #tt_desc = "Modula il pan degli step. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 10 ? #tt_desc = "Modula il micro-timing degli step. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 11 ? #tt_desc = "Modula il ratcheting degli step. Trascinamento, rotella o menù contestuale" :
    cur_dst_tip == 12 ? #tt_desc = "Modula la probabilità dei singoli step. Trascinamento, rotella o menù contestuale" :
    (cur_dst_tip >= 13 && cur_dst_tip <= 60) ? (
      t_lfo_tip = floor((cur_dst_tip - 13) / 3);
      s_dst_tip = (cur_dst_tip - 13) % 3;
      s_dst_tip == 0 ? sprintf(#tt_desc, "Modula il Rate dell'LFO %d. Trascinamento, rotella o menù contestuale", t_lfo_tip + 1) :
      s_dst_tip == 1 ? sprintf(#tt_desc, "Modula la Shape dell'LFO %d. Trascinamento, rotella o menù contestuale", t_lfo_tip + 1) :
                       sprintf(#tt_desc, "Modula l'Amount dell'LFO %d. Trascinamento, rotella o menù contestuale", t_lfo_tip + 1);
    ) :
    #tt_desc = "Nessuna destinazione assegnata. Trascinamento, rotella o menù contestuale";
  ) : (
    #tt_title = "LFO DESTINATION";
    cur_dst_tip == 0  ? #tt_desc = "No destination assigned. Drag, mouse wheel or context menu" :
    cur_dst_tip == 1  ? #tt_desc = "Modulates track pitch. Drag, mouse wheel or context menu" :
    cur_dst_tip == 2  ? #tt_desc = "Modulates track time division. Drag, mouse wheel or context menu" :
    cur_dst_tip == 3  ? #tt_desc = "Modulates track pattern length. Drag, mouse wheel or context menu" :
    cur_dst_tip == 4  ? #tt_desc = "Modulates track Euclidean beats. Drag, mouse wheel or context menu" :
    cur_dst_tip == 64 ? #tt_desc = "Modulates the length of all tracks. Drag, mouse wheel or context menu" :
    cur_dst_tip == 65 ? #tt_desc = "Modulates master density. Drag, mouse wheel or context menu" :
    cur_dst_tip == 66 ? #tt_desc = "Modulates swing on all tracks. Drag, mouse wheel or context menu" :
    cur_dst_tip == 67 ? #tt_desc = "Modulates master gate. Drag, mouse wheel or context menu" :
    cur_dst_tip == 62 ? #tt_desc = "Modulates track gate. Drag, mouse wheel or context menu" :
    cur_dst_tip == 63 ? #tt_desc = "Modulates track pan. Drag, mouse wheel or context menu" :
    cur_dst_tip == 61 ? #tt_desc = "Modulates track volume. Drag, mouse wheel or context menu" :
    cur_dst_tip == 5  ? #tt_desc = "Modulates track density. Drag, mouse wheel or context menu" :
    cur_dst_tip == 6  ? #tt_desc = "Modulates track swing. Drag, mouse wheel or context menu" :
    cur_dst_tip == 7  ? #tt_desc = "Modulates track step velocity. Drag, mouse wheel or context menu" :
    cur_dst_tip == 8  ? #tt_desc = "Modulates step gate length. Drag, mouse wheel or context menu" :
    cur_dst_tip == 9  ? #tt_desc = "Modulates step pan position. Drag, mouse wheel or context menu" :
    cur_dst_tip == 10 ? #tt_desc = "Modulates step micro-timing. Drag, mouse wheel or context menu" :
    cur_dst_tip == 11 ? #tt_desc = "Modulates step ratcheting subdivisions. Drag, mouse wheel or context menu" :
    cur_dst_tip == 12 ? #tt_desc = "Modulates per-step chance. Drag, mouse wheel or context menu" :
    (cur_dst_tip >= 13 && cur_dst_tip <= 60) ? (
      t_lfo_tip = floor((cur_dst_tip - 13) / 3);
      s_dst_tip = (cur_dst_tip - 13) % 3;
      s_dst_tip == 0 ? sprintf(#tt_desc, "Modulates Rate of LFO %d. Drag, mouse wheel or context menu", t_lfo_tip + 1) :
      s_dst_tip == 1 ? sprintf(#tt_desc, "Modulates Shape of LFO %d. Drag, mouse wheel or context menu", t_lfo_tip + 1) :
                       sprintf(#tt_desc, "Modulates Amount of LFO %d. Drag, mouse wheel or context menu", t_lfo_tip + 1);
    ) :
    #tt_desc = "No destination assigned. Drag, mouse wheel or context menu";
  );
) :
lfo_am_hov ? (
  info_lang == 0 ? (
    #tt_title = "AMPIEZZA LFO";
    #tt_desc = "Intensita di modulazione (0%..100%). Trascinamento, rotella (+/-5%), Click Sx + Rotella (+/-1%), Click rotella per digitare, doppio click per reset (100%)";
  ) : (
    #tt_title = "LFO AMOUNT";
    #tt_desc = "Modulation depth (0%..100%). Drag, mouse wheel (+/-5%), Left-Click + Wheel (+/-1%), Wheel-click to type, double-click to reset (100%)";
  );
) :
euc_hov ? (
  info_lang == 0 ? (
    #tt_title = "RITMO EUCLIDEO";
    #tt_desc = "Distribuisce automaticamente i beat sulla lunghezza della traccia nel modo più uniforme possibile. Imposta il numero di beat con il parametro B";
  ) : (
    #tt_title = "EUCLIDEAN MODE";
    #tt_desc = "Automatically distributes beats as evenly as possible across the track length. Set the number of beats with the B parameter";
  );
) :
trans_rst_hov ? (
  info_lang == 0 ? (
    #tt_title = "RESET TRASPOSIZIONE";
    #tt_desc = "Ripristina tutte le tracce all'intonazione originale (offset 0)";
  ) : (
    #tt_title = "RESET TRANSPOSE";
    #tt_desc = "Reset all tracks back to original pitch (offset 0)";
  );
) :
oct_disp_hov ? (
  info_lang == 0 ? (
    #tt_title = "OFFSET OTTAVA";
    #tt_desc = "Offset ottava globale (-3..+4). Rotella (+/-1), Click rotella per digitare";
  ) : (
    #tt_title = "OCTAVE OFFSET";
    #tt_desc = "Global octave offset (-3..+4). Wheel (+/-1), Wheel-click to type";
  );
) :
semi_disp_hov ? (
  info_lang == 0 ? (
    #tt_title = "OFFSET SEMITONI";
    #tt_desc = "Offset semitoni in scala (-36..+48). Rotella (+/-1), Click rotella per digitare";
  ) : (
    #tt_title = "SEMITONE OFFSET";
    #tt_desc = "Global scale semitone offset (-36..+48). Wheel (+/-1), Wheel-click to type";
  );
) :
m_slot1_hov ? (
  info_lang == 0 ? (
    #tt_title = "DENSITA' MASTER";
    sprintf(#tt_desc, "Densita Master (%d%%). Scala la densita di tutte le tracce. Trascina o rotella (+/-5%%), Click Sx + Rotella: fine (+/-1%%), Click rotella: digita, doppio click: reset (100%%)", master_density);
  ) : (
    #tt_title = "MASTER DENSITY";
    sprintf(#tt_desc, "Master Density (%d%%). Scales density across all tracks. Drag or mouse wheel (+/-5%%), Left-Click + Wheel: fine (+/-1%%), Wheel-click to type, double-click to reset (100%%)", master_density);
  );
) :
m_slot3_hov ? (
  info_lang == 0 ? (
    #tt_title = "MASTER LENGTH";
    master_len_offset == 0 ? #ml_tip = "0" : master_len_offset > 0 ? sprintf(#ml_tip, "+%d", master_len_offset) : sprintf(#ml_tip, "%d", master_len_offset);
    sprintf(#tt_desc, "Offset lunghezza master (%s step). Aggiunge o sottrae lo stesso numero di step a tutte le tracce, entro i limiti 1..64. Rotella: +/-1 step; click sinistro + rotella: +/-4. Trascina, click rotella: digita, doppio click: reset (0)", #ml_tip);
  ) : (
    #tt_title = "MASTER LENGTH";
    master_len_offset == 0 ? #ml_tip = "0" : master_len_offset > 0 ? sprintf(#ml_tip, "+%d", master_len_offset) : sprintf(#ml_tip, "%d", master_len_offset);
    sprintf(#tt_desc, "Master pattern length offset (%s steps). Adds or subtracts the same number of steps on every track, within the 1..64 limits. Wheel: +/-1 step; left button + wheel: +/-4. Drag, wheel-click to type, double-click to reset (0)", #ml_tip);
  );
) :
m_slot2_hov ? (
  master_s2_mode == 0 ? (
    info_lang == 0 ? (
      #tt_title = "MASTER SWING";
      master_swing == 0 ? #ms_tip = "0" : master_swing > 0 ? sprintf(#ms_tip, "+%d%%", master_swing) : sprintf(#ms_tip, "%d%%", master_swing);
      sprintf(#tt_desc, "Offset swing master (%s): sposta nel tempo gli step alternati di tutte le tracce. Trascina o rotella (+/-5%%), Click Sx + Rotella: fine (+/-1%%), Click rotella: digita, click Dx: menu Gate/Swing, doppio click: reset (0)", #ms_tip);
    ) : (
      #tt_title = "MASTER SWING";
      master_swing == 0 ? #ms_tip = "0" : master_swing > 0 ? sprintf(#ms_tip, "+%d%%", master_swing) : sprintf(#ms_tip, "%d%%", master_swing);
      sprintf(#tt_desc, "Master swing offset (%s): shifts alternate steps across all tracks in time. Drag or mouse wheel (+/-5%%), Left-Click + Wheel: fine (+/-1%%), Wheel-click to type, right-click: Gate/Swing menu, double-click to reset (0)", #ms_tip);
    );
  ) : (
    info_lang == 0 ? (
      #tt_title = "MASTER GATE";
      master_gate == 0 ? #mg_tip = "0 (Neutro)" : master_gate > 0 ? sprintf(#mg_tip, "+%d%%", master_gate) : sprintf(#mg_tip, "%d%%", master_gate);
      sprintf(#tt_desc, "Moltiplicatore durata gate master (%s). Trascina o rotella (+/-5%%), Click Sx + Rotella: fine (+/-1%%), Click rotella: digita, click Dx: menu Gate/Swing, doppio click: reset (0)", #mg_tip);
    ) : (
      #tt_title = "MASTER GATE";
      master_gate == 0 ? #mg_tip = "0 (Neutral)" : master_gate > 0 ? sprintf(#mg_tip, "+%d%%", master_gate) : sprintf(#mg_tip, "%d%%", master_gate);
      sprintf(#tt_desc, "Master gate length multiplier (%s). Drag or mouse wheel (+/-5%%), Left-Click + Wheel: fine (+/-1%%), Wheel-click to type, right-click: Gate/Swing menu, double-click to reset (0)", #mg_tip);
    );
  );
) :
meter_hov ? (
  info_lang == 0 ? (
    #tt_title = "MASTER VOLUME / METER";
    sprintf(#tt_desc, "Volume Master: %d%%. Scala la velocity delle note su tutte le tracce; il meter mostra l'attività MIDI. Trascina o rotella (+/-5%%), Click Sx + Rotella: fine (+/-1%%), Doppio click: reset (100%%)", master_vol);
  ) : (
    #tt_title = "MASTER VOLUME / METER";
    sprintf(#tt_desc, "Master Volume: %d%%. Scales note velocity across all tracks; the meter shows MIDI activity. Drag or mouse wheel (+/-5%%), Left-Click + Wheel: fine (+/-1%%), Double-click: reset (100%%)", master_vol);
  );
) :
chain_btn_hov ? (
  info_lang == 0 ? (
    #tt_title = "CATENA PATTERN (CHAIN)";
    #tt_desc = "Attiva la catena: clicca i pattern per aggiungerli in ordine (max 64). Doppio click: svuota e disattiva la catena";
  ) : (
    #tt_title = "PATTERN CHAINING";
    #tt_desc = "Enable chaining, then click patterns to append them in order (max 64). Double-click to clear and disable the chain";
  );
) :
hov_pat_idx >= 0 ? (
  info_lang == 0 ? (
    #tt_title = "PATTERN";
    #tt_desc = "Click: seleziona da fermo, accoda in riproduzione o aggiunge alla catena se CHAIN e attivo. Click destro: Copy/Cut/Paste. Click rotella: modifica in background";
  ) : (
    #tt_title = "PATTERN";
    #tt_desc = "Click: select when stopped, queue during playback, or append to the chain when CHAIN is on. Right-click: Copy/Cut/Paste. Wheel-click: edit in background";
  );
) :
del_hov ? (
  info_lang == 0 ? (
    #tt_title = "CANCELLA TUTTO";
    #tt_desc = "Azzera gli step e i loro parametri su tutte le tracce del pattern; disattiva EUC e resetta beat euclidei, densita master, lunghezza master e swing master. Annullabile con UNDO";
  ) : (
    #tt_title = "CLEAR ALL";
    #tt_desc = "Clear steps and their parameters on all tracks of the pattern; disable EUC and reset Euclidean beats, master density, master length and master swing. Can be undone with UNDO";
  );
) :
undo_hov ? (
  info_lang == 0 ? (
    #tt_title = "ANNULLA";
    #tt_desc = "Annulla fino a 16 modifiche";
  ) : (
    #tt_title = "UNDO";
    #tt_desc = "Undo up to 16 edits";
  );
) :
redo_hov ? (
  info_lang == 0 ? (
    #tt_title = "RIPRISTINA";
    #tt_desc = "Ripristina fino a 16 modifiche annullate";
  ) : (
    #tt_title = "REDO";
    #tt_desc = "Redo up to 16 undone edits";
  );
);

// Track row tooltip tracking
row_idx = 0;
while (row_idx < TRACKS_PER_PAGE) (
  tr_t = current_page * 8 + row_idx;
  ry_t = 52 + row_idx * 44;

  m_x >= 52 && m_x <= 72 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    #tt_title = "SOLO";
    info_lang == 0 ? sprintf(#tt_desc, "Traccia %d: Isola l'ascolto di questa traccia. Click destro per azzerare tutti i Solo (Clear Solo)", tr_t + 1)
                   : sprintf(#tt_desc, "Track %d: Solo and isolate this track. Right-click to clear all active Solos", tr_t + 1);
  ) :
  m_x >= 76 && m_x <= 96 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    #tt_title = "MUTE";
    info_lang == 0 ? sprintf(#tt_desc, "Traccia %d: Silenzia l'uscita MIDI di questa traccia. Click destro per riattivare tutte le tracce (Clear Mute)", tr_t + 1)
                   : sprintf(#tt_desc, "Track %d: Mute MIDI output from this track. Right-click to clear all active Mutes (Unmute all)", tr_t + 1);
  ) :
  m_x >= 100 && m_x <= 146 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "CANALE MIDI";
      sprintf(#tt_desc, "Traccia %d: Canale di uscita MIDI (1..16, 0 = ALL). Trascinamento, rotella o click rotella per digitare", tr_t + 1);
    ) : (
      #tt_title = "MIDI CHANNEL";
      sprintf(#tt_desc, "Track %d: Output MIDI channel (1..16, 0 = ALL). Drag, wheel or wheel-click to type", tr_t + 1);
    );
  ) :
  m_x >= 150 && m_x <= 188 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "NOTA";
      sprintf(#tt_desc, "Traccia %d: Nota MIDI. Rotella: note in scala (+/-1), Click Sx + Rotella: ottave (+/-12), Trascinamento, Click rotella per digitare", tr_t + 1);
    ) : (
      #tt_title = "PITCH";
      sprintf(#tt_desc, "Track %d: Output MIDI pitch. Wheel: scale notes (+/-1), Left-Click + Wheel: octaves (+/-12), Drag, Wheel-click to type", tr_t + 1);
    );
  ) :
  m_x >= 192 && m_x <= 226 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "VELOCITA";
      sprintf(#tt_desc, "Traccia %d: Risoluzione metrica dello step da /16 a x16, default x4. Trascinamento, rotella o click rotella per digitare", tr_t + 1);
    ) : (
      #tt_title = "RATE";
      sprintf(#tt_desc, "Track %d: Step metric rate from /16 to x16, default x4. Drag, wheel or wheel-click to type", tr_t + 1);
    );
  ) :
  m_x >= 230 && m_x <= 268 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "LUNGHEZZA PATTERN";
      sprintf(#tt_desc, "Traccia %d: Numero di step attivi nel loop (1..64). Trascinamento, rotella o click rotella per digitare", tr_t + 1);
    ) : (
      #tt_title = "PATTERN LENGTH";
      sprintf(#tt_desc, "Track %d: Active loop steps (1..64). Drag, wheel or wheel-click to type", tr_t + 1);
    );
  ) :
  m_x >= 272 && m_x <= 310 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "BEAT EUCLIDEI";
      sprintf(#tt_desc, "Traccia %d: Numero di beat euclidei (da 0 alla lunghezza della traccia, attivo con EUC acceso). Trascinamento, rotella o click rotella per digitare", tr_t + 1);
    ) : (
      #tt_title = "EUCLIDEAN BEATS";
      sprintf(#tt_desc, "Track %d: Number of Euclidean beats (0 to track length, active when EUC is on). Drag, wheel or wheel-click to type", tr_t + 1);
    );
  ) :
  m_x >= 786 && m_x <= 836 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    2100[tr_t] == 0 ? (
      info_lang == 0 ? (
        #tt_title = "VOLUME";
        sprintf(#tt_desc, "Traccia %d: Volume della traccia (%d%%). Scala la velocity di tutti gli step. Rotella (+/-5%%), Click rotella per digitare, Click Dx per menu parametro", tr_t + 1, 1940[tr_t]);
      ) : (
        #tt_title = "VOLUME";
        sprintf(#tt_desc, "Track %d: Track volume (%d%%). Scales step velocity. Wheel (+/-5%%), Wheel-click to type, Right-click for parameter menu", tr_t + 1, 1940[tr_t]);
      );
    ) : (
      info_lang == 0 ? (
        #tt_title = "DENSITA'";
        sprintf(#tt_desc, "Traccia %d: Densita (%d%%): riduce la probabilità di attivazione degli step della traccia. Rotella (+/-5%%), Click rotella per digitare, Click Dx per menu parametro", tr_t + 1, 1720[tr_t]);
      ) : (
        #tt_title = "DENSITY";
        sprintf(#tt_desc, "Track %d: Density (%d%%): reduces the probability of triggering steps on this track. Wheel (+/-5%%), Wheel-click to type, Right-click for parameter menu", tr_t + 1, 1720[tr_t]);
      );
    );
  ) :
  m_x >= 840 && m_x <= 888 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    2140[tr_t] == 2 ? (
      info_lang == 0 ? (
        #tt_title = "GATE TRACCIA";
        2160[tr_t] == 0 ? #gate_tip_val = "0 (Neutro)" : 2160[tr_t] > 0 ? sprintf(#gate_tip_val, "+%d%%", 2160[tr_t]) : sprintf(#gate_tip_val, "%d%%", 2160[tr_t]);
        sprintf(#tt_desc, "Traccia %d: Gate della traccia (%s). Moltiplicatore della durata delle note (-100%%..+100%%). Rotella (+/-5%%), Click rotella per digitare, Click Dx per menu", tr_t + 1, #gate_tip_val);
      ) : (
        #tt_title = "TRACK GATE";
        2160[tr_t] == 0 ? #gate_tip_val = "0 (Neutral)" : 2160[tr_t] > 0 ? sprintf(#gate_tip_val, "+%d%%", 2160[tr_t]) : sprintf(#gate_tip_val, "%d%%", 2160[tr_t]);
        sprintf(#tt_desc, "Track %d: Track gate (%s). Note duration scaling factor (-100%%..+100%%). Wheel (+/-5%%), Wheel-click to type, Right-click for menu", tr_t + 1, #gate_tip_val);
      );
    ) : 2140[tr_t] == 1 ? (
      info_lang == 0 ? (
        #tt_title = "PAN TRACCIA";
        2120[tr_t] == 0 ? #pan_tip_val = "0 (Centro)" : 2120[tr_t] > 0 ? sprintf(#pan_tip_val, "+%d", 2120[tr_t]) : sprintf(#pan_tip_val, "%d", 2120[tr_t]);
        sprintf(#tt_desc, "Traccia %d: Pan della traccia (%s): sposta a sinistra o a destra il pan degli step. Rotella (+/-5), Click rotella per digitare, Click Dx per menu parametro", tr_t + 1, #pan_tip_val);
      ) : (
        #tt_title = "TRACK PAN";
        2120[tr_t] == 0 ? #pan_tip_val = "0 (Center)" : 2120[tr_t] > 0 ? sprintf(#pan_tip_val, "+%d", 2120[tr_t]) : sprintf(#pan_tip_val, "%d", 2120[tr_t]);
        sprintf(#tt_desc, "Track %d: Track pan (%s): shifts the pan of its steps left or right. Wheel (+/-5), Wheel-click to type, Right-click for parameter menu", tr_t + 1, #pan_tip_val);
      );
    ) : (
      #tt_title = "SWING";
      info_lang == 0 ? (
        1740[tr_t] == 0 ? #sw_tip_val = "0" : 1740[tr_t] > 0 ? sprintf(#sw_tip_val, "+%d", 1740[tr_t]) : sprintf(#sw_tip_val, "%d", 1740[tr_t]);
        sprintf(#tt_desc, "Traccia %d: Swing (%s): sposta nel tempo gli step alternati, cambiando il groove. Rotella (+/-5%%), Click rotella per digitare, Click Dx per menu parametro", tr_t + 1, #sw_tip_val);
      ) : (
        1740[tr_t] == 0 ? #sw_tip_val = "0" : 1740[tr_t] > 0 ? sprintf(#sw_tip_val, "+%d", 1740[tr_t]) : sprintf(#sw_tip_val, "%d", 1740[tr_t]);
        sprintf(#tt_desc, "Track %d: Swing (%s): shifts alternate steps in time to change the groove. Wheel (+/-5%%), Wheel-click to type, Right-click for parameter menu", tr_t + 1, #sw_tip_val);
      );
    );
  ) :
  m_x >= 892 && m_x <= 912 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "SPOSTA A SINISTRA";
      sprintf(#tt_desc, "Traccia %d: Scorre il pattern di uno step a sinistra", tr_t + 1);
    ) : (
      #tt_title = "SHIFT LEFT";
      sprintf(#tt_desc, "Track %d: Shift pattern one step left", tr_t + 1);
    );
  ) :
  m_x >= 916 && m_x <= 936 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "SPOSTA A DESTRA";
      sprintf(#tt_desc, "Traccia %d: Scorre il pattern di uno step a destra", tr_t + 1);
    ) : (
      #tt_title = "SHIFT RIGHT";
      sprintf(#tt_desc, "Track %d: Shift pattern one step right", tr_t + 1);
    );
  ) :
  m_x >= 940 && m_x <= 974 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "INVERTI";
      sprintf(#tt_desc, "Traccia %d: Inverte l'ordine temporale degli step", tr_t + 1);
    ) : (
      #tt_title = "REVERSE";
      sprintf(#tt_desc, "Track %d: Reverse step order horizontally", tr_t + 1);
    );
  ) :
  m_x >= 978 && m_x <= 1002 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    info_lang == 0 ? (
      #tt_title = "CASUALE";
      sprintf(#tt_desc, "Traccia %d: Genera un pattern casuale di step", tr_t + 1);
    ) : (
      #tt_title = "RANDOM";
      sprintf(#tt_desc, "Track %d: Generate random step pattern", tr_t + 1);
    );
  ) :
  m_x >= 1005 && m_x <= 1055 && m_y >= ry_t + 6 && m_y <= ry_t + 30 ? (
    pm_t = 1920[tr_t];
    pm_t == 0 ? ( #pm_lbl = (info_lang == 0 ? "Avanti" : "Forward"); ) :
    pm_t == 1 ? ( #pm_lbl = (info_lang == 0 ? "Indietro" : "Reverse"); ) :
    pm_t == 2 ? ( #pm_lbl = (info_lang == 0 ? "Ping Pong" : "Ping Pong"); ) :
                ( #pm_lbl = (info_lang == 0 ? "Stocastica" : "Stochastic"); );
    info_lang == 0 ? (
      #tt_title = "MODALITA' RIPRODUZIONE";
      sprintf(#tt_desc, "Traccia %d: Modo attivo: %s. Trascinamento o rotella per cambiare. Doppio click: reset ad Avanti", tr_t + 1, #pm_lbl);
    ) : (
      #tt_title = "PLAY MODE";
      sprintf(#tt_desc, "Track %d: Active mode: %s. Drag or mouse wheel to change. Double-click to reset to Forward", tr_t + 1, #pm_lbl);
    );
  ) : (
    // 16-step grid tooltip check
    st_i = 0;
    while (st_i < 16) (
      bx_st = screen_grid_x + st_i * box_pitch_px;
      by_st = Y(ry_t + 6);
      mouse_x >= bx_st && mouse_x <= bx_st + box_w_px && mouse_y >= by_st && mouse_y <= by_st + box_h_px ? (
        #tt_title = "STEP";
        tt_g_step = step_page * 16 + st_i;
        tt_s_off = tr_t * 64 + tt_g_step;
        cond_mode ? (
          step_cond_val = 24000[tt_s_off];
          get_cond_str(step_cond_val);
          get_cond_desc(step_cond_val, info_lang);
          sprintf(#tt_title, "COND [%s]", #c_str);
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: %s. Rotella: cambia, Click rotella: digita indice, Click Destro/trascina: reset (---)", tr_t + 1, tt_g_step + 1, #c_desc)
                         : sprintf(#tt_desc, "Track %d, Step %d: %s. Mouse wheel: change, Wheel-click: type index, Right-Click/drag: reset (---)", tr_t + 1, tt_g_step + 1, #c_desc);
        ) :
        chance_mode ? (
          step_chance_val = 22000[tt_s_off];
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: Chance: %d%%. Rotella (+/-5%%), Click rotella: digita, Click Destro/trascina: reset (100%%)", tr_t + 1, tt_g_step + 1, step_chance_val)
                         : sprintf(#tt_desc, "Track %d, Step %d: Chance: %d%%. Wheel (+/-5%%), Wheel-click: type, Right-Click/drag: reset (100%%)", tr_t + 1, tt_g_step + 1, step_chance_val);
        ) :
        ratchet_mode ? (
          step_ratchet = 20000[tt_s_off];
          step_ratchet <= 0 ? step_ratchet = 1;
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: Click/trascina on/off. Rotella per RATCHETING (%d sub-step), Click rotella: digita, Click Destro/trascina: reset (1)", tr_t + 1, tt_g_step + 1, step_ratchet)
                         : sprintf(#tt_desc, "Track %d, Step %d: Click/drag on/off. Mouse wheel for RATCHETING (%d sub-steps), Wheel-click: type, Right-Click/drag: reset (1)", tr_t + 1, tt_g_step + 1, step_ratchet);
        ) :
        timing_mode ? (
          step_timing = 18000[tt_s_off];
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: Micro Timing: %+d%%. Rotella (+/-5%%), Click rotella: digita, Click Destro/trascina: reset (0%%)", tr_t + 1, tt_g_step + 1, step_timing)
                         : sprintf(#tt_desc, "Track %d, Step %d: Micro Timing: %+d%%. Wheel (+/-5%%), Wheel-click: type, Right-Click/drag: reset (0%%)", tr_t + 1, tt_g_step + 1, step_timing);
        ) :
        pan_mode ? (
          step_pan = 14000[tt_s_off];
          step_pan <= 0 && step_pan != 0 ? step_pan = 64;
          step_pan == 64 ? ( #p_str = "C"; ) :
          step_pan > 64 ? ( sprintf(#p_str, "+%d", step_pan - 64); ) :
                          ( sprintf(#p_str, "%d", step_pan - 64); );
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: Pan: %s. Rotella (+/-5), Click rotella: digita, Tasto Destro/trascina: reset (C)", tr_t + 1, tt_g_step + 1, #p_str)
                         : sprintf(#tt_desc, "Track %d, Step %d: Pan: %s. Wheel (+/-5), Wheel-click: type, Right-Click/drag: reset (C)", tr_t + 1, tt_g_step + 1, #p_str);
        ) :
        gate_mode ? (
          step_gate_idx = 16000[tt_s_off];
          (step_gate_idx < 0 || step_gate_idx > 69) ? step_gate_idx = 4;
          get_elektron_gate_full_str(step_gate_idx);
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: Click/trascina on/off. Rotella per GATE (%s step), Click rotella: digita, Click Destro/trascina: reset (1)", tr_t + 1, tt_g_step + 1, #g_full_str)
                         : sprintf(#tt_desc, "Track %d, Step %d: Click/drag on/off. Mouse wheel for GATE (%s steps), Wheel-click: type, Right-Click/drag: reset (1)", tr_t + 1, tt_g_step + 1, #g_full_str);
        ) :
        velocity_mode ? (
          step_vel = 12000[tt_s_off];
          step_vel <= 0 ? step_vel = 100;
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: Velocity: %d. Rotella (+/-5), Click rotella: digita, Click Destro/trascina: reset (100)", tr_t + 1, tt_g_step + 1, step_vel)
                         : sprintf(#tt_desc, "Track %d, Step %d: Velocity: %d. Wheel (+/-5), Wheel-click: type, Right-Click/drag: reset (100)", tr_t + 1, tt_g_step + 1, step_vel);
        ) : (
          info_lang == 0 ? sprintf(#tt_desc, "Traccia %d, Step %d: Click o trascinamento per attivare/disattivare lo step", tr_t + 1, tt_g_step + 1)
                         : sprintf(#tt_desc, "Track %d, Step %d: Click or drag to toggle step on/off", tr_t + 1, tt_g_step + 1);
        );
      );
      st_i += 1;
    );
  );

  row_idx += 1;
);

// Shared interaction details for the controls whose behavior is common.
strlen(#tt_title) > 0 ? (
  (vel_btn_hov || pan_btn_hov || timing_btn_hov || chance_btn_hov || gate_btn_hov || ratchet_btn_hov || cond_btn_hov) ? (
    str_getchar(#tt_desc, strlen(#tt_desc) - 1) == 46 ? str_setchar(#tt_desc, strlen(#tt_desc) - 1, 0);
    info_lang == 0 ? strcat(#tt_desc, ". Agisce sugli step attivi. Click o trascinamento per attivare o disattivare gli step; click destro o trascinamento per ripristinare il parametro.")
                   : strcat(#tt_desc, ". Applies to active steps. Click or drag to toggle steps; right-click or drag to reset the parameter.");
  );
  row_idx = 0;
  while (row_idx < TRACKS_PER_PAGE) (
    ry_tip = 52 + row_idx * 44;
    m_y >= ry_tip + 6 && m_y <= ry_tip + 30 ? (
      m_x >= 100 && m_x <= 310 ? (
        str_getchar(#tt_desc, strlen(#tt_desc) - 1) == 46 ? str_setchar(#tt_desc, strlen(#tt_desc) - 1, 0);
        info_lang == 0 ? strcat(#tt_desc, ". Click destro: ripristina questo parametro su tutte le tracce.")
                       : strcat(#tt_desc, ". Right-click: reset this parameter on all tracks.");
      ) : (m_x >= 786 && m_x <= 888) ? (
        str_getchar(#tt_desc, strlen(#tt_desc) - 1) == 46 ? str_setchar(#tt_desc, strlen(#tt_desc) - 1, 0);
        info_lang == 0 ? strcat(#tt_desc, ". Tasto sinistro o destro + rotella: regolazione fine di 1.")
                       : strcat(#tt_desc, ". Hold the left or right button while scrolling for fine adjustment by 1.");
      );
      mouse_x >= screen_grid_x && mouse_x <= screen_grid_x + 16 * box_pitch_px ? (
        str_getchar(#tt_desc, strlen(#tt_desc) - 1) == 46 ? str_setchar(#tt_desc, strlen(#tt_desc) - 1, 0);
        info_lang == 0 ? strcat(#tt_desc, ". Le modifiche al parametro e il reset agiscono solo sugli step attivi.")
                       : strcat(#tt_desc, ". Parameter edits and resets apply only to active steps.");
      );
    );
    row_idx += 1;
  );
);

// Floating tooltip box rendering
info_mode && strlen(#tt_title) > 0 ? (
  gfx_setfont(5, "Inter", sz_tt_title, 'B');
  gfx_measurestr(#tt_title, tt_t_w, tt_t_h);
  gfx_setfont(6, "Inter", sz_tt_desc, 'B');
  gfx_measurestr("Ag", tt_dummy_w, tt_line_h);
  tt_pad_x = W(14);
  tt_pad_y = H(8);
  // Measure whole words against a bounded width, then draw the same lines below.
  tt_max_w = max(1, min(W(430), cur_w - W(20) - tt_pad_x * 2));
  tt_pos = 0;
  tt_len = strlen(#tt_desc);
  tt_lines = 0;
  tt_d_w = 0;
  while (tt_pos < tt_len) (
    tt_end = tt_pos;
    tt_fit = tt_pos;
    while (tt_end < tt_len) (
      while (tt_end < tt_len && str_getchar(#tt_desc, tt_end) != 32) (tt_end += 1;);
      strcpy_substr(#tt_line, #tt_desc, tt_pos, tt_end - tt_pos);
      gfx_measurestr(#tt_line, tt_line_w, tt_dummy_h);
      (tt_line_w <= tt_max_w || tt_fit == tt_pos) ? (
        tt_fit = tt_end;
        tt_end < tt_len ? tt_end += 1;
      ) : (tt_end = tt_len;);
    );
    strcpy_substr(#tt_line, #tt_desc, tt_pos, tt_fit - tt_pos);
    gfx_measurestr(#tt_line, tt_line_w, tt_dummy_h);
    tt_d_w = max(tt_d_w, tt_line_w);
    tt_lines += 1;
    tt_pos = tt_fit;
    while (tt_pos < tt_len && str_getchar(#tt_desc, tt_pos) == 32) (tt_pos += 1;);
  );
  tt_content_w = max(tt_t_w, tt_d_w);
  tt_box_w = tt_content_w + tt_pad_x * 2;
  tt_box_h = tt_t_h + tt_lines * tt_line_h + tt_pad_y * 2 + H(4);

// Position tooltip near cursor
  tt_draw_x = mouse_x + W(16);
  tt_draw_y = mouse_y + H(18);

  tt_draw_x + tt_box_w > cur_w - W(12) ? (
    tt_draw_x = mouse_x - tt_box_w - W(12);
  );
  tt_draw_x < W(10) ? tt_draw_x = W(10);

  tt_draw_y + tt_box_h > cur_h - H(12) ? (
    tt_draw_y = mouse_y - tt_box_h - H(12);
  );
  tt_draw_y < H(10) ? tt_draw_y = H(10);

  gfx_r = 14 / 255.0; gfx_g = 14 / 255.0; gfx_b = 18 / 255.0;
  fill_roundrect(tt_draw_x, tt_draw_y, tt_box_w, tt_box_h, W(4));
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  gfx_roundrect(tt_draw_x, tt_draw_y, tt_box_w, tt_box_h, W(4), 1);

  gfx_setfont(5, "Inter", sz_tt_title, 'b');
  gfx_x = tt_draw_x + tt_pad_x;
  gfx_y = tt_draw_y + tt_pad_y;
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  gfx_drawstr(#tt_title);

  gfx_setfont(6, "Inter", sz_tt_desc, 'b');
  gfx_x = tt_draw_x + tt_pad_x;
  gfx_y = tt_draw_y + tt_pad_y + tt_t_h + H(4);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
  tt_pos = 0;
  while (tt_pos < tt_len) (
    tt_end = tt_pos;
    tt_fit = tt_pos;
    while (tt_end < tt_len) (
      while (tt_end < tt_len && str_getchar(#tt_desc, tt_end) != 32) (tt_end += 1;);
      strcpy_substr(#tt_line, #tt_desc, tt_pos, tt_end - tt_pos);
      gfx_measurestr(#tt_line, tt_line_w, tt_dummy_h);
      (tt_line_w <= tt_max_w || tt_fit == tt_pos) ? (
        tt_fit = tt_end;
        tt_end < tt_len ? tt_end += 1;
      ) : (tt_end = tt_len;);
    );
    strcpy_substr(#tt_line, #tt_desc, tt_pos, tt_fit - tt_pos);
    gfx_drawstr(#tt_line);
    gfx_x = tt_draw_x + tt_pad_x;
    gfx_y += tt_line_h;
    tt_pos = tt_fit;
    while (tt_pos < tt_len && str_getchar(#tt_desc, tt_pos) == 32) (tt_pos += 1;);
  );
  gfx_setfont(1, "Inter", sz_main, 'b');
);
lfo_sh_menu_open ? (
  gfx_dest = -1;
  mx_pos = lfo_sh_menu_x;
  my_pos = lfo_sh_menu_y;

  draw_floating_menu_frame(mx_pos, my_pos, menu_w_sh, menu_h_sh);

  cur_sh_m = 4500[lfo_cur_tr];
  cur_pol_m = 4760[lfo_cur_tr];
  gfx_setfont(8, "Inter", sz_btn, 0);

  // Mathematical hover item calculation
  hov_it = -1;
  (mouse_x >= mx_pos + W(2) && mouse_x <= mx_pos + menu_w_sh - W(2)) ? (
    rel_my = mouse_y - (my_pos + pad_y_sh);
    (rel_my >= 0 && rel_my < item_h_sh * 6) ? (
      hov_it = floor(rel_my / item_h_sh);
    ) :
    (rel_my >= item_h_sh * 6 + sep_sh && rel_my < item_h_sh * 9 + sep_sh) ? (
      hov_it = 6 + floor((rel_my - (item_h_sh * 6 + sep_sh)) / item_h_sh);
    );
  );

  it_i = 0;
  while (it_i < 9) (
    it_y = (it_i < 6) ? (my_pos + pad_y_sh + it_i * item_h_sh) :
                        (my_pos + pad_y_sh + it_i * item_h_sh + sep_sh);
    it_hov = (hov_it == it_i);

    it_hov ? (
      gfx_r = 45 / 255.0; gfx_g = 75 / 255.0; gfx_b = 110 / 255.0;
      fill_roundrect(mx_pos + W(2), it_y, menu_w_sh - W(4), item_h_sh, W(2));
    );

    it_i == 0 ? ( #it_str = "Sine"; is_chk = (cur_sh_m == 0); ) :
    it_i == 1 ? ( #it_str = "Triangle"; is_chk = (cur_sh_m == 1); ) :
    it_i == 2 ? ( #it_str = "Saw Down"; is_chk = (cur_sh_m == 2); ) :
    it_i == 3 ? ( #it_str = "Saw Up"; is_chk = (cur_sh_m == 3); ) :
    it_i == 4 ? ( #it_str = "Square"; is_chk = (cur_sh_m == 4); ) :
    it_i == 5 ? ( #it_str = "Sample & Hold"; is_chk = (cur_sh_m == 5); ) :
    it_i == 6 ? ( #it_str = "Bipolar"; is_chk = (cur_pol_m == 0); ) :
    it_i == 7 ? ( #it_str = "+Unipolar"; is_chk = (cur_pol_m == 1); ) :
                ( #it_str = "-Unipolar"; is_chk = (cur_pol_m == 2); );

    gfx_measurestr(#it_str, str_w, str_h);
    txt_y = it_y + floor((item_h_sh - str_h) * 0.5);

    is_chk ? (
      gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    ) : (
      it_hov ? (
        gfx_r = 245 / 255.0; gfx_g = 245 / 255.0; gfx_b = 250 / 255.0;
      ) : (
        gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 205 / 255.0;
      );
    );

    gfx_x = mx_pos + W(10);
    gfx_y = txt_y;
    gfx_drawstr(#it_str);

    it_i == 5 ? (
      sep_y = it_y + item_h_sh + floor(sep_sh * 0.5);
      gfx_r = 55 / 255.0; gfx_g = 55 / 255.0; gfx_b = 60 / 255.0;
      gfx_line(mx_pos + W(6), sep_y, mx_pos + menu_w_sh - W(6), sep_y);
    );

    it_i += 1;
  );
);

// In-GUI floating menu for LFO destinations
lfo_ds_menu_open ? (
  gfx_dest = -1;
  mx_pos = lfo_ds_menu_x; my_pos = lfo_ds_menu_y;
  draw_floating_menu_frame(mx_pos, my_pos, menu_w_ds, menu_h_ds);
  cur_d_m = 4600[lfo_cur_tr];
  gfx_setfont(8, "Inter", sz_btn, 0);
  it_i = 0;
  while (it_i < 7) (
    it_y = my_pos + pad_y_ds + it_i * item_h_ds + (it_i >= 1 ? sep_ds : 0) + (it_i >= 4 ? sep_ds : 0);
    it_hov = (mouse_x >= mx_pos + W(2) && mouse_x <= mx_pos + menu_w_ds - W(2) && mouse_y >= it_y && mouse_y < it_y + item_h_ds) ||
      (it_i == 1 && lfo_ds_sub_open == 4) || (it_i == 2 && lfo_ds_sub_open == 3) ||
      (it_i == 3 && lfo_ds_sub_open == 5) || (it_i == 4 && lfo_ds_sub_open == 1) || (it_i == 5 && lfo_ds_sub_open == 0) || (it_i == 6 && lfo_ds_sub_open == 2);
    it_hov ? (
      gfx_r = 45 / 255.0; gfx_g = 75 / 255.0; gfx_b = 110 / 255.0;
      fill_roundrect(mx_pos + W(2), it_y, menu_w_ds - W(4), item_h_ds, W(2));
    );
    it_i == 0 ? ( #it_d_str = "OFF"; is_chk = cur_d_m == 0; ) :
    it_i == 1 ? ( #it_d_str = "< Step"; is_chk = cur_d_m >= 7 && cur_d_m <= 12; ) :
    it_i == 2 ? ( #it_d_str = "< Track"; is_chk = (cur_d_m >= 1 && cur_d_m <= 6) || (cur_d_m >= 61 && cur_d_m <= 63); ) :
    it_i == 3 ? ( #it_d_str = "< Master"; is_chk = cur_d_m >= 64 && cur_d_m <= 67; ) :
    it_i == 4 ? ( #it_d_str = "< LFO Shape"; is_chk = cur_d_m >= 13 && cur_d_m <= 60 && (cur_d_m - 13) % 3 == 1; ) :
    it_i == 5 ? ( #it_d_str = "< LFO Rate"; is_chk = cur_d_m >= 13 && cur_d_m <= 60 && (cur_d_m - 13) % 3 == 0; ) :
                ( #it_d_str = "< LFO Amount"; is_chk = cur_d_m >= 13 && cur_d_m <= 60 && (cur_d_m - 13) % 3 == 2; );
    gfx_measurestr(#it_d_str, str_w, str_h);
    is_chk && it_i != 0 ? ( gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; ) :
    it_hov ? ( gfx_r = 245 / 255.0; gfx_g = 245 / 255.0; gfx_b = 250 / 255.0; ) :
             ( gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 205 / 255.0; );
    gfx_x = mx_pos + W(10); gfx_y = it_y + floor((item_h_ds - str_h) * 0.5); gfx_drawstr(#it_d_str);
    (it_i == 0 || it_i == 3) ? (
      gfx_r = 55 / 255.0; gfx_g = 55 / 255.0; gfx_b = 60 / 255.0;
      sep_y = it_y + item_h_ds + floor(sep_ds * 0.5);
      gfx_line(mx_pos + W(6), sep_y, mx_pos + menu_w_ds - W(6), sep_y);
    );
    it_i += 1;
  );
  lfo_ds_sub_open >= 0 ? (
    gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.45;
    fill_roundrect(sub_x_ds + W(2), sub_y_ds + H(2), sub_w_ds, sub_h_ds, W(3)); gfx_a = 1;
    gfx_r = 34 / 255.0; gfx_g = 34 / 255.0; gfx_b = 38 / 255.0;
    fill_roundrect(sub_x_ds, sub_y_ds, sub_w_ds, sub_h_ds, W(3));
    gfx_r = 62 / 255.0; gfx_g = 62 / 255.0; gfx_b = 68 / 255.0;
    gfx_roundrect(sub_x_ds, sub_y_ds, sub_w_ds, sub_h_ds, W(3), 1);
    sub_idx = 0; ti_sub = 0;
    while (sub_idx < sub_count_ds) (
      lfo_ds_sub_open == 3 ? (
        target_d = sub_idx < 4 ? sub_idx + 1 : sub_idx == 4 ? 61 : sub_idx == 7 ? 62 : sub_idx == 8 ? 63 : sub_idx;
        sub_idx == 0 ? #sub_lbl = "Pitch" : sub_idx == 1 ? #sub_lbl = "Rate" : sub_idx == 2 ? #sub_lbl = "Length" : sub_idx == 3 ? #sub_lbl = "Beats" : sub_idx == 4 ? #sub_lbl = "Volume" : sub_idx == 5 ? #sub_lbl = "Density" : sub_idx == 6 ? #sub_lbl = "Swing" : sub_idx == 7 ? #sub_lbl = "Gate" : #sub_lbl = "Pan";
      ) : lfo_ds_sub_open == 5 ? (
        target_d = sub_idx + 64;
        sub_idx == 0 ? #sub_lbl = "Length" : sub_idx == 1 ? #sub_lbl = "Density" : sub_idx == 2 ? #sub_lbl = "Swing" : #sub_lbl = "Gate";
      ) : lfo_ds_sub_open == 4 ? (
        target_d = sub_idx + 7;
        sub_idx == 0 ? #sub_lbl = "Velocity" : sub_idx == 1 ? #sub_lbl = "Gate" : sub_idx == 2 ? #sub_lbl = "Pan" : sub_idx == 3 ? #sub_lbl = "Timing" : sub_idx == 4 ? #sub_lbl = "Ratcheting" : #sub_lbl = "Chance";
      ) : (
        ti_sub == lfo_cur_tr ? ti_sub += 1;
        target_d = 13 + ti_sub * 3 + lfo_ds_sub_open;
        sprintf(#sub_lbl, "LFO %d", ti_sub + 1); ti_sub += 1;
      );
      it_sub_y = sub_y_ds + pad_y_ds + sub_idx * item_h_ds;
      is_sub_hov = mouse_x >= sub_x_ds + W(2) && mouse_x <= sub_x_ds + sub_w_ds - W(2) && mouse_y >= it_sub_y && mouse_y < it_sub_y + item_h_ds;
      is_sub_hov ? (
        gfx_r = 45 / 255.0; gfx_g = 75 / 255.0; gfx_b = 110 / 255.0;
        fill_roundrect(sub_x_ds + W(2), it_sub_y, sub_w_ds - W(4), item_h_ds, W(2));
      );
      gfx_measurestr(#sub_lbl, sub_str_w, sub_str_h);
      cur_d_m == target_d ? ( gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255; ) :
      is_sub_hov ? ( gfx_r = 245 / 255.0; gfx_g = 245 / 255.0; gfx_b = 250 / 255.0; ) :
                   ( gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 205 / 255.0; );
      gfx_x = sub_x_ds + W(10); gfx_y = it_sub_y + floor((item_h_ds - sub_str_h) * 0.5); gfx_drawstr(#sub_lbl);
      sub_idx += 1;
    );
  );
);

// In-GUI floating menu for scale selection (60 fps, non-blocking)
scale_menu_open ? (
  gfx_dest = -1;
  mx_pos = scale_menu_x;
  my_pos = scale_menu_y;

  draw_floating_menu_frame(mx_pos, my_pos, menu_w_sc, menu_h_sc);

  cur_sc_m = quant_scale;
  gfx_setfont(8, "Inter", sz_btn, 0);

  // Hover item calculation for 5 macro-categories
  hov_cat_i = -1;
  (mouse_x >= mx_pos + W(2) && mouse_x <= mx_pos + menu_w_sc - W(2)) ? (
    rel_my = mouse_y - (my_pos + pad_y_sc);
    (rel_my >= 0 && rel_my < item_h_sc * 5) ? (
      hov_cat_i = floor(rel_my / item_h_sc);
    );
  );

  cat_i = 0;
  while (cat_i < 5) (
    it_y = my_pos + pad_y_sc + cat_i * item_h_sc;
    it_hov = (hov_cat_i == cat_i) || (scale_sub_open == cat_i);

    it_hov ? (
      gfx_r = 45 / 255.0; gfx_g = 75 / 255.0; gfx_b = 110 / 255.0;
      fill_roundrect(mx_pos + W(2), it_y, menu_w_sc - W(4), item_h_sc, W(2));
    );

    cat_i == 0 ? #cat_str = "Diatonic Modes" :
    cat_i == 1 ? #cat_str = "Minor & Major Variations" :
    cat_i == 2 ? #cat_str = "Pentatonic & Blues" :
    cat_i == 3 ? #cat_str = "World & Ethnic" :
                 #cat_str = "Jazz & Symmetrical";

    is_cat_active = (cat_i == 0 && cur_sc_m <= 7) ||
                    (cat_i == 1 && cur_sc_m >= 8 && cur_sc_m <= 17) ||
                    (cat_i == 2 && cur_sc_m >= 18 && cur_sc_m <= 23) ||
                    (cat_i == 3 && cur_sc_m >= 24 && cur_sc_m <= 36) ||
                    (cat_i == 4 && cur_sc_m >= 37 && cur_sc_m <= 53);

    gfx_measurestr(#cat_str, str_w, str_h);
    txt_y = it_y + floor((item_h_sc - str_h) * 0.5);

    is_cat_active ? (
      gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    ) : (
      it_hov ? (
        gfx_r = 245 / 255.0; gfx_g = 245 / 255.0; gfx_b = 250 / 255.0;
      ) : (
        gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 205 / 255.0;
      );
    );

    gfx_x = mx_pos + W(10);
    gfx_y = txt_y;
    gfx_drawstr(#cat_str);

    // Arrow indicator to the right
    gfx_measurestr(">", arr_w, arr_h);
    gfx_x = mx_pos + menu_w_sc - arr_w - W(8);
    gfx_y = txt_y;
    gfx_drawstr(">");

    cat_i += 1;
  );

  // Cascading submenu to the right with active category scales
  scale_sub_open >= 0 ? (
    sub_w_sc = max(145, W(165));
    sub_cnt_sc = (scale_sub_open == 0) ? 8 :
                 (scale_sub_open == 1) ? 10 :
                 (scale_sub_open == 2) ? 6 :
                 (scale_sub_open == 3) ? 13 :
                 (scale_sub_open == 4) ? 17 : 0;
    sub_h_sc = pad_y_sc * 2 + item_h_sc * sub_cnt_sc;
    sub_x_sc = (scale_menu_x + menu_w_sc + sub_w_sc + W(10) <= cur_w) ?
               (scale_menu_x + menu_w_sc + W(2)) :
               (scale_menu_x - sub_w_sc - W(2));
    sub_y_sc = min(cur_h - sub_h_sc - H(8), max(H(8), scale_menu_y + scale_sub_open * item_h_sc - H(20)));

    // Submenu depth shadow
    gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.45;
    fill_roundrect(sub_x_sc + W(2), sub_y_sc + H(2), sub_w_sc, sub_h_sc, W(3));
    gfx_a = 1.0;

    // Submenu dark background (#222226)
    gfx_r = 34 / 255.0; gfx_g = 34 / 255.0; gfx_b = 38 / 255.0;
    fill_roundrect(sub_x_sc, sub_y_sc, sub_w_sc, sub_h_sc, W(3));
    gfx_r = 62 / 255.0; gfx_g = 62 / 255.0; gfx_b = 68 / 255.0;
    gfx_roundrect(sub_x_sc, sub_y_sc, sub_w_sc, sub_h_sc, W(3), 1);

    // Scale submenu hover calculation
    hov_sub_sc = -1;
    (mouse_x >= sub_x_sc + W(2) && mouse_x <= sub_x_sc + sub_w_sc - W(2)) ? (
      sub_rel_my = mouse_y - (sub_y_sc + pad_y_sc);
      (sub_rel_my >= 0 && sub_rel_my < item_h_sc * sub_cnt_sc) ? (
        hov_sub_sc = floor(sub_rel_my / item_h_sc);
      );
    );

    base_sc_idx = (scale_sub_open == 0) ? 0 :
                  (scale_sub_open == 1) ? 8 :
                  (scale_sub_open == 2) ? 18 :
                  (scale_sub_open == 3) ? 24 : 37;

    sc_it = 0;
    while (sc_it < sub_cnt_sc) (
      curr_scale_id = base_sc_idx + sc_it;
      it_sub_y = sub_y_sc + pad_y_sc + sc_it * item_h_sc;
      is_it_hov = (hov_sub_sc == sc_it);

      is_it_hov ? (
        gfx_r = 45 / 255.0; gfx_g = 75 / 255.0; gfx_b = 110 / 255.0;
        fill_roundrect(sub_x_sc + W(2), it_sub_y, sub_w_sc - W(4), item_h_sc, W(2));
      );

      is_scale_active = (cur_sc_m == curr_scale_id);

      scale_sub_open == 0 ? (
        sc_it == 0 ? #sc_it_str = "Chromatic" :
        sc_it == 1 ? #sc_it_str = "Major (Ionian)" :
        sc_it == 2 ? #sc_it_str = "Natural Minor (Aeolian)" :
        sc_it == 3 ? #sc_it_str = "Dorian" :
        sc_it == 4 ? #sc_it_str = "Phrygian" :
        sc_it == 5 ? #sc_it_str = "Lydian" :
        sc_it == 6 ? #sc_it_str = "Mixolydian" :
                     #sc_it_str = "Locrian";
      ) :
      scale_sub_open == 1 ? (
        sc_it == 0 ? #sc_it_str = "Harmonic Minor" :
        sc_it == 1 ? #sc_it_str = "Melodic Minor" :
        sc_it == 2 ? #sc_it_str = "Harmonic Major" :
        sc_it == 3 ? #sc_it_str = "Phrygian Dominant" :
        sc_it == 4 ? #sc_it_str = "Double Harmonic" :
        sc_it == 5 ? #sc_it_str = "Hungarian Minor" :
        sc_it == 6 ? #sc_it_str = "Hungarian Major" :
        sc_it == 7 ? #sc_it_str = "Romanian Minor" :
        sc_it == 8 ? #sc_it_str = "Neapolitan Major" :
                     #sc_it_str = "Neapolitan Minor";
      ) :
      scale_sub_open == 2 ? (
        sc_it == 0 ? #sc_it_str = "Major Pentatonic" :
        sc_it == 1 ? #sc_it_str = "Minor Pentatonic" :
        sc_it == 2 ? #sc_it_str = "Blues" :
        sc_it == 3 ? #sc_it_str = "Major Blues" :
        sc_it == 4 ? #sc_it_str = "Egyptian" :
                     #sc_it_str = "Ryukyu";
      ) :
      scale_sub_open == 3 ? (
        sc_it == 0  ? #sc_it_str = "Hirajoshi" :
        sc_it == 1  ? #sc_it_str = "Insen" :
        sc_it == 2  ? #sc_it_str = "Iwato" :
        sc_it == 3  ? #sc_it_str = "Kumoi" :
        sc_it == 4  ? #sc_it_str = "Miyako-bushi" :
        sc_it == 5  ? #sc_it_str = "Pelog" :
        sc_it == 6  ? #sc_it_str = "Balinese" :
        sc_it == 7  ? #sc_it_str = "Slendro" :
        sc_it == 8  ? #sc_it_str = "Ritsusen" :
        sc_it == 9  ? #sc_it_str = "Arabic" :
        sc_it == 10 ? #sc_it_str = "Persian" :
        sc_it == 11 ? #sc_it_str = "Spanish 8-Tone" :
                      #sc_it_str = "Todi (Raga)";
      ) : (
        sc_it == 0  ? #sc_it_str = "Whole Tone" :
        sc_it == 1  ? #sc_it_str = "Diminished HW" :
        sc_it == 2  ? #sc_it_str = "Diminished WH" :
        sc_it == 3  ? #sc_it_str = "Augmented" :
        sc_it == 4  ? #sc_it_str = "Altered" :
        sc_it == 5  ? #sc_it_str = "Lydian Dominant" :
        sc_it == 6  ? #sc_it_str = "Lydian Augmented" :
        sc_it == 7  ? #sc_it_str = "Locrian Natural 2" :
        sc_it == 8  ? #sc_it_str = "Major Locrian" :
        sc_it == 9  ? #sc_it_str = "Ultra Locrian" :
        sc_it == 10 ? #sc_it_str = "Leading Whole Tone" :
        sc_it == 11 ? #sc_it_str = "Bebop Major" :
        sc_it == 12 ? #sc_it_str = "Bebop Dominant" :
        sc_it == 13 ? #sc_it_str = "Bebop Minor" :
        sc_it == 14 ? #sc_it_str = "Prometheus" :
        sc_it == 15 ? #sc_it_str = "Istrian" :
                      #sc_it_str = "Enigmatic";
      );

      gfx_measurestr(#sc_it_str, str_w, str_h);
      sub_txt_y = it_sub_y + floor((item_h_sc - str_h) * 0.5);

      is_scale_active ? (
        gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
      ) : (
        is_it_hov ? (
          gfx_r = 245 / 255.0; gfx_g = 245 / 255.0; gfx_b = 250 / 255.0;
        ) : (
          gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 205 / 255.0;
        );
      );

      gfx_x = sub_x_sc + W(10);
      gfx_y = sub_txt_y;
      gfx_drawstr(#sc_it_str);

      sc_it += 1;
    );
  );
);

// In-GUI floating menu for LFO Rate / Metric Sync (60 fps, non-blocking)
lfo_rt_menu_open ? (
  gfx_dest = -1;
  mx_pos = lfo_rt_menu_x;
  my_pos = lfo_rt_menu_y;

  draw_floating_menu_frame(mx_pos, my_pos, menu_w_rt, menu_h_rt);

  cur_typ_m = 4700[lfo_cur_tr];
  cur_rt_m = 4540[lfo_cur_tr];
  gfx_setfont(8, "Inter", sz_btn, 0);

  // Hover item calculation
  hov_it_rt = -1;
  (mouse_x >= mx_pos + W(2) && mouse_x <= mx_pos + menu_w_rt - W(2)) ? (
    rel_my = mouse_y - (my_pos + pad_y_rt);
    (rel_my >= 0 && rel_my < item_h_rt * 12) ? (
      hov_it_rt = floor(rel_my / item_h_rt);
    ) :
    (rel_my >= item_h_rt * 12 + sep_rt && rel_my < item_h_rt * 15 + sep_rt) ? (
      hov_it_rt = 12 + floor((rel_my - (item_h_rt * 12 + sep_rt)) / item_h_rt);
    );
  );

  it_i = 0;
  while (it_i < 15) (
    it_y = (it_i <= 11) ? (my_pos + pad_y_rt + it_i * item_h_rt) :
                          (my_pos + pad_y_rt + it_i * item_h_rt + sep_rt);
    it_hov = (hov_it_rt == it_i);

    it_hov ? (
      gfx_r = 45 / 255.0; gfx_g = 75 / 255.0; gfx_b = 110 / 255.0;
      fill_roundrect(mx_pos + W(2), it_y, menu_w_rt - W(4), item_h_rt, W(2));
    );

    it_i == 0  ? ( #it_rt_str = "1/64";           is_chk = (cur_rt_m == 11); ) :
    it_i == 1  ? ( #it_rt_str = "1/32";           is_chk = (cur_rt_m == 10); ) :
    it_i == 2  ? ( #it_rt_str = "1/16";           is_chk = (cur_rt_m == 9);  ) :
    it_i == 3  ? ( #it_rt_str = "1/8";            is_chk = (cur_rt_m == 8);  ) :
    it_i == 4  ? ( #it_rt_str = "1/4";            is_chk = (cur_rt_m == 7);  ) :
    it_i == 5  ? ( #it_rt_str = "1/2";            is_chk = (cur_rt_m == 6);  ) :
    it_i == 6  ? ( #it_rt_str = "1/1";            is_chk = (cur_rt_m == 5);  ) :
    it_i == 7  ? ( #it_rt_str = "2/1";            is_chk = (cur_rt_m == 4);  ) :
    it_i == 8  ? ( #it_rt_str = "4/1";            is_chk = (cur_rt_m == 3);  ) :
    it_i == 9  ? ( #it_rt_str = "8/1";            is_chk = (cur_rt_m == 2);  ) :
    it_i == 10 ? ( #it_rt_str = "16/1";           is_chk = (cur_rt_m == 1);  ) :
    it_i == 11 ? ( #it_rt_str = "32/1";           is_chk = (cur_rt_m == 0);  ) :
    it_i == 12 ? ( #it_rt_str = "Tempo";          is_chk = (cur_typ_m == 0); ) :
    it_i == 13 ? ( #it_rt_str = "Tempo Dotted";   is_chk = (cur_typ_m == 1); ) :
                 ( #it_rt_str = "Tempo Triplets"; is_chk = (cur_typ_m == 2); );

    gfx_measurestr(#it_rt_str, str_w, str_h);
    txt_y = it_y + floor((item_h_rt - str_h) * 0.5);

    is_chk ? (
      gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    ) : (
      it_hov ? (
        gfx_r = 245 / 255.0; gfx_g = 245 / 255.0; gfx_b = 250 / 255.0;
      ) : (
        gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 205 / 255.0;
      );
    );

    gfx_x = mx_pos + W(10);
    gfx_y = txt_y;
    gfx_drawstr(#it_rt_str);

    it_i == 11 ? (
      sep_y = it_y + item_h_rt + floor(sep_rt * 0.5);
      gfx_r = 55 / 255.0; gfx_g = 55 / 255.0; gfx_b = 60 / 255.0;
      gfx_line(mx_pos + W(6), sep_y, mx_pos + menu_w_rt - W(6), sep_y);
    );

    it_i += 1;
  );
);

// In-GUI floating menu for Slot A mode (Density / Volume)
slot_a_menu_open ? (
  gfx_dest = -1;
  mx_pos = slot_a_menu_x;
  my_pos = slot_a_menu_y;

  draw_floating_menu_frame(mx_pos, my_pos, menu_w_sa, menu_h_sa);

  cur_m_sa = 2100[slot_a_menu_tr];
  gfx_setfont(8, "Inter", sz_btn, 0);

  // Check if all tracks currently share the same mode
  all_vol = 1;
  all_dens = 1;
  ti_chk = 0;
  while (ti_chk < NUM_TRACKS) (
    2100[ti_chk] != 0 ? all_vol = 0;
    2100[ti_chk] != 1 ? all_dens = 0;
    ti_chk += 1;
  );

  // Hover item calculation
  hov_it_sa = -1;
  (mouse_x >= mx_pos + W(2) && mouse_x <= mx_pos + menu_w_sa - W(2)) ? (
    rel_my = mouse_y - (my_pos + pad_y_sa);
    (rel_my >= 0 && rel_my < item_h_sa * 2) ? (
      hov_it_sa = floor(rel_my / item_h_sa);
    ) :
    (rel_my >= item_h_sa * 2 + sep_sa && rel_my < item_h_sa * 4 + sep_sa) ? (
      hov_it_sa = 2 + floor((rel_my - (item_h_sa * 2 + sep_sa)) / item_h_sa);
    ) :
    (rel_my >= item_h_sa * 4 + sep_sa * 2 && rel_my < item_h_sa * 6 + sep_sa * 2) ? (
      hov_it_sa = 4 + floor((rel_my - (item_h_sa * 4 + sep_sa * 2)) / item_h_sa);
    );
  );

  it_i = 0;
  while (it_i < 6) (
    it_y = my_pos + pad_y_sa + it_i * item_h_sa + (it_i >= 2 ? sep_sa : 0) + (it_i >= 4 ? sep_sa : 0);
    it_hov = (hov_it_sa == it_i);

    it_hov ? (
      gfx_r = 45 / 255.0; gfx_g = 75 / 255.0; gfx_b = 110 / 255.0;
      fill_roundrect(mx_pos + W(2), it_y, menu_w_sa - W(4), item_h_sa, W(2));
    );

    it_i == 0 ? ( #it_sa_str = "Volume";      is_chk = (cur_m_sa == 0); ) :
    it_i == 1 ? ( #it_sa_str = "Density";     is_chk = (cur_m_sa == 1); ) :
    it_i == 2 ? ( #it_sa_str = "ALL Volume";  is_chk = all_vol; ) :
    it_i == 3 ? ( #it_sa_str = "ALL Density"; is_chk = all_dens; ) :
    it_i == 4 ? ( #it_sa_str = "Reset Volume"; is_chk = 0; ) :
                ( #it_sa_str = "Reset Density"; is_chk = 0; );

    gfx_measurestr(#it_sa_str, str_w, str_h);
    txt_y = it_y + floor((item_h_sa - str_h) * 0.5);

    is_chk ? (
      gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    ) : (
      it_hov ? (
        gfx_r = 245 / 255.0; gfx_g = 245 / 255.0; gfx_b = 250 / 255.0;
      ) : (
        gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 205 / 255.0;
      );
    );

    gfx_x = mx_pos + W(10);
    gfx_y = txt_y;
    gfx_drawstr(#it_sa_str);

    // Separator line between individual and global track options
    (it_i == 1 || it_i == 3) ? (
      sep_y = it_y + item_h_sa + floor(sep_sa * 0.5);
      gfx_r = 55 / 255.0; gfx_g = 55 / 255.0; gfx_b = 60 / 255.0;
      gfx_line(mx_pos + W(6), sep_y, mx_pos + menu_w_sa - W(6), sep_y);
    );

    it_i += 1;
  );
);

// In-GUI floating menu for Slot B mode (Swing / Pan / Gate)
slot_b_menu_open ? (
  gfx_dest = -1;
  mx_pos = slot_b_menu_x;
  my_pos = slot_b_menu_y;

  draw_floating_menu_frame(mx_pos, my_pos, menu_w_sb, menu_h_sb);

  cur_m_sb = 2140[slot_b_menu_tr];
  gfx_setfont(8, "Inter", sz_btn, 0);

  // Check if all tracks currently share the same mode
  all_sw = 1;
  all_gt = 1;
  all_pn = 1;
  ti_chk_b = 0;
  while (ti_chk_b < NUM_TRACKS) (
    2140[ti_chk_b] != 0 ? all_sw = 0;
    2140[ti_chk_b] != 2 ? all_gt = 0;
    2140[ti_chk_b] != 1 ? all_pn = 0;
    ti_chk_b += 1;
  );

  // Hover item calculation
  hov_it_sb = -1;
  (mouse_x >= mx_pos + W(2) && mouse_x <= mx_pos + menu_w_sb - W(2)) ? (
    rel_my = mouse_y - (my_pos + pad_y_sb);
    (rel_my >= 0 && rel_my < item_h_sb * 3) ? (
      hov_it_sb = floor(rel_my / item_h_sb);
    ) :
    (rel_my >= item_h_sb * 3 + sep_sb && rel_my < item_h_sb * 6 + sep_sb) ? (
      hov_it_sb = 3 + floor((rel_my - (item_h_sb * 3 + sep_sb)) / item_h_sb);
    ) :
    (rel_my >= item_h_sb * 6 + sep_sb * 2 && rel_my < item_h_sb * 9 + sep_sb * 2) ? (
      hov_it_sb = 6 + floor((rel_my - (item_h_sb * 6 + sep_sb * 2)) / item_h_sb);
    );
  );

  it_i = 0;
  while (it_i < 9) (
    it_y = my_pos + pad_y_sb + it_i * item_h_sb + (it_i >= 3 ? sep_sb : 0) + (it_i >= 6 ? sep_sb : 0);
    it_hov = (hov_it_sb == it_i);

    it_hov ? (
      gfx_r = 45 / 255.0; gfx_g = 75 / 255.0; gfx_b = 110 / 255.0;
      fill_roundrect(mx_pos + W(2), it_y, menu_w_sb - W(4), item_h_sb, W(2));
    );

    it_i == 0 ? ( #it_sb_str = "Swing";     is_chk = (cur_m_sb == 0); ) :
    it_i == 1 ? ( #it_sb_str = "Gate";      is_chk = (cur_m_sb == 2); ) :
    it_i == 2 ? ( #it_sb_str = "Pan";       is_chk = (cur_m_sb == 1); ) :
    it_i == 3 ? ( #it_sb_str = "ALL Swing"; is_chk = all_sw; ) :
    it_i == 4 ? ( #it_sb_str = "ALL Gate";  is_chk = all_gt; ) :
    it_i == 5 ? ( #it_sb_str = "ALL Pan";   is_chk = all_pn; ) :
    it_i == 6 ? ( #it_sb_str = "Reset Swing"; is_chk = 0; ) :
    it_i == 7 ? ( #it_sb_str = "Reset Gate";  is_chk = 0; ) :
                ( #it_sb_str = "Reset Pan";   is_chk = 0; );

    gfx_measurestr(#it_sb_str, str_w, str_h);
    txt_y = it_y + floor((item_h_sb - str_h) * 0.5);

    is_chk ? (
      gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    ) : (
      it_hov ? (
        gfx_r = 245 / 255.0; gfx_g = 245 / 255.0; gfx_b = 250 / 255.0;
      ) : (
        gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 205 / 255.0;
      );
    );

    gfx_x = mx_pos + W(10);
    gfx_y = txt_y;
    gfx_drawstr(#it_sb_str);

    // Separator line between individual and global track options
    (it_i == 2 || it_i == 5) ? (
      sep_y = it_y + item_h_sb + floor(sep_sb * 0.5);
      gfx_r = 55 / 255.0; gfx_g = 55 / 255.0; gfx_b = 60 / 255.0;
      gfx_line(mx_pos + W(6), sep_y, mx_pos + menu_w_sb - W(6), sep_y);
    );

    it_i += 1;
  );
);

// In-GUI floating menu for Master Slot 2 mode (Swing / Gate)
master_s2_menu_open ? (
  gfx_dest = -1;
  mx_pos = master_s2_menu_x;
  my_pos = master_s2_menu_y;

  draw_floating_menu_frame(mx_pos, my_pos, menu_w_ms2, menu_h_ms2);

  cur_m_ms2 = master_s2_mode;
  gfx_setfont(8, "Inter", sz_btn, 0);

  // Hover item calculation
  hov_it_ms2 = -1;
  (mouse_x >= mx_pos + W(2) && mouse_x <= mx_pos + menu_w_ms2 - W(2)) ? (
    rel_my = mouse_y - (my_pos + pad_y_ms2);
    (rel_my >= 0 && rel_my < item_h_ms2 * 2) ? (
      hov_it_ms2 = floor(rel_my / item_h_ms2);
    );
  );

  it_i = 0;
  while (it_i < 2) (
    it_y = my_pos + pad_y_ms2 + it_i * item_h_ms2;
    it_hov = (hov_it_ms2 == it_i);

    it_hov ? (
      gfx_r = 45 / 255.0; gfx_g = 75 / 255.0; gfx_b = 110 / 255.0;
      fill_roundrect(mx_pos + W(2), it_y, menu_w_ms2 - W(4), item_h_ms2, W(2));
    );

    it_i == 0 ? ( #it_ms2_str = "Master Swing"; is_chk = (cur_m_ms2 == 0); ) :
                ( #it_ms2_str = "Master Gate";  is_chk = (cur_m_ms2 == 1); );

    gfx_measurestr(#it_ms2_str, str_w, str_h);
    txt_y = it_y + floor((item_h_ms2 - str_h) * 0.5);

    is_chk ? (
      gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    ) : (
      it_hov ? (
        gfx_r = 245 / 255.0; gfx_g = 245 / 255.0; gfx_b = 250 / 255.0;
      ) : (
        gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 205 / 255.0;
      );
    );

    gfx_x = mx_pos + W(10);
    gfx_y = txt_y;
    gfx_drawstr(#it_ms2_str);

    it_i += 1;
  );
);

// In-GUI floating menu for Pattern context actions (Copy / Cut / Paste)
pat_menu_open ? (
  gfx_dest = -1;
  mx_pos = pat_menu_x;
  my_pos = pat_menu_y;

  draw_floating_menu_frame(mx_pos, my_pos, menu_w_pat, menu_h_pat);

  gfx_setfont(8, "Inter", sz_btn, 0);

  // Hover item calculation
  hov_it_pat = -1;
  (mouse_x >= mx_pos + W(2) && mouse_x <= mx_pos + menu_w_pat - W(2)) ? (
    rel_my = mouse_y - (my_pos + pad_y_pat);
    (rel_my >= 0 && rel_my < item_h_pat * 3) ? (
      hov_it_pat = floor(rel_my / item_h_pat);
    );
  );

  it_i = 0;
  while (it_i < 3) (
    it_y = my_pos + pad_y_pat + it_i * item_h_pat;
    it_hov = (hov_it_pat == it_i);
    is_disabled = (it_i == 2 && !has_pat_clipboard);

    (it_hov && !is_disabled) ? (
      gfx_r = 45 / 255.0; gfx_g = 75 / 255.0; gfx_b = 110 / 255.0;
      fill_roundrect(mx_pos + W(2), it_y, menu_w_pat - W(4), item_h_pat, W(2));
    );

    it_i == 0 ? ( #it_pat_str = "Copy"; ) :
    it_i == 1 ? ( #it_pat_str = "Cut";  ) :
                ( #it_pat_str = "Paste"; );

    gfx_measurestr(#it_pat_str, str_w, str_h);
    txt_y = it_y + floor((item_h_pat - str_h) * 0.5);

    is_disabled ? (
      gfx_r = 80 / 255.0; gfx_g = 80 / 255.0; gfx_b = 88 / 255.0;
    ) : it_hov ? (
      gfx_r = 245 / 255.0; gfx_g = 245 / 255.0; gfx_b = 250 / 255.0;
    ) : (
      gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 205 / 255.0;
    );

    gfx_x = mx_pos + W(10);
    gfx_y = txt_y;
    gfx_drawstr(#it_pat_str);

    it_i += 1;
  );
);
