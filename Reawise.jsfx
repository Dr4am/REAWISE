          active_mouse_zone = 1; captured_btn_id = 300 + tr_btn;
          undo_push(); do_track_shl(tr_btn); mouse_clicked = 1; gui_dirty = 1;
        ) :
        m_x >= 917 && m_x <= 937 ? (
