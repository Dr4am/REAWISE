) :
vel_btn_hov ? (
  info_lang == 0 ? (
    #tt_title = "VELOCITY";
    #tt_desc = "Seleziona la modifica della velocity: determina l'intensità della nota MIDI di ogni step. Usa la rotella sullo step o click rotella per digitare";
  ) : (
