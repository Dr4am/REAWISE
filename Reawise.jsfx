          undo_push(); do_track_flip(tr_btn); mouse_clicked = 1; gui_dirty = 1;
        ) :
        m_x >= 979 && m_x <= 1003 ? (
          active_mouse_zone = 7; captured_btn_id = 600 + tr_btn;
          last_painted_random_tr = tr_btn;
          undo_push(); do_track_rnd(tr_btn); mouse_clicked = 1; gui_dirty = 1;
        );
      );
