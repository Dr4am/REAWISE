desc: REAWISE
// Author: DR4
// Version: 1.8
options:no_meter

in_pin:none
out_pin:none

@init
ext_noinit = 1;
NUM_TRACKS = 16;
leg_overlap_ms = 10;   // LEG: how long (ms) the old note overlaps the new one before its note-off
TRACKS_PER_PAGE = 8;
MAX_STEPS = 64;

current_page = 0;
step_page = 0;         // Active step page (0: 1..16, 1: 17..32, 2: 33..48, 3: 49..64)
euc_mode = 0;          // Global Euclidean mode (0 = off, 1 = on)
last_mouse_r_down = 0;

// Pattern & Chaining Engine (16 patterns x 9000 slots)
PATTERN_BASE = 500000;
PATTERN_BLOCK_SIZE = 9000;
active_edit_pat = 0;   // Pattern currently edited in GUI (0..15)
active_play_pat = 0;   // Pattern currently sounding in audio engine (0..15)
queued_play_pat = -1;  // Pattern queued for next cycle (-1 = none)
chain_mode = 0;        // Pattern chaining mode (0 = off, 1 = on)
chain_len = 0;         // Number of patterns in chain (0..64)
chain_pos = 0;         // Current playing index in chain (0..chain_len-1)
pat_start_beat = 0;    // Beat position where current pattern cycle started
CHAIN_BASE = 650000;   // Chain sequence buffer
PAT_CLIPBOARD_BASE = 400000; // Pattern clipboard buffer (9000 slots)
has_pat_clipboard = 0;       // 1 if clipboard contains copied/cut pattern
pat_menu_open = 0;           // Pattern context menu state
pat_menu_target = 0;         // Target pattern index for Copy/Cut/Paste

// Global Transpose (+/- semi in scale, +/- octaves) - Active
global_oct_offset = 0;   // Transpose octave counter
global_semi_offset = 0;  // Transpose semitone counter

// Master Volume Control (0..100%, scales track volume -> step velocity)
master_vol = 100;

// Master Density Control (0..100%, default 100% = 1.0x neutral)
master_density = 100;

// Master Gate Control (-100..+100%, default 0% = 1.0x neutral)
master_gate = 0;

// Master Swing Control (-100..+100%, default 0% offset to track swing)
master_swing = 0;

// Master Modular Slot 2 Mode (0: Swing, 1: Gate)
master_s2_mode = 0;
master_s2_menu_open = 0;

// Master Pattern Length Offset (-63..+63, relative shift preserving track proportions)
master_len_offset = 0;

// Stereo MIDI Activity Meter (Velocity x Pan)
meter_l_raw = 0.0;
meter_r_raw = 0.0;
meter_l_disp = 0.0;
meter_r_disp = 0.0;
meter_l_peak = 0.0;
meter_r_peak = 0.0;
meter_l_peak_time = 0.0;
meter_r_peak_time = 0.0;
meter_l_num_peak = 0;
meter_r_num_peak = 0;
meter_l_num_time = 0.0;
meter_r_num_time = 0.0;
last_mtr_time = 0.0;

function update_midi_meter(vel, pan) local(norm_vel, gl, gr, now_t, vl, vr) (
  vel > 0 ? (
    pan < 0 ? pan = 64 : pan > 127 ? pan = 64;
    norm_vel = min(1.0, max(0.0, vel / 127.0));
    pan <= 64 ? (
      gl = norm_vel;
      gr = norm_vel * (pan / 64.0);
    ) : (
      gl = norm_vel * ((127 - pan) / 63.0);
      gr = norm_vel;
    );
    gl > meter_l_raw ? meter_l_raw = gl;
    gr > meter_r_raw ? meter_r_raw = gr;
    now_t = time_precise();
    gl >= meter_l_peak ? (
      meter_l_peak = gl;
      meter_l_peak_time = now_t;
    );
    gr >= meter_r_peak ? (
      meter_r_peak = gr;
      meter_r_peak_time = now_t;
    );

    // Track numeric MIDI velocity peak (0..127) per channel
    vl = min(127, max(0, floor(gl * 127.0 + 0.5)));
    vr = min(127, max(0, floor(gr * 127.0 + 0.5)));
    vl > meter_l_block_vel ? meter_l_block_vel = vl;
    vr > meter_r_block_vel ? meter_r_block_vel = vr;
  );
);

// Pattern slots contain eight 1024-value step arrays (16 tracks x 64 steps),
// followed by per-track settings. The same layout is used when saving and loading.
function init_pattern_slot_defaults(pat_idx) local(base, si, ti) (
  base = PATTERN_BASE + (pat_idx % 16) * PATTERN_BLOCK_SIZE;
  si = 0;
  while (si < 1024) (
    base[si]        = 0;   // Step trigger: off (0)
    base[1024 + si] = 100; // Velocity: 100
    base[2048 + si] = 64;  // Pan: 64 (Center)
    base[3072 + si] = 4;   // Gate: 4 (1 step)
    base[4096 + si] = 0;   // Timing: 0%
    base[5120 + si] = 1;   // Ratchet: 1
    base[6144 + si] = 100; // Chance: 100%
    base[7168 + si] = 0;   // Condition: 0 ("---")
    si += 1;
  );

  ti = 0;
  while (ti < 16) (
    base[8192 + ti]       = 60;     // Pitch: 60 (C4)
    base[8192 + 16 + ti]  = ti + 1; // Channel: 1..16
    base[8192 + 32 + ti]  = 7;      // Rate: index 7 ("x4")
    base[8192 + 48 + ti]  = 16;     // Length: 16 steps
    base[8192 + 64 + ti]  = 0;      // Solo: 0
    base[8192 + 80 + ti]  = 0;      // Mute: 0
    base[8192 + 96 + ti]  = 100;    // Density / Chance: 100%
    base[8192 + 112 + ti] = 0;      // Swing: 0%
    base[8192 + 128 + ti] = 0;      // Euclidean Fill: 0
    base[8192 + 160 + ti] = 0;      // Play mode: 0 (Forward)
    base[8192 + 176 + ti] = 100;    // Track Volume: 100%
    base[8192 + 192 + ti] = 0;      // Slot A mode: 0=Volume, 1=Density
    base[8430 + ti]       = 0;      // Track Pan: 0% (Center)
    base[8450 + ti]       = 0;      // Slot B mode: 0=Swing, 1=Pan, 2=Gate
    base[8470 + ti]       = 0;      // Track Gate: 0% (Neutral 1.0x)
    ti += 1;
  );
  base[8486] = 100; // Master density
  base[8487] = 0;   // Master swing offset
  base[8488] = 0;   // Master length offset
);

// Copy the editable working arrays into the selected pattern slot.
function save_pattern_to_mem(pat_idx) local(base, ti) (
  base = PATTERN_BASE + (pat_idx % 16) * PATTERN_BLOCK_SIZE;
  memcpy(base,        10000, 1024);
  memcpy(base + 1024, 12000, 1024);
  memcpy(base + 2048, 14000, 1024);
  memcpy(base + 3072, 16000, 1024);
  memcpy(base + 4096, 18000, 1024);
  memcpy(base + 5120, 20000, 1024);
  memcpy(base + 6144, 22000, 1024);
  memcpy(base + 7168, 24000, 1024);

  ti = 0;
  while (ti < 16) (
    base[8192 + ti]       = 1600[ti];
    base[8192 + 16 + ti]  = 1620[ti];
    base[8192 + 32 + ti]  = 1640[ti];
    base[8192 + 48 + ti]  = 1660[ti];
    base[8192 + 64 + ti]  = 1680[ti];
    base[8192 + 80 + ti]  = 1700[ti];
    base[8192 + 96 + ti]  = 1720[ti];
    base[8192 + 112 + ti] = 1740[ti];
    base[8192 + 128 + ti] = 1860[ti];
    base[8192 + 160 + ti] = 1920[ti];
    base[8192 + 176 + ti] = 1940[ti];
    base[8192 + 192 + ti] = 2100[ti];
    base[8430 + ti]       = 2120[ti];
    base[8450 + ti]       = 2140[ti];
    base[8470 + ti]       = 2160[ti];
    ti += 1;
  );
  base[8486] = master_density;
  base[8487] = master_swing;
  base[8488] = master_len_offset;
);

// Restore the working arrays from a pattern slot, applying defaults to invalid values.
function load_pattern_from_mem(pat_idx) local(base, si, ti) (
  base = PATTERN_BASE + (pat_idx % 16) * PATTERN_BLOCK_SIZE;

  // If pattern has not been initialized yet (Length <= 0)
  base[8192 + 48] <= 0 ? (
    init_pattern_slot_defaults(pat_idx);
  );
  master_density = min(100, max(0, base[8486]));
  master_swing = min(100, max(-100, base[8487]));
  master_len_offset = min(63, max(-63, base[8488]));

  si = 0;
  while (si < 1024) (
    10000[si] = base[si];
    12000[si] = base[1024 + si] <= 0 ? 100 : base[1024 + si];
    14000[si] = (base[2048 + si] <= 0 && base[2048 + si] != 0) ? 64 : base[2048 + si];
    16000[si] = (base[3072 + si] < 0 || base[3072 + si] > 69) ? 4 : base[3072 + si];
    18000[si] = base[4096 + si];
    20000[si] = base[5120 + si] <= 0 ? 1 : base[5120 + si];
    22000[si] = base[6144 + si] < 0 ? 100 : base[6144 + si];
    24000[si] = base[7168 + si];
    si += 1;
  );

  ti = 0;
  while (ti < 16) (
    1600[ti] = base[8192 + ti] <= 0 ? 60 : base[8192 + ti];
    1620[ti] = base[8192 + 16 + ti] <= 0 ? ti + 1 : base[8192 + 16 + ti];
    1640[ti] = base[8192 + 32 + ti];
    1660[ti] = base[8192 + 48 + ti] <= 0 ? 16 : base[8192 + 48 + ti];
    1680[ti] = base[8192 + 64 + ti];
    1700[ti] = base[8192 + 80 + ti];
    1720[ti] = base[8192 + 96 + ti] < 0 ? 100 : base[8192 + 96 + ti];
    1740[ti] = base[8192 + 112 + ti];
    1860[ti] = base[8192 + 128 + ti];
    1920[ti] = base[8192 + 160 + ti];
    1940[ti] = base[8192 + 176 + ti] < 0 ? 100 : base[8192 + 176 + ti];
    2100[ti] = base[8192 + 192 + ti];
    2120[ti] = base[8430 + ti];
    2140[ti] = base[8450 + ti];
    2160[ti] = base[8470 + ti];
    ti += 1;
  );
);

// Initialize all 16 memory patterns with default blank state
p_init = 0;
while (p_init < 16) (
  init_pattern_slot_defaults(p_init);
  p_init += 1;
);

lfo_cur_tr = 0; // Active LFO track shown in top bar (0..15)
lfo_sh_menu_open = 0; // LFO waveform in-GUI menu open state
lfo_ds_menu_open = 0; // LFO destination in-GUI menu open state
lfo_ds_sub_open = -1; // LFO destination cascading submenu open state (-1: none, 0: Rate, 1: Shape, 2: Amount)
lfo_rt_menu_open = 0; // LFO rate in-GUI menu open state
scale_menu_open = 0;  // Scale selection in-GUI menu open state
scale_sub_open = -1;  // Scale category submenu open state (-1: none, 0..4)
slot_a_menu_open = 0; // Slot A mode menu open state
slot_a_menu_tr = 0;   // Track index for Slot A menu
slot_b_menu_open = 0; // Slot B mode menu open state
slot_b_menu_tr = 0;   // Track index for Slot B menu
ti_lfo = 0;
while (ti_lfo < NUM_TRACKS) (
  4500[ti_lfo] = 0;   // Shape: 0=Sine, 1=Tri, 2=SawUp, 3=SawDown, 4=Square, 5=S&H
  4520[ti_lfo] = 1;   // Sync mode: 1=Sync, 0=Freq (Hz)
  4540[ti_lfo] = 6;   // Sync rate: index 6 ("1/2")
  4560[ti_lfo] = 2.0; // Free frequency: 2.0 Hz
  4580[ti_lfo] = 1;   // Retrigger: 1=On (transport sync), 0=Off (free-running)
  4600[ti_lfo] = 0;   // Destination: 0=Off, 1..12=Pitch..Chance, 13..28=LFO 1..16
  4620[ti_lfo] = 100; // Modulation depth (0..100%)
  4700[ti_lfo] = 0;   // Sync timing mode: 0=Straight, 1=Dotted, 2=Triplets
  4760[ti_lfo] = 0;   // Polarity: 0=Bipolar (default), 1=Unipolar
  4770[ti_lfo] = 0;   // Last destination state
  4780[ti_lfo] = 0.0; // Free-run start time anchor
  4790[ti_lfo] = 0.0; // Free-run start beat anchor
  ti_lfo += 1;
);

// Derive a repeatable sample-and-hold value from the cycle and track indices.
function get_sh_val(cyc, tr) local(r) (
  r = abs(sin(cyc * 12.9898 + (tr + 1) * 78.233 + 45.123) * 43758.5453);
  (r - floor(r)) * 2.0 - 1.0;
);

function draw_lfo_wave_icon(shape, bx, by, bw, bh, s, ph_offset, am_pct, pol_mode) local(cx, cy, hw, hh, eff_hh, ys_top, ys_bot, ys_mid, v_top, v_bot, v_mid, vs1, vs2, vs3, vs4, vs5, xi, x0, y0, x1, y1, phi, ph, ph0, ph1, v, t0, t1, c0, c1, xs0, xs1, xs2, xs3, xs4, xs5, ys1, ys2, ys3, ys4, ys5) (
  cx = floor(bx + bw * 0.5);
  cy = floor(by + bh * 0.5);
  hw = max(7, floor(10 * s));
  hh = max(3, floor(4 * s));
  eff_hh = hh * am_pct;

  shape == 0 ? (
    // Subpixel vertical coverage keeps the moving sine smooth between pixel rows.
    t0 = gfx_a;
    xi = -hw;
    while (xi <= hw) (
      phi = (((xi + hw) / (hw * 2.0)) + ph_offset) * 6.283185307179586;
      v = sin(phi);
      pol_mode == 1 ? ( v = (v + 1.0) * 0.5; ) : pol_mode == 2 ? ( v = (v - 1.0) * 0.5; );
      y0 = cy - v * eff_hh;
      y1 = floor(y0);
      t1 = y0 - y1;
      gfx_a = t0 * (1.0 - t1);
      gfx_rect(cx + xi, y1, 1, 1);
      gfx_a = t0 * t1;
      gfx_rect(cx + xi, y1 + 1, 1, 1);
      xi += 1;
    );
    gfx_a = t0;
  ) :
  shape == 1 ? (
    // Subpixel vertical coverage for a stable moving triangle.
    t0 = gfx_a;
    xi = -hw;
    while (xi <= hw) (
      ph = ((xi + hw) / (hw * 2.0)) + ph_offset;
      ph = ph - floor(ph);
      v = ph < 0.25 ? (4.0 * ph) : ph < 0.75 ? (2.0 - 4.0 * ph) : (4.0 * ph - 4.0);
      pol_mode == 1 ? ( v = (v + 1.0) * 0.5; ) : pol_mode == 2 ? ( v = (v - 1.0) * 0.5; );
      y0 = cy - v * eff_hh;
      y1 = floor(y0);
      t1 = y0 - y1;
      gfx_a = t0 * (1.0 - t1);
      gfx_rect(cx + xi, y1, 1, 1);
      gfx_a = t0 * t1;
      gfx_rect(cx + xi, y1 + 1, 1, 1);
      xi += 1;
    );
    gfx_a = t0;
  ) :
  shape == 2 ? (
    ph_offset == 0.0 ? (
      // Reference static Saw Down
      v_top = 1.0; v_bot = -1.0; v_mid = 0.0;
      pol_mode == 1 ? ( v_top = 1.0; v_bot = 0.0; v_mid = 0.0; ) :
      pol_mode == 2 ? ( v_top = 0.0; v_bot = -1.0; v_mid = 0.0; );
      ys_top = floor(cy - v_top * eff_hh + 0.5);
      ys_bot = floor(cy - v_bot * eff_hh + 0.5);
      ys_mid = floor(cy - v_mid * eff_hh + 0.5);
      gfx_line(cx - hw, ys_mid, cx - hw, ys_top);
      gfx_line(cx - hw, ys_top, cx + hw, ys_bot);
      gfx_line(cx + hw, ys_bot, cx + hw, ys_mid);
    ) : (
      // Subpixel coverage with the original vertical retrace.
      t0 = gfx_a;
      xi = -hw;
      ph0 = -1;
      ys_top = cy - (pol_mode == 2 ? 0.0 : 1.0) * eff_hh;
      while (xi <= hw) (
        ph = ((xi + hw) / (hw * 2.0)) + ph_offset;
        ph1 = ph - floor(ph);
        v = 1.0 - 2.0 * ph1;
        pol_mode == 1 ? ( v = (v + 1.0) * 0.5; ) : pol_mode == 2 ? ( v = (v - 1.0) * 0.5; );
        y1 = cy - v * eff_hh;
        (ph0 >= 0 && ph1 < ph0) ? (
          gfx_a = t0;
          gfx_line(cx + xi - 1, y0, cx + xi - 1, ys_top);
          gfx_line(cx + xi - 1, ys_top, cx + xi, y1);
        );
        y0 = y1;
        ys_mid = floor(y1);
        t1 = y1 - ys_mid;
        gfx_a = t0 * (1.0 - t1);
        gfx_rect(cx + xi, ys_mid, 1, 1);
        gfx_a = t0 * t1;
        gfx_rect(cx + xi, ys_mid + 1, 1, 1);
        ph0 = ph1;
        xi += 1;
      );
      gfx_a = t0;
    );
  ) :
  shape == 3 ? (
    ph_offset == 0.0 ? (
      // Reference static Saw Up
      v_top = 1.0; v_bot = -1.0; v_mid = 0.0;
      pol_mode == 1 ? ( v_top = 1.0; v_bot = 0.0; v_mid = 0.0; );
      pol_mode == 2 ? ( v_top = 0.0; v_bot = -1.0; v_mid = 0.0; );
      ys_top = floor(cy - v_top * eff_hh + 0.5);
      ys_bot = floor(cy - v_bot * eff_hh + 0.5);
      ys_mid = floor(cy - v_mid * eff_hh + 0.5);
      gfx_line(cx - hw, ys_mid, cx - hw, ys_bot);
      gfx_line(cx - hw, ys_bot, cx + hw, ys_top);
      gfx_line(cx + hw, ys_top, cx + hw, ys_mid);
    ) : (
      // Subpixel coverage with the original vertical retrace.
      t0 = gfx_a;
      xi = -hw;
      ph0 = -1;
      ys_top = cy - (pol_mode == 1 ? 0.0 : -1.0) * eff_hh;
      while (xi <= hw) (
        ph = ((xi + hw) / (hw * 2.0)) + ph_offset;
        ph1 = ph - floor(ph);
        v = 2.0 * ph1 - 1.0;
        pol_mode == 1 ? ( v = (v + 1.0) * 0.5; ) : pol_mode == 2 ? ( v = (v - 1.0) * 0.5; );
        y1 = cy - v * eff_hh;
        (ph0 >= 0 && ph1 < ph0) ? (
          gfx_a = t0;
          gfx_line(cx + xi - 1, y0, cx + xi - 1, ys_top);
          gfx_line(cx + xi - 1, ys_top, cx + xi, y1);
        );
        y0 = y1;
        ys_mid = floor(y1);
        t1 = y1 - ys_mid;
        gfx_a = t0 * (1.0 - t1);
        gfx_rect(cx + xi, ys_mid, 1, 1);
        gfx_a = t0 * t1;
        gfx_rect(cx + xi, ys_mid + 1, 1, 1);
        ph0 = ph1;
        xi += 1;
      );
      gfx_a = t0;
    );
  ) :
  shape == 4 ? (
    ph_offset == 0.0 ? (
      // Reference static Square wave
      v_top = 1.0; v_bot = -1.0; v_mid = 0.0;
      pol_mode == 1 ? ( v_top = 1.0; v_bot = 0.0; v_mid = 0.0; );
      pol_mode == 2 ? ( v_top = 0.0; v_bot = -1.0; v_mid = 0.0; );
      ys_top = floor(cy - v_top * eff_hh + 0.5);
      ys_bot = floor(cy - v_bot * eff_hh + 0.5);
      ys_mid = floor(cy - v_mid * eff_hh + 0.5);
      gfx_line(cx - hw, ys_mid, cx - hw, ys_top);
      gfx_line(cx - hw, ys_top, cx, ys_top);
      gfx_line(cx, ys_top, cx, ys_bot);
      gfx_line(cx, ys_bot, cx + hw, ys_bot);
      gfx_line(cx + hw, ys_bot, cx + hw, ys_mid);
    ) : (
      // Square wave: continuous 60 fps oscilloscope with crisp 90-degree vertical edges
      xi = -hw;
      x0 = cx + xi;
      ph = ((xi + hw) / (hw * 2.0)) + ph_offset;
      ph0 = ph - floor(ph);
      v = ph0 < 0.5 ? 1.0 : -1.0;
      pol_mode == 1 ? ( v = (v + 1.0) * 0.5; ) : pol_mode == 2 ? ( v = (v - 1.0) * 0.5; );
      y0 = floor(cy - v * eff_hh + 0.5);
      while (xi < hw) (
        xi += 1;
        x1 = cx + xi;
        ph = ((xi + hw) / (hw * 2.0)) + ph_offset;
        ph1 = ph - floor(ph);
        v = ph1 < 0.5 ? 1.0 : -1.0;
        pol_mode == 1 ? ( v = (v + 1.0) * 0.5; ) : pol_mode == 2 ? ( v = (v - 1.0) * 0.5; );
        y1 = floor(cy - v * eff_hh + 0.5);
        y0 != y1 ? (
          gfx_line(x0, y0, x0, y1);
          gfx_line(x0, y1, x1, y1);
        ) : (
          gfx_line(x0, y0, x1, y1);
        );
        x0 = x1; y0 = y1;
        ph0 = ph1;
      );
    );
  ) : (
    ph_offset == 0.0 ? (
      // Reference static 5-step Sample & Hold
      xs0 = cx - hw;
      xs1 = cx - floor(hw * 0.6);
      xs2 = cx - floor(hw * 0.2);
      xs3 = cx + floor(hw * 0.2);
      xs4 = cx + floor(hw * 0.6);
      xs5 = cx + hw;

      vs1 = 0.35; vs2 = -0.85; vs3 = 0.80; vs4 = -0.40; vs5 = 0.15;
      pol_mode == 1 ? (
        vs1 = (vs1 + 1.0) * 0.5; vs2 = (vs2 + 1.0) * 0.5;
        vs3 = (vs3 + 1.0) * 0.5; vs4 = (vs4 + 1.0) * 0.5; vs5 = (vs5 + 1.0) * 0.5;
      ) :
      pol_mode == 2 ? (
        vs1 = (vs1 - 1.0) * 0.5; vs2 = (vs2 - 1.0) * 0.5;
        vs3 = (vs3 - 1.0) * 0.5; vs4 = (vs4 - 1.0) * 0.5; vs5 = (vs5 - 1.0) * 0.5;
      );

      ys1 = floor(cy - vs1 * eff_hh + 0.5);
      ys2 = floor(cy - vs2 * eff_hh + 0.5);
      ys3 = floor(cy - vs3 * eff_hh + 0.5);
      ys4 = floor(cy - vs4 * eff_hh + 0.5);
      ys5 = floor(cy - vs5 * eff_hh + 0.5);

      gfx_line(xs0, ys1, xs1, ys1);
      gfx_line(xs1, ys1, xs1, ys2);
      gfx_line(xs1, ys2, xs2, ys2);
      gfx_line(xs2, ys2, xs2, ys3);
      gfx_line(xs2, ys3, xs3, ys3);
      gfx_line(xs3, ys3, xs3, ys4);
      gfx_line(xs3, ys4, xs4, ys4);
      gfx_line(xs4, ys4, xs4, ys5);
      gfx_line(xs4, ys5, xs5, ys5);
    ) : (
      // Subpixel horizontal coverage keeps existing steps at a constant width.
      t0 = gfx_a;
      xi = -hw;
      while (xi <= hw) (
        ph0 = ph_offset + (((xi - 0.5 + hw) / (hw * 2.0)) - 1.0) * 2.5;
        ph1 = ph_offset + (((xi + 0.5 + hw) / (hw * 2.0)) - 1.0) * 2.5;
        c0 = floor(ph0); c1 = floor(ph1);
        v = get_sh_val(c0, lfo_cur_tr);
        pol_mode == 1 ? ( v = (v + 1.0) * 0.5; ) : pol_mode == 2 ? ( v = (v - 1.0) * 0.5; );
        y0 = floor(cy - v * eff_hh + 0.5);
        c0 != c1 ? (
          t1 = (c1 - ph0) / (ph1 - ph0);
          gfx_a = t0 * t1;
          gfx_rect(cx + xi, y0, 1, 1);
          v = get_sh_val(c1, lfo_cur_tr);
          pol_mode == 1 ? ( v = (v + 1.0) * 0.5; ) : pol_mode == 2 ? ( v = (v - 1.0) * 0.5; );
          y1 = floor(cy - v * eff_hh + 0.5);
          gfx_a = t0 * (1.0 - t1);
          gfx_rect(cx + xi, y1, 1, 1);
        ) : (
          gfx_a = t0;
          gfx_rect(cx + xi, y0, 1, 1);
        );
        xi += 1;
      );
      // Draw each vertical transition at its exact horizontal position.
      c0 = floor(ph_offset - 2.5) + 1;
      while (c0 <= floor(ph_offset)) (
        x0 = cx - hw + ((c0 - ph_offset) / 2.5 + 1.0) * (hw * 2.0);
        v = get_sh_val(c0 - 1, lfo_cur_tr);
        pol_mode == 1 ? ( v = (v + 1.0) * 0.5; ) : pol_mode == 2 ? ( v = (v - 1.0) * 0.5; );
        y0 = floor(cy - v * eff_hh + 0.5);
        v = get_sh_val(c0, lfo_cur_tr);
        pol_mode == 1 ? ( v = (v + 1.0) * 0.5; ) : pol_mode == 2 ? ( v = (v - 1.0) * 0.5; );
        y1 = floor(cy - v * eff_hh + 0.5);
        x1 = floor(x0); t1 = x0 - x1;
        x1 >= cx - hw ? (
          gfx_a = t0 * (1.0 - t1);
          gfx_line(x1, y0, x1, y1);
        );
        x1 + 1 <= cx + hw ? (
          gfx_a = t0 * t1;
          gfx_line(x1 + 1, y0, x1 + 1, y1);
        );
        c0 += 1;
      );
      gfx_a = t0;
    );
  );
);

function get_lfo_sync_beats(idx, typ) local(base_beats) (
  idx == 0  ? base_beats = 128.0 :
  idx == 1  ? base_beats = 64.0  :
  idx == 2  ? base_beats = 32.0  :
  idx == 3  ? base_beats = 16.0  :
  idx == 4  ? base_beats = 8.0   :
  idx == 5  ? base_beats = 4.0   :
  idx == 6  ? base_beats = 2.0   :
  idx == 7  ? base_beats = 1.0   :
  idx == 8  ? base_beats = 0.5   :
  idx == 9  ? base_beats = 0.25  :
  idx == 10 ? base_beats = 0.125 :
  base_beats = 0.0625;

  typ == 1 ? (
    base_beats * 1.5;
  ) :
  typ == 2 ? (
    base_beats * (2.0 / 3.0);
  ) : (
    base_beats;
  );
);

function get_lfo_sync_str(idx, typ) (
  idx == 0  ? #lfo_s_str = "32/1" :
  idx == 1  ? #lfo_s_str = "16/1" :
  idx == 2  ? #lfo_s_str = "8/1"  :
  idx == 3  ? #lfo_s_str = "4/1"  :
  idx == 4  ? #lfo_s_str = "2/1"  :
  idx == 5  ? #lfo_s_str = "1/1"  :
  idx == 6  ? #lfo_s_str = "1/2"  :
  idx == 7  ? #lfo_s_str = "1/4"  :
  idx == 8  ? #lfo_s_str = "1/8"  :
  idx == 9  ? #lfo_s_str = "1/16" :
  idx == 10 ? #lfo_s_str = "1/32" :
  #lfo_s_str = "1/64";

  typ == 1 ? strcat(#lfo_s_str, "D") :
  typ == 2 ? strcat(#lfo_s_str, "T") : 0;
);

function get_lfo_dest_str(dest_idx) local(t_lfo, s_dst) (
  dest_idx == 0  ? #lfo_d_str = "OFF" :
  dest_idx == 1  ? #lfo_d_str = "PITCH" :
  dest_idx == 2  ? #lfo_d_str = "RATE" :
  dest_idx == 3  ? #lfo_d_str = "LEN" :
  dest_idx == 4  ? #lfo_d_str = "BEAT" :
  dest_idx == 64 ? #lfo_d_str = "M-LN" :
  dest_idx == 65 ? #lfo_d_str = "M-DN" :
  dest_idx == 66 ? #lfo_d_str = "M-SW" :
  dest_idx == 67 ? #lfo_d_str = "M-GT" :
  dest_idx == 61 ? #lfo_d_str = "VOL" :
  dest_idx == 62 ? #lfo_d_str = "T-GT" :
  dest_idx == 63 ? #lfo_d_str = "T-PN" :
  dest_idx == 5  ? #lfo_d_str = "DENS" :
  dest_idx == 6  ? #lfo_d_str = "SWG" :
  dest_idx == 7  ? #lfo_d_str = "VEL" :
  dest_idx == 8  ? #lfo_d_str = "GATE" :
  dest_idx == 9  ? #lfo_d_str = "PAN" :
  dest_idx == 10 ? #lfo_d_str = "TIME" :
  dest_idx == 11 ? #lfo_d_str = "RATC" :
  dest_idx == 12 ? #lfo_d_str = "CHNC" :
  (dest_idx >= 13 && dest_idx <= 60) ? (
    t_lfo = floor((dest_idx - 13) / 3);
    s_dst = (dest_idx - 13) % 3;
    s_dst == 0 ? sprintf(#lfo_d_str, "%d:RT", t_lfo + 1) :
    s_dst == 1 ? sprintf(#lfo_d_str, "%d:SH", t_lfo + 1) :
                 sprintf(#lfo_d_str, "%d:AM", t_lfo + 1);
  ) :
  #lfo_d_str = "OFF";
);

function get_next_lfo_dest(cur_d, dir, cur_tr) local(next_d, step) (
  step = dir > 0 ? 1 : -1;
  next_d = cur_d == 4 && step > 0 ? 61 :
           cur_d == 5 && step < 0 ? 61 :
           cur_d == 61 ? (step > 0 ? 5 : 4) :
           cur_d == 6 && step > 0 ? 62 :
           cur_d == 7 && step < 0 ? 63 :
           cur_d == 62 ? (step > 0 ? 63 : 6) :
           cur_d == 63 ? (step > 0 ? 7 : 62) :
           cur_d == 12 && step > 0 ? 64 :
           cur_d == 13 && step < 0 ? 67 :
           cur_d >= 64 && cur_d <= 67 ? (cur_d == 64 && step < 0 ? 12 : cur_d == 67 && step > 0 ? 13 : cur_d + step) : cur_d + step;
  while (next_d >= 13 && next_d <= 60 && floor((next_d - 13) / 3) == cur_tr) (
    next_d += step;
  );
  // Skipping the current track's LFO 1 destinations can cross the Master group.
  (step < 0 && cur_d >= 13 && cur_d <= 60 && next_d == 12) ? next_d = 67;
  next_d < 0 ? next_d = 0 :
  next_d > 60 && !(next_d >= 64 && next_d <= 67 && (cur_d == 12 || (cur_d >= 13 && cur_d <= 60 && next_d == 67 && step < 0) || (cur_d >= 64 && cur_d <= 67))) && !((next_d == 61 && (cur_d == 4 || cur_d == 5)) || (next_d == 62 && (cur_d == 6 || cur_d == 63)) || (next_d == 63 && (cur_d == 7 || cur_d == 62))) ? (
    next_d = (cur_tr == 15) ? 57 : 60;
  );
  next_d;
);

// Evaluate the track LFO using beat or wall-clock phase and incoming modulation.
function get_lfo_value(tr_idx, b_beat, b_time) local(is_sync, shp, r_beats, f_hz, ph, raw_val, cur_cyc, in_mod, in_shp_mod, in_am_mod, is_retrig, cur_t, cur_b, eff_amount, cur_dst, last_dst) (
  cur_dst = 4600[tr_idx];
  cur_dst == 0 ? (
    4770[tr_idx] = 0;
    0.0;
  ) : (
    last_dst = 4770[tr_idx];
    (last_dst == 0 && cur_dst != 0) ? (
      4780[tr_idx] = time_precise();
      4790[tr_idx] = 4780[tr_idx] * (tempo / 60.0);
    );
    4770[tr_idx] = cur_dst;

    shp = 4500[tr_idx];
    is_sync = 4520[tr_idx];
    in_mod = 4720[tr_idx];
    in_shp_mod = 4820[tr_idx];
    in_am_mod = 4840[tr_idx];
    is_retrig = 4580[tr_idx];

    // Shape modulation (dynamic morphing across waveforms 0..5)
    in_shp_mod != 0.0 ? (
      shp = floor(shp + in_shp_mod * 3.0 + 0.5);
      shp = min(5, max(0, shp));
    );

    // If retrig is off (0), free-run anchored to activation time; if on (1), sync to transport position
    !is_retrig ? (
      cur_t = max(0.0, time_precise() - 4780[tr_idx]);
      cur_b = max(0.0, time_precise() * (tempo / 60.0) - 4790[tr_idx]);
    ) : (
      cur_t = b_time;
      cur_b = b_beat;
    );

    is_sync ? (
      r_beats = get_lfo_sync_beats(4540[tr_idx], 4700[tr_idx]);
      r_beats <= 0 ? r_beats = 2.0;
      ph = (cur_b / r_beats + in_mod * 0.5);
      ph = ph - floor(ph);
      cur_cyc = floor(cur_b / r_beats);
    ) : (
      f_hz = 4560[tr_idx];
      f_hz <= 0 ? f_hz = 2.0;
      in_mod != 0.0 ? (
        f_hz = max(0.05, f_hz * exp(in_mod * 1.5));
      );
      ph = (cur_t * f_hz);
      ph = ph - floor(ph);
      cur_cyc = floor(cur_t * f_hz);
    );

    shp == 0 ? (
      raw_val = sin(ph * 6.283185307);
    ) :
    shp == 1 ? (
      raw_val = ph < 0.25 ? (4.0 * ph) : ph < 0.75 ? (2.0 - 4.0 * ph) : (4.0 * ph - 4.0);
    ) :
    shp == 2 ? (
      raw_val = 1.0 - 2.0 * ph;
    ) :
    shp == 3 ? (
      raw_val = 2.0 * ph - 1.0;
    ) :
    shp == 4 ? (
      raw_val = ph < 0.5 ? 1.0 : -1.0;
    ) : (
      raw_val = get_sh_val(cur_cyc, tr_idx);
    );

    // Bipolar (0: -1.0..+1.0), +Unipolar (1: 0.0..+1.0), -Unipolar (2: -1.0..0.0) modes
    4760[tr_idx] == 1 ? (
      raw_val = (raw_val + 1.0) * 0.5;
    ) :
    4760[tr_idx] == 2 ? (
      raw_val = (raw_val - 1.0) * 0.5;
    );

    // Amount modulation (VCA depth)
    eff_amount = 4620[tr_idx];
    in_am_mod != 0.0 ? (
      eff_amount = min(100, max(0, eff_amount + in_am_mod * 100.0));
    );

    raw_val * (eff_amount / 100.0);
  );
);

kb_paint_mode = -1;    // -1: idle, 0: clear, 1: paint
last_painted_note = -1;
last_kb_paint_x = -1;
last_kb_paint_y = -1;

// Pitch Quantizer
quant_root = 0;       // 0 = C (0..11)
quant_scale = 0;      // 0 = CHROMATIC (default)
quant_mask_bits = 4095; // 0xFFF = all 12 semitones active (1..11)
// Default CHROMATIC: all 12 semitones active (4000[0..11] = 1)
qi_init = 0;
while (qi_init < 12) (
  4000[qi_init] = 1;
  qi_init += 1;
);

function get_bit_pow(idx) (
  idx == 0 ? 1 :
  idx == 1 ? 2 :
  idx == 2 ? 4 :
  idx == 3 ? 8 :
  idx == 4 ? 16 :
  idx == 5 ? 32 :
  idx == 6 ? 64 :
  idx == 7 ? 128 :
  idx == 8 ? 256 :
  idx == 9 ? 512 :
  idx == 10 ? 1024 :
  idx == 11 ? 2048 : 0;
);

function get_scale_mask(idx) (
  idx == 0  ? 4095 : // Chromatic
  // Diatonic Modes (1..7)
  idx == 1  ? 2741 : // Major (Ionian)
  idx == 2  ? 1453 : // Natural Minor (Aeolian)
  idx == 3  ? 1709 : // Dorian
  idx == 4  ? 1451 : // Phrygian
  idx == 5  ? 2773 : // Lydian
  idx == 6  ? 1717 : // Mixolydian
  idx == 7  ? 1387 : // Locrian
  // Minor & Major Variations (8..17)
  idx == 8  ? 2477 : // Harmonic Minor
  idx == 9  ? 2733 : // Melodic Minor
  idx == 10 ? 2485 : // Harmonic Major
  idx == 11 ? 1459 : // Phrygian Dominant (Spanish)
  idx == 12 ? 2483 : // Double Harmonic Major (Byzantine)
  idx == 13 ? 2509 : // Hungarian Minor (Gypsy)
  idx == 14 ? 1753 : // Hungarian Major
  idx == 15 ? 1741 : // Romanian Minor (Dorian #4)
  idx == 16 ? 2731 : // Neapolitan Major
  idx == 17 ? 2475 : // Neapolitan Minor
  // Pentatonic & Blues (18..23)
  idx == 18 ? 661  : // Major Pentatonic
  idx == 19 ? 1193 : // Minor Pentatonic
  idx == 20 ? 1257 : // Blues
  idx == 21 ? 669  : // Major Blues
  idx == 22 ? 1189 : // Egyptian (Suspended Pentatonic)
  idx == 23 ? 2225 : // Ryukyu (Okinawan)
  // World & Ethnic (24..36)
  idx == 24 ? 397  : // Hirajoshi (Giappone)
  idx == 25 ? 1187 : // Insen
  idx == 26 ? 1123 : // Iwato
  idx == 27 ? 653  : // Kumoi
  idx == 28 ? 419  : // Miyako-bushi
  idx == 29 ? 1163 : // Pelog (Indonesia)
  idx == 30 ? 395  : // Balinese
  idx == 31 ? 677  : // Slendro
  idx == 32 ? 677  : // Ritsusen
  idx == 33 ? 2485 : // Arabic (Bayati)
  idx == 34 ? 2419 : // Persian
  idx == 35 ? 1403 : // Spanish 8-Tone
  idx == 36 ? 2507 : // Todi (Raga indiano)
  // Jazz, Symmetrical & Altered (37..53)
  idx == 37 ? 1365 : // Whole Tone (Esatonale)
  idx == 38 ? 1755 : // Diminished Half-Whole
  idx == 39 ? 2925 : // Diminished Whole-Half
  idx == 40 ? 2457 : // Augmented
  idx == 41 ? 1371 : // Altered (Super Locrian)
  idx == 42 ? 1749 : // Lydian Dominant (Overtone)
  idx == 43 ? 2901 : // Lydian Augmented
  idx == 44 ? 1389 : // Locrian Natural 2 (Half-Diminished)
  idx == 45 ? 1397 : // Major Locrian
  idx == 46 ? 859  : // Ultra Locrian
  idx == 47 ? 3413 : // Leading Whole Tone
  idx == 48 ? 2997 : // Bebop Major
  idx == 49 ? 3765 : // Bebop Dominant
  idx == 50 ? 1725 : // Bebop Minor
  idx == 51 ? 1621 : // Prometheus (Scriabin)
  idx == 52 ? 219  : // Istrian
  idx == 53 ? 1243 : // Enigmatic
  4095;
);

function get_scale_name(idx) (
  idx == 0  ? #sc_name = "CHROMATIC" :
  idx == 1  ? #sc_name = "MAJOR" :
  idx == 2  ? #sc_name = "NATURAL MINOR" :
  idx == 3  ? #sc_name = "DORIAN" :
  idx == 4  ? #sc_name = "PHRYGIAN" :
  idx == 5  ? #sc_name = "LYDIAN" :
  idx == 6  ? #sc_name = "MIXOLYDIAN" :
  idx == 7  ? #sc_name = "LOCRIAN" :
  idx == 8  ? #sc_name = "HARMONIC MIN" :
  idx == 9  ? #sc_name = "MELODIC MIN" :
  idx == 10 ? #sc_name = "HARMONIC MAJ" :
  idx == 11 ? #sc_name = "PHRYGIAN DOM" :
  idx == 12 ? #sc_name = "DBL HARMONIC" :
  idx == 13 ? #sc_name = "HUNGARIAN MIN" :
  idx == 14 ? #sc_name = "HUNGARIAN MAJ" :
  idx == 15 ? #sc_name = "ROMANIAN MIN" :
  idx == 16 ? #sc_name = "NEAPOLITAN MAJ" :
  idx == 17 ? #sc_name = "NEAPOLITAN MIN" :
  idx == 18 ? #sc_name = "MAJ PENTATONIC" :
  idx == 19 ? #sc_name = "MIN PENTATONIC" :
  idx == 20 ? #sc_name = "BLUES" :
  idx == 21 ? #sc_name = "MAJOR BLUES" :
  idx == 22 ? #sc_name = "EGYPTIAN" :
  idx == 23 ? #sc_name = "RYUKYU" :
  idx == 24 ? #sc_name = "HIRAJOSHI" :
  idx == 25 ? #sc_name = "INSEN" :
  idx == 26 ? #sc_name = "IWATO" :
  idx == 27 ? #sc_name = "KUMOI" :
  idx == 28 ? #sc_name = "MIYAKO-BUSHI" :
  idx == 29 ? #sc_name = "PELOG" :
  idx == 30 ? #sc_name = "BALINESE" :
  idx == 31 ? #sc_name = "SLENDRO" :
  idx == 32 ? #sc_name = "RITSUSEN" :
  idx == 33 ? #sc_name = "ARABIC" :
  idx == 34 ? #sc_name = "PERSIAN" :
  idx == 35 ? #sc_name = "SPANISH 8-TONE" :
  idx == 36 ? #sc_name = "TODI" :
  idx == 37 ? #sc_name = "WHOLE TONE" :
  idx == 38 ? #sc_name = "DIMINISHED HW" :
  idx == 39 ? #sc_name = "DIMINISHED WH" :
  idx == 40 ? #sc_name = "AUGMENTED" :
  idx == 41 ? #sc_name = "ALTERED" :
  idx == 42 ? #sc_name = "LYDIAN DOM" :
  idx == 43 ? #sc_name = "LYDIAN AUG" :
  idx == 44 ? #sc_name = "LOCRIAN NAT 2" :
  idx == 45 ? #sc_name = "MAJOR LOCRIAN" :
  idx == 46 ? #sc_name = "ULTRA LOCRIAN" :
  idx == 47 ? #sc_name = "LEADING WT" :
  idx == 48 ? #sc_name = "BEBOP MAJOR" :
  idx == 49 ? #sc_name = "BEBOP DOM" :
  idx == 50 ? #sc_name = "BEBOP MINOR" :
  idx == 51 ? #sc_name = "PROMETHEUS" :
  idx == 52 ? #sc_name = "ISTRIAN" :
  idx == 53 ? #sc_name = "ENIGMATIC" :
  #sc_name = "CUSTOM";
);

function update_quant_mask_bits() local(i, bit) (
  quant_mask_bits = 0;
  i = 0;
  while (i < 12) (
    bit = get_bit_pow(i);
    4000[i] ? (
      quant_mask_bits += bit;
    );
    i += 1;
  );
  quant_mask_bits;
);

function get_kb_note_at(mx, my) local(rx, ry, n, wk_idx) (
  (mx >= 52 && mx <= 146 && my >= 12 && my <= 36) ? (
    rx = mx - 52;
    ry = my - 12;
    n = -1;
    ry <= 14 ? (
      (rx >= 9 && rx <= 18) ? n = 1 :
      (rx >= 22 && rx <= 31) ? n = 3 :
      (rx >= 49 && rx <= 58) ? n = 6 :
      (rx >= 63 && rx <= 72) ? n = 8 :
      (rx >= 76 && rx <= 85) ? n = 10;
    );
    n < 0 ? (
      wk_idx = floor(rx * 7.0 / 94.0);
      wk_idx = min(6, max(0, wk_idx));
      wk_idx == 0 ? n = 0 :
      wk_idx == 1 ? n = 2 :
      wk_idx == 2 ? n = 4 :
      wk_idx == 3 ? n = 5 :
      wk_idx == 4 ? n = 7 :
      wk_idx == 5 ? n = 9 : n = 11;
    );
    n;
  ) : -1;
);

function set_quant_scale(new_scale) local(i, mask) (
  quant_scale = min(53, max(0, new_scale));
  (quant_scale >= 0 && quant_scale <= 53) ? (
    mask = get_scale_mask(new_scale);
    i = 0;
    while (i < 12) (
      4000[(quant_root + i) % 12] = (mask & get_bit_pow(i)) ? 1 : 0;
      i += 1;
    );
  );
  update_quant_mask_bits();
);

function set_quant_root(new_root) (
  quant_root = min(11, max(0, new_root));
  (quant_scale >= 0 && quant_scale <= 53) ? (
    set_quant_scale(quant_scale);
  );
);

function update_quant_scale_type() local(s, rel_mask, found_sc, k) (
  rel_mask = 0;
  s = 0;
  while (s < 12) (
    4000[(quant_root + s) % 12] ? (
      rel_mask += get_bit_pow(s);
    );
    s += 1;
  );

  found_sc = 99; // Default CUSTOM
  k = 0;
  while (k <= 53 && found_sc == 99) (
    rel_mask == get_scale_mask(k) ? (
      found_sc = k;
    );
    k += 1;
  );
  quant_scale = found_sc;
  update_quant_mask_bits();
);

function apply_quant_mask_bits(bits) local(i, bit) (
  quant_mask_bits = bits;
  i = 0;
  while (i < 12) (
    bit = get_bit_pow(i);
    (bits & bit) ? (
      4000[i] = 1;
    ) : (
      4000[i] = 0;
    );
    i += 1;
  );
  update_quant_scale_type();
);

// Find the closest enabled pitch in the current scale mask.
function quantize_pitch(raw_p) local(semi, has_active, i, best_p, d, s_down, s_up) (
  has_active = 0;
  i = 0;
  while (i < 12) (
    4000[i] ? has_active = 1;
    i += 1;
  );

  !has_active ? raw_p : (
    semi = raw_p % 12;
    4000[semi] ? raw_p : (
      best_p = raw_p;
      d = 1;
      while (d <= 6 && best_p == raw_p) (
        s_down = (semi - d + 12) % 12;
        s_up = (semi + d) % 12;
        4000[s_down] ? (
          best_p = raw_p - d;
        ) :
        4000[s_up] ? (
          best_p = raw_p + d;
        );
        d += 1;
      );
      best_p;
    );
  );
);

function get_next_scale_pitch(cur_p, dir) local(has_active, i, p, target_p) (
  has_active = 0;
  i = 0;
  while (i < 12) (
    4000[i] ? has_active = 1;
    i += 1;
  );

  !has_active ? (
    min(108, max(24, cur_p + dir))
  ) : (
    p = cur_p + dir;
    target_p = -1;
    dir > 0 ? (
      while (p <= 108 && target_p < 0) (
        4000[p % 12] ? target_p = p;
        p += 1;
      );
    ) : (
      while (p >= 24 && target_p < 0) (
        4000[p % 12] ? target_p = p;
        p -= 1;
      );
    );
    target_p >= 0 ? target_p : cur_p;
  );
);

function get_next_scale_octave(cur_p, dir) local(has_active, i, q_p, p) (
  has_active = 0;
  i = 0;
  while (i < 12) (
    4000[i] ? has_active = 1;
    i += 1;
  );

  !has_active ? (
    min(108, max(24, cur_p + dir * 12))
  ) : (
    q_p = quantize_pitch(cur_p);
    p = q_p + dir * 12;
    (p >= 24 && p <= 108) ? p : q_p;
  );
);

edit_active = 0;       // Keyboard text edit state (0=none, 1=Ch, 2=Pitch, 3=Rate, 4=Len, 5=Density, 6=Swing, 7=Fill, 8=Amount, 9=RateHz, 10=LfoTr, 11=Root, 12=Oct, 13=Semi, 14=MasterGate, 15=MasterLen, 16=MasterSwing, 17=MasterDensity, 18..24=Step parameters)
edit_tr = -1;          // Target track index for text editing
edit_step_offset = -1; // Target step offset for text editing (track * 64 + step)
#edit_buf = "";        // Typed text buffer
edit_first_key = 0;    // 1 = newly focused field (first keystroke overwrites)
info_mode = 0;         // Global tooltips mode (0 = off, 1 = on)
info_lang = 1;         // Tooltip language (0 = ITA, 1 = ENG, default 1)
velocity_mode = 1;     // Wheel step velocity edit mode (0 = off, 1 = on)
gate_mode = 0;         // Wheel step gate length edit mode (0 = off, 1 = on)
pan_mode = 0;          // Wheel step pan edit mode (0 = off, 1 = on)
timing_mode = 0;       // Wheel step micro-timing edit mode (0 = off, 1 = on)
ratchet_mode = 0;      // Wheel step ratcheting edit mode (0 = off, 1 = on)
chance_mode = 0;       // Wheel step chance edit mode (0 = off, 1 = on)
cond_mode = 0;         // Wheel step trig condition edit mode (0 = off, 1 = on)
active_mouse_zone = 0; // 0: Idle, 1: Button, 2: Step grid, 3: Keyboard, 4: Drag param, 5: Solo paint, 6: Mute paint, 8: Step parameter reset paint
captured_btn_id = 0;   // Captured button ID during mouse hold
solo_paint_mode = -1;  // Drag solo paint state (-1: idle, 0: off, 1: on)
mute_paint_mode = -1;  // Drag mute paint state (-1: idle, 0: off, 1: on)
last_painted_random_tr = -1; // Last track randomized during drag paint
step_paint_mode = -1;  // Drag step paint state (-1: idle, 0: clear, 1: paint)
last_painted_offset = -1; // Last modified step offset (tr * 64 + step)
last_reset_paint_x = -1; // Last pointer X for right-click parameter reset painting
last_reset_paint_y = -1; // Last pointer Y for right-click parameter reset painting
last_click_time = 0;
last_click_elem = -1;
last_euc_len = -1;
last_euc_fill = -1;
drag_pushed_undo = 0;

gui_dirty = 1;
last_gfx_w = 0;
last_gfx_h = 0;
last_m_x = -1;
last_m_y = -1;

b_was_playing = 0;
b_last_play_pos = 0;

// Internal Undo / Redo system (16 tracks x 64 steps = 1024 steps)
UNDO_MAX = 16;
UNDO_BLOCK_SIZE = 9000;
UNDO_BASE = 50000;
undo_count = 0;
undo_head = 0;

REDO_MAX = 16;
REDO_BLOCK_SIZE = 9000;
REDO_BASE = 250000;
redo_count = 0;
redo_head = 0;

// Snapshot the editable state before a change so it can be restored by undo.
function undo_push() local(dest_base, si, ti) (
  dest_base = UNDO_BASE + (undo_head % UNDO_MAX) * UNDO_BLOCK_SIZE;

  // Save step data: trigger, velocity, pan, gate, timing, ratchet, chance, cond
  si = 0;
  while (si < 1024) (
    dest_base[si]        = 10000[si];
    dest_base[1024 + si] = 12000[si];
    dest_base[2048 + si] = 14000[si];
    dest_base[3072 + si] = 16000[si];
    dest_base[4096 + si] = 18000[si];
    dest_base[5120 + si] = 20000[si];
    dest_base[6144 + si] = 22000[si];
    dest_base[7168 + si] = 24000[si];
    si += 1;
  );

  // Save 16-track parameters
  ti = 0;
  while (ti < 16) (
    dest_base[8192 + ti]       = 1600[ti]; // Pitch
    dest_base[8192 + 16 + ti]  = 1620[ti]; // Channel
    dest_base[8192 + 32 + ti]  = 1640[ti]; // Rate
    dest_base[8192 + 48 + ti]  = 1660[ti]; // Length
    dest_base[8192 + 64 + ti]  = 1680[ti]; // Solo
    dest_base[8192 + 80 + ti]  = 1700[ti]; // Mute
    dest_base[8192 + 96 + ti]  = 1720[ti]; // Chance
    dest_base[8192 + 112 + ti] = 1740[ti]; // Swing
    dest_base[8192 + 128 + ti] = 1860[ti]; // Euclidean Fill
    dest_base[8192 + 160 + ti] = 1920[ti]; // Play mode
    dest_base[8192 + 176 + ti] = 1940[ti]; // Track Volume
    dest_base[8192 + 192 + ti] = 2100[ti]; // Slot A mode
    dest_base[8430 + ti]       = 2120[ti]; // Track Pan
    dest_base[8450 + ti]       = 2140[ti]; // Slot B mode
    dest_base[8470 + ti]       = 2160[ti]; // Track Gate
    ti += 1;
  );
  dest_base[8400] = euc_mode;
  dest_base[8401] = velocity_mode;
  dest_base[8402] = gate_mode;
  dest_base[8403] = pan_mode;
  dest_base[8404] = timing_mode;
  dest_base[8405] = ratchet_mode;
  dest_base[8406] = chance_mode;
  dest_base[8407] = cond_mode;
  dest_base[8408] = master_len_offset;
  dest_base[8428] = master_swing;
  dest_base[8429] = master_s2_mode;
  dest_base[8486] = master_density;
  update_quant_mask_bits();
  dest_base[8409] = quant_root;
  dest_base[8410] = quant_scale;
  dest_base[8411] = quant_mask_bits;
  ti = 0;
  while (ti < 16) (
    dest_base[8412 + ti] = 4760[ti]; // LFO Polarity
    ti += 1;
  );

  undo_head += 1;
  undo_count < UNDO_MAX ? undo_count += 1;

  // New action clears redo history
  redo_count = 0;
  redo_head = 0;
);

function undo_pop() local(r_dest, si, ti, src_base) (
  undo_count > 0 ? (
    // Save current state into redo buffer before restoring
    r_dest = REDO_BASE + (redo_head % REDO_MAX) * REDO_BLOCK_SIZE;
    si = 0;
    while (si < 1024) (
      r_dest[si]        = 10000[si];
      r_dest[1024 + si] = 12000[si];
      r_dest[2048 + si] = 14000[si];
      r_dest[3072 + si] = 16000[si];
      r_dest[4096 + si] = 18000[si];
      r_dest[5120 + si] = 20000[si];
      r_dest[6144 + si] = 22000[si];
      r_dest[7168 + si] = 24000[si];
      si += 1;
    );
    ti = 0;
    while (ti < 16) (
      r_dest[8192 + ti]       = 1600[ti];
      r_dest[8192 + 16 + ti]  = 1620[ti];
      r_dest[8192 + 32 + ti]  = 1640[ti];
      r_dest[8192 + 48 + ti]  = 1660[ti];
      r_dest[8192 + 64 + ti]  = 1680[ti];
      r_dest[8192 + 80 + ti]  = 1700[ti];
      r_dest[8192 + 96 + ti]  = 1720[ti];
      r_dest[8192 + 112 + ti] = 1740[ti];
      r_dest[8192 + 128 + ti] = 1860[ti];
      r_dest[8192 + 160 + ti] = 1920[ti];
      r_dest[8192 + 176 + ti] = 1940[ti];
      r_dest[8192 + 192 + ti] = 2100[ti];
      r_dest[8430 + ti]       = 2120[ti];
      r_dest[8450 + ti]       = 2140[ti];
      r_dest[8470 + ti]       = 2160[ti];
      ti += 1;
    );
    r_dest[8400] = euc_mode;
    r_dest[8401] = velocity_mode;
    r_dest[8402] = gate_mode;
    r_dest[8403] = pan_mode;
    r_dest[8404] = timing_mode;
    r_dest[8405] = ratchet_mode;
    r_dest[8406] = chance_mode;
    r_dest[8407] = cond_mode;
    r_dest[8408] = master_len_offset;
    r_dest[8428] = master_swing;
    r_dest[8429] = master_s2_mode;
    r_dest[8486] = master_density;
    r_dest[8409] = quant_root;
    r_dest[8410] = quant_scale;
    r_dest[8411] = quant_mask_bits;
    ti = 0;
    while (ti < 16) (
      r_dest[8412 + ti] = 4760[ti];
      ti += 1;
    );

    redo_head += 1;
    redo_count < REDO_MAX ? redo_count += 1;
    undo_head -= 1;
    undo_head < 0 ? undo_head += UNDO_MAX;
    src_base = UNDO_BASE + (undo_head % UNDO_MAX) * UNDO_BLOCK_SIZE;

    // Restore per-step states (1024 steps)
    si = 0;
    while (si < 1024) (
      10000[si] = src_base[si];
      12000[si] = src_base[1024 + si];
      14000[si] = src_base[2048 + si];
      16000[si] = src_base[3072 + si];
      18000[si] = src_base[4096 + si];
      20000[si] = src_base[5120 + si];
      22000[si] = src_base[6144 + si];
      24000[si] = src_base[7168 + si];
      si += 1;
    );

    // Restore 16-track parameters
    ti = 0;
    while (ti < 16) (
      1600[ti] = src_base[8192 + ti];
      1620[ti] = src_base[8192 + 16 + ti];
      1640[ti] = src_base[8192 + 32 + ti];
      1660[ti] = src_base[8192 + 48 + ti];
      1680[ti] = src_base[8192 + 64 + ti];
      1700[ti] = src_base[8192 + 80 + ti];
      1720[ti] = src_base[8192 + 96 + ti];
      1740[ti] = src_base[8192 + 112 + ti];
      1860[ti] = src_base[8192 + 128 + ti];
      1920[ti] = src_base[8192 + 160 + ti];
      1940[ti] = (src_base[8192 + 176 + ti] <= 0 && src_base[8192 + 176 + ti] != 0) ? 100 : src_base[8192 + 176 + ti];
      2100[ti] = src_base[8192 + 192 + ti];
      2120[ti] = src_base[8430 + ti];
      2140[ti] = src_base[8450 + ti];
      2160[ti] = src_base[8470 + ti];
      ti += 1;
    );
    euc_mode = src_base[8400];
    velocity_mode = src_base[8401];
    gate_mode = src_base[8402];
    pan_mode = src_base[8403];
    timing_mode = src_base[8404];
    ratchet_mode = src_base[8405];
    chance_mode = src_base[8406];
    cond_mode = src_base[8407];
    master_len_offset = src_base[8408];
    master_swing = src_base[8428];
    master_s2_mode = src_base[8429];
    master_density = src_base[8486];
    master_density <= 0 && master_density != 0 ? master_density = 100;
    quant_root = src_base[8409];
    quant_scale = src_base[8410];
    apply_quant_mask_bits(src_base[8411]);
    ti = 0;
    while (ti < 16) (
      4760[ti] = src_base[8412 + ti];
      ti += 1;
    );

    undo_count -= 1;
  );
);

function redo_pop() local(u_dest, si, ti, r_src) (
  redo_count > 0 ? (
    // Save current state into undo buffer before restoring
    u_dest = UNDO_BASE + (undo_head % UNDO_MAX) * UNDO_BLOCK_SIZE;
    si = 0;
    while (si < 1024) (
      u_dest[si]        = 10000[si];
      u_dest[1024 + si] = 12000[si];
      u_dest[2048 + si] = 14000[si];
      u_dest[3072 + si] = 16000[si];
      u_dest[4096 + si] = 18000[si];
      u_dest[5120 + si] = 20000[si];
      u_dest[6144 + si] = 22000[si];
      u_dest[7168 + si] = 24000[si];
      si += 1;
    );
    ti = 0;
    while (ti < 16) (
      u_dest[8192 + ti]       = 1600[ti];
      u_dest[8192 + 16 + ti]  = 1620[ti];
      u_dest[8192 + 32 + ti]  = 1640[ti];
      u_dest[8192 + 48 + ti]  = 1660[ti];
      u_dest[8192 + 64 + ti]  = 1680[ti];
      u_dest[8192 + 80 + ti]  = 1700[ti];
      u_dest[8192 + 96 + ti]  = 1720[ti];
      u_dest[8192 + 112 + ti] = 1740[ti];
      u_dest[8192 + 128 + ti] = 1860[ti];
      u_dest[8192 + 160 + ti] = 1920[ti];
      u_dest[8192 + 176 + ti] = 1940[ti];
      u_dest[8192 + 192 + ti] = 2100[ti];
      u_dest[8430 + ti]       = 2120[ti];
      u_dest[8450 + ti]       = 2140[ti];
      u_dest[8470 + ti]       = 2160[ti];
      ti += 1;
    );
    u_dest[8400] = euc_mode;
    u_dest[8401] = velocity_mode;
    u_dest[8402] = gate_mode;
    u_dest[8403] = pan_mode;
    u_dest[8404] = timing_mode;
    u_dest[8405] = ratchet_mode;
    u_dest[8406] = chance_mode;
    u_dest[8407] = cond_mode;
    u_dest[8408] = master_len_offset;
    u_dest[8428] = master_swing;
    u_dest[8429] = master_s2_mode;
    u_dest[8486] = master_density;
    u_dest[8409] = quant_root;
    u_dest[8410] = quant_scale;
    u_dest[8411] = quant_mask_bits;
    ti = 0;
    while (ti < 16) (
      u_dest[8412 + ti] = 4760[ti];
      ti += 1;
    );
    undo_head += 1;
    undo_count < UNDO_MAX ? undo_count += 1;

    redo_head -= 1;
    redo_head < 0 ? redo_head += REDO_MAX;
    r_src = REDO_BASE + (redo_head % REDO_MAX) * REDO_BLOCK_SIZE;

    // Restore per-step states (1024 steps)
    si = 0;
    while (si < 1024) (
      10000[si] = r_src[si];
      12000[si] = r_src[1024 + si];
      14000[si] = r_src[2048 + si];
      16000[si] = r_src[3072 + si];
      18000[si] = r_src[4096 + si];
      20000[si] = r_src[5120 + si];
      22000[si] = r_src[6144 + si];
      24000[si] = r_src[7168 + si];
      si += 1;
    );

    // Restore 16-track parameters
    ti = 0;
    while (ti < 16) (
      1600[ti] = r_src[8192 + ti];
      1620[ti] = r_src[8192 + 16 + ti];
      1640[ti] = r_src[8192 + 32 + ti];
      1660[ti] = r_src[8192 + 48 + ti];
      1680[ti] = r_src[8192 + 64 + ti];
      1700[ti] = r_src[8192 + 80 + ti];
      1720[ti] = r_src[8192 + 96 + ti];
      1740[ti] = r_src[8192 + 112 + ti];
      1860[ti] = r_src[8192 + 128 + ti];
      1920[ti] = r_src[8192 + 160 + ti];
      1940[ti] = (r_src[8192 + 176 + ti] <= 0 && r_src[8192 + 176 + ti] != 0) ? 100 : r_src[8192 + 176 + ti];
      2100[ti] = r_src[8192 + 192 + ti];
      2120[ti] = r_src[8430 + ti];
      2140[ti] = r_src[8450 + ti];
      2160[ti] = r_src[8470 + ti];
      ti += 1;
    );
    euc_mode = r_src[8400];
    velocity_mode = r_src[8401];
    gate_mode = r_src[8402];
    pan_mode = r_src[8403];
    timing_mode = r_src[8404];
    ratchet_mode = r_src[8405];
    chance_mode = r_src[8406];
    cond_mode = r_src[8407];
    master_len_offset = r_src[8408];
    master_swing = r_src[8428];
    master_s2_mode = r_src[8429];
    master_density = r_src[8486];
    master_density <= 0 && master_density != 0 ? master_density = 100;
    quant_root = r_src[8409];
    quant_scale = r_src[8410];
    apply_quant_mask_bits(r_src[8411]);
    ti = 0;
    while (ti < 16) (
      4760[ti] = r_src[8412 + ti];
      ti += 1;
    );

    redo_count -= 1;
  );
);

// Pure Bjorklund Euclidean algorithm (matches HoRNet RhyGenerator exactly for any length and fill)
// Scratch buffers hold groups of hits and rests while the groups are distributed.
function gen_bjorklund(out_buf, len, fill) local(l1, c1, l2, c2, l_new, rem, i, k, pos, rep, do_loop) (
  fill <= 0 ? (
    i = 0; while (i < len) ( out_buf[i] = 0; i += 1; );
  ) :
  fill >= len ? (
    i = 0; while (i < len) ( out_buf[i] = 1; i += 1; );
  ) : (
    41000[0] = 1;
    l1 = 1;
    c1 = fill;

    41100[0] = 0;
    l2 = 1;
    c2 = len - fill;

    do_loop = 1;
    while (do_loop) (
      i = 0; while (i < l1) ( 41200[i] = 41000[i]; i += 1; );
      k = 0; while (k < l2) ( 41200[l1 + k] = 41100[k]; k += 1; );
      l_new = l1 + l2;

      c1 >= c2 ? (
        rem = c1 - c2;
        i = 0; while (i < l1) ( 41100[i] = 41000[i]; i += 1; );
        l2 = l1;
        c2 = rem;

        i = 0; while (i < l_new) ( 41000[i] = 41200[i]; i += 1; );
        l1 = l_new;
        c1 = c1 - rem;
      ) : (
        c2 = c2 - c1;
        i = 0; while (i < l_new) ( 41000[i] = 41200[i]; i += 1; );
        l1 = l_new;
      );
      (c1 <= 1 || c2 <= 1) ? do_loop = 0;
    );

    pos = 0;
    rep = 0;
    while (rep < c1) (
      i = 0; while (i < l1 && pos < len) ( out_buf[pos] = 41000[i]; pos += 1; i += 1; );
      rep += 1;
    );
    rep = 0;
    while (rep < c2) (
      i = 0; while (i < l2 && pos < len) ( out_buf[pos] = 41100[i]; pos += 1; i += 1; );
      rep += 1;
    );
  );
);

// Real-time Euclidean step evaluation with cached Bjorklund buffer
function eval_euclidean_step(step, len, fill) (
  step < 0 || step >= len || fill <= 0 ? 0 :
  fill >= len ? 1 : (
    (last_euc_len != len || last_euc_fill != fill) ? (
      last_euc_len = len;
      last_euc_fill = fill;
      gen_bjorklund(41500, len, fill);
    );
    41500[step];
  );
);

// Euclidean pattern generator
function apply_euclidean_track(t_idx) local(len, fill, si) (
  len = 1660[t_idx];
  len <= 0 ? len = 16;
  len > 64 ? len = 64;
  fill = 1860[t_idx];
  fill < 0 ? fill = 0;
  fill > len ? fill = len;
  1860[t_idx] = fill;

  si = 0;
  while (si < 64) (
    10000[t_idx * 64 + si] = 0;
    si += 1;
  );

  gen_bjorklund(10000 + t_idx * 64, len, fill);

  si = 0;
  while (si < len) (
    10000[t_idx * 64 + si] ? (
      12000[t_idx * 64 + si] <= 0 ? 12000[t_idx * 64 + si] = 100;
    );
    si += 1;
  );
);

// Base and hover border colors (RGB 64,64,64 base vs 105,105,105 hover)
BORDER_R = 64 / 255.0; BORDER_G = 64 / 255.0; BORDER_B = 64 / 255.0;
HOVER_R = 105 / 255.0; HOVER_G = 105 / 255.0; HOVER_B = 105 / 255.0;

function set_border_color(is_hov) (
  is_hov ? (
    gfx_r = HOVER_R; gfx_g = HOVER_G; gfx_b = HOVER_B;
  ) : (
    gfx_r = BORDER_R; gfx_g = BORDER_G; gfx_b = BORDER_B;
  );
);

function do_track_shl(t) local(cur_len, first_step, first_vel, first_pan, first_gate, first_timing, first_ratchet, first_chc, first_cnd, si) (
  cur_len = 1660[t];
  first_step = 10000[t * 64];
  first_vel = 12000[t * 64];
  first_pan = 14000[t * 64];
  first_gate = 16000[t * 64];
  first_timing = 18000[t * 64];
  first_ratchet = 20000[t * 64];
  first_chc = 22000[t * 64];
  first_cnd = 24000[t * 64];
  si = 0;
  while (si < cur_len - 1) (
    10000[t * 64 + si] = 10000[t * 64 + si + 1];
    12000[t * 64 + si] = 12000[t * 64 + si + 1];
    14000[t * 64 + si] = 14000[t * 64 + si + 1];
    16000[t * 64 + si] = 16000[t * 64 + si + 1];
    18000[t * 64 + si] = 18000[t * 64 + si + 1];
    20000[t * 64 + si] = 20000[t * 64 + si + 1];
    22000[t * 64 + si] = 22000[t * 64 + si + 1];
    24000[t * 64 + si] = 24000[t * 64 + si + 1];
    si += 1;
  );
  10000[t * 64 + cur_len - 1] = first_step;
  12000[t * 64 + cur_len - 1] = first_vel;
  14000[t * 64 + cur_len - 1] = first_pan;
  16000[t * 64 + cur_len - 1] = first_gate;
  18000[t * 64 + cur_len - 1] = first_timing;
  20000[t * 64 + cur_len - 1] = first_ratchet;
  22000[t * 64 + cur_len - 1] = first_chc;
  24000[t * 64 + cur_len - 1] = first_cnd;
);

function do_track_shr(t) local(cur_len, last_step, last_vel, last_pan, last_gate, last_timing, last_ratchet, last_cnd, si) (
  cur_len = 1660[t];
  last_step = 10000[t * 64 + cur_len - 1];
  last_vel = 12000[t * 64 + cur_len - 1];
  last_pan = 14000[t * 64 + cur_len - 1];
  last_gate = 16000[t * 64 + cur_len - 1];
  last_timing = 18000[t * 64 + cur_len - 1];
  last_ratchet = 20000[t * 64 + cur_len - 1];
  last_chc = 22000[t * 64 + cur_len - 1];
  last_cnd = 24000[t * 64 + cur_len - 1];
  si = cur_len - 1;
  while (si > 0) (
    10000[t * 64 + si] = 10000[t * 64 + si - 1];
    12000[t * 64 + si] = 12000[t * 64 + si - 1];
    14000[t * 64 + si] = 14000[t * 64 + si - 1];
    16000[t * 64 + si] = 16000[t * 64 + si - 1];
    18000[t * 64 + si] = 18000[t * 64 + si - 1];
    20000[t * 64 + si] = 20000[t * 64 + si - 1];
    22000[t * 64 + si] = 22000[t * 64 + si - 1];
    24000[t * 64 + si] = 24000[t * 64 + si - 1];
    si -= 1;
  );
  10000[t * 64] = last_step;
  12000[t * 64] = last_vel;
  14000[t * 64] = last_pan;
  16000[t * 64] = last_gate;
  18000[t * 64] = last_timing;
  20000[t * 64] = last_ratchet;
  22000[t * 64] = last_chc;
  24000[t * 64] = last_cnd;
);

function do_track_flip(t) local(cur_len, half, si, other_i, tmp_s, tmp_v, tmp_p, tmp_g, tmp_t, tmp_r, tmp_c, tmp_cond) (
  cur_len = 1660[t];
  half = floor(cur_len / 2);
  si = 0;
  while (si < half) (
    other_i = cur_len - 1 - si;
    tmp_s = 10000[t * 64 + si];
    tmp_v = 12000[t * 64 + si];
    tmp_p = 14000[t * 64 + si];
    tmp_g = 16000[t * 64 + si];
    tmp_t = 18000[t * 64 + si];
    tmp_r = 20000[t * 64 + si];
    tmp_c = 22000[t * 64 + si];
    tmp_cond = 24000[t * 64 + si];

    10000[t * 64 + si] = 10000[t * 64 + other_i];
    12000[t * 64 + si] = 12000[t * 64 + other_i];
    14000[t * 64 + si] = 14000[t * 64 + other_i];
    16000[t * 64 + si] = 16000[t * 64 + other_i];
    18000[t * 64 + si] = 18000[t * 64 + other_i];
    20000[t * 64 + si] = 20000[t * 64 + other_i];
    22000[t * 64 + si] = 22000[t * 64 + other_i];
    24000[t * 64 + si] = 24000[t * 64 + other_i];

    10000[t * 64 + other_i] = tmp_s;
    12000[t * 64 + other_i] = tmp_v;
    14000[t * 64 + other_i] = tmp_p;
    16000[t * 64 + other_i] = tmp_g;
    18000[t * 64 + other_i] = tmp_t;
    20000[t * 64 + other_i] = tmp_r;
    22000[t * 64 + other_i] = tmp_c;
    24000[t * 64 + other_i] = tmp_cond;

    si += 1;
  );
);

function do_track_rnd(t) local(cur_len, si) (
  cur_len = 1660[t];
  si = 0;
  while (si < cur_len) (
    10000[t * 64 + si] = rand(100) > 60;
    12000[t * 64 + si] = 100;
    si += 1;
  );
);

function transpose_all_tracks(semis, is_oct) local(ti, cur_p, new_p, q_dir, can_t) (
  q_dir = semis > 0 ? 1 : -1;
  can_t = 1;
  is_oct ? (
    (q_dir > 0 && global_oct_offset >= floor((48 - global_semi_offset) / 12)) ? can_t = 0;
    (q_dir < 0 && global_oct_offset <= ceil((-36 - global_semi_offset) / 12)) ? can_t = 0;
  ) : (
    (q_dir > 0 && global_semi_offset >= 48) ? can_t = 0;
    (q_dir < 0 && global_semi_offset <= -36) ? can_t = 0;
  );
  can_t ? (
    undo_push();
    ti = 0;
    while (ti < NUM_TRACKS) (
      cur_p = 1600[ti];
      is_oct ? (
        new_p = get_next_scale_octave(cur_p, q_dir);
      ) : (
        new_p = get_next_scale_pitch(cur_p, q_dir);
      );
      1600[ti] = new_p;
      ti += 1;
    );
    is_oct ? (
      global_oct_offset += q_dir;

    ) : (
      global_semi_offset += q_dir;
    );
    save_pattern_to_mem(active_edit_pat);
  );
);

function reset_transpose() local(diff, is_oct, step_dir, ti) (
  (global_oct_offset != 0 || global_semi_offset != 0) ? (
    undo_push();
    while (global_semi_offset != 0) (
      step_dir = global_semi_offset > 0 ? -1 : 1;
      ti = 0;
      while (ti < NUM_TRACKS) (
        1600[ti] = get_next_scale_pitch(1600[ti], step_dir);
        ti += 1;
      );
      global_semi_offset += step_dir;
    );
    while (global_oct_offset != 0) (
      step_dir = global_oct_offset > 0 ? -1 : 1;
      ti = 0;
      while (ti < NUM_TRACKS) (
        1600[ti] = get_next_scale_octave(1600[ti], step_dir);
        ti += 1;
      );
      global_oct_offset += step_dir;
    );
    save_pattern_to_mem(active_edit_pat);
  );
);

function modify_master_len(delta) local(step_dir, steps_to_do, s, can_move, ti, cur_l) (
  delta != 0 ? (
    step_dir = delta > 0 ? 1 : -1;
    steps_to_do = abs(delta);
    s = 0;
    while (s < steps_to_do) (
      can_move = 1;
      ti = 0;
      while (ti < NUM_TRACKS) (
        cur_l = 1660[ti];
        (step_dir > 0 && cur_l >= 64) ? can_move = 0;
        (step_dir < 0 && cur_l <= 1) ? can_move = 0;
        ti += 1;
      );
      can_move ? (
        !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
        ti = 0;
        while (ti < NUM_TRACKS) (
          1660[ti] += step_dir;
          1860[ti] > 1660[ti] ? 1860[ti] = 1660[ti];
          (euc_mode && 1860[ti] > 0) ? apply_euclidean_track(ti);
          ti += 1;
        );
        master_len_offset += step_dir;
        save_pattern_to_mem(active_edit_pat);
      ) : (
        s = steps_to_do;
      );
      s += 1;
    );
  );
);

function reset_master_len() local(ti, step_dir) (
  master_len_offset != 0 ? (
    undo_push();
    while (master_len_offset != 0) (
      step_dir = master_len_offset > 0 ? -1 : 1;
      ti = 0;
      while (ti < NUM_TRACKS) (
        1660[ti] = min(64, max(1, 1660[ti] + step_dir));
        1860[ti] > 1660[ti] ? 1860[ti] = 1660[ti];
        (euc_mode && 1860[ti] > 0) ? apply_euclidean_track(ti);
        ti += 1;
      );
      master_len_offset += step_dir;
    );
    save_pattern_to_mem(active_edit_pat);
  );
);

function modify_master_swing(delta) local(step_dir, steps_to_do, s, can_move, ti, cur_sw) (
  delta != 0 ? (
    step_dir = delta > 0 ? 1 : -1;
    steps_to_do = abs(delta);
    s = 0;
    while (s < steps_to_do) (
      can_move = 1;
      ti = 0;
      while (ti < NUM_TRACKS) (
        cur_sw = 1740[ti];
        (step_dir > 0 && cur_sw >= 100) ? can_move = 0;
        (step_dir < 0 && cur_sw <= -100) ? can_move = 0;
        ti += 1;
      );
      can_move ? (
        !drag_pushed_undo ? ( undo_push(); drag_pushed_undo = 1; );
        ti = 0;
        while (ti < NUM_TRACKS) (
          1740[ti] += step_dir;
          ti += 1;
        );
        master_swing += step_dir;
        save_pattern_to_mem(active_edit_pat);
      ) : (
        s = steps_to_do;
      );
      s += 1;
    );
  );
);

function reset_master_swing() local(ti, step_dir) (
  master_swing != 0 ? (
    undo_push();
    while (master_swing != 0) (
      step_dir = master_swing > 0 ? -1 : 1;
      ti = 0;
      while (ti < NUM_TRACKS) (
        1740[ti] = min(100, max(-100, 1740[ti] + step_dir));
        ti += 1;
      );
      master_swing += step_dir;
    );
    save_pattern_to_mem(active_edit_pat);
  );
);

function copy_pattern_to_clipboard(pat_idx) local(src_base, i) (
  pat_idx == active_edit_pat ? (
    save_pattern_to_mem(active_edit_pat);
  );
  src_base = PATTERN_BASE + (pat_idx % 16) * PATTERN_BLOCK_SIZE;
  i = 0;
  while (i < PATTERN_BLOCK_SIZE) (
    PAT_CLIPBOARD_BASE[i] = src_base[i];
    i += 1;
  );
  has_pat_clipboard = 1;
);

function cut_pattern_to_clipboard(pat_idx) local(dest_base, i) (
  undo_push();
  copy_pattern_to_clipboard(pat_idx);
  init_pattern_slot_defaults(pat_idx);
  pat_idx == active_edit_pat ? (
    load_pattern_from_mem(active_edit_pat);
  );
);

function paste_pattern_from_clipboard(pat_idx) local(dest_base, i) (
  has_pat_clipboard ? (
    undo_push();
    dest_base = PATTERN_BASE + (pat_idx % 16) * PATTERN_BLOCK_SIZE;
    i = 0;
    while (i < PATTERN_BLOCK_SIZE) (
      dest_base[i] = PAT_CLIPBOARD_BASE[i];
      i += 1;
    );
    pat_idx == active_edit_pat ? (
      load_pattern_from_mem(active_edit_pat);
    );
  );
);

// Condition IDs 0..45 remain compatible with existing projects.
// Ratios use a triangular ordinal (1:2 = 1, 16:16 = 135).
function cond_ratio_ord(id) (
  id >= 1 && id <= 35 ? id :
  id == 42 ? 135 : id == 43 ? 9 : id == 44 ? 35 : id == 45 ? 135 :
  id >= 46 && id <= 145 ? id - 10 :
  id >= 146 && id <= 280 ? id - 145 : 0;
);
function cond_inverse(id) ( id == 43 || id == 44 || id == 45 || (id >= 146 && id <= 280); );
function cond_ratio_id(a, b, inv) local(ord) (
  ord = b * (b - 1) / 2 + a - 1;
  inv ? 145 + ord : ord <= 35 ? ord : ord + 10;
);
function cond_order(id) local(ord) (
  ord = cond_ratio_ord(id);
  id == 0 ? 0 : ord > 0 ? (2 * ord - 1 + cond_inverse(id)) :
  id >= 36 && id <= 41 ? 271 + id - 36 : 0;
);
function cond_from_order(pos) local(ord) (
  pos <= 0 ? 0 : pos <= 270 ? (
    ord = floor((pos + 1) / 2);
    (pos % 2) == 0 ? 145 + ord : ord <= 35 ? ord : ord + 10;
  ) : 36 + pos - 271;
);
function get_cond_str(c_idx) local(ord, b, a) (
  ord = cond_ratio_ord(c_idx);
  ord > 0 ? (
    b = 2; while (b < 16 && ord > b * (b + 1) / 2 - 1) ( b += 1; );
    a = ord - b * (b - 1) / 2 + 1;
    cond_inverse(c_idx) ? sprintf(#c_str, "/%d:%d", a, b) : sprintf(#c_str, "%d:%d", a, b);
  ) : (
    c_idx == 36 ? #c_str = "1ST" : c_idx == 37 ? #c_str = "/1ST" :
    c_idx == 38 ? #c_str = "PRE" : c_idx == 39 ? #c_str = "/PRE" :
    c_idx == 40 ? #c_str = "NEI" : c_idx == 41 ? #c_str = "/NEI" : #c_str = "---";
  );
);
function get_cond_desc(c_idx, lang) local(ord, b, a) (
  ord = cond_ratio_ord(c_idx);
  ord > 0 ? (
    b = 2; while (b < 16 && ord > b * (b + 1) / 2 - 1) ( b += 1; );
    a = ord - b * (b - 1) / 2 + 1;
    lang == 0 ? (
      cond_inverse(c_idx) ? sprintf(#c_desc, "Suona in tutti i cicli tranne il %d su %d", a, b) : sprintf(#c_desc, "Suona solo al ciclo %d su %d", a, b);
    ) : (
      cond_inverse(c_idx) ? sprintf(#c_desc, "Plays on every loop except %d out of %d", a, b) : sprintf(#c_desc, "Plays only on loop %d out of %d", a, b);
    );
  ) : lang == 0 ? (
    c_idx == 36 ? #c_desc = "Suona solo al primo ciclo" : c_idx == 37 ? #c_desc = "Muto al primo ciclo, suona nei successivi" :
    c_idx == 38 ? #c_desc = "Suona se la precedente condizione era vera" : c_idx == 39 ? #c_desc = "Suona se la precedente condizione era falsa" :
    c_idx == 40 ? #c_desc = "Suona se la condizione della traccia vicina era vera" : c_idx == 41 ? #c_desc = "Suona se la condizione della traccia vicina era falsa" : #c_desc = "Sempre attivo";
  ) : (
    c_idx == 36 ? #c_desc = "Plays only on the first loop" : c_idx == 37 ? #c_desc = "Muted on the first loop, plays on subsequent loops" :
    c_idx == 38 ? #c_desc = "Plays if the previous condition was true" : c_idx == 39 ? #c_desc = "Plays if the previous condition was false" :
    c_idx == 40 ? #c_desc = "Plays if the neighboring track condition was true" : c_idx == 41 ? #c_desc = "Plays if the neighboring track condition was false" : #c_desc = "Always active";
  );
);

// Continuous gate length calculation (0.125..0.75, 1..64 steps, INF)
// 0.05-step gap allows clean retriggering of monophonic/legato envelopes
function get_elektron_gate_dur(g_idx, step_beat_dur) local(st_count) (
  g_idx == 0 ? (0.125 * step_beat_dur) :
  g_idx == 1 ? (0.25  * step_beat_dur) :
  g_idx == 2 ? (0.5   * step_beat_dur) :
  g_idx == 3 ? (0.75  * step_beat_dur) :
  g_idx >= 4 && g_idx <= 67 ? (
    st_count = g_idx - 3; // 1..64 exact steps
    ((st_count - 0.05) * step_beat_dur)
  ) :
  g_idx == 68 ? 999999.0 : // INF: play legato across the steps until the next trig!
  g_idx == 69 ? 999999.0 : // LEG: held until the next note-on on the same MIDI channel, then released AFTER it (overlap -> synth glide)
  (0.95 * step_beat_dur);
);

function get_elektron_gate_full_str(g_idx) (
  g_idx == 0 ? #g_full_str = "0.125" :
  g_idx == 1 ? #g_full_str = "0.25"  :
  g_idx == 2 ? #g_full_str = "0.5"   :
  g_idx == 3 ? #g_full_str = "0.75"  :
  g_idx >= 4 && g_idx <= 67 ? sprintf(#g_full_str, "%d", g_idx - 3) :
  g_idx == 68 ? #g_full_str = "INF"  :
  g_idx == 69 ? #g_full_str = "LEG"  :
  #g_full_str = "1";
);

function eval_cond(c_idx, cur_cycle, tr_idx) local(res, nei_tr, ord, b, a) (
  ord = cond_ratio_ord(c_idx);
  ord > 0 ? (
    b = 2; while (b < 16 && ord > b * (b + 1) / 2 - 1) ( b += 1; );
    a = ord - b * (b - 1) / 2 + 1;
    res = ((cur_cycle % b) == (a - 1));
    cond_inverse(c_idx) ? res = !res;
  ) : c_idx == 0 ? res = 1 :
  // 1ST / /1ST
  c_idx == 36 ? res = (cur_cycle == 0) :
  c_idx == 37 ? res = (cur_cycle > 0) :
  // PRE / /PRE
  c_idx == 38 ? res = (3800[tr_idx] == 1) :
  c_idx == 39 ? res = (3800[tr_idx] == 0) :
  // NEI / /NEI
  c_idx == 40 ? (
    nei_tr = tr_idx > 0 ? tr_idx - 1 : NUM_TRACKS - 1;
    res = (3800[nei_tr] == 1);
  ) :
  c_idx == 41 ? (
    nei_tr = tr_idx > 0 ? tr_idx - 1 : NUM_TRACKS - 1;
    res = (3800[nei_tr] == 0);
  ) :
  res = 1;

  c_idx > 0 ? (
    3800[tr_idx] = res;
  );

  res;
);

t = 0;
while (t < NUM_TRACKS) (
  1600[t] = 60;          // Pitch: 60 (C4)
  1620[t] = t + 1;       // MIDI Channel (1..16)
  1640[t] = 7;           // Rate: index 7 ("x4" = 16th notes)
  1660[t] = 16;          // Pattern length: 16 steps
  1680[t] = 0;           // Solo: off
  1700[t] = 0;           // Mute: off
  1720[t] = 100;         // Track Chance / Density: 100%
  1740[t] = 0;           // Swing: 0%
  1860[t] = 0;           // Euclidean Fill: 0
  1920[t] = 0;           // Per-track play mode (0: Forward, 1: Reverse, 2: Ping-Pong, 3: Stochastic)
  1940[t] = 100;         // Track Volume: 100% default
  2100[t] = 0;           // Slot A mode: 0=Volume, 1=Density
  2120[t] = 0;           // Track Pan: 0% default (Center)
  2140[t] = 0;           // Slot B mode: 0=Swing, 1=Pan, 2=Gate
  2160[t] = 0;           // Track Gate: 0% default (Neutral 1.0x)
  1760[t] = 0;           // Visual Playhead position
  1780[t] = -1;          // Active sounding note (-1 = none)
  1800[t] = t + 1;       // Active MIDI channel
  1820[t] = -1;          // Last triggered step index
  1840[t] = -1;          // Scheduled Note-Off beat position
  44000[t] = 0;          // LEG flag of the held note
  44020[t] = -1;         // Beat of the last note-on (LEG detection)
  44100[t] = 0;          // Pattern cycle counter (trig conditions)
  44120[t] = -1;         // Last step position inside the pattern (cycle wrap detection)
  1880[t] = 64;          // Last sent Pan state (64 = Center)
  3800[t] = 1;           // Last evaluated trig condition result (1 = true)

  s = 0;
  while (s < MAX_STEPS) (
    offset = t * 64 + s;
    10000[offset] = 0;   // Step state: off (0)
    12000[offset] = 100; // Velocity: 100
    14000[offset] = 64;  // Pan: 64 (Center)
    16000[offset] = 4;   // Gate length: index 4 (1 step)
    18000[offset] = 0;   // Micro-timing: 0%
    20000[offset] = 1;   // Ratcheting: 1 sub-step (1..4)
    22000[offset] = 100; // Step Chance: 100%
    24000[offset] = 0;   // Trig Condition: 0 ("---")
    s += 1;
  );
  t += 1;
);

function get_track_play_step(raw_step, len, mode, tr_idx) local(st, cl, ph, res) (
  len <= 0 ? len = 16;
  res = 0;
  mode == 0 ? (
    // Forward
    st = raw_step % len;
    st < 0 ? st += len;
    res = st;
  ) :
  mode == 1 ? (
    // Reverse
    st = raw_step % len;
    st < 0 ? st += len;
    res = (len - 1) - st;
  ) :
  mode == 2 ? (
    // Ping-Pong
    len <= 1 ? (
      res = 0;
    ) : (
      cl = 2 * (len - 1);
      ph = raw_step % cl;
      ph < 0 ? ph += cl;
      ph < len ? ( res = ph; ) : ( res = cl - ph; );
    );
  ) : (
    // Stochastic / Random
    len <= 1 ? (
      res = 0;
    ) : (
      res = floor(abs(sin(raw_step * 12.9898 + (tr_idx + 1) * 78.233)) * 43758.5453) % len;
    );
  );
  res;
);

function get_beats_per_step(r_idx) (
  r_idx == 0 ? 16.0 :
  r_idx == 1 ? 12.0 :
  r_idx == 2 ? 8.0 :
  r_idx == 3 ? 4.0 :
  r_idx == 4 ? 2.0 :
  r_idx == 5 ? 1.0 :
  r_idx == 6 ? 0.5 :
  r_idx == 7 ? 0.25 :
  r_idx == 8 ? 0.125 :
  r_idx == 9 ? 1.0 / 12.0 :
  0.0625;
);

function X(val) ( floor(val * sx); );
function Y(val) ( floor(val * sy); );
function W(val) ( max(1, floor(val * sx)); );
function H(val) ( max(1, floor(val * sy)); );

function get_track_color(idx) local(mod) (
  mod = idx % 16;
  mod == 0 ? ( cr = 110 / 255.0; cg = 76 / 255.0;  cb = 225 / 255.0; ) :
  mod == 1 ? ( cr = 150 / 255.0; cg = 75 / 255.0;  cb = 225 / 255.0; ) :
  mod == 2 ? ( cr = 190 / 255.0; cg = 75 / 255.0;  cb = 225 / 255.0; ) :
  mod == 3 ? ( cr = 225 / 255.0; cg = 79 / 255.0;  cb = 209 / 255.0; ) :
  mod == 4 ? ( cr = 225 / 255.0; cg = 77 / 255.0;  cb = 162 / 255.0; ) :
  mod == 5 ? ( cr = 225 / 255.0; cg = 79 / 255.0;  cb = 118 / 255.0; ) :
  mod == 6 ? ( cr = 225 / 255.0; cg = 95 / 255.0;  cb = 91 / 255.0;  ) :
  mod == 7 ? ( cr = 225 / 255.0; cg = 122 / 255.0; cb = 73 / 255.0;  ) :
  mod == 8 ? ( cr = 225 / 255.0; cg = 159 / 255.0; cb = 71 / 255.0;  ) :
  mod == 9 ? ( cr = 193 / 255.0; cg = 220 / 255.0; cb = 81 / 255.0;  ) :
  mod == 10 ? ( cr = 92 / 255.0;  cg = 220 / 255.0; cb = 82 / 255.0;  ) :
  mod == 11 ? ( cr = 71 / 255.0;  cg = 220 / 255.0; cb = 128 / 255.0; ) :
  mod == 12 ? ( cr = 56 / 255.0;  cg = 220 / 255.0; cb = 182 / 255.0; ) :
  mod == 13 ? ( cr = 39 / 255.0;  cg = 181 / 255.0; cb = 225 / 255.0; ) :
  mod == 14 ? ( cr = 77 / 255.0;  cg = 164 / 255.0; cb = 225 / 255.0; ) :
              ( cr = 139 / 255.0; cg = 171 / 255.0; cb = 225 / 255.0; );
);

function draw_arrow_forward(bx, by, bw, bh, s) local(cx, cy, arr, head) (
  cx = bx + bw * 0.5; cy = by + bh * 0.5;
  arr = max(4, floor(5.5 * s));
  head = max(2, floor(3.5 * s));
  gfx_line(cx - arr, cy, cx + arr, cy);
  gfx_line(cx + arr, cy, cx + arr - head, cy - head);
  gfx_line(cx + arr, cy, cx + arr - head, cy + head);
);

function draw_arrow_backward(bx, by, bw, bh, s) local(cx, cy, arr, head) (
  cx = bx + bw * 0.5; cy = by + bh * 0.5;
  arr = max(4, floor(5.5 * s));
  head = max(2, floor(3.5 * s));
  gfx_line(cx + arr, cy, cx - arr, cy);
  gfx_line(cx - arr, cy, cx - arr + head, cy - head);
  gfx_line(cx - arr, cy, cx - arr + head, cy + head);
);

function draw_arrow_pingpong(bx, by, bw, bh, s) local(cx, cy, arr, head, y_off) (
  cx = bx + bw * 0.5; cy = by + bh * 0.5;
  arr = max(4, floor(5.5 * s));
  head = max(2, floor(2.5 * s));
  y_off = max(3, floor(3.5 * s));
  // Forward arrow
  gfx_line(cx - arr, cy - y_off, cx + arr, cy - y_off);
  gfx_line(cx + arr, cy - y_off, cx + arr - head, cy - y_off - head);
  gfx_line(cx + arr, cy - y_off, cx + arr - head, cy - y_off + head);
  // Reverse arrow
  gfx_line(cx + arr, cy + y_off, cx - arr, cy + y_off);
  gfx_line(cx - arr, cy + y_off, cx - arr + head, cy + y_off - head);
  gfx_line(cx - arr, cy + y_off, cx - arr + head, cy + y_off + head);
);

function draw_arrow_shuffle(bx, by, bw, bh, s) local(cx, cy, arr, mid, y_off, head) (
  cx = bx + bw * 0.5;
  cy = by + bh * 0.5;
  arr = max(5, floor(6.5 * s));
  mid = max(2, floor(2.5 * s));
  y_off = max(3, floor(3.5 * s));
  head = max(2, floor(2.5 * s));

  // Path 1: top-left to bottom-right
  gfx_line(cx - arr, cy - y_off, cx - mid, cy - y_off);
  gfx_line(cx - mid, cy - y_off, cx + mid, cy + y_off);
  gfx_line(cx + mid, cy + y_off, cx + arr, cy + y_off);
  gfx_line(cx + arr, cy + y_off, cx + arr - head, cy + y_off - head);
  gfx_line(cx + arr, cy + y_off, cx + arr - head, cy + y_off + head);

  // Path 2: bottom-left to top-right
  gfx_line(cx - arr, cy + y_off, cx - mid, cy + y_off);
  gfx_line(cx - mid, cy + y_off, cx + mid, cy - y_off);
  gfx_line(cx + mid, cy - y_off, cx + arr, cy - y_off);
  gfx_line(cx + arr, cy - y_off, cx + arr - head, cy - y_off - head);
  gfx_line(cx + arr, cy - y_off, cx + arr - head, cy - y_off + head);
);

function format_note_name(pitch) local(oct, semi, note_ch) (
  oct = floor(pitch / 12) - 1;
  semi = pitch % 12;
  semi == 0 ? note_ch = "C" :
  semi == 1 ? note_ch = "C#" :
  semi == 2 ? note_ch = "D" :
  semi == 3 ? note_ch = "D#" :
  semi == 4 ? note_ch = "E" :
  semi == 5 ? note_ch = "F" :
  semi == 6 ? note_ch = "F#" :
  semi == 7 ? note_ch = "G" :
  semi == 8 ? note_ch = "G#" :
  semi == 9 ? note_ch = "A" :
  semi == 10 ? note_ch = "A#" : note_ch = "B";
  sprintf(#note_full_str, "%s%d", note_ch, oct);
);

function draw_arrow_left(x, y, w, h, s) local(cx, cy, arr) (
  cx = x + w * 0.5; cy = y + h * 0.5;
  arr = max(3, floor(4 * s));
  gfx_line(cx + arr, cy, cx - arr, cy);
  gfx_line(cx - arr, cy, cx, cy - arr);
  gfx_line(cx - arr, cy, cx, cy + arr);
);

function draw_arrow_right(x, y, w, h, s) local(cx, cy, arr) (
  cx = x + w * 0.5; cy = y + h * 0.5;
  arr = max(3, floor(4 * s));
  gfx_line(cx - arr, cy, cx + arr, cy);
  gfx_line(cx, cy - arr, cx + arr, cy);
  gfx_line(cx, cy + arr, cx + arr, cy);
);

function draw_note_name_centered(pitch, bx, by, bw, bh) local(oct, semi, note_ch, has_sh, n_w, n_h, o_w, o_h, spc_w, spc_h, sh_w, sh_h, p_gap, tot_w, max_h, start_x, start_y) (
  oct = floor(pitch / 12) - 1;
  semi = pitch % 12;
  semi == 0 ? ( note_ch = "C"; has_sh = 0; ) :
  semi == 1 ? ( note_ch = "C"; has_sh = 1; ) :
  semi == 2 ? ( note_ch = "D"; has_sh = 0; ) :
  semi == 3 ? ( note_ch = "D"; has_sh = 1; ) :
  semi == 4 ? ( note_ch = "E"; has_sh = 0; ) :
  semi == 5 ? ( note_ch = "F"; has_sh = 0; ) :
  semi == 6 ? ( note_ch = "F"; has_sh = 1; ) :
  semi == 7 ? ( note_ch = "G"; has_sh = 0; ) :
  semi == 8 ? ( note_ch = "G"; has_sh = 1; ) :
  semi == 9 ? ( note_ch = "A"; has_sh = 0; ) :
  semi == 10 ? ( note_ch = "A"; has_sh = 1; ) :
               ( note_ch = "B"; has_sh = 0; );

  sprintf(#note_name_str, "%s", note_ch);
  sprintf(#oct_str, "%d", oct);

  gfx_setfont(9, "Inter Light", sz_param, 0);
  gfx_measurestr(#note_name_str, n_w, n_h);
  gfx_measurestr(#oct_str, o_w, o_h);
  gfx_measurestr(" ", spc_w, spc_h);

  has_sh ? (
    gfx_measurestr("#", sh_w, sh_h);
    p_gap = max(1, floor(1.5 * scale_font));
    tot_w = n_w + p_gap + sh_w + spc_w + o_w;
    max_h = max(n_h, max(sh_h, o_h));
    start_x = bx + floor((bw - tot_w) * 0.5);
    start_y = by + floor((bh - max_h) * 0.5);

    gfx_x = start_x; gfx_y = start_y;
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    gfx_drawstr(#note_name_str);

    gfx_x = start_x + n_w + p_gap; gfx_y = start_y;
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    gfx_drawstr("#");

    gfx_x = start_x + n_w + p_gap + sh_w + spc_w; gfx_y = start_y;
    gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
    gfx_drawstr(#oct_str);
  ) : (
    tot_w = n_w + spc_w + o_w;
    max_h = max(n_h, o_h);
    start_x = bx + floor((bw - tot_w) * 0.5);
    start_y = by + floor((bh - max_h) * 0.5);

    gfx_x = start_x; gfx_y = start_y;
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
    gfx_drawstr(#note_name_str);

    gfx_x = start_x + n_w + spc_w; gfx_y = start_y;
    gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
    gfx_drawstr(#oct_str);
  );
);

function fill_roundrect(fx, fy, fw, fh, fr) local(ix, iy, iw, ih, ir) (
  ix = floor(fx);
  iy = floor(fy);
  iw = floor(fw);
  ih = floor(fh);
  ir = floor(fr);
  gfx_rect(ix + ir, iy, iw - 2 * ir, ih);
  gfx_rect(ix, iy + ir, ir, ih - 2 * ir);
  gfx_rect(ix + iw - ir, iy + ir, ir, ih - 2 * ir);
  gfx_circle(ix + ir, iy + ir, ir, 1, 1);
  gfx_circle(ix + iw - ir - 1, iy + ir, ir, 1, 1);
  gfx_circle(ix + ir, iy + ih - ir - 1, ir, 1, 1);
  gfx_circle(ix + iw - ir - 1, iy + ih - ir - 1, ir, 1, 1);
);

// Shared drawing for each MIDI meter segment.
function draw_midi_meter_segment(cx, cy, cw, ch, lit) (
  lit ? (
    gfx_r = seg_r; gfx_g = seg_g; gfx_b = seg_b;
    fill_roundrect(cx, cy, cw, ch, W(1));
    gfx_r = min(1.0, seg_r * 1.35 + 0.15);
    gfx_g = min(1.0, seg_g * 1.35 + 0.15);
    gfx_b = min(1.0, seg_b * 1.35 + 0.15);
    gfx_line(cx + 1, cy, cx + cw - 2, cy);
    gfx_r = seg_r * 0.55; gfx_g = seg_g * 0.55; gfx_b = seg_b * 0.55;
    gfx_line(cx + 1, cy + ch - 1, cx + cw - 2, cy + ch - 1);
  ) : (
    gfx_r = 16 / 255.0; gfx_g = 20 / 255.0; gfx_b = 26 / 255.0;
    fill_roundrect(cx, cy, cw, ch, W(1));
    gfx_r = 24 / 255.0; gfx_g = 28 / 255.0; gfx_b = 35 / 255.0;
    gfx_roundrect(cx, cy, cw, ch, W(1), 0);
  );
);

// Shared background for floating menus.
function draw_floating_menu_frame(mx, my, mw, mh) (
  gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.45;
  fill_roundrect(mx + W(2), my + H(2), mw, mh, W(3));
  gfx_a = 1.0;
  gfx_r = 34 / 255.0; gfx_g = 34 / 255.0; gfx_b = 38 / 255.0;
  fill_roundrect(mx, my, mw, mh, W(3));
  gfx_r = 62 / 255.0; gfx_g = 62 / 255.0; gfx_b = 68 / 255.0;
  gfx_roundrect(mx, my, mw, mh, W(3), 1);
);

function fill_left_roundrect(fx, fy, fw, fh, fr) (
  gfx_rect(fx + fr, fy, fw - fr, fh);
  gfx_rect(fx, fy + fr, fr, fh - 2 * fr);
  gfx_circle(fx + fr, fy + fr, fr, 1);
  gfx_circle(fx + fr, fy + fh - fr - 1, fr, 1);
);

function fill_right_roundrect(fx, fy, fw, fh, fr) (
  gfx_rect(fx, fy, fw - fr, fh);
  gfx_rect(fx + fw - fr, fy + fr, fr, fh - 2 * fr);
  gfx_circle(fx + fw - fr - 1, fy + fr, fr, 1);
  gfx_circle(fx + fw - fr - 1, fy + fh - fr - 1, fr, 1);
);

function draw_display_frame(bx, by, bw, bh, r, is_hov) local(gl_h, gy, ga, gx0, gx1) (
  // 1. Light reflection on bottom milled chassis edge (bezel depth)
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_a = 0.18;
  gfx_line(bx + r, by + bh, bx + bw - r, by + bh);
  gfx_a = 1.0;
  // 2. Deep black display glass background (OLED #0d0d10)
  gfx_r = 13 / 255.0; gfx_g = 13 / 255.0; gfx_b = 16 / 255.0;
  fill_roundrect(bx, by, bw, bh, r);
  // 3. Glossy glass reflection from hardware display (natural balanced calibration)
  gl_h = max(3, floor(bh * 0.44));
  gy = 1;
  while (gy <= gl_h) (
    gy == 1 ? (
      gx0 = bx + r; gx1 = bx + bw - r;
      ga = 0.14;
    ) : gy == 2 ? (
      gx0 = bx + max(1, r - 1); gx1 = bx + bw - max(1, r - 1);
      ga = 0.11;
    ) : (
      gx0 = bx + 1; gx1 = bx + bw - 1;
      ga = max(0.02, 0.09 - (gy - 2) * (0.07 / max(1, gl_h - 2)));
    );
    gfx_r = 195 / 255.0; gfx_g = 220 / 255.0; gfx_b = 245 / 255.0;
    gfx_a = ga;
    gfx_line(gx0, by + gy, gx1, by + gy);
    gy += 1;
  );
  gfx_a = 1.0;

  // 4. Top inner shadow of metallic bezel onto glass
  gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
  gfx_a = 0.50;
  gfx_line(bx + r, by + 1, bx + bw - r, by + 1);
  gfx_a = 0.25;
  gfx_line(bx + r, by + 2, bx + bw - r, by + 2);

  // 5. Left inner side shadow
  gfx_a = 0.35;
  gfx_line(bx + 1, by + r, bx + 1, by + bh - r);

  // 6. Subtle reflection along inside bottom glass edge
  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  gfx_a = 0.10;
  gfx_line(bx + r, by + bh - 1, bx + bw - r, by + bh - 1);
  gfx_a = 1.0;

  // 7. Clean outer frame border
  set_border_color(is_hov);
  gfx_roundrect(bx, by, bw, bh, r, 1);
);

function draw_text_edit_box(bx, by, bw, bh, r, font_id) local(db_w, db_h, dt_x, dt_y) (
  gfx_r = 0.12; gfx_g = 0.22; gfx_b = 0.32;
  fill_roundrect(bx, by, bw, bh, r);
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  gfx_roundrect(bx, by, bw, bh, r, 1);
  gfx_setfont(font_id);
  strcpy(#draw_buf, #edit_buf);
  gfx_measurestr(#draw_buf, db_w, db_h);
  dt_x = bx + floor((bw - db_w) * 0.5);
  dt_y = by + floor((bh - db_h) * 0.5);
  edit_first_key ? (
    gfx_r = 0.22; gfx_g = 0.45; gfx_b = 0.75;
    gfx_rect(dt_x - 2, dt_y - 1, db_w + 4, db_h + 2);
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  ) : (
    (time_precise() * 2) % 1 < 0.5 ? strcat(#draw_buf, "|");
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  );
  gfx_x = dt_x; gfx_y = dt_y;
  gfx_drawstr(#draw_buf);
);

function draw_display_pitch(bx, by, bw, bh, r, is_hov, is_editing, pitch) (
  is_editing ? (
    draw_text_edit_box(bx, by, bw, bh, r, 9);
  ) : (
    draw_display_frame(bx, by, bw, bh, r, is_hov);
    draw_note_name_centered(pitch, bx, by, bw, bh);
  );
);

function draw_display_val(bx, by, bw, bh, r, is_hov, is_editing, font_id, val_str, val_r, val_g, val_b, y_off) local(v_w, v_h) (
  is_editing ? (
    draw_text_edit_box(bx, by, bw, bh, r, font_id);
  ) : (
    draw_display_frame(bx, by, bw, bh, r, is_hov);
    font_id == 10 ? gfx_setfont(10, "Inter", sz_main, 0) :
    font_id == 8  ? gfx_setfont(8, "Inter", sz_btn, 0) :
    font_id == 9  ? gfx_setfont(9, "Inter Light", sz_param, 0) :
                    gfx_setfont(font_id);
    gfx_measurestr(val_str, v_w, v_h);
    gfx_r = val_r; gfx_g = val_g; gfx_b = val_b;
    gfx_x = bx + floor((bw - v_w) * 0.5);
    gfx_y = by + floor((bh - v_h) * 0.5) + y_off;
    gfx_drawstr(val_str);
  );
);

function draw_display_scale(bx, by, bw, bh, r, is_hov, scale_str) local(str_w, str_h, f_id) (
  draw_display_frame(bx, by, bw, bh, r, is_hov);
  f_id = 8;
  gfx_setfont(f_id, "Inter", sz_btn, 0);
  gfx_measurestr(scale_str, str_w, str_h);
  str_w > (bw - W(8)) ? (
    f_id = 3;
    gfx_setfont(f_id, "Inter", sz_sub, 'B');
    gfx_measurestr(scale_str, str_w, str_h);
  );
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  gfx_x = bx + floor((bw - str_w) * 0.5) + max(1, floor(1 * sx));
  gfx_y = by + floor((bh - str_h) * 0.5) + max(1, floor(1 * sy));
  gfx_drawstr(scale_str);
);

function draw_display_lfo_wave(bx, by, bw, bh, r, is_hov, tr_idx) local(is_dst_on, is_retrig, last_dst, is_active, is_sync, r_beats, cur_t, cur_b, raw_ph, ph_anim, am_scale, pol) (
  draw_display_frame(bx, by, bw, bh, r, is_hov);

  get_track_color(tr_idx);
  is_hov ? (
    gfx_r = min(1.0, cr * 1.25); gfx_g = min(1.0, cg * 1.25); gfx_b = min(1.0, cb * 1.25);
  ) : (
    gfx_r = cr; gfx_g = cg; gfx_b = cb;
  );

  is_dst_on = (4600[tr_idx] != 0);
  is_retrig = 4580[tr_idx];

  last_dst = 4770[tr_idx];
  (last_dst == 0 && is_dst_on) ? (
    4780[tr_idx] = time_precise();
    4790[tr_idx] = 4780[tr_idx] * (tempo / 60.0);
  );
  4770[tr_idx] = 4600[tr_idx];

  is_active = is_dst_on && (!is_retrig || is_playing_transport);
  is_active ? (
    is_sync = 4520[tr_idx];
    r_beats = is_sync ? get_lfo_sync_beats(4540[tr_idx], 4700[tr_idx]) : 2.0;
    r_beats <= 0 ? r_beats = 2.0;

    !is_retrig ? (
      cur_t = max(0.0, time_precise() - 4780[tr_idx]);
      cur_b = max(0.0, time_precise() * (tempo / 60.0) - 4790[tr_idx]);
    ) : (
      cur_t = play_position;
      cur_b = gfx_cur_beat;
    );

    raw_ph = is_sync ? (cur_b / r_beats) : (cur_t * 4560[tr_idx]);
    ph_anim = raw_ph;
  ) : (
    ph_anim = 0.0;
  );

  am_scale = is_dst_on ? (min(100, max(0, 4620[tr_idx])) / 100.0) : 1.0;
  pol = 4760[tr_idx];

  draw_lfo_wave_icon(4500[tr_idx], bx, by, bw, bh, scale_font, ph_anim, am_scale, pol);
);

function draw_display_play_mode(bx, by, bw, bh, r, is_hov, mode, cr, cg, cb, scale_f) (
  draw_display_frame(bx, by, bw, bh, r, is_hov);

  is_hov ? (
    gfx_r = min(1.0, cr * 1.30); gfx_g = min(1.0, cg * 1.30); gfx_b = min(1.0, cb * 1.30);
  ) : (
    gfx_r = cr; gfx_g = cg; gfx_b = cb;
  );

  mode == 0 ? (
    draw_arrow_forward(bx, by, bw, bh, scale_f);
  ) :
  mode == 1 ? (
    draw_arrow_backward(bx, by, bw, bh, scale_f);
  ) :
  mode == 2 ? (
    draw_arrow_pingpong(bx, by, bw, bh, scale_f);
  ) : (
    draw_arrow_shuffle(bx, by, bw, bh, scale_f);
  );
);

function draw_display_labeled(bx, by, bw, bh, r, is_hov, is_editing, is_disabled, font_id, lbl_str, val_str, lbl_r, lbl_g, lbl_b, val_r, val_g, val_b) local(l_w, l_h, v_w, v_h, gap, tot_w, start_x, start_y) (
  is_editing ? (
    draw_text_edit_box(bx, by, bw, bh, r, font_id);
  ) : (
    is_disabled ? (
      // Disabled state
      gfx_r = 0.12; gfx_g = 0.12; gfx_b = 0.14;
      fill_roundrect(bx, by, bw, bh, r);
      gfx_r = 48 / 255.0; gfx_g = 48 / 255.0; gfx_b = 48 / 255.0;
      gfx_roundrect(bx, by, bw, bh, r, 1);
    ) : (
      draw_display_frame(bx, by, bw, bh, r, is_hov);
    );

    gfx_setfont(font_id, "Inter Light", sz_param, 0);
    gfx_measurestr(lbl_str, l_w, l_h);
    gfx_measurestr(val_str, v_w, v_h);
    gap = max(3, floor(3.5 * scale_font));
    tot_w = l_w + gap + v_w;
    start_x = bx + floor((bw - tot_w) * 0.5);
    start_y = by + floor((bh - max(l_h, v_h)) * 0.5);

    is_disabled ? (
      gfx_r = 100 / 255.0; gfx_g = 100 / 255.0; gfx_b = 100 / 255.0;
    ) : (
      gfx_r = lbl_r; gfx_g = lbl_g; gfx_b = lbl_b;
    );
    gfx_x = start_x; gfx_y = start_y;
    gfx_drawstr(lbl_str);

    is_disabled ? (
      gfx_r = 100 / 255.0; gfx_g = 100 / 255.0; gfx_b = 100 / 255.0;
    ) : (
      gfx_r = val_r; gfx_g = val_g; gfx_b = val_b;
    );
    gfx_x = start_x + l_w + gap; gfx_y = start_y;
    gfx_drawstr(val_str);
  );
);

function draw_button(bx, by, bw, bh, r, btn_text, font_id, is_active, is_pressed, is_hov, is_disabled, act_r, act_g, act_b, x_off) local(lbl_w, lbl_h, p_off) (
  is_disabled ? (
    gfx_r = 0.08; gfx_g = 0.08; gfx_b = 0.10;
    fill_roundrect(bx, by, bw, bh, r);
    gfx_r = 34 / 255.0; gfx_g = 34 / 255.0; gfx_b = 38 / 255.0;
    gfx_roundrect(bx, by, bw, bh, r, 1);
  ) :
  is_active ? (
    gfx_r = is_hov ? 0.13 : 0.10; gfx_g = gfx_r; gfx_b = gfx_r + 0.01;
    fill_roundrect(bx, by, bw, bh, r);
    gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.35;
    gfx_line(bx + r, by + 1, bx + bw - r, by + 1);
    gfx_line(bx + max(1, r - 1), by + 2, bx + bw - max(1, r - 1), by + 2);
    gfx_a = 1.0;
    gfx_r = 34 / 255.0; gfx_g = 34 / 255.0; gfx_b = 38 / 255.0;
    gfx_roundrect(bx, by, bw, bh, r, 1);
  ) :
  is_pressed ? (
    gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
    fill_roundrect(bx, by, bw, bh, r);
    gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.40;
    gfx_line(bx + r, by + 1, bx + bw - r, by + 1);
    gfx_a = 1.0;
    gfx_r = 34 / 255.0; gfx_g = 34 / 255.0; gfx_b = 38 / 255.0;
    gfx_roundrect(bx, by, bw, bh, r, 1);
  ) : (
    gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.45;
    gfx_line(bx + max(1, r - 1), by + bh, bx + bw - max(1, r - 1), by + bh);
    gfx_a = 1.0;
    gfx_r = is_hov ? 0.15 : 0.11; gfx_g = gfx_r; gfx_b = gfx_r + 0.02;
    fill_roundrect(bx, by, bw, bh, r);
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_a = 0.22;
    gfx_line(bx + r, by + 1, bx + bw - r, by + 1);
    gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.50;
    gfx_line(bx + max(1, r - 1), by + bh - 1, bx + bw - max(1, r - 1), by + bh - 1);
    gfx_a = 1.0;
    gfx_r = 34 / 255.0; gfx_g = 34 / 255.0; gfx_b = 38 / 255.0;
    gfx_roundrect(bx, by, bw, bh, r, 1);
  );
  gfx_setfont(font_id, "Inter", sz_btn, 0);
  gfx_measurestr(btn_text, lbl_w, lbl_h);
  is_disabled ? (
    gfx_r = 90 / 255.0; gfx_g = 90 / 255.0; gfx_b = 95 / 255.0;
  ) : (is_active || is_pressed) ? (
    gfx_r = act_r; gfx_g = act_g; gfx_b = act_b;
  ) : (
    gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
  );
  p_off = (is_active || is_pressed) ? max(1, floor(1 * sy)) : 0;
  gfx_x = bx + floor((bw - lbl_w) * 0.5) + x_off;
  gfx_y = by + floor((bh - lbl_h) * 0.5) + sb_txt_y_off + p_off;
  gfx_drawstr(btn_text);
);

function draw_color_button(bx, by, bw, bh, r, btn_text, font_id, is_pressed, is_hov, cr, cg, cb, x_off) local(lbl_w, lbl_h, p_off, r_alpha) (
  is_pressed ? (
    r_alpha = 0.65;
    gfx_r = cr * r_alpha; gfx_g = cg * r_alpha; gfx_b = cb * r_alpha;
    fill_roundrect(bx, by, bw, bh, r);
    // Inner shadow at top for sunken 3D look
    gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.40;
    gfx_line(bx + r, by + 1, bx + bw - r, by + 1);
    gfx_line(bx + max(1, r - 1), by + 2, bx + bw - max(1, r - 1), by + 2);
    gfx_a = 1.0;
    gfx_r = cr * 0.50; gfx_g = cg * 0.50; gfx_b = cb * 0.50;
    gfx_roundrect(bx, by, bw, bh, r, 1);
  ) : (
    gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.45;
    gfx_line(bx + max(1, r - 1), by + bh, bx + bw - max(1, r - 1), by + bh);
    gfx_a = 1.0;
    r_alpha = is_hov ? 1.0 : 0.85;
    gfx_r = cr * r_alpha; gfx_g = cg * r_alpha; gfx_b = cb * r_alpha;
    fill_roundrect(bx, by, bw, bh, r);
    // Highlight bevel on top edge (3D relief)
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_a = 0.28;
    gfx_line(bx + r, by + 1, bx + bw - r, by + 1);
    // Dark bevel on bottom edge
    gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0; gfx_a = 0.45;
    gfx_line(bx + max(1, r - 1), by + bh - 1, bx + bw - max(1, r - 1), by + bh - 1);
    gfx_a = 1.0;
    gfx_r = 34 / 255.0; gfx_g = 34 / 255.0; gfx_b = 38 / 255.0;
    gfx_roundrect(bx, by, bw, bh, r, 1);
  );
  gfx_setfont(font_id, "Inter", sz_q, 'B');
  gfx_measurestr(btn_text, lbl_w, lbl_h);
  p_off = is_pressed ? max(1, floor(1 * sy)) : 0;
  gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
  gfx_x = bx + floor((bw - lbl_w) * 0.5) + x_off;
  gfx_y = by + floor((bh - lbl_h) * 0.5) + p_off;
  gfx_drawstr(btn_text);
);

midi_evt_count = 0;
MIDI_EVENT_BASE = 700000; // Four consecutive slots per event, separate from pattern memory
MIDI_EVENT_CAPACITY = 4096;
midi_evt_overflow = 0;

// Buffer events for the current audio block so they can be ordered before sending.
// If the buffer fills, silence all channels after flushing the retained events.
function emit_midi(m_samp, m_m1, m_m2, m_m3) local(idx) (
  m_samp = max(0, min(samplesblock - 1, m_samp));
  (midi_evt_count < MIDI_EVENT_CAPACITY) ? (
    idx = MIDI_EVENT_BASE + midi_evt_count * 4;
    idx[0] = m_samp;
    idx[1] = m_m1;
    idx[2] = m_m2;
    idx[3] = m_m3;
    midi_evt_count += 1;
  ) : (
    midi_evt_overflow = 1;
  );
);

function flush_midi_sorted() local(i, j, idx, prev, s_key, t_samp, t_m1, t_m2, t_m3, ch) (
  // Guaranteed chronological sorting: Note-Off (0x80) before Note-On (0x90) at identical sample
  i = 1;
  while (i < midi_evt_count) (
    idx = MIDI_EVENT_BASE + i * 4;
    t_samp = idx[0];
    t_m1   = idx[1];
    t_m2   = idx[2];
    t_m3   = idx[3];
    s_key  = t_samp * 256 + (t_m1 & 0xF0);

    j = i - 1;
    prev = MIDI_EVENT_BASE + j * 4;
    while (j >= 0 && (prev[0] * 256 + (prev[1] & 0xF0)) > s_key) (
      prev[4] = prev[0];
      prev[5] = prev[1];
      prev[6] = prev[2];
      prev[7] = prev[3];
      j -= 1;
      prev -= 4;
    );
    prev[4] = t_samp;
    prev[5] = t_m1;
    prev[6] = t_m2;
    prev[7] = t_m3;
    i += 1;
  );

  i = 0;
  while (i < midi_evt_count) (
    idx = MIDI_EVENT_BASE + i * 4;
    midisend(idx[0], idx[1], idx[2], idx[3]);
    i += 1;
  );
  midi_evt_overflow ? (
    ch = 0;
    while (ch < 16) (
      midisend(samplesblock - 1, 0xB0 + ch, 123, 0);
      midisend(samplesblock - 1, 0xB0 + ch, 120, 0);
      ch += 1;
    );
    midi_evt_overflow = 0;
  );
  midi_evt_count = 0;
);

// Send pan before the note when possible, and avoid repeating an unchanged value.
function send_pan_if_changed(s_sample, s_ch, s_pan, s_tr) local(p_sample, c_i) (
  (s_tr >= 0 && 1880[s_tr] != s_pan) ? (
    p_sample = max(0, s_sample - 1);
    s_ch == 0 ? (
      c_i = 0; while (c_i < 16) (
        emit_midi(p_sample, 0xB0 + c_i, 10, s_pan);
        c_i += 1;
      );
    ) : (
      emit_midi(p_sample, 0xB0 + (s_ch - 1), 10, s_pan);
    );
    1880[s_tr] = s_pan;
  );
);

function send_note_on(s_sample, s_pitch, s_ch, s_vel) local(c_i) (
  s_ch == 0 ? (
    c_i = 0; while (c_i < 16) (
      emit_midi(s_sample, 0x90 + c_i, s_pitch, s_vel);
      c_i += 1;
    );
  ) : (
    emit_midi(s_sample, 0x90 + (s_ch - 1), s_pitch, s_vel);
  );
);

function send_note_off(s_sample, s_pitch, s_ch) local(c_i) (
  s_ch == 0 ? (
    c_i = 0; while (c_i < 16) (
      emit_midi(s_sample, 0x80 + c_i, s_pitch, 0);
      c_i += 1;
    );
  ) : (
    emit_midi(s_sample, 0x80 + (s_ch - 1), s_pitch, 0);
  );
);

// Commit keyboard typed values
function commit_param_edit() local(
  val, p_semi, p_oct, has_val, is_neg, has_sign,
  c0, b_len, cur_semi, new_oct, next_idx, c1, c_oct,
  is_div, r_val, s_len, n_idx, found_d, ch, best_diff, d, tie_count, closest_num,
  cur_l, new_val, c_i, f_val, d_val, tr_val, diff_oct, diff_semi, step_dir, ti,
  c_inv, r_a, r_b
) (
  strlen(#edit_buf) > 0 && ((edit_tr >= 0 && edit_tr < NUM_TRACKS) || edit_active == 11) ? (
    undo_push();

    // 1: Channel (0..16, 0 = ALL)
    edit_active == 1 ? (
      matchi("*ALL*", #edit_buf) ? (
        1620[edit_tr] = 0;
      ) : (
        match("%d", #edit_buf, val) ? (
          1620[edit_tr] = min(16, max(0, val));
        );
      );
    ) :

    // 2: Pitch (24..108, support MIDI number, note name, or single-digit octave change)
    edit_active == 2 ? (
      c0 = str_getchar(#edit_buf, 0);
      c0 >= 'a' && c0 <= 'z' ? c0 -= 32;

      b_len = strlen(#edit_buf);

      // Single digit (0..8) changes octave while preserving note
      (b_len == 1 && c0 >= '0' && c0 <= '8') ? (
        cur_semi = 1600[edit_tr] % 12;
        new_oct = c0 - '0';
        1600[edit_tr] = min(108, max(24, (new_oct + 1) * 12 + cur_semi));
      ) :

      // 2+ digits: parse as MIDI note number
      (c0 >= '0' && c0 <= '9') ? (
        match("%d", #edit_buf, val) ? (
          1600[edit_tr] = min(108, max(24, val));
        );
      ) : (
        p_semi = -1;
        p_oct = floor(1600[edit_tr] / 12) - 1;
        next_idx = 1;

        // Solfege note names
        matchi("DO*", #edit_buf) ? ( p_semi = 0; next_idx = 2; ) :
        matchi("RE*", #edit_buf) ? ( p_semi = 2; next_idx = 2; ) :
        matchi("MI*", #edit_buf) ? ( p_semi = 4; next_idx = 2; ) :
        matchi("FA*", #edit_buf) ? ( p_semi = 5; next_idx = 2; ) :
        matchi("SOL*", #edit_buf) ? ( p_semi = 7; next_idx = 3; ) :
        matchi("LA*", #edit_buf) ? ( p_semi = 9; next_idx = 2; ) :
        matchi("SI*", #edit_buf) ? ( p_semi = 11; next_idx = 2; ) :
        // Standard note names
        c0 == 'C' ? ( p_semi = 0; next_idx = 1; ) :
        c0 == 'D' ? ( p_semi = 2; next_idx = 1; ) :
        c0 == 'E' ? ( p_semi = 4; next_idx = 1; ) :
        c0 == 'F' ? ( p_semi = 5; next_idx = 1; ) :
        c0 == 'G' ? ( p_semi = 7; next_idx = 1; ) :
        c0 == 'A' ? ( p_semi = 9; next_idx = 1; ) :
        c0 == 'B' ? ( p_semi = 11; next_idx = 1; ) : 0;

        p_semi >= 0 ? (
          c1 = str_getchar(#edit_buf, next_idx);
          // Sharp (#, +, s, S, £)
          (c1 == '#' || c1 == '+' || c1 == 's' || c1 == 'S' || c1 == 163) ? (
            p_semi = (p_semi + 1) % 12;
            next_idx += 1;
          ) :
          // Flat (b, -)
          (c1 == 'b' || c1 == '-') ? (
            p_semi = (p_semi + 11) % 12;
            next_idx += 1;
          );

          // Octave (0..8)
          c_oct = str_getchar(#edit_buf, next_idx);
          (c_oct >= '0' && c_oct <= '8') ? (
            p_oct = c_oct - '0';
          );

          1600[edit_tr] = min(108, max(24, (p_oct + 1) * 12 + p_semi));
        );
      );
    ) :

    // 3: Rate (0..10: /16..x16) with nearest match or rejection on ties
    edit_active == 3 ? (
      is_div = match("/*", #edit_buf) || match("-*", #edit_buf);
      r_val = -1;
      s_len = strlen(#edit_buf);
      n_idx = 0;
      found_d = -1;
      while (n_idx < s_len && found_d < 0) (
        ch = str_getchar(#edit_buf, n_idx);
        (ch >= '0' && ch <= '9') ? (
          found_d = n_idx;
        );
        n_idx += 1;
      );
      found_d >= 0 ? (
        strcpy_substr(#sub_num, #edit_buf, found_d, s_len - found_d);
        match("%d", #sub_num, r_val);
      );

      r_val > 0 ? (
        best_diff = 999;
        !is_div ? (
          d = abs(r_val - 1); d < best_diff ? best_diff = d;
        );
        d = abs(r_val - 2);  d < best_diff ? best_diff = d;
        d = abs(r_val - 4);  d < best_diff ? best_diff = d;
        d = abs(r_val - 8);  d < best_diff ? best_diff = d;
        d = abs(r_val - 12); d < best_diff ? best_diff = d;
        d = abs(r_val - 16); d < best_diff ? best_diff = d;

        tie_count = 0;
        closest_num = -1;
        !is_div ? (
          abs(r_val - 1) == best_diff ? ( tie_count += 1; closest_num = 1; );
        );
        abs(r_val - 2) == best_diff ? ( tie_count += 1; closest_num = 2; );
        abs(r_val - 4) == best_diff ? ( tie_count += 1; closest_num = 4; );
        abs(r_val - 8) == best_diff ? ( tie_count += 1; closest_num = 8; );
        abs(r_val - 12) == best_diff ? ( tie_count += 1; closest_num = 12; );
        abs(r_val - 16) == best_diff ? ( tie_count += 1; closest_num = 16; );
        // If tied, reject and keep current value
        tie_count == 1 ? (
          is_div ? (
            closest_num == 16 ? 1640[edit_tr] = 0 :
            closest_num == 12 ? 1640[edit_tr] = 1 :
            closest_num == 8  ? 1640[edit_tr] = 2 :
            closest_num == 4  ? 1640[edit_tr] = 3 :
            closest_num == 2  ? 1640[edit_tr] = 4 : 0;
          ) : (
            closest_num == 1  ? 1640[edit_tr] = 5 :
            closest_num == 2  ? 1640[edit_tr] = 6 :
            closest_num == 4  ? 1640[edit_tr] = 7 :
            closest_num == 8  ? 1640[edit_tr] = 8 :
            closest_num == 12 ? 1640[edit_tr] = 9 :
            closest_num == 16 ? 1640[edit_tr] = 10 : 0;
          );
        );
      );
    ) :

    // 4: Length (1..64)
    edit_active == 4 ? (
      match("%d", #edit_buf, val) ? (
        1660[edit_tr] = min(64, max(1, val));
        1860[edit_tr] > 1660[edit_tr] ? 1860[edit_tr] = 1660[edit_tr];
        (euc_mode && 1860[edit_tr] > 0) ? apply_euclidean_track(edit_tr);
      );
    ) :

    // 5: Slot A (Volume if 2100==0, Density if 2100==1)
    edit_active == 5 ? (
      match("%d", #edit_buf, val) ? (
        2100[edit_tr] == 0 ? (
          1940[edit_tr] = min(100, max(0, val));
        ) : (
          1720[edit_tr] = min(100, max(0, val));
        );
      );
    ) :

    // 6: Slot B (Swing if 2140==0, Pan if 2140==1, Gate if 2140==2)
    edit_active == 6 ? (
      is_neg = match("-*", #edit_buf);
      has_sign = is_neg || match("+*", #edit_buf);
      has_sign ? (
        strcpy_substr(#clean_buf, #edit_buf, 1, strlen(#edit_buf) - 1);
        has_val = match("%d", #clean_buf, val);
        is_neg ? val = -val;
      ) : (
        has_val = match("%d", #edit_buf, val);
      );
      has_val ? (
        val = min(100, max(-100, val));
        2140[edit_tr] == 2 ? (
          2160[edit_tr] = val;
        ) : 2140[edit_tr] == 1 ? (
          2120[edit_tr] = val;
        ) : (
          1740[edit_tr] = val;
        );
      );
    ) :

    // 7: Fill (0..Length, active when Euclidean mode is on)
    edit_active == 7 ? (
      match("%d", #edit_buf, val) ? (
        cur_l = 1660[edit_tr];
        cur_l <= 0 ? cur_l = 16;
        cur_l > 64 ? cur_l = 64;
        1860[edit_tr] = min(cur_l, max(0, val));
        euc_mode ? apply_euclidean_track(edit_tr);
      );
    ) :
    edit_active == 8 ? (
      match("%d", #edit_buf, val) ? (
        4620[edit_tr] = min(100, max(0, val));
      );
    ) :
    edit_active == 9 ? (
      c_i = 0;
      b_len = strlen(#edit_buf);
      while (c_i < b_len) (
        str_getchar(#edit_buf, c_i) == ',' ? str_setchar(#edit_buf, c_i, '.');
        c_i += 1;
      );
      match("%f", #edit_buf, f_val) ? (
        4560[edit_tr] = min(20.0, max(0.01, floor(f_val * 100 + 0.5) / 100.0));
      ) :
      match("%d", #edit_buf, d_val) ? (
        4560[edit_tr] = min(20.0, max(0.01, d_val * 1.0));
      );
    ) :
    edit_active == 10 ? (
      tr_val = -1;
      matchi("T*%d", #edit_buf, tr_val) ? 0 :
      match("%d", #edit_buf, tr_val) ? 0 : (
        match("*%d", #edit_buf, tr_val);
      );
      tr_val > 0 ? (
        lfo_cur_tr = min(NUM_TRACKS - 1, max(0, tr_val - 1));
      );
    ) :
    edit_active == 11 ? (
      c0 = str_getchar(#edit_buf, 0);
      c0 >= 'a' && c0 <= 'z' ? c0 -= 32;

      p_semi = -1;
      next_idx = 1;

      // Solfege note names
      matchi("DO*", #edit_buf) ? ( p_semi = 0; next_idx = 2; ) :
      matchi("RE*", #edit_buf) ? ( p_semi = 2; next_idx = 2; ) :
      matchi("MI*", #edit_buf) ? ( p_semi = 4; next_idx = 2; ) :
      matchi("FA*", #edit_buf) ? ( p_semi = 5; next_idx = 2; ) :
      matchi("SOL*", #edit_buf) ? ( p_semi = 7; next_idx = 3; ) :
      matchi("LA*", #edit_buf) ? ( p_semi = 9; next_idx = 2; ) :
      matchi("SI*", #edit_buf) ? ( p_semi = 11; next_idx = 2; ) :
      // Standard note names
      c0 == 'C' ? ( p_semi = 0; next_idx = 1; ) :
      c0 == 'D' ? ( p_semi = 2; next_idx = 1; ) :
      c0 == 'E' ? ( p_semi = 4; next_idx = 1; ) :
      c0 == 'F' ? ( p_semi = 5; next_idx = 1; ) :
      c0 == 'G' ? ( p_semi = 7; next_idx = 1; ) :
      c0 == 'A' ? ( p_semi = 9; next_idx = 1; ) :
      c0 == 'B' ? ( p_semi = 11; next_idx = 1; ) :
      // Numeric pitch
      (c0 >= '0' && c0 <= '9') ? (
        match("%d", #edit_buf, val) ? (
          p_semi = (val % 12 + 12) % 12;
        );
      );
      p_semi >= 0 ? (
        c1 = str_getchar(#edit_buf, next_idx);
        // Sharp (#, +, s, S, £)
        (c1 == '#' || c1 == '+' || c1 == 's' || c1 == 'S' || c1 == 163) ? (
          p_semi = (p_semi + 1) % 12;
        ) :
        // Flat (b, -)
        (c1 == '-' || c1 == 'b') ? (
          p_semi = (p_semi + 11) % 12;
        );
        set_quant_root(p_semi);
      );
    ) :
    edit_active == 12 ? (
      is_neg = match("-*", #edit_buf);
      has_sign = is_neg || match("+*", #edit_buf);
      has_sign ? (
        strcpy_substr(#clean_buf, #edit_buf, 1, strlen(#edit_buf) - 1);
        has_val = match("%d", #clean_buf, val);
        is_neg ? val = -val;
      ) : (
        has_val = match("%d", #edit_buf, val);
      );
      has_val ? (
        val = min(floor((48 - global_semi_offset) / 12), max(ceil((-36 - global_semi_offset) / 12), val));
        diff_oct = val - global_oct_offset;
        diff_oct != 0 ? (
          undo_push();
          while (diff_oct != 0) (
            step_dir = diff_oct > 0 ? 1 : -1;
            ti = 0;
            while (ti < NUM_TRACKS) (
              1600[ti] = get_next_scale_octave(1600[ti], step_dir);
              ti += 1;
            );
            global_oct_offset += step_dir;
            diff_oct -= step_dir;
          );
          save_pattern_to_mem(active_edit_pat);
        );
      );
    ) :
    edit_active == 13 ? (
      is_neg = match("-*", #edit_buf);
      has_sign = is_neg || match("+*", #edit_buf);
      has_sign ? (
        strcpy_substr(#clean_buf, #edit_buf, 1, strlen(#edit_buf) - 1);
        has_val = match("%d", #clean_buf, val);
        is_neg ? val = -val;
      ) : (
        has_val = match("%d", #edit_buf, val);
      );
      has_val ? (
        val = min(48, max(-36, val));
        diff_semi = val - global_semi_offset;
        diff_semi != 0 ? (
          undo_push();
          while (diff_semi != 0) (
            step_dir = diff_semi > 0 ? 1 : -1;
            ti = 0;
            while (ti < NUM_TRACKS) (
              1600[ti] = get_next_scale_pitch(1600[ti], step_dir);
              ti += 1;
            );
            global_semi_offset += step_dir;
            diff_semi -= step_dir;
          );
          save_pattern_to_mem(active_edit_pat);
        );
      );
    );
    edit_active == 14 ? (
      is_neg = match("-*", #edit_buf);
      has_sign = is_neg || match("+*", #edit_buf);
      has_sign ? (
        strcpy_substr(#clean_buf, #edit_buf, 1, strlen(#edit_buf) - 1);
        has_val = match("%d", #clean_buf, val);
        is_neg ? val = -val;
      ) : (
        has_val = match("%d", #edit_buf, val);
      );
      has_val ? (
        master_gate = min(100, max(-100, val));
      );
    ) :
    edit_active == 15 ? (
      is_neg = match("-*", #edit_buf);
      has_sign = is_neg || match("+*", #edit_buf);
      has_sign ? (
        strcpy_substr(#clean_buf, #edit_buf, 1, strlen(#edit_buf) - 1);
        has_val = match("%d", #clean_buf, val);
        is_neg ? val = -val;
      ) : (
        has_val = match("%d", #edit_buf, val);
      );
      has_val ? (
        diff_len = val - master_len_offset;
        diff_len != 0 ? (
          modify_master_len(diff_len);
        );
      );
    ) :
    edit_active == 16 ? (
      is_neg = match("-*", #edit_buf);
      has_sign = is_neg || match("+*", #edit_buf);
      has_sign ? (
        strcpy_substr(#clean_buf, #edit_buf, 1, strlen(#edit_buf) - 1);
        has_val = match("%d", #clean_buf, val);
        is_neg ? val = -val;
      ) : (
        has_val = match("%d", #edit_buf, val);
      );
      has_val ? (
        diff_sw = val - master_swing;
        diff_sw != 0 ? (
          modify_master_swing(diff_sw);
        );
      );
    ) :
    edit_active == 17 ? (
      match("%d", #edit_buf, val) ? (
        master_density = min(100, max(0, val));
      );
    ) :
    // 18: Step Velocity (1..127)
    edit_active == 18 ? (
      match("%d", #edit_buf, val) ? (
        12000[edit_step_offset] = min(127, max(1, val));
      );
    ) :
    // 19: Step Gate (0.125, 0.25, 0.5, 0.75, 1..64, INF, LEG)
    edit_active == 19 ? (
      matchi("I*", #edit_buf) ? (
        16000[edit_step_offset] = 68;   // "i" / "inf"
      ) : matchi("L*", #edit_buf) ? (
        16000[edit_step_offset] = 69;   // "l" / "leg"
      ) : (
        c_i = 0;
        b_len = strlen(#edit_buf);
        while (c_i < b_len) (
          str_getchar(#edit_buf, c_i) == ',' ? str_setchar(#edit_buf, c_i, '.');
          c_i += 1;
        );
        match("%f", #edit_buf, f_val) ? (
          abs(f_val - 0.125) < 0.001 ? 16000[edit_step_offset] = 0 :
          abs(f_val - 0.25)  < 0.001 ? 16000[edit_step_offset] = 1 :
          abs(f_val - 0.5)   < 0.001 ? 16000[edit_step_offset] = 2 :
          abs(f_val - 0.75)  < 0.001 ? 16000[edit_step_offset] = 3 :
          (f_val >= 1 && f_val <= 64) ? 16000[edit_step_offset] = min(67, max(4, floor(f_val + 0.5) + 3));
        ) : (
          match("%d", #edit_buf, val) ? (
            val >= 1 && val <= 64 ? 16000[edit_step_offset] = val + 3;
          );
        );
      );
    ) :
    // 20: Step Pan (-64..+63, 0 = center)
    edit_active == 20 ? (
      is_neg = match("-*", #edit_buf);
      has_sign = is_neg || match("+*", #edit_buf);
      has_sign ? (
        strcpy_substr(#clean_buf, #edit_buf, 1, strlen(#edit_buf) - 1);
        has_val = match("%d", #clean_buf, val);
        is_neg ? val = -val;
      ) : (
        has_val = match("%d", #edit_buf, val);
      );
      has_val ? 14000[edit_step_offset] = min(127, max(0, 64 + val));
    ) :
    // 21: Step Timing (-50..+50%)
    edit_active == 21 ? (
      is_neg = match("-*", #edit_buf);
      has_sign = is_neg || match("+*", #edit_buf);
      has_sign ? (
        strcpy_substr(#clean_buf, #edit_buf, 1, strlen(#edit_buf) - 1);
        has_val = match("%d", #clean_buf, val);
        is_neg ? val = -val;
      ) : (
        has_val = match("%d", #edit_buf, val);
      );
      has_val ? 18000[edit_step_offset] = min(50, max(-50, val));
    ) :
    // 22: Step Ratcheting (1..4)
    edit_active == 22 ? (
      match("%d", #edit_buf, val) ? 20000[edit_step_offset] = min(4, max(1, val));
    ) :
    // 23: Step Chance (0..100%)
    edit_active == 23 ? (
      match("%d", #edit_buf, val) ? 22000[edit_step_offset] = min(100, max(0, val));
    ) :
    // 24: Step Condition. Accepts: index (0..280), ratio "a:b", or letters (a leading "/" = inverse):
    //   compact ratios "34" = 3:4, "1316" = 13:16; s = 1ST, p = PRE, n = NEI,
    //   f2 / f4 / f8 / f16 (+ "/" for inverse), f = f2, - = ---
    edit_active == 24 ? (
      c_inv = (str_getchar(#edit_buf, 0) == '/') ? 1 : 0;
      c_inv ? strcpy_substr(#cond_buf, #edit_buf, 1, strlen(#edit_buf) - 1) : strcpy(#cond_buf, #edit_buf);
      c0 = str_getchar(#cond_buf, 0);
      c0 >= 'A' && c0 <= 'Z' ? c0 += 32;
      n_idx = -1;

      (c0 == '1' && matchi("1ST*", #cond_buf)) ? (
        n_idx = 36 + c_inv;
      ) : (c0 >= '0' && c0 <= '9') ? (
        match("%d:%d", #cond_buf, r_a, r_b) ? (
          (r_b >= 2 && r_b <= 16 && r_a >= 1 && r_a <= r_b) ? n_idx = cond_ratio_id(r_a, r_b, c_inv);
        ) : (
          // Prefer valid compact ratios; otherwise retain plain-index input.
          r_a = str_getchar(#cond_buf, 0) - '0';
          r_b = str_getchar(#cond_buf, 1) - '0';
          c_len = strlen(#cond_buf);
          c_len >= 3 && c_len <= 4 ? (
            strcpy_substr(#clean_buf, #cond_buf, 0, c_len - 2);
            match("%d", #clean_buf, r_a);
            strcpy_substr(#clean_buf, #cond_buf, c_len - 2, 2);
            match("%d", #clean_buf, r_b);
          );
          ((c_len == 2 && r_b >= 2 && r_b <= 9) ||
           (c_len >= 3 && c_len <= 4 && r_b >= 10 && r_b <= 16)) &&
          r_a >= 1 && r_a <= r_b ? (
            n_idx = cond_ratio_id(r_a, r_b, c_inv);
          ) : (
            match("%d", #cond_buf, val) ? n_idx = min(280, max(0, val));
          );
        );
      ) : c0 == '-' ? (
        n_idx = 0;
      ) : c0 == 's' ? (
        n_idx = 36 + c_inv;
      ) : c0 == 'p' ? (
        n_idx = 38 + c_inv;
      ) : c0 == 'n' ? (
        n_idx = 40 + c_inv;
      ) : c0 == 'f' ? (
        d_val = 2;
        c_i = 1;
        b_len = strlen(#cond_buf);
        while (c_i < b_len && (str_getchar(#cond_buf, c_i) < '0' || str_getchar(#cond_buf, c_i) > '9')) (
          c_i += 1;
        );
        c_i < b_len ? (
          strcpy_substr(#clean_buf, #cond_buf, c_i, b_len - c_i);
          match("%d", #clean_buf, d_val);
        );
        // FL:2/4/8 were merged into the plain cycle conditions (2:2, 4:4, 8:8 and their inverse)
        n_idx = (d_val == 4) ? (c_inv ? 43 : 9) : (d_val == 8) ? (c_inv ? 44 : 35) : (d_val == 16) ? (c_inv ? 45 : 42) : (c_inv ? 1 : 2);
      ) : 0;

      n_idx >= 0 ? 24000[edit_step_offset] = n_idx;
    );
  );
);

// Queue up to 64 sub-step events; return -1 when no free slot is available.
function queue_add(q_st, q_p, q_c, q_v, q_pn, q_tr, q_on, q_off) local(qi, found) (
  qi = 0; found = -1;
  while (found < 0 && qi < 64) (
    30000[qi] == 0 ? found = qi;
    qi += 1;
  );
  found >= 0 ? (
    30000[found] = q_st;
    30100[found] = q_p;
    30200[found] = q_c;
    30300[found] = q_v;
    30400[found] = q_pn;
    30700[found] = q_tr;
    30500[found] = q_on;
    30600[found] = q_off;
  );
  found;
);

// LEG: release a note at l_off_beat (this block if it falls inside it, otherwise through the queue)
function leg_release(l_pitch, l_ch, l_tr, l_off_beat, l_min_samp) local(l_samp) (
  l_off_beat < b_rel_end_beat ? (
    l_samp = floor((l_off_beat - b_rel_start_beat) * b_samples_per_beat);
    l_samp = max(l_min_samp, min(samplesblock - 1, l_samp));
    send_note_off(l_samp, l_pitch, l_ch);
  ) : (
    queue_add(2, l_pitch, l_ch, 0, 64, l_tr, l_off_beat, l_off_beat);
  );
);

// Keep the serialized field order stable: existing project data depends on it.
@serialize
file_is_loading = file_avail(file) > 0;
!file_is_loading ? (
  // Save current active pattern to pattern memory before writing to disk
  save_pattern_to_mem(active_edit_pat);
);
file_version = 3;
file_var(file, file_version);
// Global parameters
file_var(file, euc_mode);
file_var(file, velocity_mode);
file_var(file, gate_mode);
file_var(file, pan_mode);
file_var(file, timing_mode);
file_var(file, ratchet_mode);
file_var(file, chance_mode);
file_var(file, cond_mode);
file_is_loading && !(velocity_mode || gate_mode || pan_mode || timing_mode || ratchet_mode || chance_mode || cond_mode) ? velocity_mode = 1;
file_var(file, info_mode);
file_var(file, info_lang);
file_var(file, current_page);
file_var(file, step_page);
file_var(file, quant_root);
file_var(file, quant_scale);
update_quant_mask_bits();
file_var(file, quant_mask_bits);
quant_mask_bits <= 0 ? (
  quant_scale >= 0 && quant_scale <= 53 ? (
    set_quant_scale(quant_scale);
  ) : (
    set_quant_scale(0); // Chromatic default: all 12 semitones active
  );
) : (
  apply_quant_mask_bits(quant_mask_bits);
);

// 16-track parameters
file_mem(file, 1600, 16); // Pitch
file_mem(file, 1620, 16); // Channel
file_mem(file, 1640, 16); // Rate
file_mem(file, 1660, 16); // Length
file_mem(file, 1680, 16); // Solo
file_mem(file, 1700, 16); // Mute
file_mem(file, 1720, 16); // Density / Chance
file_mem(file, 1740, 16); // Swing
file_mem(file, 1860, 16); // Euclidean Fill
file_mem(file, 1920, 16); // Per-track play mode
file_mem(file, 1940, 16); // Track Volume
file_mem(file, 2100, 16); // Slot A mode
file_mem(file, 2120, 16); // Track Pan
file_mem(file, 2140, 16); // Slot B mode
file_mem(file, 2160, 16); // Track Gate
file_mem(file, 10000, 1024); // Step State (0/1)
file_mem(file, 12000, 1024); // Velocity
file_mem(file, 14000, 1024); // Pan
file_mem(file, 16000, 1024); // Gate Length index
file_mem(file, 18000, 1024); // Micro-timing
file_mem(file, 20000, 1024); // Ratcheting
file_mem(file, 22000, 1024); // Step Chance
file_mem(file, 24000, 1024); // Trig Conditions
file_var(file, master_vol);
master_vol <= 0 && master_vol != 0 ? master_vol = 100;
master_vol = min(100, max(0, master_vol));
file_var(file, master_gate);
master_gate = min(100, max(-100, master_gate));

file_var(file, lfo_cur_tr);
file_mem(file, 4500, 16);
file_mem(file, 4520, 16);
file_mem(file, 4540, 16);
file_mem(file, 4560, 16);
file_mem(file, 4580, 16);
file_mem(file, 4600, 16);
file_mem(file, 4620, 16);
file_mem(file, 4700, 16);
file_mem(file, 4760, 16);

// V2 additions: 16 patterns memory and pattern chaining
file_version >= 2 ? (
  file_var(file, active_edit_pat);
  file_var(file, active_play_pat);
  file_var(file, chain_mode);
  file_var(file, chain_len);
  file_mem(file, CHAIN_BASE, 64);
  file_mem(file, PATTERN_BASE, 16 * PATTERN_BLOCK_SIZE);
  file_is_loading ? (
    active_edit_pat = min(15, max(0, active_edit_pat));
    active_play_pat = min(15, max(0, active_play_pat));
    chain_mode = chain_mode ? 1 : 0;
    chain_len = min(64, max(0, chain_len));
    // Older projects have no per-pattern master values; their track values
    // already include any previous swing and length adjustments.
    file_version < 3 ? (
      pat_migrate = 0;
      while (pat_migrate < 16) (
        pat_base = PATTERN_BASE + pat_migrate * PATTERN_BLOCK_SIZE;
        pat_base[8486] = 100;
        pat_base[8487] = 0;
        pat_base[8488] = 0;
        pat_migrate += 1;
      );
    );
    load_pattern_from_mem(active_edit_pat);
  );
) : (
  file_is_loading ? (
    active_edit_pat = 0;
    active_play_pat = 0;
    chain_mode = 0;
    chain_len = 0;
    master_density = 100;
    master_swing = 0;
    master_len_offset = 0;
    save_pattern_to_mem(0);
  );
);

gui_dirty = 1;

// Process incoming MIDI and schedule sequencer events for this audio block.
@block
midi_evt_count = 0;
midi_evt_overflow = 0;
meter_l_block_vel = 0;
meter_r_block_vel = 0;
while (midirecv(in_samp, in_m1, in_m2, in_m3)) (
  ((in_m1 & 0xF0) == 0x90 && in_m3 > 0) ? (
    update_midi_meter(in_m3, 64);
  );
  emit_midi(in_samp, in_m1, in_m2, in_m3);
);

b_is_playing = play_state & 1;

b_is_playing ? (
  b_sec_per_beat = 60.0 / tempo;
  b_samples_per_beat = srate * b_sec_per_beat;
  b_block_beats = samplesblock / b_samples_per_beat;
  b_cur_beat = max(0.0, play_position * (tempo / 60.0));

  // LFO cross-modulation (LFO -> LFO)
  ti_in = 0;
  while (ti_in < NUM_TRACKS) (
    4720[ti_in] = 0.0; // Rate / Phase mod
    4820[ti_in] = 0.0; // Shape mod
    4840[ti_in] = 0.0; // Amount mod
    ti_in += 1;
  );

  ti_src = 0;
  while (ti_src < NUM_TRACKS) (
    src_dst = 4600[ti_src];
    (src_dst >= 13 && src_dst <= 60) ? (
      tgt_lfo = floor((src_dst - 13) / 3);
      tgt_param = (src_dst - 13) % 3;
      tgt_lfo != ti_src ? (
        src_val = get_lfo_value(ti_src, b_cur_beat, play_position);
        tgt_param == 0 ? (
          4720[tgt_lfo] += src_val;
        ) :
        tgt_param == 1 ? (
          4820[tgt_lfo] += src_val;
        ) : (
          4840[tgt_lfo] += src_val;
        );
      );
    );
    ti_src += 1;
  );

  // Master modulation is temporary: never write it into pattern settings.
  master_lfo_len = 0; master_lfo_density = 0; master_lfo_swing = 0; master_lfo_gate = 0;
  master_src = 0;
  while (master_src < NUM_TRACKS) (
    master_dst = 4600[master_src];
    (master_dst >= 64 && master_dst <= 67) ? (
      master_value = get_lfo_value(master_src, b_cur_beat, play_position);
      master_dst == 64 ? master_lfo_len += master_value * 16.0 :
      master_dst == 65 ? master_lfo_density += master_value * 50.0 :
      master_dst == 66 ? master_lfo_swing += master_value * 50.0 :
                         master_lfo_gate += master_value * 50.0;
    );
    master_src += 1;
  );
  master_lfo_len = floor(master_lfo_len + 0.5);
  master_lfo_density = floor(master_lfo_density + 0.5);
  master_lfo_swing = floor(master_lfo_swing + 0.5);
  master_lfo_gate = floor(master_lfo_gate + 0.5);
  effective_master_density = min(100, max(0, master_density + master_lfo_density));
  effective_master_gate = min(100, max(-100, master_gate + master_lfo_gate));

  // Pattern Switch / Chaining on cycle completion
  b_is_starting = !b_was_playing;
  b_is_loop_wrap = play_position < (b_last_play_pos - 0.05);
  b_is_seek = abs(play_position - b_last_play_pos) > max(0.05, b_block_beats * 2.0);

  // Calculate pattern cycle duration in beats (Track 1 length or maximum across active tracks)
  pat_cycle_beats = min(64, max(1, 1660[0] + master_lfo_len)) * get_beats_per_step(1640[0]);
  t_chk = 0;
  while (t_chk < NUM_TRACKS) (
    !1700[t_chk] ? (
      t_cb = min(64, max(1, 1660[t_chk] + master_lfo_len)) * get_beats_per_step(1640[t_chk]);
      t_cb > pat_cycle_beats ? pat_cycle_beats = t_cb;
    );
    t_chk += 1;
  );
  pat_cycle_beats <= 0 ? pat_cycle_beats = 4.0;

  (b_is_starting || b_is_loop_wrap || b_is_seek) ? (
    pat_start_beat = b_cur_beat;
  );

  // Realign pat_start_beat if playback advanced past boundary without queued switches
  while ((pat_start_beat + pat_cycle_beats) < (b_cur_beat - 0.001)) (
    pat_start_beat += pat_cycle_beats;
  );

  boundary_beat = pat_start_beat + pat_cycle_beats;
  b_pat_cycle_done = (b_cur_beat + b_block_beats >= (boundary_beat - 0.0001));

  (b_pat_cycle_done || b_is_loop_wrap || b_is_starting) ? (
    queued_play_pat >= 0 ? (
      next_pat = queued_play_pat;
      queued_play_pat = -1;
    ) : (chain_mode && chain_len > 0 && b_pat_cycle_done) ? (
      chain_pos = (chain_pos + 1) % chain_len;
      next_pat = CHAIN_BASE[chain_pos];
    ) : (
      next_pat = -1;
      b_pat_cycle_done ? (
        pat_start_beat = boundary_beat;
      );
    );

    next_pat >= 0 ? (
      save_pattern_to_mem(active_edit_pat);
      active_play_pat = next_pat;
      active_edit_pat = next_pat;
      load_pattern_from_mem(active_play_pat);
      pat_start_beat = boundary_beat;
      b_tr_i = 0;
      while (b_tr_i < NUM_TRACKS) (
        1780[b_tr_i] >= 0 ? (
          send_note_off(0, 1780[b_tr_i], 1800[b_tr_i]);
          1780[b_tr_i] = -1;
          1840[b_tr_i] = -1;
        );
        b_rate = 1640[b_tr_i];
        b_step_dur = get_beats_per_step(b_rate);
        b_start_step = floor((boundary_beat + 0.00001) / b_step_dur);
        1820[b_tr_i] = b_start_step - 1;
        1760[b_tr_i] = b_start_step;
        44100[b_tr_i] = 0;
        44120[b_tr_i] = -1;
        b_tr_i += 1;
      );
      gui_dirty = 1;
    );
  );

  (b_is_starting || b_is_loop_wrap || b_is_seek) ? (
    b_tr_i = 0;
    while (b_tr_i < NUM_TRACKS) (
      b_rate = 1640[b_tr_i];
      b_step_dur = get_beats_per_step(b_rate);
      b_start_step = floor((b_cur_beat + 0.00001) / b_step_dur);
      b_start_step = max(0, b_start_step);
      1820[b_tr_i] = b_start_step - 1;
      1760[b_tr_i] = b_start_step;
      1780[b_tr_i] >= 0 ? (
        send_note_off(0, 1780[b_tr_i], 1800[b_tr_i]);
        1780[b_tr_i] = -1;
      );
      1880[b_tr_i] != 64 ? (
        b_ch_rst = 1620[b_tr_i];
        b_ch_rst == 0 ? (
          c_i = 0; while (c_i < 16) ( emit_midi(0, 0xB0 + c_i, 10, 64); c_i += 1; );
        ) : (
          emit_midi(0, 0xB0 + (b_ch_rst - 1), 10, 64);
        );
        1880[b_tr_i] = 64;
      );
      1840[b_tr_i] = -1;
      44000[b_tr_i] = 0;
      44020[b_tr_i] = -1;
      b_is_starting ? (
        44100[b_tr_i] = 0;
        44120[b_tr_i] = -1;
      );
      b_tr_i += 1;
    );
    // Clear sub-step note queue on transport start or seek
    q_clr_i = 0;
    while (q_clr_i < 64) (
      30000[q_clr_i] > 0 ? (
        send_note_off(0, 30100[q_clr_i], 30200[q_clr_i]);
        30000[q_clr_i] = 0;
      );
      q_clr_i += 1;
    );
  );

  g_cur_beat = b_cur_beat;
  b_rel_start_beat = b_cur_beat;
  b_rel_end_beat = b_rel_start_beat + b_block_beats;

  // Master gate is constant for the whole audio block.
  b_master_gate_val = effective_master_gate;
  b_master_gate_val < -100 ? b_master_gate_val = -100 : b_master_gate_val > 100 ? b_master_gate_val = 100;
  b_master_gate_mult = b_master_gate_val >= 0 ? (1.0 + b_master_gate_val / 100.0) : max(0.02, 1.0 + (b_master_gate_val / 100.0) * 0.98);

  b_has_solo = 0;
  b_s = 0;
  while (b_s < NUM_TRACKS && !b_has_solo) (
    1680[b_s] ? b_has_solo = 1;
    b_s += 1;
  );

  // Process scheduled sub-step note queue (Note-On / Note-Off)
  qi = 0;
  while (qi < 64) (
    q_state = 30000[qi];
    q_state == 2 ? (
      // Active note scheduled to turn off (Note-Off)
      30600[qi] < b_rel_end_beat ? (
        off_samp = floor((30600[qi] - b_rel_start_beat) * b_samples_per_beat);
        off_samp = max(0, min(samplesblock - 1, off_samp));
        send_note_off(off_samp, 30100[qi], 30200[qi]);
        30000[qi] = 0;
      );
    ) :
    q_state == 1 ? (
      // Scheduled note awaiting trigger (Note-On)
      30500[qi] < b_rel_end_beat ? (
        on_samp = floor((30500[qi] - b_rel_start_beat) * b_samples_per_beat);
        on_samp = max(0, min(samplesblock - 1, on_samp));
        update_midi_meter(30300[qi], 30400[qi]);
        send_pan_if_changed(on_samp, 30200[qi], 30400[qi], 30700[qi]);
        send_note_on(on_samp, 30100[qi], 30200[qi], 30300[qi]);

        (30600[qi] < b_rel_end_beat && on_samp < samplesblock - 1) ? (
          off_samp = floor((30600[qi] - b_rel_start_beat) * b_samples_per_beat);
          off_samp = max(on_samp + 1, min(samplesblock - 1, off_samp));
          send_note_off(off_samp, 30100[qi], 30200[qi]);
          30000[qi] = 0;
        ) : (
          30000[qi] = 2; // Active note spanning to next block
        );
      );
    );
    qi += 1;
  );

  b_tr = 0;
  while (b_tr < NUM_TRACKS) (
    b_is_muted = 1700[b_tr];
    b_is_soloed = 1680[b_tr];
    b_can_play = (!b_has_solo || b_is_soloed) && !b_is_muted;

    b_len = 1660[b_tr];
    b_len <= 0 ? b_len = 16;
    b_len = min(64, max(1, b_len + master_lfo_len));
    b_rate_idx = 1640[b_tr];
    b_sw = 1740[b_tr];

    // Per-track LFO modulation (active only when connected to a destination)
    b_lfo_dst = 4600[b_tr];
    b_lfo_dst != 0 ? (
      b_lfo_mod = get_lfo_value(b_tr, b_cur_beat, play_position);
      4740[b_tr] = b_lfo_mod; // Modulation feedback buffer
    ) : (
      b_lfo_mod = 0.0;
      4740[b_tr] = 0.0;
    );

    // Apply LFO rate modulation before step duration calculation
    b_lfo_dst == 2 ? (
      b_rate_idx = min(10, max(0, floor(b_rate_idx + b_lfo_mod * 3.0 + 0.5)));
    );
    b_step_beat_dur = get_beats_per_step(b_rate_idx);

    // Detect rate changes to recalculate step index and prevent timing bursts
    3900[b_tr] != b_rate_idx ? (
      3900[b_tr] = b_rate_idx;
      b_cur_st = floor((b_cur_beat + 0.00001) / b_step_beat_dur);
      1820[b_tr] = b_cur_st - 1;
    );

    b_lfo_dst == 3 ? ( b_len = min(64, max(1, floor(b_len + b_lfo_mod * 16.0 + 0.5))); );
    b_lfo_dst == 6 ? ( b_sw = min(100, max(-100, floor(b_sw + b_lfo_mod * 50.0 + 0.5))); );
    b_eff_sw = min(100, max(-100, b_sw + master_lfo_swing));

    // These parameters remain unchanged while the current track is processed.
    b_tr_gate_val = 2160[b_tr];
    b_lfo_dst == 62 ? b_tr_gate_val = min(100, max(-100, floor(b_tr_gate_val + b_lfo_mod * 50.0 + 0.5)));
    b_tr_gate_val < -100 ? b_tr_gate_val = -100 : b_tr_gate_val > 100 ? b_tr_gate_val = 100;
    b_tr_gate_mult = b_tr_gate_val >= 0 ? (1.0 + b_tr_gate_val / 100.0) : max(0.02, 1.0 + (b_tr_gate_val / 100.0) * 0.98);
    b_tr_pan_val = 2120[b_tr];
    b_lfo_dst == 63 ? b_tr_pan_val = min(100, max(-100, floor(b_tr_pan_val + b_lfo_mod * 50.0 + 0.5)));
    b_tr_pan_val < -100 ? b_tr_pan_val = -100 : b_tr_pan_val > 100 ? b_tr_pan_val = 100;
    b_tr_vol_val = 1940[b_tr];
    b_tr_vol_val < 0 ? b_tr_vol_val = 100;
    b_lfo_dst == 61 ? b_tr_vol_val = min(100, max(0, floor(b_tr_vol_val + b_lfo_mod * 50.0 + 0.5)));

    // Immediately silence any note sounding on a muted or inactive track
    (!b_can_play && 1780[b_tr] >= 0) ? (
      send_note_off(0, 1780[b_tr], 1800[b_tr]);
      1780[b_tr] = -1;
      1840[b_tr] = -1;
    );

    // Standard track Note-Off
    (1780[b_tr] >= 0 && 1840[b_tr] < b_rel_end_beat) ? (
      b_off_sample = floor((1840[b_tr] - b_rel_start_beat) * b_samples_per_beat);
      b_off_sample = max(0, min(samplesblock - 1, b_off_sample));
      send_note_off(b_off_sample, 1780[b_tr], 1800[b_tr]);
      1780[b_tr] = -1;
      1840[b_tr] = -1;
    );

    // Update visual playhead buffer 1760 with correct track rate
    1760[b_tr] = floor((b_cur_beat + 0.00001) / b_step_beat_dur);
    b_pm = 1920[b_tr];

    b_keep_checking = 1;
    while (b_keep_checking) (
      b_st = 1820[b_tr] + 1;
      b_step_in_pattern = get_track_play_step(b_st, b_len, b_pm, b_tr);

      // Plugin-owned cycle counter: +1 every time the pattern wraps (works with REAPER loops / any host position)
      b_raw_pos = b_st % b_len;
      b_raw_pos < 44120[b_tr] ? ( 44100[b_tr] += 1; );
      44120[b_tr] = b_raw_pos;

      b_step_offset = b_tr * 64 + b_step_in_pattern;

      b_fill = 1860[b_tr];
      b_lfo_dst == 4 ? (
        fill_mod = floor(b_lfo_mod * (b_len * 0.5) + 0.5);
        b_fill = min(b_len, max(0, b_fill + fill_mod));
      );

      (euc_mode && (b_lfo_dst == 4 || (master_lfo_len != 0 && 1860[b_tr] > 0))) ? (
        b_step_active = eval_euclidean_step(b_step_in_pattern, b_len, b_fill);
      ) : (
        b_step_active = 10000[b_step_offset];
      );

      b_step_vel = 12000[b_step_offset];
      b_step_vel <= 0 ? b_step_vel = 100;

      b_step_gate_idx = 16000[b_step_offset];
      (b_step_gate_idx < 0 || b_step_gate_idx > 69) ? b_step_gate_idx = 4;
      b_gate_dur = get_elektron_gate_dur(b_step_gate_idx, b_step_beat_dur);

      eff_gate_mult = b_tr_gate_mult * b_master_gate_mult;

      b_step_gate_idx < 68 ? (
        b_gate_dur = max(0.005 * b_step_beat_dur, b_gate_dur * eff_gate_mult);
      );

      b_sw_offset = (b_step_in_pattern % 2 == 1 && b_eff_sw != 0) ? ((b_eff_sw / 100.0) * b_step_beat_dur * 0.5) : 0.0;
      b_step_timing = 18000[b_step_offset];
      b_lfo_dst == 10 ? ( b_step_timing = min(50, max(-50, floor(b_step_timing + b_lfo_mod * 50.0 + 0.5))); );
      b_mt_offset = (b_step_timing / 100.0) * b_step_beat_dur * 0.5;
      b_st_sound_beat = b_st * b_step_beat_dur + b_sw_offset + b_mt_offset;

      // Swing gate compensation: shorten shifted notes to prevent overlap with next step
      b_step_gate_idx < 68 ? ( // Bypass when gate is INF / LEG
        b_sw > 0 && (b_step_in_pattern % 2 == 1) ? (
          avail_gate = max(0.01 * b_step_beat_dur, b_step_beat_dur - b_sw_offset - (0.015 * b_step_beat_dur));
          b_gate_dur = min(b_gate_dur, avail_gate);
        ) :
        b_eff_sw < 0 && (b_step_in_pattern % 2 == 0) ? (
          avail_gate = max(0.01 * b_step_beat_dur, b_step_beat_dur - abs(b_sw_offset) - (0.015 * b_step_beat_dur));
          b_gate_dur = min(b_gate_dur, avail_gate);
        );
      );

      (b_st_sound_beat < b_rel_end_beat) ? (
        (b_st_sound_beat >= (b_rel_start_beat - 0.001) || b_st == floor((b_cur_beat + 0.0001) / b_step_beat_dur)) ? (
          b_target_sample = floor((b_st_sound_beat - b_rel_start_beat) * b_samples_per_beat);
          // On start, loop wrap, or seek, minimum sample offset is 1 to avoid collision with reset/note-off at sample 0
          b_target_sample = max((b_is_starting || b_is_loop_wrap || b_is_seek) ? 1 : 0, min(samplesblock - 1, b_target_sample));

          b_can_play && b_step_active ? (
            b_cycle = 44100[b_tr];
            b_step_cond = 24000[b_step_offset];
            b_pass_cond = eval_cond(b_step_cond, b_cycle, b_tr);

            b_pass_cond ? (
              b_track_chance = 1720[b_tr];
              b_lfo_dst == 5 ? ( b_track_chance = min(100, max(0, floor(b_track_chance + b_lfo_mod * 50.0 + 0.5))); );
              b_eff_track_chance = max(0, min(100, b_track_chance + effective_master_density - 100));
              b_step_chance = 22000[b_step_offset];
              b_lfo_dst == 12 ? ( b_step_chance = min(100, max(0, floor(b_step_chance + b_lfo_mod * 50.0 + 0.5))); );
              b_effective_chance = max(0, min(100, b_step_chance + b_eff_track_chance - 100));
              b_pass_chance = (b_effective_chance >= 100 || (b_effective_chance > 0 && rand(100) < b_effective_chance));

              b_pass_chance ? (
                b_pitch = 1600[b_tr];
                b_lfo_dst == 1 ? ( b_pitch = min(108, max(24, floor(b_pitch + b_lfo_mod * 12.0 + 0.5))); );
                b_pitch = quantize_pitch(b_pitch);
                b_ch = 1620[b_tr];
                b_step_pan = 14000[b_step_offset];
                (b_step_pan < 0 || b_step_pan > 127) ? b_step_pan = 64;
                b_lfo_dst == 9 ? ( b_step_pan = min(127, max(0, floor(b_step_pan + b_lfo_mod * 64.0 + 0.5))); );

                // Offset by Track Pan (2120: -100..+100)
                b_step_pan = min(127, max(0, floor(b_step_pan + (b_tr_pan_val * 64.0 / 100.0) + 0.5)));

                // Ratcheting (1..4 sub-steps)
                b_ratchet = 20000[b_step_offset];
                (b_ratchet < 1 || b_ratchet > 4) ? b_ratchet = 1;
                b_lfo_dst == 11 ? ( b_ratchet = min(4, max(1, floor(b_ratchet + b_lfo_mod * 2.0 + 0.5))); );
                b_lfo_dst == 7 ? ( b_step_vel = min(127, max(1, floor(b_step_vel + b_lfo_mod * 64.0 + 0.5))); );

                // Scale velocity by Track Volume (1940: 0..100%) and Master Volume (master_vol: 0..100%)
                b_step_vel = floor(b_step_vel * (b_tr_vol_val / 100.0) * (master_vol / 100.0) + 0.5);
                b_step_vel = min(127, max(0, b_step_vel));

                (b_lfo_dst == 8 && b_step_gate_idx != 69) ? (
                  b_step_gate_idx = min(68, max(0, floor(b_step_gate_idx + b_lfo_mod * 34.0 + 0.5)));
                  b_gate_dur = get_elektron_gate_dur(b_step_gate_idx, b_step_beat_dur);
                  b_step_gate_idx < 68 ? (
                    b_gate_dur = max(0.005 * b_step_beat_dur, b_gate_dur * eff_gate_mult);
                  );
                );

                // ---- LEGATO (LEG) handling + choke of previous notes ----
                // A held LEG note (any track, same MIDI channel) is not cut: the new note-on goes out first
                // and the old note-off follows 1 sample later, so the synth sees an overlap (glide / portamento).
                b_leg_src = -1;
                b_lt = 0;
                while (b_lt < NUM_TRACKS) (
                  (b_leg_src < 0 && 1780[b_lt] >= 0 && 44000[b_lt] == 1 && 1800[b_lt] == b_ch && 44020[b_lt] < b_st_sound_beat) ? (
                    b_leg_src = b_lt;
                  );
                  b_lt += 1;
                );
                b_leg_ov = min(0.25 * b_step_beat_dur, leg_overlap_ms * 0.001 * tempo / 60.0);
                b_leg_hand = 0;
                b_leg_tie = 0;
                (b_leg_src >= 0 && b_ratchet == 1) ? (
                  (1780[b_leg_src] == b_pitch) ? ( b_leg_tie = 1; ) : ( b_leg_hand = 1; );
                );

                // Standard choke of this track's previous note (skipped when it is taken over by legato)
                (1780[b_tr] >= 0 && !((b_leg_hand || b_leg_tie) && b_leg_src == b_tr)) ? (
                  b_kill_sample = max(0, b_target_sample - 2);
                  (b_target_sample <= 1) ? (
                    send_note_off(0, 1780[b_tr], 1800[b_tr]);
                    b_target_sample = max(b_target_sample, 2);
                  ) : (
                    send_note_off(b_kill_sample, 1780[b_tr], 1800[b_tr]);
                  );
                  1780[b_tr] = -1;
                  1840[b_tr] = -1;
                );
                // A LEG note of another track that cannot be taken over (e.g. ratcheted target): release it normally
                (b_leg_src >= 0 && b_leg_src != b_tr && !(b_leg_hand || b_leg_tie)) ? (
                  send_note_off(max(0, b_target_sample - 2), 1780[b_leg_src], 1800[b_leg_src]);
                  1780[b_leg_src] = -1;
                  1840[b_leg_src] = -1;
                );

                b_sub_dur = b_step_beat_dur / b_ratchet;

                b_ratchet == 1 ? (
                  // Standard single step
                  b_leg_hand ? ( b_target_sample = min(b_target_sample, max(0, samplesblock - 2)); );
                  !b_leg_tie ? (
                    update_midi_meter(b_step_vel, b_step_pan);
                    send_pan_if_changed(b_target_sample, b_ch, b_step_pan, b_tr);
                    send_note_on(b_target_sample, b_pitch, b_ch, b_step_vel);
                  );
                  // LEG: previous note-off goes out right AFTER the new note-on (same pitch = tie, no retrigger)
                  b_leg_hand ? (
                    leg_release(1780[b_leg_src], 1800[b_leg_src], b_leg_src, b_st_sound_beat + b_leg_ov, b_target_sample + 1);
                  );
                  (b_leg_hand || b_leg_tie) ? (
                    1780[b_leg_src] = -1;
                    1840[b_leg_src] = -1;
                  );

                  // Remember this note-on (used by LEG detection)
                  44000[b_tr] = (b_step_gate_idx == 69) ? 1 : 0;
                  44020[b_tr] = b_st_sound_beat;
                  44040[b_tr] = b_target_sample;
                  44060[b_tr] = b_pitch;

                  b_note_off_beat = b_st_sound_beat + b_gate_dur;
                  (b_note_off_beat < b_rel_end_beat && b_target_sample < samplesblock - 1) ? (
                    b_off_sample = floor((b_note_off_beat - b_rel_start_beat) * b_samples_per_beat);
                    b_off_sample = max(b_target_sample + 1, min(samplesblock - 1, b_off_sample));
                    send_note_off(b_off_sample, b_pitch, b_ch);
                    1780[b_tr] = -1;
                    1840[b_tr] = -1;
                  ) : (
                    1780[b_tr] = b_pitch;
                    1800[b_tr] = b_ch;
                    1840[b_tr] = b_note_off_beat;
                  );

                  // LEG safety: another track on the same channel already played a LATER note inside this block
                  // (tracks are processed in order) -> close this legato note right after that note-on
                  (b_step_gate_idx == 69 && 1780[b_tr] >= 0) ? (
                    b_rv_t = -1;
                    b_rv_beat = 1000000000;
                    b_lt = 0;
                    while (b_lt < NUM_TRACKS) (
                      (b_lt != b_tr && 1620[b_lt] == b_ch && 44020[b_lt] > b_st_sound_beat && 44020[b_lt] >= b_rel_start_beat && 44020[b_lt] < b_rel_end_beat && 44020[b_lt] < b_rv_beat) ? (
                        b_rv_t = b_lt;
                        b_rv_beat = 44020[b_lt];
                      );
                      b_lt += 1;
                    );
                    b_rv_t >= 0 ? (
                      (44060[b_rv_t] != b_pitch) ? (
                        leg_release(b_pitch, b_ch, b_tr, 44020[b_rv_t] + b_leg_ov, 44040[b_rv_t] + 1);
                      );
                      1780[b_tr] = -1;
                      1840[b_tr] = -1;
                    );
                  );
                ) : (
                  // Multiple sub-steps
                  r_i = 0;
                  while (r_i < b_ratchet) (
                    sub_on_beat = b_st_sound_beat + r_i * b_sub_dur;
                    sub_g_dur = min(b_sub_dur * 0.85, max(0.005, b_gate_dur / b_ratchet));
                    sub_off_beat = sub_on_beat + sub_g_dur;

                    (sub_on_beat < b_rel_end_beat) ? (
                      (sub_on_beat >= b_rel_start_beat) ? (
                        sub_on_samp = floor((sub_on_beat - b_rel_start_beat) * b_samples_per_beat);
                        sub_on_samp = max(0, min(samplesblock - 1, sub_on_samp));
                        update_midi_meter(b_step_vel, b_step_pan);
                        send_pan_if_changed(sub_on_samp, b_ch, b_step_pan, b_tr);
                        send_note_on(sub_on_samp, b_pitch, b_ch, b_step_vel);

                        (sub_off_beat < b_rel_end_beat) ? (
                          sub_off_samp = floor((sub_off_beat - b_rel_start_beat) * b_samples_per_beat);
                          sub_off_samp = max(sub_on_samp + 1, min(samplesblock - 1, sub_off_samp));
                          send_note_off(sub_off_samp, b_pitch, b_ch);
                        ) : (
                          queue_add(2, b_pitch, b_ch, b_step_vel, b_step_pan, b_tr, sub_on_beat, sub_off_beat);
                        );
                      ) : (
                        (sub_off_beat > b_rel_start_beat && sub_off_beat < b_rel_end_beat) ? (
                          sub_off_samp = floor((sub_off_beat - b_rel_start_beat) * b_samples_per_beat);
                          sub_off_samp = max(0, min(samplesblock - 1, sub_off_samp));
                          send_note_off(sub_off_samp, b_pitch, b_ch);
                        );
                      );
                    ) : (
                      // Schedule for future block
                      queue_add(1, b_pitch, b_ch, b_step_vel, b_step_pan, b_tr, sub_on_beat, sub_off_beat);
                    );

                    r_i += 1;
                  );
                );
              );
            );
          );
        );

        1820[b_tr] = b_st;
      ) : (
        b_keep_checking = 0;
      );
    );

    b_tr += 1;
  );
) : (
  master_lfo_len = 0; master_lfo_density = 0; master_lfo_swing = 0; master_lfo_gate = 0;
  effective_master_density = master_density; effective_master_gate = master_gate;
  g_cur_beat = max(0.0, play_position * (tempo / 60.0));
  b_t = 0;
  while (b_t < NUM_TRACKS) (
    1780[b_t] >= 0 ? (
      send_note_off(0, 1780[b_t], 1800[b_t]);
      1780[b_t] = -1;
    );
    1880[b_t] != 64 ? (
      b_ch_rst = 1620[b_t];
      b_ch_rst == 0 ? (
        c_i = 0; while (c_i < 16) ( emit_midi(0, 0xB0 + c_i, 10, 64); c_i += 1; );
      ) : (
        emit_midi(0, 0xB0 + (b_ch_rst - 1), 10, 64);
      );
      1880[b_t] = 64;
    );

    // On stop send All Notes Off (CC 123) and All Sound Off (CC 120) for complete voice clearing on VSTs
    b_ch_rst = 1620[b_t];
    b_ch_rst == 0 ? (
      c_i = 0; while (c_i < 16) (
        emit_midi(0, 0xB0 + c_i, 123, 0);
        emit_midi(0, 0xB0 + c_i, 120, 0);
        c_i += 1;
      );
    ) : (
      emit_midi(0, 0xB0 + (b_ch_rst - 1), 123, 0);
      emit_midi(0, 0xB0 + (b_ch_rst - 1), 120, 0);
    );
    1820[b_t] = -1;
    1840[b_t] = -1;
    b_r_t = 1640[b_t];
    b_dur_t = get_beats_per_step(b_r_t);
    b_len_t = 1660[b_t]; b_len_t <= 0 ? b_len_t = 16;
    1760[b_t] = floor((g_cur_beat + 0.00001) / b_dur_t);
    b_t += 1;
  );

  // Turn off all queued sub-step notes
  q_t_i = 0;
  while (q_t_i < 64) (
    30000[q_t_i] > 0 ? (
      send_note_off(0, 30100[q_t_i], 30200[q_t_i]);
      30000[q_t_i] = 0;
    );
    q_t_i += 1;
  );
  meter_l_num_peak = 0;
  meter_r_num_peak = 0;
);

flush_midi_sorted();

meter_l_block_vel > 0 ? (
  meter_l_num_peak = meter_l_block_vel;
  meter_l_num_time = time_precise();
);
meter_r_block_vel > 0 ? (
  meter_r_num_peak = meter_r_block_vel;
  meter_r_num_time = time_precise();
);

b_was_playing = b_is_playing;
b_last_play_pos = play_position;

// Draw the interface and handle user interaction on the graphics thread.
@gfx 1324 538
gfx_clear = 0x242424;
gfx_mode = 0;

// Window resolution scaling (1324x538, base 1103x448 including right sidebar 44px)
cur_w = max(100, gfx_w);
cur_h = max(50, gfx_h);
sx = cur_w / 1103.0;
sy = cur_h / 448.0;
scale_font = max(min(sx, sy), min(sx, sy * 1.35) * 0.70 + (sx + sy) * 0.15);

// Font size scaling (Slot 9: 16px params, Slot 7: 15px pages)
sz_param = max(13, min(54, floor(16 * scale_font)));
sz_page  = max(13, min(50, floor(15 * scale_font)));
sz_main  = max(12, min(48, floor(14 * scale_font)));
sz_btn   = max(10, min(42, floor(12 * scale_font)));
sz_sub   = max(9,  min(36, floor(10 * scale_font)));
sz_q     = max(13, min(56, floor(16 * scale_font)));
sz_tt_title = max(14, min(48, floor(15 * scale_font)));
sz_tt_desc  = max(12, min(42, floor(13 * scale_font)));
sz_reawise  = max(22, min(96, floor(28 * scale_font)));
sz_readout  = max(12, min(48, floor(14 * scale_font)));
sz_mtr_pk   = max(9,  min(40, floor(11 * scale_font)));

// System fonts
gfx_setfont(1, "Inter",       sz_main,  'B');
gfx_setfont(2, "Inter",       sz_btn,   'B');
gfx_setfont(3, "Inter",       sz_sub,   'B');
gfx_setfont(4, "Inter",       sz_q,     'B');
gfx_setfont(5, "Inter",       sz_tt_title, 'B');
gfx_setfont(6, "Inter",       sz_tt_desc,  'B');
gfx_setfont(7, "Inter Light", sz_page,  0);
gfx_setfont(8, "Inter Light", sz_btn,   0);
gfx_setfont(9, "Inter Light", sz_param, 0);
gfx_setfont(10, "Inter",       sz_main,  0);
gfx_setfont(11, "Inter",       sz_reawise, 'B');
gfx_setfont(12, "Inter",       sz_readout, 'B');
gfx_setfont(14, "Inter Light", sz_mtr_pk,  0);

function X(val) ( floor(val * sx); );
function Y(val) ( floor(val * sy); );
function W(val) ( max(1, floor(val * sx)); );
function H(val) ( max(1, floor(val * sy)); );

sb_w = W(44);
rsb_w = W(44);
rsb_x = cur_w - rsb_w;
left_gap = X(52) - sb_w;
pm_right_edge = rsb_x - left_gap;

// Step grid horizontal alignment between FILL box and CHANCE meter
fill_end_px = X(310);
chance_start_px = X(787);
avail_space_px = chance_start_px - fill_end_px;

box_w_px = W(23);
box_gap_px = max(2, floor(4 * sx + 0.5));
box_pitch_px = box_w_px + box_gap_px;
box_h_px = H(24);
sb_txt_y_off = max(1, floor(1 * sy));

grid_total_w_px = 16 * box_w_px + 15 * box_gap_px;
left_margin_px = floor((avail_space_px - grid_total_w_px) * 0.5);
screen_grid_x = fill_end_px + left_margin_px;

// Top bar button alignment above step grid
by_top_btn = floor(Y(15));
bh_top_btn = floor(H(18));
by_gate = by_top_btn; bh_gate = bh_top_btn;
by_pan = by_top_btn; bh_pan = bh_top_btn;
by_tm = by_top_btn; bh_tm = bh_top_btn;
by_rt = by_top_btn; bh_rt = bh_top_btn;
by_cnd_btn = by_top_btn; bh_cnd_btn = bh_top_btn;

bw_vel = floor(W(64));
bw_gate = floor(W(44));
bw_pan = floor(W(36));
bw_tm = floor(W(54));
bw_rt = floor(W(76));
bw_chance_mode = floor(W(56));
bw_cnd_btn = floor(W(44));

tot_btns_w = bw_vel + bw_gate + bw_pan + bw_tm + bw_rt + bw_chance_mode + bw_cnd_btn;
tot_gaps_w = grid_total_w_px - tot_btns_w;
btn_gap_px = tot_gaps_w / 6.0;

bx_vel = floor(screen_grid_x);
bx_gate = floor(screen_grid_x + bw_vel + btn_gap_px);
bx_pan = floor(screen_grid_x + (bw_vel + bw_gate) + btn_gap_px * 2);
bx_tm = floor(screen_grid_x + (bw_vel + bw_gate + bw_pan) + btn_gap_px * 3);
bx_rt = floor(screen_grid_x + (bw_vel + bw_gate + bw_pan + bw_tm) + btn_gap_px * 4);
bx_chance_mode = floor(screen_grid_x + (bw_vel + bw_gate + bw_pan + bw_tm + bw_rt) + btn_gap_px * 5);
bx_cnd_btn = floor(screen_grid_x + grid_total_w_px - bw_cnd_btn);

// Top bar LFO strip layout: starts exactly on Density meter (X(787)) and ends on Play Mode (pm_right_edge)
by_lfo = Y(12);
bh_lfo = H(24);
lfo_start_x = X(787);
lfo_end_x = pm_right_edge;
lfo_total_w = lfo_end_x - lfo_start_x;
lfo_gap_px = max(2, floor(4 * sx + 0.5));
bw_lfo = max(18, floor((lfo_total_w - 6 * lfo_gap_px) / 7.0));

bx_lfo_tr = lfo_start_x;
bx_lfo_sh = lfo_start_x + floor(1 * (lfo_total_w - bw_lfo) / 6.0 + 0.5);
bx_lfo_sy = lfo_start_x + floor(2 * (lfo_total_w - bw_lfo) / 6.0 + 0.5);
bx_lfo_rt = lfo_start_x + floor(3 * (lfo_total_w - bw_lfo) / 6.0 + 0.5);
bx_lfo_tg = lfo_start_x + floor(4 * (lfo_total_w - bw_lfo) / 6.0 + 0.5);
bx_lfo_ds = lfo_start_x + floor(5 * (lfo_total_w - bw_lfo) / 6.0 + 0.5);
bx_lfo_am = lfo_end_x - bw_lfo;

// Keyboard input and direct parameter text editing
edit_active > 0 ? (
  gui_dirty = 1;
  key_char = gfx_getchar();
  while (key_char > 0) (
    key_char == 13 ? ( // Enter (confirm)
      commit_param_edit();
      edit_active = 0;
      edit_tr = -1;
      edit_first_key = 0;
      gui_dirty = 1;
    ) :
    key_char == 8 ? ( // Backspace
      edit_first_key ? (
        #edit_buf = "";
        edit_first_key = 0;
        gui_dirty = 1;
      ) : (
        b_len = strlen(#edit_buf);
        b_len > 0 ? (
          strcpy_substr(#edit_buf, #edit_buf, 0, b_len - 1);
          gui_dirty = 1;
        );
      );
    ) :
    (key_char >= 32 && key_char <= 255) ? (
      edit_first_key ? (
        #edit_buf = "";
        edit_first_key = 0;
      );
      // Map sharp key variants ('s', 'S', '+', '£') to '#' for Pitch or Root Note
      (edit_active == 2 || edit_active == 11) ? (
        (key_char == 's' || key_char == 'S' || key_char == '+' || key_char == 163) ? (
          key_char = '#';
        );
      );
      strlen(#edit_buf) < 10 ? (
        sprintf(#k_chr, "%c", key_char);
        strcat(#edit_buf, #k_chr);
        gui_dirty = 1;
      );
    );
    key_char = gfx_getchar();
  );
);

now_time = time_precise();
is_playing_transport = play_state & 1;
gfx_cur_beat = play_position * (tempo / 60.0);

// Floating menus geometry definitions
pad_y_sh = max(3, H(4));
sep_sh = max(4, H(4));
menu_w_sh = max(115, W(130));
item_h_sh = max(18, H(20));
menu_h_sh = pad_y_sh * 2 + item_h_sh * 9 + sep_sh;
is_over_lfo_sh_m = lfo_sh_menu_open && (mouse_x >= lfo_sh_menu_x && mouse_x <= lfo_sh_menu_x + menu_w_sh && mouse_y >= lfo_sh_menu_y && mouse_y <= lfo_sh_menu_y + menu_h_sh);

pad_y_ds = max(3, H(4));
sep_ds = max(4, H(4));
menu_w_ds = max(120, W(135));
item_h_ds = max(18, H(20));
menu_h_ds = pad_y_ds * 2 + item_h_ds * 7 + sep_ds * 2;
sub_w_ds = max(120, W(135));
sub_count_ds = lfo_ds_sub_open == 3 ? 9 : lfo_ds_sub_open == 4 ? 6 : lfo_ds_sub_open == 5 ? 4 : 15;
sub_h_ds = pad_y_ds * 2 + item_h_ds * sub_count_ds;
sub_x_ds = (lfo_ds_menu_x + menu_w_ds + W(2) + sub_w_ds <= cur_w - W(8)) ? (lfo_ds_menu_x + menu_w_ds + W(2)) : (lfo_ds_menu_x - sub_w_ds - W(2));
sub_anchor_ds = lfo_ds_sub_open == 4 ? 1 : lfo_ds_sub_open == 3 ? 2 : lfo_ds_sub_open == 5 ? 3 : lfo_ds_sub_open == 1 ? 4 : lfo_ds_sub_open == 0 ? 5 : 6;
sub_y_ds = min(cur_h - sub_h_ds - H(8), max(H(8), lfo_ds_menu_y + pad_y_ds + sub_anchor_ds * item_h_ds + sep_ds - H(20)));

is_over_lfo_ds_m = lfo_ds_menu_open && (
  (mouse_x >= lfo_ds_menu_x && mouse_x <= lfo_ds_menu_x + menu_w_ds && mouse_y >= lfo_ds_menu_y && mouse_y <= lfo_ds_menu_y + menu_h_ds) ||
  ((lfo_ds_sub_open >= 0) && mouse_x >= sub_x_ds && mouse_x <= sub_x_ds + sub_w_ds && mouse_y >= sub_y_ds && mouse_y <= sub_y_ds + sub_h_ds)
);

// Scale menu layout and hover check
pad_y_sc = max(3, H(4));
menu_w_sc = max(160, W(180));
item_h_sc = max(18, H(20));
menu_h_sc = pad_y_sc * 2 + item_h_sc * 5;
sub_w_sc = max(145, W(165));
sub_cnt_sc = (scale_sub_open == 0) ? 8 :
             (scale_sub_open == 1) ? 10 :
             (scale_sub_open == 2) ? 6 :
             (scale_sub_open == 3) ? 13 :
             (scale_sub_open == 4) ? 17 : 0;
sub_h_sc = pad_y_sc * 2 + item_h_sc * sub_cnt_sc;
sub_x_sc = (scale_menu_x + menu_w_sc + sub_w_sc + W(10) <= cur_w) ?
           (scale_menu_x + menu_w_sc + W(2)) :
           (scale_menu_x - sub_w_sc - W(2));
sub_y_sc = min(cur_h - sub_h_sc - H(8), max(H(8), scale_menu_y + scale_sub_open * item_h_sc - H(20)));

pad_y_rt = max(3, H(4));
sep_rt = max(4, H(4));
menu_w_rt = max(120, W(135));
item_h_rt = max(18, H(20));
menu_h_rt = pad_y_rt * 2 + item_h_rt * 15 + sep_rt;
is_over_lfo_rt_m = lfo_rt_menu_open && (mouse_x >= lfo_rt_menu_x && mouse_x <= lfo_rt_menu_x + menu_w_rt && mouse_y >= lfo_rt_menu_y && mouse_y <= lfo_rt_menu_y + menu_h_rt);

pad_y_sa = max(3, H(4));
sep_sa = max(4, H(4));
menu_w_sa = max(105, W(120));
item_h_sa = max(18, H(20));
menu_h_sa = pad_y_sa * 2 + item_h_sa * 6 + sep_sa * 2;
is_over_sa_m = slot_a_menu_open && (mouse_x >= slot_a_menu_x && mouse_x <= slot_a_menu_x + menu_w_sa && mouse_y >= slot_a_menu_y && mouse_y <= slot_a_menu_y + menu_h_sa);

pad_y_ms2 = max(3, H(4));
menu_w_ms2 = max(115, W(130));
item_h_ms2 = max(18, H(20));
menu_h_ms2 = pad_y_ms2 * 2 + item_h_ms2 * 2;
is_over_ms2_m = master_s2_menu_open && (mouse_x >= master_s2_menu_x && mouse_x <= master_s2_menu_x + menu_w_ms2 && mouse_y >= master_s2_menu_y && mouse_y <= master_s2_menu_y + menu_h_ms2);

pad_y_pat = max(3, H(4));
menu_w_pat = max(95, W(105));
item_h_pat = max(18, H(20));
menu_h_pat = pad_y_pat * 2 + item_h_pat * 3;
is_over_pat_m = pat_menu_open && (mouse_x >= pat_menu_x && mouse_x <= pat_menu_x + menu_w_pat && mouse_y >= pat_menu_y && mouse_y <= pat_menu_y + menu_h_pat);

pad_y_sb = max(3, H(4));
sep_sb = max(4, H(4));
menu_w_sb = max(105, W(120));
item_h_sb = max(18, H(20));
menu_h_sb = pad_y_sb * 2 + item_h_sb * 9 + sep_sb * 2;
is_over_sb_m = slot_b_menu_open && (mouse_x >= slot_b_menu_x && mouse_x <= slot_b_menu_x + menu_w_sb && mouse_y >= slot_b_menu_y && mouse_y <= slot_b_menu_y + menu_h_sb);

is_over_sc_m = scale_menu_open && (
  (mouse_x >= scale_menu_x && mouse_x <= scale_menu_x + menu_w_sc && mouse_y >= scale_menu_y && mouse_y <= scale_menu_y + menu_h_sc) ||
  ((scale_sub_open >= 0) && mouse_x >= sub_x_sc && mouse_x <= sub_x_sc + sub_w_sc && mouse_y >= sub_y_sc && mouse_y <= sub_y_sc + sub_h_sc)
);

is_over_lfo_menu = is_over_lfo_sh_m || is_over_lfo_ds_m || is_over_sc_m || is_over_lfo_rt_m || is_over_sa_m || is_over_sb_m || is_over_ms2_m || is_over_pat_m;

// Update submenu flyout on mouse hover over main scale menu
scale_menu_open ? (
  in_sc_m_hov = mouse_x >= scale_menu_x && mouse_x <= scale_menu_x + menu_w_sc && mouse_y >= scale_menu_y && mouse_y <= scale_menu_y + menu_h_sc;
  in_sc_m_hov ? (
    rel_my_sc = mouse_y - (scale_menu_y + pad_y_sc);
    (rel_my_sc >= 0 && rel_my_sc < item_h_sc * 5) ? (
      hov_cat = floor(rel_my_sc / item_h_sc);
      (hov_cat >= 0 && hov_cat < 5) ? (
        scale_sub_open = hov_cat;
      );
    );
  );
);

// Open destination categories on hover; keep the submenu open while crossing to it.
lfo_ds_menu_open ? (
  (mouse_x >= lfo_ds_menu_x && mouse_x <= lfo_ds_menu_x + menu_w_ds && mouse_y >= lfo_ds_menu_y && mouse_y <= lfo_ds_menu_y + menu_h_ds) ? (
    ds_rel = mouse_y - (lfo_ds_menu_y + pad_y_ds);
    ds_hover_row = ds_rel < item_h_ds ? 0 :
      ds_rel >= item_h_ds + sep_ds && ds_rel < item_h_ds * 4 + sep_ds ? 1 + floor((ds_rel - item_h_ds - sep_ds) / item_h_ds) :
      ds_rel >= item_h_ds * 4 + sep_ds * 2 && ds_rel < item_h_ds * 7 + sep_ds * 2 ? 4 + floor((ds_rel - item_h_ds * 4 - sep_ds * 2) / item_h_ds) : -1;
    ds_hover_row == 0 ? lfo_ds_sub_open = -1 :
    ds_hover_row == 1 ? lfo_ds_sub_open = 4 :
    ds_hover_row == 2 ? lfo_ds_sub_open = 3 :
    ds_hover_row == 3 ? lfo_ds_sub_open = 5 :
    ds_hover_row == 4 ? lfo_ds_sub_open = 1 :
    ds_hover_row == 5 ? lfo_ds_sub_open = 0 :
    ds_hover_row == 6 ? lfo_ds_sub_open = 2;
  );
);

// Normalized mouse coordinates
m_x = is_over_lfo_menu ? -999 : floor(mouse_x / sx);
m_y = is_over_lfo_menu ? -999 : floor(mouse_y / sy);

mouse_down = (mouse_cap & 1);
mouse_press = mouse_down && !mouse_was_down;
mouse_release = !mouse_down && mouse_was_down;
mouse_was_down = mouse_down;

mouse_r_down = (mouse_cap & 2) != 0;
mouse_r_press = mouse_r_down && !last_mouse_r_down;
mouse_r_release = !mouse_r_down && last_mouse_r_down;
last_mouse_r_down = mouse_r_down;

(mouse_release || mouse_r_release) ? (
  active_mouse_zone = 0;
  captured_btn_id = 0;
  solo_paint_mode = -1;
  mute_paint_mode = -1;
  last_painted_random_tr = -1;
  drag_mode = 0;
  drag_tr = -1;
  drag_pushed_undo = 0;
  step_paint_mode = -1;
  last_painted_offset = -1;
  last_reset_paint_x = -1;
  last_reset_paint_y = -1;
  kb_paint_mode = -1;
  last_painted_note = -1;
  mouse_clicked = 0;
);

// In-GUI LFO waveform / polarity menu click handling
lfo_sh_menu_open && mouse_press ? (
  in_sh_m = mouse_x >= lfo_sh_menu_x && mouse_x <= lfo_sh_menu_x + menu_w_sh && mouse_y >= lfo_sh_menu_y && mouse_y <= lfo_sh_menu_y + menu_h_sh;

  in_sh_m ? (
    rel_my = mouse_y - (lfo_sh_menu_y + pad_y_sh);
    clicked_it = -1;
    rel_my >= 0 && rel_my < item_h_sh * 6 ? (
      clicked_it = floor(rel_my / item_h_sh);
    ) :
    rel_my >= item_h_sh * 6 + sep_sh && rel_my < item_h_sh * 9 + sep_sh ? (
      clicked_it = 6 + floor((rel_my - (item_h_sh * 6 + sep_sh)) / item_h_sh);
    );

    clicked_it >= 0 ? (
      undo_push();
      clicked_it <= 5 ? (
        4500[lfo_cur_tr] = clicked_it;
      ) :
      clicked_it == 6 ? (
        4760[lfo_cur_tr] = 0; // Bipolar
      ) :
      clicked_it == 7 ? (
        4760[lfo_cur_tr] = 1; // +Unipolar
      ) :
      clicked_it == 8 ? (
        4760[lfo_cur_tr] = 2; // -Unipolar
      );
      lfo_sh_menu_open = 0;
      mouse_clicked = 1;
      gui_dirty = 1;
    );
  ) : (
    lfo_sh_menu_open = 0;
    mouse_clicked = 1;
    gui_dirty = 1;
  );
);

// In-GUI LFO destination menu click handling
lfo_ds_menu_open && mouse_press ? (
  in_ds_m = mouse_x >= lfo_ds_menu_x && mouse_x <= lfo_ds_menu_x + menu_w_ds && mouse_y >= lfo_ds_menu_y && mouse_y <= lfo_ds_menu_y + menu_h_ds;
  in_ds_sub = lfo_ds_sub_open >= 0 && mouse_x >= sub_x_ds && mouse_x <= sub_x_ds + sub_w_ds && mouse_y >= sub_y_ds && mouse_y <= sub_y_ds + sub_h_ds;
  in_ds_m ? (
    ds_rel = mouse_y - (lfo_ds_menu_y + pad_y_ds);
    ds_rel >= 0 && ds_rel < item_h_ds ? (
      undo_push(); 4600[lfo_cur_tr] = 0;
      lfo_ds_menu_open = 0; lfo_ds_sub_open = -1; gui_dirty = 1;
    );
    mouse_clicked = 1;
  ) : in_ds_sub ? (
    ds_sub_rel = mouse_y - (sub_y_ds + pad_y_ds);
    clicked_sub = floor(ds_sub_rel / item_h_ds);
    (ds_sub_rel >= 0 && clicked_sub < sub_count_ds) ? (
      chosen_ds = -1;
      lfo_ds_sub_open == 3 ? (
        chosen_ds = clicked_sub < 4 ? clicked_sub + 1 : clicked_sub == 4 ? 61 : clicked_sub == 7 ? 62 : clicked_sub == 8 ? 63 : clicked_sub;
      ) : lfo_ds_sub_open == 4 ? (
        chosen_ds = clicked_sub + 7;
      ) : lfo_ds_sub_open == 5 ? (
        chosen_ds = clicked_sub + 64;
      ) : (
        ti_cnt = 0; match_i = 0;
        while (ti_cnt < NUM_TRACKS && chosen_ds < 0) (
          ti_cnt != lfo_cur_tr ? (
            match_i == clicked_sub ? chosen_ds = 13 + ti_cnt * 3 + lfo_ds_sub_open;
            match_i += 1;
          );
          ti_cnt += 1;
        );
      );
      chosen_ds >= 0 ? (
        undo_push(); 4600[lfo_cur_tr] = chosen_ds;
        lfo_ds_menu_open = 0; lfo_ds_sub_open = -1; mouse_clicked = 1; gui_dirty = 1;
      );
    );
  ) : (
    lfo_ds_menu_open = 0; lfo_ds_sub_open = -1; mouse_clicked = 1; gui_dirty = 1;
  );
);

// In-GUI scale menu click handling
scale_menu_open && mouse_press ? (
  in_sc_m = mouse_x >= scale_menu_x && mouse_x <= scale_menu_x + menu_w_sc && mouse_y >= scale_menu_y && mouse_y <= scale_menu_y + menu_h_sc;
  in_sc_sub = (scale_sub_open >= 0) && (mouse_x >= sub_x_sc && mouse_x <= sub_x_sc + sub_w_sc && mouse_y >= sub_y_sc && mouse_y <= sub_y_sc + sub_h_sc);

  in_sc_m ? (
    rel_my_sc = mouse_y - (scale_menu_y + pad_y_sc);
    (rel_my_sc >= 0 && rel_my_sc < item_h_sc * 5) ? (
      clicked_cat = floor(rel_my_sc / item_h_sc);
      (clicked_cat >= 0 && clicked_cat < 5) ? (
        scale_sub_open = clicked_cat;
        mouse_clicked = 1;
        gui_dirty = 1;
      );
    );
  ) :
  in_sc_sub ? (
    sub_rel_my = mouse_y - (sub_y_sc + pad_y_sc);
    clicked_sub_sc = floor(sub_rel_my / item_h_sc);
    (clicked_sub_sc >= 0 && clicked_sub_sc < sub_cnt_sc) ? (
      base_sc_idx = (scale_sub_open == 0) ? 0 :
                    (scale_sub_open == 1) ? 8 :
                    (scale_sub_open == 2) ? 18 :
                    (scale_sub_open == 3) ? 24 : 37;
      sel_scale_idx = base_sc_idx + clicked_sub_sc;
      undo_push();
      set_quant_scale(sel_scale_idx);
      scale_menu_open = 0;
      scale_sub_open = -1;
      mouse_clicked = 1;
      gui_dirty = 1;
    );
  ) : (
    scale_menu_open = 0;
    scale_sub_open = -1;
    mouse_clicked = 1;
    gui_dirty = 1;
  );
);

// In-GUI LFO Rate menu click handling
lfo_rt_menu_open && mouse_press ? (
  in_rt_m = mouse_x >= lfo_rt_menu_x && mouse_x <= lfo_rt_menu_x + menu_w_rt && mouse_y >= lfo_rt_menu_y && mouse_y <= lfo_rt_menu_y + menu_h_rt;

  in_rt_m ? (
    rel_my = mouse_y - (lfo_rt_menu_y + pad_y_rt);
    clicked_it = -1;
    (rel_my >= 0 && rel_my < item_h_rt * 12) ? (
      clicked_it = floor(rel_my / item_h_rt);
    ) :
    (rel_my >= item_h_rt * 12 + sep_rt && rel_my < item_h_rt * 15 + sep_rt) ? (
      clicked_it = 12 + floor((rel_my - (item_h_rt * 12 + sep_rt)) / item_h_rt);
    );

    clicked_it >= 0 ? (
      undo_push();
      clicked_it <= 11 ? (
        4540[lfo_cur_tr] = 11 - clicked_it;
      ) : (
        4700[lfo_cur_tr] = clicked_it - 12;
      );
      lfo_rt_menu_open = 0;
      mouse_clicked = 1;
      gui_dirty = 1;
    );
  ) : (
    lfo_rt_menu_open = 0;
    mouse_clicked = 1;
    gui_dirty = 1;
  );
);

// In-GUI Slot A mode menu click handling
slot_a_menu_open && mouse_press ? (
  in_sa_m = mouse_x >= slot_a_menu_x && mouse_x <= slot_a_menu_x + menu_w_sa && mouse_y >= slot_a_menu_y && mouse_y <= slot_a_menu_y + menu_h_sa;

  in_sa_m ? (
    rel_my = mouse_y - (slot_a_menu_y + pad_y_sa);
    clicked_it = -1;
    (rel_my >= 0 && rel_my < item_h_sa * 2) ? (
      clicked_it = floor(rel_my / item_h_sa);
    ) :
    (rel_my >= item_h_sa * 2 + sep_sa && rel_my < item_h_sa * 4 + sep_sa) ? (
      clicked_it = 2 + floor((rel_my - (item_h_sa * 2 + sep_sa)) / item_h_sa);
    ) :
    (rel_my >= item_h_sa * 4 + sep_sa * 2 && rel_my < item_h_sa * 6 + sep_sa * 2) ? (
      clicked_it = 4 + floor((rel_my - (item_h_sa * 4 + sep_sa * 2)) / item_h_sa);
    );

    clicked_it >= 0 ? (
      undo_push();
      clicked_it == 0 ? (
        2100[slot_a_menu_tr] = 0;
      ) :
      clicked_it == 1 ? (
        2100[slot_a_menu_tr] = 1;
      ) :
      clicked_it == 2 ? (
        ti_sa = 0;
        while (ti_sa < NUM_TRACKS) (
          2100[ti_sa] = 0;
          ti_sa += 1;
        );
      ) :
      clicked_it == 3 ? (
        ti_sa = 0;
        while (ti_sa < NUM_TRACKS) (
          2100[ti_sa] = 1;
          ti_sa += 1;
        );
      ) : (
        ti_sa = 0;
        while (ti_sa < NUM_TRACKS) (
          clicked_it == 4 ? 1940[ti_sa] = 100 : 1720[ti_sa] = 100;
          ti_sa += 1;
        );
      );
      save_pattern_to_mem(active_edit_pat);
      slot_a_menu_open = 0;
      mouse_clicked = 1;
      gui_dirty = 1;
    );
  ) : (
    slot_a_menu_open = 0;
    mouse_clicked = 1;
    gui_dirty = 1;
  );
);

// In-GUI Slot B mode menu click handling
slot_b_menu_open && mouse_press ? (
  in_sb_m = mouse_x >= slot_b_menu_x && mouse_x <= slot_b_menu_x + menu_w_sb && mouse_y >= slot_b_menu_y && mouse_y <= slot_b_menu_y + menu_h_sb;

  in_sb_m ? (
    rel_my = mouse_y - (slot_b_menu_y + pad_y_sb);
    clicked_it = -1;
    (rel_my >= 0 && rel_my < item_h_sb * 3) ? (
      clicked_it = floor(rel_my / item_h_sb);
    ) :
    (rel_my >= item_h_sb * 3 + sep_sb && rel_my < item_h_sb * 6 + sep_sb) ? (
      clicked_it = 3 + floor((rel_my - (item_h_sb * 3 + sep_sb)) / item_h_sb);
    ) :
    (rel_my >= item_h_sb * 6 + sep_sb * 2 && rel_my < item_h_sb * 9 + sep_sb * 2) ? (
      clicked_it = 6 + floor((rel_my - (item_h_sb * 6 + sep_sb * 2)) / item_h_sb);
    );

    clicked_it >= 0 ? (
      undo_push();
      clicked_it == 0 ? (
        2140[slot_b_menu_tr] = 0;
      ) :
      clicked_it == 1 ? (
        2140[slot_b_menu_tr] = 2;
      ) :
      clicked_it == 2 ? (
        2140[slot_b_menu_tr] = 1;
      ) :
      clicked_it == 3 ? (
        ti_sb = 0;
        while (ti_sb < NUM_TRACKS) (
          2140[ti_sb] = 0;
          ti_sb += 1;
        );
      ) :
      clicked_it == 4 ? (
        ti_sb = 0;
        while (ti_sb < NUM_TRACKS) (
          2140[ti_sb] = 2;
          ti_sb += 1;
        );
      ) :
      clicked_it == 5 ? (
        ti_sb = 0;
        while (ti_sb < NUM_TRACKS) (
          2140[ti_sb] = 1;
          ti_sb += 1;
        );
      ) : (
        ti_sb = 0;
        while (ti_sb < NUM_TRACKS) (
          clicked_it == 6 ? 1740[ti_sb] = 0 : clicked_it == 7 ? 2160[ti_sb] = 0 : 2120[ti_sb] = 0;
          ti_sb += 1;
        );
      );
      save_pattern_to_mem(active_edit_pat);
      slot_b_menu_open = 0;
      mouse_clicked = 1;
      gui_dirty = 1;
    );
  ) : (
    slot_b_menu_open = 0;
    mouse_clicked = 1;
    gui_dirty = 1;
  );
);

// In-GUI Master Slot 2 mode menu click handling
master_s2_menu_open && mouse_press ? (
  in_ms2_m = mouse_x >= master_s2_menu_x && mouse_x <= master_s2_menu_x + menu_w_ms2 && mouse_y >= master_s2_menu_y && mouse_y <= master_s2_menu_y + menu_h_ms2;

  in_ms2_m && mouse_press ? (
    rel_my = mouse_y - (master_s2_menu_y + pad_y_ms2);
    clicked_it = floor(rel_my / item_h_ms2);
    (clicked_it >= 0 && clicked_it <= 1) ? (
      undo_push();
      master_s2_mode = clicked_it;
      master_s2_menu_open = 0;
      mouse_clicked = 1;
      gui_dirty = 1;
    );
  ) : (
    master_s2_menu_open = 0;
    mouse_clicked = 1;
    gui_dirty = 1;
  );
);

// In-GUI Pattern context menu (Copy / Cut / Paste)
pat_menu_open && mouse_press ? (
  in_pat_m = mouse_x >= pat_menu_x && mouse_x <= pat_menu_x + menu_w_pat && mouse_y >= pat_menu_y && mouse_y <= pat_menu_y + menu_h_pat;

  in_pat_m ? (
    rel_my = mouse_y - (pat_menu_y + pad_y_pat);
    clicked_it = floor(rel_my / item_h_pat);
    clicked_it == 0 ? (
      copy_pattern_to_clipboard(pat_menu_target);
      pat_menu_open = 0;
      mouse_clicked = 1;
      gui_dirty = 1;
    ) :
    clicked_it == 1 ? (
      cut_pattern_to_clipboard(pat_menu_target);
      pat_menu_open = 0;
      mouse_clicked = 1;
      gui_dirty = 1;
    ) :
    clicked_it == 2 ? (
      has_pat_clipboard ? (
        paste_pattern_from_clipboard(pat_menu_target);
      );
      pat_menu_open = 0;
      mouse_clicked = 1;
      gui_dirty = 1;
    ) : (
      pat_menu_open = 0;
      mouse_clicked = 1;
      gui_dirty = 1;
    );
  ) : (
    pat_menu_open = 0;
    mouse_clicked = 1;
    gui_dirty = 1;
  );
);
mouse_middle_down = (mouse_cap & 64);
mouse_middle_press = mouse_middle_down && !mouse_middle_was_down;
mouse_middle_was_down = mouse_middle_down;

// Close and commit active text edit field on outside click
edit_active > 0 && mouse_press ? (
  is_in_box = 0;
  ed_row = (edit_tr % 8);
  ed_ry = 52 + ed_row * 44;
  ed_page = floor(edit_tr / 8);
  ed_page == current_page ? (
    edit_active == 1 ? ( is_in_box = (m_x >= 100 && m_x <= 146 && m_y >= ed_ry + 6 && m_y <= ed_ry + 30); ) :
    edit_active == 2 ? ( is_in_box = (m_x >= 150 && m_x <= 188 && m_y >= ed_ry + 6 && m_y <= ed_ry + 30); ) :
    edit_active == 3 ? ( is_in_box = (m_x >= 192 && m_x <= 226 && m_y >= ed_ry + 6 && m_y <= ed_ry + 30); ) :
    edit_active == 4 ? ( is_in_box = (m_x >= 230 && m_x <= 268 && m_y >= ed_ry + 6 && m_y <= ed_ry + 30); ) :
    edit_active == 7 ? ( is_in_box = (m_x >= 272 && m_x <= 310 && m_y >= ed_ry + 6 && m_y <= ed_ry + 30); ) :
    edit_active == 5 ? ( is_in_box = (m_x >= 786 && m_x <= 836 && m_y >= ed_ry + 6 && m_y <= ed_ry + 30); ) :
    edit_active == 6 ? ( is_in_box = (m_x >= 840 && m_x <= 888 && m_y >= ed_ry + 6 && m_y <= ed_ry + 30); );
  );
  edit_active == 8 ? (
    is_in_box = lfo_am_hov;
  );
  edit_active == 9 ? (
    is_in_box = lfo_rt_hov;
  );
  edit_active == 10 ? (
    is_in_box = lfo_tr_hov;
  );
  edit_active == 11 ? (
    is_in_box = root_hov;
  );
  edit_active == 12 ? (
    is_in_box = oct_disp_hov;
  );
  edit_active == 13 ? (
    is_in_box = semi_disp_hov;
  );
  edit_active == 14 ? (
    is_in_box = m_slot2_hov;
  );
  edit_active == 15 ? (
    is_in_box = m_slot3_hov;
  );
  edit_active == 16 ? (
    is_in_box = m_slot2_hov;
  );
  edit_active == 17 ? (
    is_in_box = m_slot1_hov;
  );
  (edit_active >= 18 && edit_active <= 24) ? (
    ed_step_tr = floor(edit_step_offset / 64);
    ed_step_num = edit_step_offset % 64;
    ed_step_row = ed_step_tr % 8;
    ed_step_page = floor(ed_step_tr / 8);
    ed_step_vis = floor(ed_step_num / 16) == step_page;
    ed_step_page == current_page && ed_step_vis ? (
      ed_step_x = screen_grid_x + (ed_step_num % 16) * box_pitch_px;
      ed_step_y = Y(52 + ed_step_row * 44 + 6);
      is_in_box = mouse_x >= ed_step_x && mouse_x <= ed_step_x + box_w_px && mouse_y >= ed_step_y && mouse_y <= ed_step_y + box_h_px;
    );
  );
  !is_in_box ? (
    commit_param_edit();
    edit_active = 0;
    edit_tr = -1;
    edit_step_offset = -1;
    edit_first_key = 0;
    gui_dirty = 1;
  );
);

// Sidebar and top bar hover detection
mode_btns_hov = !is_over_lfo_menu && (mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn && mouse_x >= bx_vel && mouse_x <= (bx_cnd_btn + bw_cnd_btn));
vel_btn_hov = !is_over_lfo_menu && (mouse_x >= bx_vel && mouse_x <= bx_vel + bw_vel && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn);
gate_btn_hov = mouse_x >= bx_gate && mouse_x <= bx_gate + bw_gate && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
pan_btn_hov = mouse_x >= bx_pan && mouse_x <= bx_pan + bw_pan && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
timing_btn_hov = mouse_x >= bx_tm && mouse_x <= bx_tm + bw_tm && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
ratchet_btn_hov = mouse_x >= bx_rt && mouse_x <= bx_rt + bw_rt && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
chance_btn_hov = mouse_x >= bx_chance_mode && mouse_x <= bx_chance_mode + bw_chance_mode && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;
cond_btn_hov = mouse_x >= bx_cnd_btn && mouse_x <= bx_cnd_btn + bw_cnd_btn && mouse_y >= by_top_btn && mouse_y <= by_top_btn + bh_top_btn;

// Right-drag across parameter buttons resets each visited parameter once.
mouse_r_press ? (
  reset_buttons_paint = 0;
  reset_buttons_seen = 0;
  mode_btns_hov && (vel_btn_hov || gate_btn_hov || pan_btn_hov || timing_btn_hov || ratchet_btn_hov || chance_btn_hov || cond_btn_hov) ? (
    reset_buttons_paint = 1;
    undo_push();
  );
);
mouse_r_release ? reset_buttons_paint = 0;
mouse_r_down && reset_buttons_paint && mode_btns_hov ? (
  reset_button_idx = vel_btn_hov ? 0 : gate_btn_hov ? 1 : pan_btn_hov ? 2 :
                     timing_btn_hov ? 3 : ratchet_btn_hov ? 4 : chance_btn_hov ? 5 :
                     cond_btn_hov ? 6 : -1;
  reset_button_idx >= 0 ? (
    reset_button_bit = reset_button_idx == 0 ? 1 : reset_button_idx == 1 ? 2 :
                       reset_button_idx == 2 ? 4 : reset_button_idx == 3 ? 8 :
                       reset_button_idx == 4 ? 16 : reset_button_idx == 5 ? 32 : 64;
    !(reset_buttons_seen & reset_button_bit) ? (
      reset_buttons_seen = reset_buttons_seen | reset_button_bit;
      reset_step_i = 0;
      while (reset_step_i < NUM_TRACKS * MAX_STEPS) (
        reset_button_idx == 0 ? 12000[reset_step_i] = 100 :
        reset_button_idx == 1 ? 16000[reset_step_i] = 4 :
        reset_button_idx == 2 ? 14000[reset_step_i] = 64 :
        reset_button_idx == 3 ? 18000[reset_step_i] = 0 :
        reset_button_idx == 4 ? 20000[reset_step_i] = 1 :
        reset_button_idx == 5 ? 22000[reset_step_i] = 100 :
                                24000[reset_step_i] = 0;
        reset_step_i += 1;
      );
      save_pattern_to_mem(active_edit_pat);
      gui_dirty = 1;
    );
  );
);

lfo_tr_hov = mouse_x >= bx_lfo_tr && mouse_x <= bx_lfo_tr + bw_lfo && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
lfo_sh_hov = mouse_x >= bx_lfo_sh && mouse_x <= bx_lfo_sh + bw_lfo && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
lfo_sy_hov = mouse_x >= bx_lfo_sy && mouse_x <= bx_lfo_sy + bw_lfo && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
lfo_rt_hov = mouse_x >= bx_lfo_rt && mouse_x <= bx_lfo_rt + bw_lfo && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
lfo_tg_hov = mouse_x >= bx_lfo_tg && mouse_x <= bx_lfo_tg + bw_lfo && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
lfo_ds_hov = mouse_x >= bx_lfo_ds && mouse_x <= bx_lfo_ds + bw_lfo && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
lfo_am_hov = mouse_x >= bx_lfo_am && mouse_x <= bx_lfo_am + bw_lfo && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;

// Right sidebar (Transpose & Master Slots) - W: 44px
rsb_w = W(44);
rsb_x = cur_w - rsb_w;

oct_disp_hov  = mouse_x >= rsb_x + W(4) && mouse_x <= rsb_x + W(40) && mouse_y >= Y(32)  && mouse_y <= Y(54);
semi_disp_hov = mouse_x >= rsb_x + W(4) && mouse_x <= rsb_x + W(40) && mouse_y >= Y(74)  && mouse_y <= Y(96);
trans_rst_hov = mouse_x >= rsb_x + W(4) && mouse_x <= rsb_x + W(40) && mouse_y >= Y(100) && mouse_y <= Y(122);
m_slot1_hov   = mouse_x >= rsb_x + W(4) && mouse_x <= rsb_x + W(40) && mouse_y >= Y(180) && mouse_y <= Y(202);
m_slot2_hov   = mouse_x >= rsb_x + W(4) && mouse_x <= rsb_x + W(40) && mouse_y >= Y(208) && mouse_y <= Y(230);
m_slot3_hov   = mouse_x >= rsb_x + W(4) && mouse_x <= rsb_x + W(40) && mouse_y >= Y(152) && mouse_y <= Y(174);
meter_hov     = !is_over_lfo_menu && (mouse_x >= rsb_x + W(4) && mouse_x <= rsb_x + W(40) && mouse_y >= Y(272) && mouse_y <= Y(440));

// Pattern Matrix & Chain layout in bottom bar (destra)
bot_bar_y = Y(400);
bot_bar_h = cur_h - bot_bar_y;

sq_size = max(16, floor(18 * sy + 0.5));
pw_pat = max(18, floor(20 * sx));
ph_pat = sq_size;
pgap_x = max(2, floor(3 * sx + 0.5));
pgap_y = max(2, floor(4 * sy + 0.5));

total_pats_h = 2 * ph_pat + pgap_y;
py_pats_top = bot_bar_y + floor((bot_bar_h - total_pats_h) * 0.5);

total_pats_w = 8 * pw_pat + 7 * pgap_x;
bx_pats_area = pm_right_edge - total_pats_w;
// CHAIN button starts at Density meter (X(787)) and extends to pattern pads
bx_chain_btn = X(787);
bh_chain_btn = H(24);
by_chain_btn = bot_bar_y + floor((bot_bar_h - bh_chain_btn) * 0.5);
chain_gap_x = max(4, floor(8 * sx + 0.5));
bw_chain_btn = max(W(40), (bx_pats_area - chain_gap_x) - bx_chain_btn);

chain_btn_hov = !is_over_lfo_menu && (mouse_x >= bx_chain_btn && mouse_x <= bx_chain_btn + bw_chain_btn && mouse_y >= by_chain_btn && mouse_y <= by_chain_btn + bh_chain_btn);

hov_pat_idx = -1;
!is_over_lfo_menu ? (
  pi_hov = 0;
  while (pi_hov < 16) (
    px_h = bx_pats_area + (pi_hov % 8) * (pw_pat + pgap_x);
    py_h = (pi_hov < 8) ? py_pats_top : py_pats_top + ph_pat + pgap_y;
    (mouse_x >= px_h && mouse_x <= px_h + pw_pat && mouse_y >= py_h && mouse_y <= py_h + ph_pat) ? (
      hov_pat_idx = pi_hov;
    );
    pi_hov += 1;
  );
);

kb_hov = m_x >= 52 && m_x <= 146 && m_y >= 12 && m_y <= 36;
root_hov = m_x >= 150 && m_x <= 188 && m_y >= 12 && m_y <= 36;
scale_hov = m_x >= 192 && m_x <= 310 && m_y >= 12 && m_y <= 36;
p0_hov = m_x >= 4 && m_x <= 40 && m_y >= 20 && m_y <= 42;
p1_hov = m_x >= 4 && m_x <= 40 && m_y >= 46 && m_y <= 68;
sp0_hov = m_x >= 4 && m_x <= 40 && m_y >= 113 && m_y <= 135;
sp1_hov = m_x >= 4 && m_x <= 40 && m_y >= 139 && m_y <= 161;
sp2_hov = m_x >= 4 && m_x <= 40 && m_y >= 165 && m_y <= 187;
sp3_hov = m_x >= 4 && m_x <= 40 && m_y >= 191 && m_y <= 213;
euc_hov = m_x >= 4 && m_x <= 40 && m_y >= 242 && m_y <= 264;
undo_hov = m_x >= 4 && m_x <= 40 && m_y >= 293 && m_y <= 315;
redo_hov = m_x >= 4 && m_x <= 40 && m_y >= 319 && m_y <= 341;
del_hov = m_x >= 4 && m_x <= 40 && m_y >= 345 && m_y <= 367;
info_hov = m_x >= 4 && m_x <= 40 && m_y >= 396 && m_y <= 418;
lang_hov = m_x >= 4 && m_x <= 40 && m_y >= 422 && m_y <= 444;

#tt_title = "";
#tt_desc = "";

// Mouse wheel handling
mouse_wheel != 0 ? (
  wheel_dir = (mouse_wheel > 0) ? 1 : -1;
  mouse_wheel = 0;
  gui_dirty = 1;

  m_slot3_hov ? (
    delta_ml = (mouse_cap & 1) ? 4 : 1;
    modify_master_len(wheel_dir * delta_ml);
    drag_mode == 22 ? (
      drag_start_val = master_len_offset;
      drag_start_y = m_y;
    );
    gui_dirty = 1;
  ) :
  m_slot1_hov ? (
    delta_md = (mouse_cap & 1) ? 1 : 5;
    master_density = min(100, max(0, master_density + wheel_dir * delta_md));
    drag_mode == 24 ? (
      drag_start_val = master_density;
      drag_start_y = m_y;
    );
    gui_dirty = 1;
  ) :
  m_slot2_hov ? (
    master_s2_mode == 0 ? (
      delta_msw = (mouse_cap & 1) ? 1 : 5;
      modify_master_swing(wheel_dir * delta_msw);
      drag_mode == 23 ? (
        drag_start_val = master_swing;
        drag_start_y = m_y;
      );
    ) : (
      delta_mg = (mouse_cap & 1) ? 1 : 5;
      master_gate = min(100, max(-100, master_gate + wheel_dir * delta_mg));
      drag_mode == 21 ? (
        drag_start_val = master_gate;
        drag_start_y = m_y;
      );
    );
    gui_dirty = 1;
  ) :
  meter_hov ? (
    delta_mv = (mouse_cap & 1) ? 1 : 5;
    master_vol = min(100, max(0, master_vol + wheel_dir * delta_mv));
    drag_mode == 20 ? (
      drag_start_val = master_vol;
      drag_start_y = m_y;
    );
    gui_dirty = 1;
  ) :
  oct_disp_hov ? (
    transpose_all_tracks(wheel_dir * 12, 1);
  ) :
  semi_disp_hov ? (
    transpose_all_tracks(wheel_dir, 0);
  ) :
  root_hov ? (
    undo_push();
    set_quant_root(quant_root + wheel_dir);
  ) :
  scale_hov ? (
    undo_push();
    next_s = quant_scale == 99 ? 0 : (quant_scale - wheel_dir);
    next_s = min(53, max(0, next_s));
    set_quant_scale(next_s);
  ) :
  lfo_tr_hov ? (
    lfo_cur_tr = min(15, max(0, lfo_cur_tr - wheel_dir));
    drag_mode == 16 ? (
      drag_start_val = lfo_cur_tr;
      drag_start_y = m_y;
    );
  ) :
  lfo_sh_hov ? (
    4500[lfo_cur_tr] = min(5, max(0, 4500[lfo_cur_tr] - wheel_dir));
    drag_mode == 12 ? (
      drag_start_val = 4500[lfo_cur_tr];
      drag_start_y = m_y;
    );
  ) :
  lfo_rt_hov ? (
    undo_push();
    4520[lfo_cur_tr] ? (
      cur_rt = 4540[lfo_cur_tr];
      4540[lfo_cur_tr] = min(11, max(0, cur_rt + wheel_dir));
      drag_mode == 11 ? (
        drag_start_val = 4540[lfo_cur_tr];
        drag_start_y = m_y;
      );
    ) : (
      step_hz = (mouse_cap & 1 || mouse_cap & 2) ? 0.01 : 0.10;
      new_hz = floor((4560[lfo_cur_tr] + wheel_dir * step_hz) * 100 + 0.5) / 100.0;
      4560[lfo_cur_tr] = min(20.0, max(0.01, new_hz));
      drag_mode == 11 ? (
        drag_start_val = 4560[lfo_cur_tr];
        drag_start_y = m_y;
      );
    );
  ) :
  lfo_ds_hov ? (
    undo_push();
    cur_dst = 4600[lfo_cur_tr];
    4600[lfo_cur_tr] = get_next_lfo_dest(cur_dst, -wheel_dir, lfo_cur_tr);
  ) :
  lfo_am_hov ? (
    undo_push();
    delta_am = (mouse_cap & 1) ? 1 : 5;
    4620[lfo_cur_tr] = min(100, max(0, 4620[lfo_cur_tr] + wheel_dir * delta_am));
    drag_mode == 15 ? (
      drag_start_val = 4620[lfo_cur_tr];
      drag_start_y = m_y;
    );
  ) :
  row_idx = 0;
  while (row_idx < TRACKS_PER_PAGE) (
    tr = current_page * 8 + row_idx;
    ry = 52 + row_idx * 44;

    m_x >= 100 && m_x <= 146 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      cur_ch = 1620[tr];
      new_ch = cur_ch - wheel_dir;
      1620[tr] = min(16, max(0, new_ch));
    );

    m_x >= 150 && m_x <= 188 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      cur_pitch = 1600[tr];
      (mouse_cap & 1) ? (
        new_pitch = get_next_scale_octave(cur_pitch, wheel_dir);
      ) : (
        new_pitch = get_next_scale_pitch(cur_pitch, wheel_dir);
      );
      1600[tr] = new_pitch;
      drag_mode == 1 ? (
        drag_start_val = new_pitch;
        drag_start_y = m_y;
      );
    );

    m_x >= 1005 && m_x <= 1055 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      cur_pm = 1920[tr];
      next_pm = min(3, max(0, cur_pm - wheel_dir));
      next_pm != cur_pm ? (
        1920[tr] = next_pm;
        save_pattern_to_mem(active_edit_pat);
        gui_dirty = 1;
      );
    );

    m_x >= 192 && m_x <= 226 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      cur_rate = 1640[tr];
      new_rate = cur_rate + wheel_dir;
      1640[tr] = min(10, max(0, new_rate));
    );

    m_x >= 230 && m_x <= 268 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      cur_len = 1660[tr];
      new_len = cur_len + wheel_dir;
      1660[tr] = min(64, max(1, new_len));
      1860[tr] > 1660[tr] ? 1860[tr] = 1660[tr];
      (euc_mode && 1860[tr] > 0) ? apply_euclidean_track(tr);
    );

    euc_mode && m_x >= 272 && m_x <= 310 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      cur_fill = 1860[tr];
      cur_len = 1660[tr];
      cur_len <= 0 ? cur_len = 16;
      cur_len > 64 ? cur_len = 64;
      new_fill = min(cur_len, max(0, cur_fill + wheel_dir));
      1860[tr] = new_fill;
      euc_mode ? apply_euclidean_track(tr);
    );

    // Chance and Swing wheel adjustment
    chance_x = 787;
    m_x >= chance_x && m_x <= chance_x + 50 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      delta_chc = (mouse_cap & 3) ? 1 : 5;
      2100[tr] == 0 ? (
        1940[tr] = min(100, max(0, 1940[tr] + (wheel_dir * delta_chc)));
      ) : (
        1720[tr] = min(100, max(0, 1720[tr] + (wheel_dir * delta_chc)));
      );
    );

    swing_x = 841;
    m_x >= swing_x && m_x <= swing_x + 48 && m_y >= ry + 6 && m_y <= ry + 30 ? (
      undo_push();
      delta_sw = (mouse_cap & 3) ? 1 : 5;
      2140[tr] == 2 ? (
        2160[tr] = min(100, max(-100, 2160[tr] + (wheel_dir * delta_sw)));
        drag_mode == 6 ? (
          drag_start_val = 2160[tr];
          drag_start_y = m_y;
        );
      ) : 2140[tr] == 1 ? (
        2120[tr] = min(100, max(-100, 2120[tr] + (wheel_dir * delta_sw)));
        drag_mode == 6 ? (
          drag_start_val = 2120[tr];
          drag_start_y = m_y;
        );
      ) : (
        1740[tr] = min(100, max(-100, 1740[tr] + (wheel_dir * delta_sw)));
        drag_mode == 6 ? (
          drag_start_val = 1740[tr];
          drag_start_y = m_y;
        );
      );
    );

    (velocity_mode || gate_mode || pan_mode || timing_mode || ratchet_mode || chance_mode || cond_mode) ? (
      s_i = 0;
      while (s_i < 16) (
        bx = screen_grid_x + s_i * box_pitch_px;
        by = Y(ry + 6);
        mouse_x >= bx && mouse_x <= bx + box_w_px && mouse_y >= by && mouse_y <= by + box_h_px ? (
          global_step = step_page * 16 + s_i;
          step_offset = tr * 64 + global_step;
          10000[step_offset] ? (
            undo_push();
            velocity_mode ? (
              cur_vel = 12000[step_offset];
              cur_vel <= 0 ? cur_vel = 100;
              wheel_delta_vel = wheel_dir * 5;
              12000[step_offset] = min(127, max(1, cur_vel + wheel_delta_vel));
            ) :
            gate_mode ? (
              cur_gate = 16000[step_offset];
              (cur_gate < 0 || cur_gate > 69) ? cur_gate = 4;
              wheel_delta_gate = (wheel_dir > 0) ? 1 : -1;
              16000[step_offset] = min(69, max(0, cur_gate + wheel_delta_gate));
            ) :
            pan_mode ? (
              cur_pan = 14000[step_offset];
              cur_pan <= 0 && cur_pan != 0 ? cur_pan = 64;
              delta_pan = 5;
              wheel_delta_pan = wheel_dir * delta_pan;
              14000[step_offset] = min(127, max(0, cur_pan + wheel_delta_pan));
            ) :
            timing_mode ? (
              cur_timing = 18000[step_offset];
              delta_timing = 5;
              wheel_delta_timing = wheel_dir * delta_timing;
              18000[step_offset] = min(50, max(-50, cur_timing + wheel_delta_timing));
            ) :
            ratchet_mode ? (
              cur_ratchet = 20000[step_offset];
              cur_ratchet <= 0 ? cur_ratchet = 1;
              wheel_delta_ratchet = (wheel_dir > 0) ? 1 : -1;
              20000[step_offset] = min(4, max(1, cur_ratchet + wheel_delta_ratchet));
            ) :
            chance_mode ? (
              cur_st_chance = 22000[step_offset];
              delta_st_chance = 5;
              wheel_delta_chance = wheel_dir * delta_st_chance;
              22000[step_offset] = min(100, max(0, cur_st_chance + wheel_delta_chance));
            ) : (
              cur_cond_val = 24000[step_offset];
              wheel_delta_cond = (wheel_dir > 0) ? 1 : -1;
              24000[step_offset] = cond_from_order(min(276, max(0, cond_order(cur_cond_val) + wheel_delta_cond)));
            );
          );
        );
        s_i += 1;
      );
    );
    row_idx += 1;
  );
);

// Middle click opens direct numeric keyboard typing or pattern blind edit
mouse_middle_press ? (
  hov_pat_idx >= 0 ? (
    !chain_mode ? (
      (active_edit_pat != active_play_pat && hov_pat_idx == active_edit_pat) ? (
        save_pattern_to_mem(active_edit_pat);
        active_edit_pat = active_play_pat;
        load_pattern_from_mem(active_edit_pat);
        gui_dirty = 1;
      ) : (
        save_pattern_to_mem(active_edit_pat);
        active_edit_pat = hov_pat_idx;
        load_pattern_from_mem(active_edit_pat);
        gui_dirty = 1;
      );
    );
  ) :
  m_slot1_hov ? (
    edit_active > 0 ? commit_param_edit();
    edit_active = 17;
    edit_tr = 0;
    edit_first_key = 1;
    #edit_buf = "";
    sprintf(#edit_buf, "%d", master_density);
    gui_dirty = 1;
  ) :
  m_slot3_hov ? (
    edit_active > 0 ? commit_param_edit();
    edit_active = 15;
    edit_tr = 0;
    edit_first_key = 1;
    #edit_buf = "";
    sprintf(#edit_buf, "%d", master_len_offset);
    gui_dirty = 1;
  ) :
  m_slot2_hov ? (
    edit_active > 0 ? commit_param_edit();
    master_s2_mode == 0 ? (
      edit_active = 16;
      edit_tr = 0;
      edit_first_key = 1;
      #edit_buf = "";
      sprintf(#edit_buf, "%d", master_swing);
    ) : (
      edit_active = 14;
      edit_tr = 0;
      edit_first_key = 1;
      #edit_buf = "";
      sprintf(#edit_buf, "%d", master_gate);
    );
    gui_dirty = 1;
  ) :
  oct_disp_hov ? (
    edit_active > 0 ? commit_param_edit();
    edit_active = 12;
    edit_tr = 0;
    edit_first_key = 1;
    #edit_buf = "";
    sprintf(#edit_buf, "%d", global_oct_offset);
    gui_dirty = 1;
  ) :
  semi_disp_hov ? (
    edit_active > 0 ? commit_param_edit();
    edit_active = 13;
    edit_tr = 0;
    edit_first_key = 1;
    #edit_buf = "";
    sprintf(#edit_buf, "%d", global_semi_offset);
    gui_dirty = 1;
  ) :
  root_hov ? (
    edit_active > 0 ? commit_param_edit();
    edit_active = 11;
    edit_tr = 0;
    edit_first_key = 1;
    #edit_buf = "";
    quant_root == 0 ? #edit_buf = "C" :
    quant_root == 1 ? #edit_buf = "C#" :
    quant_root == 2 ? #edit_buf = "D" :
    quant_root == 3 ? #edit_buf = "D#" :
    quant_root == 4 ? #edit_buf = "E" :
    quant_root == 5 ? #edit_buf = "F" :
    quant_root == 6 ? #edit_buf = "F#" :
    quant_root == 7 ? #edit_buf = "G" :
    quant_root == 8 ? #edit_buf = "G#" :
    quant_root == 9 ? #edit_buf = "A" :
    quant_root == 10 ? #edit_buf = "A#" : #edit_buf = "B";
    gui_dirty = 1;
  ) :
  lfo_tr_hov ? (
    edit_active > 0 ? commit_param_edit();
    edit_active = 10;
    edit_tr = lfo_cur_tr;
    edit_first_key = 1;
    #edit_buf = "";
    sprintf(#edit_buf, "%d", lfo_cur_tr + 1);
    gui_dirty = 1;
  ) :
  lfo_rt_hov && !4520[lfo_cur_tr] ? (
    edit_active > 0 ? commit_param_edit();
    edit_active = 9;
    edit_tr = lfo_cur_tr;
    edit_first_key = 1;
    #edit_buf = "";
    sprintf(#edit_buf, "%.2f", 4560[lfo_cur_tr]);
    gui_dirty = 1;
  ) :
  lfo_am_hov ? (
    edit_active > 0 ? commit_param_edit();
    edit_active = 8;
    edit_tr = lfo_cur_tr;
    edit_first_key = 1;
    #edit_buf = "";
    sprintf(#edit_buf, "%d", 4620[lfo_cur_tr]);
    gui_dirty = 1;
  );

  row_m = 0;
  while (row_m < TRACKS_PER_PAGE) (
    tr_m = current_page * 8 + row_m;
    ry_m = 52 + row_m * 44;

    // Channel
    (m_x >= 100 && m_x <= 146 && m_y >= ry_m + 6 && m_y <= ry_m + 30) ? (
      edit_active > 0 ? commit_param_edit();
      edit_active = 1; edit_tr = tr_m; edit_first_key = 1;
      #edit_buf = "";
      1620[tr_m] == 0 ? #edit_buf = "ALL" : sprintf(#edit_buf, "%d", 1620[tr_m]);
      gui_dirty = 1;
    );

    // Pitch
    (m_x >= 150 && m_x <= 188 && m_y >= ry_m + 6 && m_y <= ry_m + 30) ? (
      edit_active > 0 ? commit_param_edit();
      edit_active = 2; edit_tr = tr_m; edit_first_key = 1;
      #edit_buf = "";
      format_note_name(1600[tr_m]);
      strcpy(#edit_buf, #note_full_str);
      gui_dirty = 1;
    );

    // Rate
    (m_x >= 192 && m_x <= 226 && m_y >= ry_m + 6 && m_y <= ry_m + 30) ? (
      edit_active > 0 ? commit_param_edit();
      edit_active = 3; edit_tr = tr_m; edit_first_key = 1;
      #edit_buf = "";
      r_c_idx = 1640[tr_m];
      r_c_idx == 0 ? #edit_buf = "/16" :
      r_c_idx == 1 ? #edit_buf = "/12" :
      r_c_idx == 2 ? #edit_buf = "/8" :
      r_c_idx == 3 ? #edit_buf = "/4" :
      r_c_idx == 4 ? #edit_buf = "/2" :
      r_c_idx == 5 ? #edit_buf = "x1" :
      r_c_idx == 6 ? #edit_buf = "x2" :
      r_c_idx == 7 ? #edit_buf = "x4" :
      r_c_idx == 8 ? #edit_buf = "x8" :
      r_c_idx == 9 ? #edit_buf = "x12" : #edit_buf = "x16";
      gui_dirty = 1;
    );

    // Length
    (m_x >= 230 && m_x <= 268 && m_y >= ry_m + 6 && m_y <= ry_m + 30) ? (
      edit_active > 0 ? commit_param_edit();
      edit_active = 4; edit_tr = tr_m; edit_first_key = 1;
      #edit_buf = "";
      sprintf(#edit_buf, "%d", 1660[tr_m]);
      gui_dirty = 1;
    );

    // Euclidean Fill
    euc_mode && (m_x >= 272 && m_x <= 310 && m_y >= ry_m + 6 && m_y <= ry_m + 30) ? (
      edit_active > 0 ? commit_param_edit();
      edit_active = 7; edit_tr = tr_m; edit_first_key = 1;
      #edit_buf = "";
      sprintf(#edit_buf, "%d", 1860[tr_m]);
      gui_dirty = 1;
    );

    // Slot A (Density / Volume)
    chance_x = 787;
    (m_x >= chance_x && m_x <= chance_x + 50 && m_y >= ry_m + 6 && m_y <= ry_m + 30) ? (
      edit_active > 0 ? commit_param_edit();
      edit_active = 5;
      edit_tr = tr_m;
      edit_first_key = 1;
      #edit_buf = "";
      2100[tr_m] == 0 ? (
        sprintf(#edit_buf, "%d", 1940[tr_m]);
      ) : (
        sprintf(#edit_buf, "%d", 1720[tr_m]);
      );
      gui_dirty = 1;
    );

    // Slot B (Swing / Delay / Humanize)
    swing_x = 841;
    (m_x >= swing_x && m_x <= swing_x + 48 && m_y >= ry_m + 6 && m_y <= ry_m + 30) ? (
      edit_active > 0 ? commit_param_edit();
      edit_active = 6;
      edit_tr = tr_m;
      edit_first_key = 1;
      #edit_buf = "";
      2140[tr_m] == 2 ? (
        sprintf(#edit_buf, "%d", 2160[tr_m]);
      ) : 2140[tr_m] == 1 ? (
        sprintf(#edit_buf, "%d", 2120[tr_m]);
      ) : (
        sprintf(#edit_buf, "%d", 1740[tr_m]);
      );
      gui_dirty = 1;
    );

    // Step parameter: middle-click opens a text field for the active top-bar mode.
    (velocity_mode || gate_mode || pan_mode || timing_mode || ratchet_mode || chance_mode || cond_mode) ? (
      sm_i = 0;
      while (sm_i < 16) (
        sm_bx = screen_grid_x + sm_i * box_pitch_px;
        sm_by = Y(ry_m + 6);
        (mouse_x >= sm_bx && mouse_x <= sm_bx + box_w_px && mouse_y >= sm_by && mouse_y <= sm_by + box_h_px) ? (
          sm_step = step_page * 16 + sm_i;
          sm_off = tr_m * 64 + sm_step;
          sm_step < 1660[tr_m] && 10000[sm_off] ? (
            edit_active > 0 ? commit_param_edit();
            edit_tr = tr_m;
            edit_step_offset = sm_off;
            edit_first_key = 1;
            #edit_buf = "";
            velocity_mode ? (
              edit_active = 18;
              sprintf(#edit_buf, "%d", 12000[sm_off]);
            ) :
            gate_mode ? (
              edit_active = 19;
              get_elektron_gate_full_str(16000[sm_off]);
              strcpy(#edit_buf, #g_full_str);
            ) :
            pan_mode ? (
              edit_active = 20;
              sprintf(#edit_buf, "%d", 14000[sm_off] - 64);
            ) :
            timing_mode ? (
              edit_active = 21;
              sprintf(#edit_buf, "%d", 18000[sm_off]);
            ) :
            ratchet_mode ? (
              edit_active = 22;
              sprintf(#edit_buf, "%d", 20000[sm_off]);
            ) :
            chance_mode ? (
              edit_active = 23;
              sprintf(#edit_buf, "%d", 22000[sm_off]);
            ) : (
              edit_active = 24;
              get_cond_str(24000[sm_off]);
              strcpy(#edit_buf, #c_str);
            );
            gui_dirty = 1;
          );
        );
        sm_i += 1;
      );
    );

    row_m += 1;
  );
);

// Context menu (gfx_showmenu) or right-click direct text input
mouse_r_press ? (
  is_on_ctrl = 0;
  m_x < 44 ? is_on_ctrl = 1; // Left sidebar

  m_slot2_hov ? (
    is_on_ctrl = 1;
    scale_menu_open = 0;
    lfo_sh_menu_open = 0;
    lfo_ds_menu_open = 0;
    lfo_rt_menu_open = 0;
    slot_a_menu_open = 0;
    slot_b_menu_open = 0;
    pat_menu_open = 0;
    master_s2_menu_open = 1;
    master_s2_menu_x = max(W(8), rsb_x - menu_w_ms2 - W(4));
    master_s2_menu_y = min(cur_h - menu_h_ms2 - H(8), max(H(8), Y(208)));
    gui_dirty = 1;
  ) :
  hov_pat_idx >= 0 ? (
    is_on_ctrl = 1;
    scale_menu_open = 0;
    lfo_sh_menu_open = 0;
    lfo_ds_menu_open = 0;
    lfo_rt_menu_open = 0;
    slot_a_menu_open = 0;
    slot_b_menu_open = 0;
    master_s2_menu_open = 0;
    pat_menu_open = 1;
    pat_menu_target = hov_pat_idx;
    pat_menu_x = min(cur_w - menu_w_pat - W(8), max(W(8), mouse_x - floor(menu_w_pat * 0.5)));
    py_h = (hov_pat_idx < 8) ? py_pats_top : py_pats_top + ph_pat + pgap_y;
    pat_menu_y = max(H(8), py_h - menu_h_pat - H(4));
    gui_dirty = 1;
  ) :
  mode_btns_hov ? is_on_ctrl = 1; // VELOCITY, GATE, PAN, TIMING, RATCHETING, CHANCE, COND
  root_hov ? is_on_ctrl = 1 :
  scale_hov ? (
    is_on_ctrl = 1;
    lfo_sh_menu_open = 0;
    lfo_ds_menu_open = 0;
    lfo_rt_menu_open = 0;
    slot_a_menu_open = 0;
    slot_b_menu_open = 0;
    master_s2_menu_open = 0;
    pat_menu_open = 0;
    scale_menu_open = 1;
    cur_sc = quant_scale;
    scale_sub_open = (cur_sc <= 7) ? 0 :
                     (cur_sc <= 17) ? 1 :
                     (cur_sc <= 23) ? 2 :
                     (cur_sc <= 36) ? 3 : 4;
    scale_menu_x = min(cur_w - menu_w_sc - W(8), max(W(8), mouse_x));
    scale_menu_y = min(cur_h - menu_h_sc - H(8), max(H(8), mouse_y));
    gui_dirty = 1;
  ) :
  kb_hov ? (
    is_on_ctrl = 1;
  ) :
  lfo_ds_hov ? (
    is_on_ctrl = 1;
    scale_menu_open = 0;
    lfo_sh_menu_open = 0;
    lfo_rt_menu_open = 0;
    slot_a_menu_open = 0;
    slot_b_menu_open = 0;
    master_s2_menu_open = 0;
    pat_menu_open = 0;
    lfo_ds_menu_open = 1;
    lfo_ds_sub_open = -1;
    lfo_ds_menu_x = min(cur_w - menu_w_ds - W(8), max(W(8), mouse_x));
    lfo_ds_menu_y = min(cur_h - menu_h_ds - H(8), max(H(8), mouse_y));
    gui_dirty = 1;
  ) :
  lfo_sh_hov ? (
    is_on_ctrl = 1;
    scale_menu_open = 0;
    lfo_ds_menu_open = 0;
    lfo_rt_menu_open = 0;
    slot_a_menu_open = 0;
    slot_b_menu_open = 0;
    master_s2_menu_open = 0;
    lfo_ds_sub_open = -1;
    pat_menu_open = 0;
    lfo_sh_menu_open = 1;
    lfo_sh_menu_x = min(cur_w - menu_w_sh - W(8), max(W(8), mouse_x));
    lfo_sh_menu_y = min(cur_h - menu_h_sh - H(8), max(H(8), mouse_y));
    gui_dirty = 1;
  ) :
  lfo_rt_hov ? (
    is_on_ctrl = 1;
    4520[lfo_cur_tr] ? (
      scale_menu_open = 0;
      lfo_sh_menu_open = 0;
      lfo_ds_menu_open = 0;
      slot_a_menu_open = 0;
      slot_b_menu_open = 0;
      master_s2_menu_open = 0;
      pat_menu_open = 0;
      lfo_rt_menu_open = 1;
      lfo_rt_menu_x = min(cur_w - rsb_w - menu_w_rt - W(8), max(W(8), mouse_x));
      lfo_rt_menu_y = min(cur_h - menu_h_rt - H(8), max(H(8), mouse_y));
      gui_dirty = 1;
    );
  ) :
  lfo_am_hov ? is_on_ctrl = 1 :
  lfo_tr_hov ? is_on_ctrl = 1 :
  (lfo_sy_hov || lfo_tg_hov) ? (
    is_on_ctrl = 1;
  ) :
  (vel_btn_hov || gate_btn_hov || pan_btn_hov || timing_btn_hov || ratchet_btn_hov || chance_btn_hov || cond_btn_hov) ? (
    is_on_ctrl = 1;
  );

  // Track row controls
  row_c = 0;
  while (row_c < TRACKS_PER_PAGE && !is_on_ctrl) (
    ry_c = 52 + row_c * 44;
    m_y >= ry_c + 6 && m_y <= ry_c + 30 ? (
      tr_c = current_page * 8 + row_c;
      // Clear All Solos on right-click on any SOLO button
      (m_x >= 52 && m_x <= 72) ? (
        is_on_ctrl = 1;
        has_any_solo = 0;
        ti_s = 0;
        while (ti_s < NUM_TRACKS) (
          1680[ti_s] ? has_any_solo = 1;
          ti_s += 1;
        );
        has_any_solo ? (
          undo_push();
          ti_s = 0;
          while (ti_s < NUM_TRACKS) (
            1680[ti_s] = 0;
            ti_s += 1;
          );
          gui_dirty = 1;
        );
      ) :
      // Clear All Mutes on right-click on any MUTE button
      (m_x >= 76 && m_x <= 96) ? (
        is_on_ctrl = 1;
        has_any_mute = 0;
        ti_m = 0;
        while (ti_m < NUM_TRACKS) (
          1700[ti_m] ? has_any_mute = 1;
          ti_m += 1;
        );
        has_any_mute ? (
          undo_push();
          ti_m = 0;
          while (ti_m < NUM_TRACKS) (
            1700[ti_m] = 0;
            ti_m += 1;
          );
          gui_dirty = 1;
        );
      ) :
      // Reset the selected track parameter across all tracks
      ((m_x >= 100 && m_x <= 146) || (m_x >= 150 && m_x <= 188) ||
       (m_x >= 192 && m_x <= 226) || (m_x >= 230 && m_x <= 268) ||
       (euc_mode && m_x >= 272 && m_x <= 310)) ? (
        is_on_ctrl = 1;
        undo_push();
        ti_reset = 0;
        while (ti_reset < NUM_TRACKS) (
          m_x <= 146 ? 1620[ti_reset] = ti_reset + 1 :
          m_x <= 188 ? 1600[ti_reset] = 60 :
          m_x <= 226 ? 1640[ti_reset] = 7 :
          m_x <= 268 ? (
            1660[ti_reset] = 16;
            1860[ti_reset] > 16 ? 1860[ti_reset] = 16;
            euc_mode ? apply_euclidean_track(ti_reset);
          ) : (
            1860[ti_reset] = 0;
            apply_euclidean_track(ti_reset);
          );
          ti_reset += 1;
        );
        save_pattern_to_mem(active_edit_pat);
        gui_dirty = 1;
      ) :
      (m_x >= 272 && m_x <= 310) ? is_on_ctrl = 1 :
      // Step grid right-click parameter reset
      (mouse_x >= screen_grid_x && mouse_x <= screen_grid_x + 16 * box_pitch_px) ? (
        is_on_ctrl = 1;
        (velocity_mode || gate_mode || pan_mode || timing_mode || ratchet_mode || chance_mode || cond_mode) ? (
          s_r_i = 0;
          while (s_r_i < 16) (
            bx_r_st = screen_grid_x + s_r_i * box_pitch_px;
            by_r_st = Y(ry_c + 6);
            (mouse_x >= bx_r_st && mouse_x <= bx_r_st + box_w_px && mouse_y >= by_r_st && mouse_y <= by_r_st + box_h_px) ? (
              g_r_step = step_page * 16 + s_r_i;
              st_r_off = tr_c * 64 + g_r_step;
              10000[st_r_off] ? (
                undo_push();
                active_mouse_zone = 8;
                last_reset_paint_x = mouse_x;
                last_reset_paint_y = mouse_y;
                velocity_mode ? (
                  12000[st_r_off] = 100;
                ) :
                gate_mode ? (
                  16000[st_r_off] = 4; // Reset to 1 step
                ) :
                pan_mode ? (
                  14000[st_r_off] = 64; // Center
                ) :
                timing_mode ? (
                  18000[st_r_off] = 0; // 0%
                ) :
                ratchet_mode ? (
                  20000[st_r_off] = 1; // 1 sub-step
                ) :
                chance_mode ? (
                  22000[st_r_off] = 100; // 100%
                ) : (
                  24000[st_r_off] = 0; // "---"
                );
                save_pattern_to_mem(active_edit_pat);
                gui_dirty = 1;
              );
            );
            s_r_i += 1;
          );
        );
      ) :
      // Slot A Menu (Density / Volume selector on right-click)
      (m_x >= 786 && m_x <= 836) ? (
        is_on_ctrl = 1;
        scale_menu_open = 0;
        lfo_sh_menu_open = 0;
        lfo_ds_menu_open = 0;
        lfo_rt_menu_open = 0;
        slot_b_menu_open = 0;
        master_s2_menu_open = 0;
        pat_menu_open = 0;
        slot_a_menu_open = 1;
        slot_a_menu_tr = tr_c;
        slot_a_menu_x = min(cur_w - rsb_w - menu_w_sa - W(8), max(W(8), mouse_x));
        slot_a_menu_y = min(cur_h - menu_h_sa - H(8), max(H(8), mouse_y));
        gui_dirty = 1;
      ) :
      // Slot B Menu (Swing / Pan / Gate selector on right-click)
      (m_x >= 840 && m_x <= 888) ? (
        is_on_ctrl = 1;
        scale_menu_open = 0;
        lfo_sh_menu_open = 0;
        lfo_ds_menu_open = 0;
        lfo_rt_menu_open = 0;
        slot_a_menu_open = 0;
        master_s2_menu_open = 0;
        pat_menu_open = 0;
        slot_b_menu_open = 1;
        slot_b_menu_tr = tr_c;
        slot_b_menu_x = min(cur_w - rsb_w - menu_w_sb - W(8), max(W(8), mouse_x));
        slot_b_menu_y = min(cur_h - menu_h_sb - H(8), max(H(8), mouse_y));
        gui_dirty = 1;
      ) :
      (m_x >= 892 && m_x <= 1050) ? is_on_ctrl = 1; // Shift / Flip / Random / Play Mode
    );
    row_c += 1;
  );

  !is_on_ctrl ? (
    pat_menu_open = 0;
    master_s2_menu_open = 0;
    edit_active > 0 ? (
      commit_param_edit();
      edit_active = 0; edit_tr = -1; edit_first_key = 0; gui_dirty = 1;
    );
  );
);

// Primary click and drag initiation
mouse_press && active_mouse_zone == 0 && !mouse_clicked && !is_over_lfo_menu ? (
  m_slot1_hov ? (
    now_t = time_precise();
    (now_t - last_click_time < 0.3 && last_click_elem == 9940) ? (
      undo_push();
      master_density = 100;
      mouse_clicked = 1;
      last_click_elem = -1;
    ) : (
      active_mouse_zone = 4;
      drag_mode = 24;
      drag_pushed_undo = 0;
      drag_start_y = m_y;
      drag_start_val = master_density;
      last_click_time = now_t;
      last_click_elem = 9940;
      mouse_clicked = 1;
    );
    gui_dirty = 1;
  ) :
  m_slot3_hov ? (
    now_t = time_precise();
    (now_t - last_click_time < 0.3 && last_click_elem == 9942) ? (
      reset_master_len();
      mouse_clicked = 1;
      last_click_elem = -1;
    ) : (
      active_mouse_zone = 4;
      drag_mode = 22;
      drag_pushed_undo = 0;
      drag_start_y = m_y;
      drag_start_val = master_len_offset;
      last_click_time = now_t;
      last_click_elem = 9942;
      mouse_clicked = 1;
    );
    gui_dirty = 1;
  ) :
  m_slot2_hov ? (
    now_t = time_precise();
    master_s2_mode == 0 ? (
      (now_t - last_click_time < 0.3 && last_click_elem == 9943) ? (
        reset_master_swing();
        mouse_clicked = 1;
        last_click_elem = -1;
      ) : (
        active_mouse_zone = 4;
        drag_mode = 23;
        drag_pushed_undo = 0;
        drag_start_y = m_y;
        drag_start_val = master_swing;
        last_click_time = now_t;
        last_click_elem = 9943;
        mouse_clicked = 1;
      );
    ) : (
      (now_t - last_click_time < 0.3 && last_click_elem == 9941) ? (
        undo_push();
        master_gate = 0;
        mouse_clicked = 1;
        last_click_elem = -1;
      ) : (
        active_mouse_zone = 4;
        drag_mode = 21;
        drag_pushed_undo = 0;
        drag_start_y = m_y;
        drag_start_val = master_gate;
        last_click_time = now_t;
        last_click_elem = 9941;
        mouse_clicked = 1;
      );
    );
    gui_dirty = 1;
  ) :
  meter_hov ? (
    now_t = time_precise();
    (now_t - last_click_time < 0.3 && last_click_elem == 9930) ? (
      master_vol = 100;
      mouse_clicked = 1;
      last_click_elem = -1;
    ) : (
      active_mouse_zone = 4;
      drag_mode = 20;
      drag_start_y = m_y;
      drag_start_val = master_vol;
      last_click_time = now_t;
      last_click_elem = 9930;
      mouse_clicked = 1;
    );
    gui_dirty = 1;
  ) :
  oct_disp_hov ? (
    now_t = time_precise();
    (now_t - last_click_time < 0.3 && last_click_elem == 9921) ? (
      while (global_oct_offset != 0) (
        step_dir = global_oct_offset > 0 ? -1 : 1;
        ti = 0;
        while (ti < NUM_TRACKS) (
          1600[ti] = get_next_scale_octave(1600[ti], step_dir);
          ti += 1;
        );
        global_oct_offset += step_dir;
      );
      save_pattern_to_mem(active_edit_pat);
      mouse_clicked = 1;
      last_click_elem = -1;
    ) : (
