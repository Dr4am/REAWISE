gfx_measurestr("R", tr2_w, trh);
gfx_measurestr("S", tr3_w, trh);
gfx_measurestr("P", tr4_w, trh);
tr_track = max(1, floor(1.2 * scale_font));
tot_tr_w = tr1_w + tr2_w + tr3_w + tr4_w + tr_track * 3;
start_tr_x = rsb_x + floor((rsb_w - tot_tr_w) * 0.5);
start_tr_y = Y(4) + floor((H(12) - trh) * 0.5) + sb_txt_y_off;
gfx_x = start_tr_x; gfx_y = start_tr_y; gfx_drawstr("T");
gfx_x = start_tr_x + tr1_w + tr_track; gfx_y = start_tr_y; gfx_drawstr("R");
gfx_x = start_tr_x + tr1_w + tr2_w + tr_track * 2; gfx_y = start_tr_y; gfx_drawstr("S");
gfx_x = start_tr_x + tr1_w + tr2_w + tr3_w + tr_track * 3; gfx_y = start_tr_y; gfx_drawstr("P");

// Label "OCT"
