    );
  ) :
  p0_hov ? (
    active_mouse_zone = 1; captured_btn_id = 8; current_page = 0; mouse_clicked = 1; gui_dirty = 1;
  ) :
  p1_hov ? (
    active_mouse_zone = 1; captured_btn_id = 9; current_page = 1; mouse_clicked = 1; gui_dirty = 1;
  ) :
  sp0_hov ? (
    active_mouse_zone = 1; captured_btn_id = 10; step_page = 0; mouse_clicked = 1; gui_dirty = 1;
  ) :
  sp1_hov ? (
    active_mouse_zone = 1; captured_btn_id = 11; step_page = 1; mouse_clicked = 1; gui_dirty = 1;
  ) :
  sp2_hov ? (
    active_mouse_zone = 1; captured_btn_id = 12; step_page = 2; mouse_clicked = 1; gui_dirty = 1;
