    gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
  ) : (
    gfx_r = 0.16; gfx_g = 0.16; gfx_b = 0.18;
  );
  fill_roundrect(bx_tm, by_tm, bw_tm, bh_tm, W(3));
  set_border_color(timing_btn_hov);
  gfx_roundrect(bx_tm, by_tm, bw_tm, bh_tm, W(3), 1);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
);
gfx_setfont(8, "Inter", sz_btn, 0);
gfx_measurestr("TIMING", tm_lbl_w, tm_lbl_h);
gfx_x = bx_tm + floor((bw_tm - tm_lbl_w) * 0.5) + btn_txt_x_off;
gfx_y = by_tm + floor((bh_tm - tm_lbl_h) * 0.5) + btn_txt_y_off + (is_timing_pressed ? 1 : 0);
gfx_drawstr("TIMING");

// RATCHETING mode button
is_ratchet_pressed = (mouse_cap & 1) && ratchet_btn_hov;
by_rt = by_top_btn; bh_rt = bh_top_btn;

ratchet_mode ? (
  is_ratchet_pressed ? (
    gfx_r = 65 / 255; gfx_g = 145 / 255; gfx_b = 200 / 255;
  ) : (
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  );
  fill_roundrect(bx_rt, by_rt, bw_rt, bh_rt, W(3));
  set_border_color(ratchet_btn_hov);
  gfx_roundrect(bx_rt, by_rt, bw_rt, bh_rt, W(3), 1);
  gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
) : (
  is_ratchet_pressed ? (
    gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
  ) : (
    gfx_r = 0.16; gfx_g = 0.16; gfx_b = 0.18;
  );
  fill_roundrect(bx_rt, by_rt, bw_rt, bh_rt, W(3));
  set_border_color(ratchet_btn_hov);
  gfx_roundrect(bx_rt, by_rt, bw_rt, bh_rt, W(3), 1);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
);
gfx_setfont(8, "Inter", sz_btn, 0);
gfx_measurestr("RATCHETING", rt_lbl_w, rt_lbl_h);
gfx_x = bx_rt + floor((bw_rt - rt_lbl_w) * 0.5) + btn_txt_x_off;
gfx_y = by_rt + floor((bh_rt - rt_lbl_h) * 0.5) + btn_txt_y_off + (is_ratchet_pressed ? 1 : 0);
gfx_drawstr("RATCHETING");

// CHANCE mode button
is_chance_pressed = (mouse_cap & 1) && chance_btn_hov;
by_ch_btn = by_top_btn; bh_ch_btn = bh_top_btn;

chance_mode ? (
  is_chance_pressed ? (
    gfx_r = 65 / 255; gfx_g = 145 / 255; gfx_b = 200 / 255;
  ) : (
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  );
  fill_roundrect(bx_ch_btn, by_ch_btn, bw_ch_btn, bh_ch_btn, W(3));
  set_border_color(chance_btn_hov);
  gfx_roundrect(bx_ch_btn, by_ch_btn, bw_ch_btn, bh_ch_btn, W(3), 1);
  gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
) : (
  is_chance_pressed ? (
    gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
  ) : (
    gfx_r = 0.16; gfx_g = 0.16; gfx_b = 0.18;
  );
  fill_roundrect(bx_ch_btn, by_ch_btn, bw_ch_btn, bh_ch_btn, W(3));
  set_border_color(chance_btn_hov);
  gfx_roundrect(bx_ch_btn, by_ch_btn, bw_ch_btn, bh_ch_btn, W(3), 1);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
);
gfx_setfont(8, "Inter", sz_btn, 0);
gfx_measurestr("CHANCE", ch_btn_w, ch_btn_h);
gfx_x = bx_ch_btn + floor((bw_ch_btn - ch_btn_w) * 0.5) + btn_txt_x_off;
gfx_y = by_ch_btn + floor((bh_ch_btn - ch_btn_h) * 0.5) + btn_txt_y_off + (is_chance_pressed ? 1 : 0);
gfx_drawstr("CHANCE");

// COND mode button
is_cond_pressed = (mouse_cap & 1) && cond_btn_hov;
by_cnd_btn = by_top_btn; bh_cnd_btn = bh_top_btn;

cond_mode ? (
  is_cond_pressed ? (
    gfx_r = 65 / 255; gfx_g = 145 / 255; gfx_b = 200 / 255;
  ) : (
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  );
  fill_roundrect(bx_cnd_btn, by_cnd_btn, bw_cnd_btn, bh_cnd_btn, W(3));
  set_border_color(cond_btn_hov);
  gfx_roundrect(bx_cnd_btn, by_cnd_btn, bw_cnd_btn, bh_cnd_btn, W(3), 1);
  gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
) : (
  is_cond_pressed ? (
    gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
  ) : (
    gfx_r = 0.16; gfx_g = 0.16; gfx_b = 0.18;
  );
  fill_roundrect(bx_cnd_btn, by_cnd_btn, bw_cnd_btn, bh_cnd_btn, W(3));
  set_border_color(cond_btn_hov);
  gfx_roundrect(bx_cnd_btn, by_cnd_btn, bw_cnd_btn, bh_cnd_btn, W(3), 1);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
);
gfx_setfont(8, "Inter", sz_btn, 0);
gfx_measurestr("COND", cnd_btn_w, cnd_btn_h);
gfx_x = bx_cnd_btn + floor((bw_cnd_btn - cnd_btn_w) * 0.5) + btn_txt_x_off;
gfx_y = by_cnd_btn + floor((bh_cnd_btn - cnd_btn_h) * 0.5) + btn_txt_y_off + (is_cond_pressed ? 1 : 0);
gfx_drawstr("COND");

// =====================================================================
// Per-track LFO strip (top bar right, 7 boxes)
// =====================================================================
by_lfo = Y(12);
bh_lfo = H(24);
lfo_box_w_px = max(20, floor(41 * (cur_w / 1271.0) + 0.5));
lfo_gap_px = max(2, floor(4 * sx + 0.5));
bw_lfo = lfo_box_w_px;

pm_right_px = X(1006) + W(44);
bx_lfo_am = pm_right_px - bw_lfo;
bx_lfo_ds = bx_lfo_am - lfo_gap_px - bw_lfo;
bx_lfo_tg = bx_lfo_ds - lfo_gap_px - bw_lfo;
bx_lfo_rt = bx_lfo_tg - lfo_gap_px - bw_lfo;
bx_lfo_sy = bx_lfo_rt - lfo_gap_px - bw_lfo;
bx_lfo_sh = bx_lfo_sy - lfo_gap_px - bw_lfo;
bx_lfo_tr = bx_lfo_sh - lfo_gap_px - bw_lfo;

// 1. LFO Track selector [ 1..16 ]
bw_lfo_tr = bw_lfo;
lfo_tr_hov = mouse_x >= bx_lfo_tr && mouse_x <= bx_lfo_tr + bw_lfo_tr && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;

(edit_active == 10) ? (
  gfx_r = 0.12; gfx_g = 0.22; gfx_b = 0.32;
  fill_roundrect(bx_lfo_tr, by_lfo, bw_lfo_tr, bh_lfo, W(3));
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  gfx_roundrect(bx_lfo_tr, by_lfo, bw_lfo_tr, bh_lfo, W(3), 1);
  gfx_setfont(8, "Inter", sz_btn, 0);
  strcpy(#draw_buf, #edit_buf);
  gfx_measurestr(#draw_buf, db_w, db_h);
  dt_x = bx_lfo_tr + floor((bw_lfo_tr - db_w) * 0.5);
  dt_y = by_lfo + floor((bh_lfo - db_h) * 0.5);
  edit_first_key ? (
    gfx_r = 0.22; gfx_g = 0.45; gfx_b = 0.75;
    gfx_rect(dt_x - W(2), dt_y - H(1), db_w + W(4), db_h + H(2));
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  ) : (
    (time_precise() * 2) % 1 < 0.5 ? strcat(#draw_buf, "|");
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  );
  gfx_x = dt_x; gfx_y = dt_y;
  gfx_drawstr(#draw_buf);
) : (
  set_border_color(lfo_tr_hov);
  gfx_roundrect(bx_lfo_tr, by_lfo, bw_lfo_tr, bh_lfo, W(3), 1);

  gfx_setfont(8, "Inter", sz_btn, 0);
  sprintf(#lfo_tr_str, "%d", lfo_cur_tr + 1);
  gfx_measurestr(#lfo_tr_str, ltr_w, ltr_h);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
  gfx_x = bx_lfo_tr + floor((bw_lfo_tr - ltr_w) * 0.5);
  gfx_y = by_lfo + floor((bh_lfo - ltr_h) * 0.5) + btn_txt_y_off;
  gfx_drawstr(#lfo_tr_str);
);

// 2. LFO Waveform selector [ ~ ]
bw_lfo_sh = bw_lfo;
lfo_sh_hov = mouse_x >= bx_lfo_sh && mouse_x <= bx_lfo_sh + bw_lfo_sh && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
is_lfo_sh_pressed = (mouse_cap & 1) && lfo_sh_hov;

set_border_color(lfo_sh_hov);
gfx_roundrect(bx_lfo_sh, by_lfo, bw_lfo_sh, bh_lfo, W(3), 1);

get_track_color(lfo_cur_tr);
lfo_sh_hov ? (
  gfx_r = min(1.0, cr * 1.25); gfx_g = min(1.0, cg * 1.25); gfx_b = min(1.0, cb * 1.25);
) : (
  gfx_r = cr; gfx_g = cg; gfx_b = cb;
);
draw_lfo_wave_icon(4500[lfo_cur_tr], bx_lfo_sh, by_lfo, bw_lfo_sh, bh_lfo, scale_font);

// Indicatore animato di fase in tempo reale sull'icona forma d'onda LFO (solo se collegato a una destinazione != OFF)
(is_playing_transport && 4600[lfo_cur_tr] != 0) ? (
  is_sync_sh = 4520[lfo_cur_tr];
  is_retrig_sh = 4580[lfo_cur_tr];
  r_beats_sh = is_sync_sh ? get_lfo_sync_beats(4540[lfo_cur_tr], 4700[lfo_cur_tr]) : 2.0;
  r_beats_sh <= 0 ? r_beats_sh = 2.0;

  !is_retrig_sh ? (
    cur_t_sh = now_time;
    cur_b_sh = cur_t_sh * (tempo / 60.0);
  ) : (
    cur_t_sh = play_position;
    cur_b_sh = gfx_cur_beat;
  );

  raw_ph_sh = is_sync_sh ? (cur_b_sh / r_beats_sh) : (cur_t_sh * 4560[lfo_cur_tr]);
  ph_anim = raw_ph_sh - floor(raw_ph_sh);

  cx_sh = bx_lfo_sh + bw_lfo_sh * 0.5;
  cy_sh = by_lfo + bh_lfo * 0.5;
  hw_sh = max(5, floor(8 * scale_font));
  hh_sh = max(3, floor(5 * scale_font));

  dot_x = cx_sh - hw_sh + ph_anim * (hw_sh * 2);
  cur_lfo_val = 4740[lfo_cur_tr];
  dot_y = cy_sh - cur_lfo_val * hh_sh;

  gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0; gfx_a = 0.95;
  gfx_circle(dot_x, dot_y, max(2, floor(2.5 * scale_font)), 1);
);

// 3. SYNC / FREQ toggle button
bw_lfo_sy = bw_lfo;
lfo_sy_hov = mouse_x >= bx_lfo_sy && mouse_x <= bx_lfo_sy + bw_lfo_sy && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
is_lfo_sy_pressed = (mouse_cap & 1) && lfo_sy_hov;
is_sync_active = 4520[lfo_cur_tr];

is_lfo_sy_pressed ? (
  gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
) : (
  gfx_r = 0.16; gfx_g = 0.16; gfx_b = 0.18;
);
fill_roundrect(bx_lfo_sy, by_lfo, bw_lfo_sy, bh_lfo, W(3));
set_border_color(lfo_sy_hov);
gfx_roundrect(bx_lfo_sy, by_lfo, bw_lfo_sy, bh_lfo, W(3), 1);

#lfo_sy_str = is_sync_active ? "SYNC" : "FREQ";
gfx_measurestr(#lfo_sy_str, lsy_w, lsy_h);
gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
gfx_x = bx_lfo_sy + floor((bw_lfo_sy - lsy_w) * 0.5) + btn_txt_x_off;
gfx_y = by_lfo + floor((bh_lfo - lsy_h) * 0.5) + btn_txt_y_off + (is_lfo_sy_pressed ? 1 : 0);
gfx_drawstr(#lfo_sy_str);

// 4. LFO Rate / Frequency [ 1/2 ]
bw_lfo_rt = bw_lfo;
lfo_rt_hov = mouse_x >= bx_lfo_rt && mouse_x <= bx_lfo_rt + bw_lfo_rt && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;

(edit_active == 9 && edit_tr == lfo_cur_tr) ? (
  gfx_r = 0.12; gfx_g = 0.22; gfx_b = 0.32;
  fill_roundrect(bx_lfo_rt, by_lfo, bw_lfo_rt, bh_lfo, W(3));
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  gfx_roundrect(bx_lfo_rt, by_lfo, bw_lfo_rt, bh_lfo, W(3), 1);
  gfx_setfont(8, "Inter", sz_btn, 0);
  strcpy(#draw_buf, #edit_buf);
  gfx_measurestr(#draw_buf, db_w, db_h);
  dt_x = bx_lfo_rt + floor((bw_lfo_rt - db_w) * 0.5);
  dt_y = by_lfo + floor((bh_lfo - db_h) * 0.5);
  edit_first_key ? (
    gfx_r = 0.22; gfx_g = 0.45; gfx_b = 0.75;
    gfx_rect(dt_x - W(2), dt_y - H(1), db_w + W(4), db_h + H(2));
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  ) : (
    (time_precise() * 2) % 1 < 0.5 ? strcat(#draw_buf, "|");
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  );
  gfx_x = dt_x; gfx_y = dt_y;
  gfx_drawstr(#draw_buf);
) : (
  set_border_color(lfo_rt_hov);
  gfx_roundrect(bx_lfo_rt, by_lfo, bw_lfo_rt, bh_lfo, W(3), 1);

  is_sync_active ? (
    get_lfo_sync_str(4540[lfo_cur_tr], 4700[lfo_cur_tr]);
    strcpy(#lfo_rt_display, #lfo_s_str);
  ) : (
    sprintf(#lfo_rt_display, (4560[lfo_cur_tr] == floor(4560[lfo_cur_tr])) ? "%d" : "%.1f", 4560[lfo_cur_tr]);
  );
  gfx_measurestr(#lfo_rt_display, lrt_w, lrt_h);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
  gfx_x = bx_lfo_rt + floor((bw_lfo_rt - lrt_w) * 0.5);
  gfx_y = by_lfo + floor((bh_lfo - lrt_h) * 0.5) + btn_txt_y_off;
  gfx_drawstr(#lfo_rt_display);
);

// 5. Retrigger button [ RTG ]
bw_lfo_tg = bw_lfo;
lfo_tg_hov = mouse_x >= bx_lfo_tg && mouse_x <= bx_lfo_tg + bw_lfo_tg && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
is_lfo_tg_pressed = (mouse_cap & 1) && lfo_tg_hov;
is_rtg_active = 4580[lfo_cur_tr];

is_rtg_active ? (
  is_lfo_tg_pressed ? (
    gfx_r = 65 / 255; gfx_g = 145 / 255; gfx_b = 200 / 255;
  ) : (
    gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  );
  fill_roundrect(bx_lfo_tg, by_lfo, bw_lfo_tg, bh_lfo, W(3));
  set_border_color(lfo_tg_hov);
  gfx_roundrect(bx_lfo_tg, by_lfo, bw_lfo_tg, bh_lfo, W(3), 1);
  gfx_r = 0.0; gfx_g = 0.0; gfx_b = 0.0;
) : (
  is_lfo_tg_pressed ? (
    gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
  ) : (
    gfx_r = 0.16; gfx_g = 0.16; gfx_b = 0.18;
  );
  fill_roundrect(bx_lfo_tg, by_lfo, bw_lfo_tg, bh_lfo, W(3));
  set_border_color(lfo_tg_hov);
  gfx_roundrect(bx_lfo_tg, by_lfo, bw_lfo_tg, bh_lfo, W(3), 1);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
);
gfx_measurestr("RTG", ltg_w, ltg_h);
gfx_x = bx_lfo_tg + floor((bw_lfo_tg - ltg_w) * 0.5) + btn_txt_x_off;
gfx_y = by_lfo + floor((bh_lfo - ltg_h) * 0.5) + btn_txt_y_off + (is_lfo_tg_pressed ? 1 : 0);
gfx_drawstr("RTG");

// 6. LFO Destination box [ VEL / OFF ]
bw_lfo_ds = bw_lfo;
lfo_ds_hov = mouse_x >= bx_lfo_ds && mouse_x <= bx_lfo_ds + bw_lfo_ds && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;
cur_lfo_dst = 4600[lfo_cur_tr];
cur_lfo_dst == (13 + lfo_cur_tr) ? (
  4600[lfo_cur_tr] = 0;
  cur_lfo_dst = 0;
);

set_border_color(lfo_ds_hov);
gfx_roundrect(bx_lfo_ds, by_lfo, bw_lfo_ds, bh_lfo, W(3), 1);

get_lfo_dest_str(cur_lfo_dst);
gfx_measurestr(#lfo_d_str, lds_w, lds_h);
lds_w > (bw_lfo_ds - W(4)) ? (
  (cur_lfo_dst >= 13 && cur_lfo_dst <= 28) ? (
    sprintf(#lfo_d_str, "LF %d", cur_lfo_dst - 12);
    gfx_measurestr(#lfo_d_str, lds_w, lds_h);
  );
);

cur_lfo_dst == 0 ? (
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
) : (
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
);
gfx_x = bx_lfo_ds + floor((bw_lfo_ds - lds_w) * 0.5);
gfx_y = by_lfo + floor((bh_lfo - lds_h) * 0.5) + btn_txt_y_off;
gfx_drawstr(#lfo_d_str);

// 7. LFO Amount / Depth box [ 100% ]
bw_lfo_am = bw_lfo;
lfo_am_hov = mouse_x >= bx_lfo_am && mouse_x <= bx_lfo_am + bw_lfo_am && mouse_y >= by_lfo && mouse_y <= by_lfo + bh_lfo;

(edit_active == 8 && edit_tr == lfo_cur_tr) ? (
  gfx_r = 0.12; gfx_g = 0.22; gfx_b = 0.32;
  fill_roundrect(bx_lfo_am, by_lfo, bw_lfo_am, bh_lfo, W(3));
  gfx_r = 92 / 255; gfx_g = 193 / 255; gfx_b = 254 / 255;
  gfx_roundrect(bx_lfo_am, by_lfo, bw_lfo_am, bh_lfo, W(3), 1);
  gfx_setfont(8, "Inter", sz_btn, 0);
  strcpy(#draw_buf, #edit_buf);
  gfx_measurestr(#draw_buf, db_w, db_h);
  dt_x = bx_lfo_am + floor((bw_lfo_am - db_w) * 0.5);
  dt_y = by_lfo + floor((bh_lfo - db_h) * 0.5);
  edit_first_key ? (
    gfx_r = 0.22; gfx_g = 0.45; gfx_b = 0.75;
    gfx_rect(dt_x - W(2), dt_y - H(1), db_w + W(4), db_h + H(2));
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  ) : (
    (time_precise() * 2) % 1 < 0.5 ? strcat(#draw_buf, "|");
    gfx_r = 1.0; gfx_g = 1.0; gfx_b = 1.0;
  );
  gfx_x = dt_x; gfx_y = dt_y;
  gfx_drawstr(#draw_buf);
) : (
  set_border_color(lfo_am_hov);
  gfx_roundrect(bx_lfo_am, by_lfo, bw_lfo_am, bh_lfo, W(3), 1);

  sprintf(#lfo_am_str, "%d%%", 4620[lfo_cur_tr]);
  gfx_measurestr(#lfo_am_str, lam_w, lam_h);
  gfx_r = 200 / 255.0; gfx_g = 200 / 255.0; gfx_b = 200 / 255.0;
  gfx_x = bx_lfo_am + floor((bw_lfo_am - lam_w) * 0.5);
  gfx_y = by_lfo + floor((bh_lfo - lam_h) * 0.5) + btn_txt_y_off;
  gfx_drawstr(#lfo_am_str);
);

// Track page buttons (1-8 and 9-16)
gfx_setfont(8, "Inter", sz_btn, 0);
gfx_mode = 0;

p0_hov = m_x >= 4 && m_x <= 40 && m_y >= 28 && m_y <= 50;
